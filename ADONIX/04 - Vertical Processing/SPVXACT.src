# Version Control
# ~~~~~~~~~~~~~~~
Funprog VERTEST() : End "03.05.00 09/07/2018 XM5"
#-------------------------------------------------------------------------------------------------------------
# actions
#
$ACTION

  If !func AFNC.ACTIV("XM5")
    # Gosub ACTION From XMOXM5MP
    mkstat = 2
    GOK = 0
    Return
  Endif

  Case ACTION
    When "RAZDUP": Gosub RAZDUP
    When "SETBOUT" : Gosub SETBOUT
    When Default
  Endcase

Return
#-------------------------------------------------------------------------------------------------------------
$SETBOUT

If [M:XACT1]ACTNO > 0
  #-- Disable delete/save button
  Call VIREBOUT(CHAINE,"AM") From GOBJET
Endif
Return
#-------------------------------------------------------------------------------------------------------------
$RAZDUP

[M:XACT1]ACTNO = 0
Affzo [M:XACT1]ACTNO
Return
#-------------------------------------------------------------------------------------------------------------
