# Version Control
# ~~~~~~~~~~~~~~~
Funprog VERTEST() : End "03.05.05 23/07/2019 XM5"

#-----------------------------------------------------------------------------------------------------------------------------------------------------
################################################################################
## Main Process
## ~~~~~~~~~~~~
##
##  Called for each ACTION.
##  In here we call additional processing for specific ACTION codes.
## v03.05.02, all actions moved to XMOXM5MI
################################################################################
$ACTION

    #
    # v03.05.04, comment out function as being called in SPE
    # gives barcode already exists error
    #
    #If func AFNC.ACTIV("XM5")
    #    Gosub ACTION From XMOXM5MI
    #Endif

Return

#-----------------------------------------------------------------------------------------------------------------------------------------------------
# v03.05.01, check that the barcode has not already been used
# on the XMXREF table or as a UPC on item table
# v03.05.02, call function from XMOXM5XMI
#
Subprog CHECK_BARCODE(IBARCODE,OVALID,OITMREF)
Value    Char IBARCODE
Variable Char OVALID
Variable Char OITMREF

    Gosub SUB_CHECK_BARCODE From XMOXM5MI

End

######################################################################################
# v03.05.03, control on BCODE Field
# required Control action be be added on XITM1 screen on BCODE field
#
Subprog C_BCODE(VALEUR)
Variable Char    VALEUR()

    If func AFNC.ACTIV("XM5")
        Gosub C_BCODE From XMOXM5MI
    Endif

End

