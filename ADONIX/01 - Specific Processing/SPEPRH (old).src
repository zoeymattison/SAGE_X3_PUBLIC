#<AdxTL>@(#)0.0.0.0 $Revision$ Pick tickets
# local integer OK
# local char VALEUR

# CALL SAICAR(VALEUR, "Title of window", "Field caption", " ", 0, 0, "", OK) from GESECRAN
# infbox VALEUR + " " + num$(OK)

# gosub EXEBOUT
# End

$ACTION

Case ACTION

 WHEN "EXEBOUT" : Gosub EXEBOUT
 When Default
Endcase
Return



$EXEBOUT  
  local integer LOK
  local char LINPUT
  local char ZTITLE : ZTITLE = "Enter number of labels"
  local char ZFLDTIT : ZFLDTIT = "Number of labels"
  local char ZOBJ : ZOBJ = " "
  
  if [M:PRH0]PRHNUM = ""
    Return
  endif
 
  PRNDEST = func afnc.intfld("APRTAUS", "PRT", GUSER+"~YMOS_PL_PACLAB~")
  if PRNDEST = "" 
     # Return
    PRNDEST = "PREVIEW"
  endif

  LINPUT = "1"
  LOK = 2
  If PRNDEST <> "PREVIEW"
     Call SAICAR (LINPUT, ZTITLE, ZFLDTIT, ZOBJ,0,0,"",LOK) from GESECRAN
  endif

  if LOK = 1 #cancel
     Return
  else

    call PRINTPACLBL ([M:PRH0]PRHNUM, PRNDEST, val(LINPUT)) from YPRNSIH
  endif 



Return






















































