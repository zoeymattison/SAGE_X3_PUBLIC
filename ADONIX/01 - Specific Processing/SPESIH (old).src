#<AdxTL>@(#)0.0.0.0 $Revision$ Invoices
$ACTION
  Case ACTION 
    when "APRES_CRE": gosub APRES_CRE
#    when "EXEBOUT" : gosub EXEBOUT
    when "VERIF_CRE" : gosub VERIF_CRE
    when "VERIF_MOD" : gosub VERIF_MOD
  endcase
Return

$VERIF_CRE
$VERIF_MOD
   [F:SIH]YSTARPT=[F:SIH]STARPT
   [F:SIV]YSTARPT=[F:SIV]STARPT 
Return

#$EXEBOUT
#   if [M:SIH0]BPCINV="EE2107"
#      call EMLSIH([M:SIH0]NUM) from YPRNSIH
#   endif
#Return

$APRES_CRE
  # & [F:YBPI]YSENDPRINT=2
  if ([F:SIV]SALFCY='DC30' | ([F:SIV]SALFCY='DC52' | [F:SIV]SALFCY='DC33' & [F:SIV]SIVTYP = 'INV')) 
    Call PRINTSIH2([F:SIV]NUM) from YPRNSIH
  endif
Return


















































