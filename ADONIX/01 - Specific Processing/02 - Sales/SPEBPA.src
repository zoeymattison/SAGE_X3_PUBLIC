Subprog C_XWEB5(VALEUR)
Variable Char    VALEUR()
If [M:YBPC]ZMARKETING=2 and VALEUR=""
    GMESSAGE="Please disable marketing emails before removing this email!"
    Chgstl [M:YBPC]ZMARKETING With "BACKRED"
    mkstat=2
Endif
End


