Subprog C_ZNOVEXCO(VALEUR)
Variable Char    VALEUR()

End


######################################################################################
######################################################################################
## Section automatically added (screen YITM) 05/05/2026 14:17:42 (MOZM)
######################################################################################
Subprog AM_ZQTYNVX(VALEUR)
Variable Decimal VALEUR

End


######################################################################################

$STYLE
[M:YITM]ZQTYMNK=val(func AFNC.INTFLD("ITMMVT","PHYSTO",[M:ITM0]ITMREF+"~"+"DC30"))
Affzo [M:YITM]ZQTYMNK
[M:YITM]ZQTYTOT=val(func AFNC.INTFLD("ITMMVT","ZQTYNVX",[M:ITM0]ITMREF+"~"+"DC30"))
Affzo [M:YITM]ZQTYTOT
Return
