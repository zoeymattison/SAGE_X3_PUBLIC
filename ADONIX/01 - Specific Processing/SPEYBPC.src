Subprog C_ZMARKETING(VALEUR)
Variable Integer VALEUR
If [M:BPAC]XWEB5="" and VALEUR=2 and GUSER="MOZM"
    chgstl [M:BPAC]XWEB5 with "BACKRED"
    GMESSAGE="Please enter a marketing email first!"
    zonsui="[M:BPAC]XWEB5"
    mkstat=2
Endif
End


