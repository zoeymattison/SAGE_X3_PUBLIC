#<AdxTL>@(#)0.0.0.0 $Revision$ 
$ACTION
#If GUSER="MOZM" : Infbox "ACTION - "+ACTION : Endif
# It is necessary to fill the screen with GAU instead of CLE_GAUCHE - when using CLE_GAUCHE, if you hit eneter to filter the left list, it runs the CLE_GAUCHE
# action on a seemingly random product code from the newly filtered list.
Case ACTION
	When "OUVRE" : Gosub OUVRE
	#When "CLE_GAUCHE" : Gosub CLE_GAUCHE
	When "GAU" : Gosub GAU
Endcase
Return

$OUVRE
#If GUSER<>"MOZM" : Infbox "Update in progress" : FIN=1 : Endif
If !clalev([ZITM]) : Local File ITMMASTER [ZITM] : Endif
Return

#$GAU
#If GUSER="MOZM" : Infbox [F:ZITM]ITMREF : Endif
#Return

$GAU
If [F:ZITM]ITMREF="" : Return : Endif
If !clalev([ZSTKD1]) : Local File ZSTKDET1 [ZSTKD1] : Endif
If !clalev([ZSTKD2]) : Local File ZSTKDET2 [ZSTKD2] : Endif
If !clalev([ZSTKD3]) : Local File ZSTKDET3 [ZSTKD3] : Endif
If !clalev([ZSTKD4]) : Local File ZSTKDET4 [ZSTKD4] : Endif
If !clalev([ZSTKD5]) : Local File ZSTKDET5 [ZSTKD5] : Endif
If !clalev([ZSTKD6]) : Local File ZSTKDET6 [ZSTKD6] : Endif
If !clalev([ZITV]) : Local File ITMMVT [ZITV] : Endif
If !clalev([ZPLI]) : Local File PPRICLIST [ZPLI] : Endif
If !clalev([ZPTD]) : Local File PRECEIPTD [ZPTD] : Endif
[M:ZPR0]EANCOD=[F:ZITM]EANCOD
[M:ZPR0]SEAKEYDIS=[F:ZITM]SEAKEY
[M:ZPR0]MNKITM=[F:ZITM]ITMREF
[M:ZPR0]ITMDES1=[F:ZITM]ITMDES1
[M:ZPR0]ITMDES2=[F:ZITM]ITMDES2
[M:ZPR0]ITMDES3=[F:ZITM]ITMDES3
[M:ZPR0]CREDAT=[F:ZITM]CREDAT
[M:ZPR0]ITMALT=[F:ZITM]RPLITM
[M:ZPR0]MNKCLS=func AFNC.INTFLD("ATEXTRA","TEXTE","ATABDIV"+"~"+"LNGDES"+"~"+"ENG"+"~"+"21"+"~"+num$([F:ZITM]TSICOD(1)))
[M:ZPR0]ITMCLS=[F:ZITM]TCLCOD(0)+" - "+func AFNC.INTFLD("ITMCATEG","TCLAXX","DC30"+"~"+[F:ZITM]TCLCOD(0))
[M:ZPR0]ITMSTA=[F:ZITM]TSICOD(0)
[M:ZPR0]STU=[F:ZITM]STU
[M:ZPR0]ZRVWDAT=[F:ZITM]ZRVWDAT
Read [ZSTKD1]ZSTKD10=[F:ZITM]ITMREF
If !fstat
	[M:ZPR2]QTY30D=[F:ZSTKD1]QTY_30D
	[M:ZPR2]QTY90D=[F:ZSTKD1]QTY_90D
	[M:ZPR2]QTY365=[F:ZSTKD1]QTY_365
	[M:ZPR2]SAL365=[F:ZSTKD1]SAL_365
	[M:ZPR1]POHQTY=num$([F:ZSTKD1]QTYPOH)+" "+[F:ZITM]STU
	[M:ZPR1]BPSNUM1=[F:ZSTKD1]BPSNUM1
	[M:ZPR1]BPSNAM1=toupper(func AFNC.INTFLD("BPSUPPLIER","BPSNAM",[F:ZSTKD1]BPSNUM1))
	[M:ZPR1]ITMREFBPS1=func AFNC.INTFLD("ITMBPS","ITMREFBPS",[F:ZITM]ITMREF+"~"+[F:ZSTKD1]BPSNUM1)
	[M:ZPR1]BPSNUM2=[F:ZSTKD1]BPSNUM2
	[M:ZPR1]BPSNAM2=toupper(func AFNC.INTFLD("BPSUPPLIER","BPSNAM",[F:ZSTKD1]BPSNUM2))
	[M:ZPR1]ITMREFBPS2=func AFNC.INTFLD("ITMBPS","ITMREFBPS",[F:ZITM]ITMREF+"~"+[F:ZSTKD1]BPSNUM2)
	Filter [ZPLI] Where PLICRI1=[F:ZSTKD1]BPSNUM1 and PLICRD=[F:ZITM]ITMREF and PLI="T20"
	Read [ZPLI] First
	If ![S]fstat
		[M:ZPR1]BPCPRI1=[F:ZPLI]PRI
	Else
		Raz [M:ZPR1]BPCPRI1
	Endif
	Filter [ZPLI] Where PLICRI1=[F:ZSTKD1]BPSNUM2 and PLICRD=[F:ZITM]ITMREF and PLI="T20"
	Read [ZPLI] First
	If ![S]fstat
		[M:ZPR1]BPCPRI2=[F:ZPLI]PRI
	Else
		Raz [M:ZPR1]BPCPRI2
	Endif
	Filter [ZPTD] Where ITMREF=[F:ZITM]ITMREF and left$(BPSNUM,1)="V" and PRHFCY="DC30" Order By CREDAT Desc
	Read [ZPTD] First
	If ![S]fstat
		[M:ZPR1]LASTREC=[F:ZPTD]CREDAT
		[M:ZPR1]LASTRECBPS=[F:ZPTD]BPSNUM
		[M:ZPR1]LASTRECNAM=toupper(func AFNC.INTFLD("BPSUPPLIER","BPSNAM",[F:ZPTD]BPSNUM))
	Else
		Raz [M:ZPR1]LASTREC,[M:ZPR1]LASTRECBPS,[M:ZPR1]LASTRECNAM
	Endif
	Filter [ZPLI]
	Filter [ZPTD]
Endif
Read [ZITV]ITV0=[F:ZITM]ITMREF;"DC30"
If ![S]fstat
	[M:ZPR0]AVGCOST=[F:ZITV]AVC
Else
	[M:ZPR0]AVGCOST=0
Endif
Read [ZSTKD3]ZSTKD30=[F:ZITM]ITMREF
If ![S]fstat
	[M:ZPR0]BKOQTY=[F:ZSTKD3]BKOQTY
Else
	[M:ZPR0]BKOQTY=0
Endif
Local Shortint NOL : [L]NOL=0
Filter [ZSTKD2] Where ITMREF=[F:ZITM]ITMREF and left$(STOFCY,2)<>"DC"
[L]NOL=0
For [ZSTKD2]
	If [F:ZSTKD2]STKA>0
		[M:ZPR3]STOFCY([L]NOL)=[F:ZSTKD2]STOFCY
		[M:ZPR3]QTYTOT([L]NOL)=[F:ZSTKD2]STKA
		[L]NOL+=1
	Endif
Next
[M:ZPR3]NBRET=[L]NOL
Filter [ZSTKD2] Where ITMREF=[F:ZITM]ITMREF and left$(STOFCY,2)="DC"
[L]NOL=0
For [ZSTKD2]
	If ([F:ZSTKD2]STKA+[F:ZSTKD2]STKQ+[F:ZSTKD2]STKR)>0
		[M:ZPR4]STOFCY([L]NOL)=[F:ZSTKD2]STOFCY
		[M:ZPR4]LOC([L]NOL)=[F:ZSTKD2]LOC
		[M:ZPR4]QTYTOTA([L]NOL)=[F:ZSTKD2]STKA
		[M:ZPR4]QTYTOTQ([L]NOL)=[F:ZSTKD2]STKQ
		[M:ZPR4]QTYTOTR([L]NOL)=[F:ZSTKD2]STKR
		[L]NOL+=1
	Endif
Next
[M:ZPR4]NBWRH=[L]NOL

Filter [ZSTKD4] Where ITMREF=[F:ZITM]ITMREF Order By CREDATTIM Desc
[L]NOL=0
For [ZSTKD4]
	If [L]NOL=9 : Break : Endif
	[M:ZPR5]INVDAT([L]NOL)=[F:ZSTKD4]INVDAT
	[M:ZPR5]CUSTOMER([L]NOL)=[F:ZSTKD4]CUSTOMER
	[M:ZPR5]NUM([L]NOL)=[F:ZSTKD4]INVOICE
	[M:ZPR5]SOHNUM([L]NOL)=[F:ZSTKD4]SALESORDER
	[M:ZPR5]QTYSTU([L]NOL)=[F:ZSTKD4]QTYSTU
	[M:ZPR5]SALPRI([L]NOL)=[F:ZSTKD4]GROPRI
	[M:ZPR5]TOTNOTAX([L]NOL)=[F:ZSTKD4]AMTNOTLIN
	[L]NOL+=1
Next
[M:ZPR5]NBSIH=[L]NOL

Filter [ZSTKD5] Where ITMREF=[F:ZITM]ITMREF Order By CREDATTIM Desc
[L]NOL=0
For [ZSTKD5]
	[M:ZPR6]ORDDAT([L]NOL)=[F:ZSTKD5]ORDDAT
	[M:ZPR6]CUSTOMER([L]NOL)=[F:ZSTKD5]CUSTOMER
	[M:ZPR6]SOHNUM([L]NOL)=[F:ZSTKD5]SALESORDER
	[M:ZPR6]QTYSTU([L]NOL)=[F:ZSTKD5]QTYSTU
	[M:ZPR6]SALPRI([L]NOL)=[F:ZSTKD5]GROPRI
	[M:ZPR6]TOTNOTAX([L]NOL)=[F:ZSTKD5]AMTNOTLIN
	[L]NOL+=1
Next
[M:ZPR6]NBSOH=[L]NOL

Filter [ZSTKD6] Where ITMREF=[F:ZITM]ITMREF Order By CREDATTIM Desc
[L]NOL=0
For [ZSTKD6]
    	[M:ZPR7]ORDDAT([L]NOL)=[F:ZSTKD6]ORDDAT
    	[M:ZPR7]POHNUM([L]NOL)=[F:ZSTKD6]POHNUM
    	[M:ZPR7]BPSNUM([L]NOL)=[F:ZSTKD6]BPSNUM
    	[M:ZPR7]REMQTY([L]NOL)=[F:ZSTKD6]QTYREM
    	[M:ZPR7]ETA([L]NOL)=[F:ZSTKD6]ETADAT
    	[L]NOL+=1
Next
[M:ZPR7]NBPOH=[L]NOL

[L]NOL=0
Affzo [ZPR0]
Affzo [ZPR1]
Affzo [ZPR2]
Affzo [ZPR3]
Affzo [ZPR4]
Affzo [ZPR5]
Affzo [ZPR6]
Affzo [ZPR7]
LogicClose File [ZSTKD1],[ZSTKD2],[ZSTKD3],[ZSTKD4],[ZSTKD5],[ZSTKD6],[ZPLI],[ZPTD],[ZITV]
Return
