## Section automatically added (screen SOH0) 08/15/2025 06:59:54 (MOZM)
######################################################################################
Subprog AS_SALFCY(VALEUR)
Variable Char    VALEUR()
If GFLAG="RNP"
	Local Char FUNCTION_PROFILE(50) : [L]FUNCTION_PROFILE=func AFNC.INTFLD("AUTILIS","PRFFCT",GUSER)
	Local Char SALES_SITE(50) : [L]SALES_SITE=func AFNC.INTFLD("AFCTFCT","FCYDEF(4)",[L]FUNCTION_PROFILE)
	If [L]SALES_SITE="" : [L]SALES_SITE="DC30" : Endif
	[M:SOH0]SALFCY=[L]SALES_SITE
	Affzo [M:SOH0]SALFCY
Endif
End

Subprog AS_SOHTYP(VALEUR)
Variable Char    VALEUR()
If [M:SOH0]SALFCY="DC30"
	VALEUR="ZWL"
Endif
End


