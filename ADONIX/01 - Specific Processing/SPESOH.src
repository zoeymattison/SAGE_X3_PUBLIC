Subprog C_BPCORD(VALEUR)
Variable Char    VALEUR()
If GFLAG="RNP"
    If func AFNC.INTFLD("BPCUSTOMER","ZDIRSHP",VALEUR)="2"
    	GMESSAGE="Direct-ship prohibited on this customer!"
    	mkstat=2
    Endif
Endif
End


