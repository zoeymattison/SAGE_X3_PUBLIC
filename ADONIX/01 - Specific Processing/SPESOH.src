######################################################################################
Subprog C_FMI(VALEUR)
Variable Integer VALEUR
If !GIMPORT
	If VALEUR=2
		GMESSAGE='"Direct to customer" prohibited! Please select "Receive and ship" and adjust the ship-to address in the PO!'
		mkstat=2
	Endif
Endif
End


