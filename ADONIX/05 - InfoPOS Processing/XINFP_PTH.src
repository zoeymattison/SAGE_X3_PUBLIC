###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES PURHCASE RECEIPTS
########################################################################################################################
Subprog PTH_TRANS()
    If !clalev([F:XINFPTH]) : Local File XINFPTH    [F:XINFPTH] : Endif
    If !clalev([F:XINFPTD]) : Local File XINFPTD    [F:XINFPTD] : Endif
    If !clalev([F:XINFPTS]) : Local File XINFPTS    [F:XINFPTS] : Endif
    If !clalev([F:XPTHA])   : Local File PRECEIPT   [F:XPTHA]   : Endif
    If !clalev([F:XPOQA])   : Local File PORDERQ    [F:XPOQA]   : Endif
    If !clalev([F:XSTC])    : Local File STOLOC     [F:XSTC]    : Endif
    If !clalev([F:XSTO])    : Local File STOCK      [F:XSTO]    : Endif
    If !clalev([M:IMP2])    : Local Mask IMPOBJ2    [M:IMP2]    : Endif
    If !clalev([F:XSITF])   : Local File ITMFACILIT [F:XSITF]   : Endif

    # TODO - UPDATE OF MESSAGE
    Call ECR_TRACE("GENERATION OF A PURCHASE RECEIPTS",0) From GESECRAN
    Call ECR_TRACE("---------------------------------",0) From GESECRAN

    Filter [F:XINFPTH] Where [F:XINFPTH]UPDFLG <> 2
&   Order By Key XINFPTH0

    For [F:XINFPTH]XINFPTH0
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("PURCHASE RECEIPTS : " - [F:XINFPTH]PTHNUM,0) From GESECRAN

        # @RH@ - 08/01/2018 - CLEAR ALL ERRORS ASSOCIATED WITH THE CURRENT RECORD
        ##############################################################################################################
        Call DELETE_ERRORS([F:XINFPTH]PTHNUM) From XINFP_ERR

        # TODO - UPDATE OF MESSAGE
        # DETERMINE IF PURCHASE RECEIPTS EXISTS
        Look [F:XPTHA]PTH0 = [F:XINFPTH]PTHNUM

        If fstat
            # CALL THE CREATION OF THE PURCHASE RECEIPTS
            Call TRANS_CRE From XINFP_PTH
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("PURCHASE RECEIPT EXISTS" -[F:XINFPTH]PTHNUM ,0) From GESECRAN
            Call UPDATETRANS([F:XINFPTH]PTHNUM) From XINFP_PTH
        Endif

        # IMPORT VARIABLE DISABLE - USED FOR LOGGING PURPOSES
        GIMPORT = 0

        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("*****************************",0) From GESECRAN
    Next

    If clalev([F:XINFPTH]) : Close Local File  [F:XINFPTH] : Endif
    If clalev([F:XINFPTD]) : Close Local File  [F:XINFPTD] : Endif
    If clalev([F:XINFPTS]) : Close Local File  [F:XINFPTS] : Endif
    If clalev([F:XPTHA])   : Close Local File  [F:XPTHA]   : Endif
    If clalev([F:XPOQA])   : Close Local File  [F:XPOQA]   : Endif
    If clalev([F:XSTC])    : Close Local File  [F:XSTC]    : Endif
    If clalev([F:XSTO])    : Close Local File  [F:XSTO]    : Endif
    If clalev([M:IMP2])    : Close Local Mask  [M:IMP2]    : Endif
    If clalev([F:XSITF])   : Close Local File  [F:XSITF]   : Endif
End

###########################################################################################
# UPDATE THE TRANSACTION AS COMPLETED
###########################################################################################
Subprog UPDATETRANS(XINFPNUM)
    Value Char XINFPNUM
    If !clalev([F:XUP]) : Local File XINFPTH [F:XUP] : Endif

    Call XERR_TRANS("PTH", XINFPNUM, [F:XINFPTH]EXPNUM, 2, 0, "SUCCESSFUL") From XINFP_ERR

    Trbegin [F:XUP]
        Update [F:XUP] Where [F:XUP]PTHNUM = XINFPNUM With [F:XUP]UPDFLG = 2

        If fstat
            Rollback
        Else
            Commit
        Endif

    If clalev([F:XUP]) : Close Local File   [F:XUP] : Endif
End

# CREATION OF PURCHASE RECEIPTS
##################################################################################################
Subprog TRANS_CRE
    Local Char    XLINE(255), XMESSAGE(255), XUOM(250), XDEFLOC(250)
    Local Decimal XQTY

    # DELETE OF CREATED FILE
    #############################################################################################################
    Local Integer XSTAT

    # DELETE OF CREATED FILE
    #############################################################################################################
    Call EFFACE(filpath("INFOPOS",[F:XINFPTH]PTHNUM,'TXT'),XSTAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFPTH]PTHNUM,'TXT')+".err",XSTAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFPTH]PTHNUM,'TXT'),XSTAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFPTH]PTHNUM,'TXT')+".err",XSTAT) From ORDSYS

    ## CREATE PURCHASE RECEIPTS FILE FOR IMPORT
    #################################################################################
    adxifs = ';' : adxirs = chr$(13)+chr$(10) : GOK = 1 : OK = 1

    ## OPEN FILE
    #################################################################################
    Openo filpath("INFOPOS",[F:XINFPTH]PTHNUM,'TXT') Using [FIC1]

    XLINE =   "E;"  + [F:XINFPTH]PRHFCY
    XLINE +=  ";"   + num$(format$("D:DDMMYYYY",[F:XINFPTH]RCPDAT))
    XLINE +=  ";"   + [F:XINFPTH]PTHNUM
    XLINE + = ";"   + [F:XINFPTH]BPSNUM
    XLINE +=  ";"   + [F:XINFPTH]BPSNDE

    Wrseq XLINE Using [FIC1]

    # LOADS THE CONTENT OF THE DETAILED PURCHASE ORDER LINES
    Filter [F:XINFPTD] Where [F:XINFPTD]PTHNUM = [F:XINFPTH]PTHNUM
&   Order By Key XINFPTD0

    # PERFORMANCE ENHANCEMENT, INSTEAD OF LOADING BLANK PURCHASE RECEIPT, JUST PRINT ERROR AND CONTINUE
    If rowcount([F:XINFPTD]) = 0
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("PURCHASE RECEIPT : " - [F:XINFPTH]PTHNUM - " HAS NO LINES",1) From GESECRAN
        GOK = 0
    Endif

    For [F:XINFPTD]XINFPTD0
        # WRITE THE LINE DETAIL RECORD INFORMATION
        ########################################################################################################
        XLINE =   "L;"  + [F:XINFPTD]POHNUM
        XLINE +=  ";"   + num$([F:XINFPTD]POPLIN)
        XLINE +=  ";"   + [F:XINFPTD]ITMREF
        XLINE +=  ";"   + num$([F:XINFPTD]QTYUOM)
        XLINE +=  ";"   + num$([F:XINFPTD]GROPRI)

        Wrseq XLINE Using [FIC1]

        Read [F:XPOQA]POQ0 = [F:XINFPTD]POHNUM;[F:XINFPTD]POPLIN

        Read [F:XSITF]ITF0 =  [F:XINFPTD]ITMREF;[F:XINFPTH]PRHFCY

        # WRITE THE STOCK LINE
        ########################################################################################################
        If [F:XSITF]LOCMGTCOD = 2

            Filter [F:XINFPTS] Where [F:XINFPTS]PTHNUM   = [F:XINFPTD]PTHNUM and
&                                    [F:XINFPTS]PTDLIN   = [F:XINFPTD]PTDLIN
&           Order By Key XINFPTS0

            For [F:XINFPTS]XINFPTS0
                XLINE  = "S;A"

                Raz [L]XUOM, [L]XQTY

                # IN THE EVENT WHERE THE STOCK UNIT NOT BEING THE SAME AS THE PUCHASING UNIT, A CONVERSION IS NEEDED
                If [F:XPOQA]UOM = [F:XPOQA]STU
                    [L]XUOM = [F:XPOQA]UOM
                    [L]XQTY = abs([F:XINFPTD]QTYUOM)
                Else
                    [L]XUOM = [F:XPOQA]STU
                    [L]XQTY = abs([F:XINFPTD]QTYUOM * ([F:XPOQA]QTYSTU / [F:XPOQA]QTYUOM))
                Endif

                XLINE += ";" + [L]XUOM + ";" + num$([L]XQTY)

                If [F:XINFPTS]LOC <> ''
                    XLINE += ";" + [F:XINFPTD]LOC
                Else
                    If find(1,[F:XSITF]LOCNUM)
                        XLINE += ";" + [F:XSITF]DEFLOC(find(1,[F:XSITF]LOCNUM) - 1)
                    Else
                        Filter [F:XSTO] Where [F:XSTO]ITMREF = [F:XINFPTD]ITMREF and
&                                             [F:XSTO]STOFCY = [F:XINFPTH]PRHFCY and
&                                             [F:XSTO]LOCTYP = [F:XINFPTS]LOCTYP and
&                                             [F:XSTO]PCU    = [L]XUOM
&                       Order By Key STO4
                        Read [F:XSTO]STO4 First

                        If !fstat
                             XLINE += ";" + [F:XSTO]LOC
                        Else
                            # TODO - UPDATE OF MESSAGE
                            Call ECR_TRACE( [F:XINFPTD]ITMREF - [F:XINFPTH]PRHFCY - ": UNABLE TO DETERMINE THE RECIEPT LOCATION",0) From GESECRAN
                            GOK = 0
                            Break 2
                        Endif

                    Endif
                Endif

                XLINE += ";" + [F:XINFPTS]LOT
                XLINE += ";" + [F:XINFPTS]SERNUM

                Wrseq XLINE Using [FIC1]
            Next
        Else
            XLINE  = "S;A"

            # IN THE EVENT WHERE THE STOCK UNIT NOT BEING THE SAME AS THE PUCHASING UNIT, A CONVERSION IS NEEDED
            If [F:XPOQA]UOM = [F:XPOQA]STU
                XLINE += ";" + [F:XPOQA]UOM
                XLINE += ";" + num$(abs([F:XINFPTD]QTYUOM))
            Else
                XLINE += ";" + [F:XPOQA]STU
                XLINE += ";" + num$(abs([F:XINFPTD]QTYUOM * ([F:XPOQA]QTYSTU / [F:XPOQA]QTYUOM)))
            Endif

            XLINE += ";"
            XLINE += ";"
            XLINE += ";"

            Wrseq XLINE Using [FIC1]
        Endif

        $SKIPT
    Next

    ## CLOSE FILE
    #################################################################################
    Openo Using [FIC1]

    # WRITING OF FILE SUCCESSFUL, IMPORT THE FILE
    #############################################################################################################
    If GOK
        # CALLS THE IMPORT PROCESS
        # Call IMPORTSIL(IMPT, FIL) From GIMPOBJ
        # @ IMPT - TEMPLATE TO BE USED
        # @ FIL  - FILE + LOCATION
        ###############################################################
        Raz [M:IMP2]

        [M:IMP2]MODIMP = "XINFPPTH"
        [M:IMP2]NOMIMP = filpath("INFOPOS",[F:XINFPTH]PTHNUM,'TXT')
        [M:IMP2]TYPEXP = 2

        Call IMPORTSIL([M:IMP2]MODIMP,[M:IMP2]NOMIMP) From GIMPOBJ

        Look [F:XPTHA]PTH0 = [F:XINFPTH]PTHNUM

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call XERR_TRANS("PTH", [F:XINFPTH]PTHNUM, [F:XINFPTH]EXPNUM, 1, 0, "ERROR ON THE PURCHASE RECEIPT CREATION- PLEASE REFER TO X3 LOG") From XINFP_ERR
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("SUCCESS ON THE PURCHASE RECEIPT CREATION",0) From GESECRAN
            Call UPDATETRANS([F:XINFPTH]PTHNUM) From XINFP_PTH
        Endif
    Endif

    # DELETE OF CREATED FILE
    #############################################################################################################
    Call EFFACE(filpath("INFOPOS",[F:XINFPTH]PTHNUM,'TXT'),XSTAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFPTH]PTHNUM,'TXT')+".err",XSTAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFPTH]PTHNUM,'TXT'),XSTAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFPTH]PTHNUM,'TXT')+".err",XSTAT) From ORDSYS
End




