#<AdxTL>@(#)0.0.0.0 $Revision$ Sales order
###########################################################################################
# Script            : XINFP_SOH
# Creation date     : 12/10/2017
# Version           : 1.0.0
# Authors (Company) : RH (InfoPOS)
# Module            : SALES
# ----------------------------------------------------------------------------------------
# Project code      : InfoPOS X3 INTEGRATION
# Description       : SALES ORDER INTEGRATION
#-----------------------------------------------------------------------------------------
#
# Evolutions        : (sequence, reference (Bug reference),) date, author, description
#                   : @nn@ – DD/MM/YYYY , XXXXX , NMA
###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When "IMP_ZONE"   : Gosub IMP_ZONE
        When "IMP_TAB"    : Gosub IMP_TAB
        When "IMP_ADD"    : Gosub IMP_ADD
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES SALES ORDERS
########################################################################################################################
Subprog SOH_TRANS()
    If !clalev([F:XINFSOH]) : Local File XINFSOH     [F:XINFSOH] : Endif
    If !clalev([F:XINFSOD]) : Local File XINFSOD     [F:XINFSOD] : Endif
    If !clalev([F:XINFSIT]) : Local File XINFSIT     [F:XINFSIT] : Endif
    If !clalev([F:XINFTST]) : Local File XINFTST     [F:XINFTST] : Endif
    If !clalev([F:XXBPCA])  : Local File BPCUSTOMER  [F:XXBPCA]  : Endif
    If !clalev([F:XAPL])    : Local File APLLCK      [F:XAPL]    : Endif
    If !clalev([F:XSOHA])   : Local File SORDER      [F:XSOHA]   : Endif
    If !clalev([F:XITMA])   : Local File ITMMASTER   [F:XITMA]   : Endif

    # TODO - UPDATE OF MESSAGE
    Call ECR_TRACE("GENERATION OF SALES ORDERS",0) From GESECRAN
    Call ECR_TRACE("--------------------------",0) From GESECRAN

    Filter [F:XINFSOH] Where [F:XINFSOH]COMPLETED <> 2 Order By Key XINFSOH0

    For [F:XINFSOH]XINFSOH0
        # TODO - UPDATE OF MESSAGE
        # @RH@ - 05/12/2017 , CHANGE OF DOCUMENT NUMBER BEING POPULATED FROM INFOPOS
        # Call ECR_TRACE("SALES ORDER :" - [F:XINFSOH]SOHNUM,0) From GESECRAN
        Call ECR_TRACE("SALES ORDER :" - [F:XINFSOH]CUSORDREF,0) From GESECRAN

        # @RH@ - 24/04/2018 - CLEAR ALL ERRORS ASSOCIATED WITH THE CURRENT RECORD
        ##############################################################################################################
        Call DELETE_ERRORS([F:XINFSOH]SOHNUM) From XINFP_ERR

        # TODO - UPDATE OF MESSAGE
        # DETERMINE IF SALES ORDER EXISTS
        # @RH@ - 05/12/2017 , CHANGE OF DOCUMENT NUMBER BEING POPULATED FROM INFOPOS
        # Look [F:XSOHA]SOH0 = [F:XINFSOH]SOHNUM
        Look [F:XSOHA]SOH0 = [F:XINFSOH]CUSORDREF

        If fstat
            # CALL THE CREATION OF THE SALES ORDER
            Call TRANS_CRE From XINFP_SOH
        Else
            Read [F:XSOHA] Curr

            If [F:XSOHA]ORDSTA <> 2
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("SALES ORDER EXISTS - UPDATING",0) From GESECRAN

                Call TRANS_MOD From XINFP_SOH
            Else
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("SALES ORDER CLOSED - UPDATING NOT POSSIBLE",1) From GESECRAN
            Endif
        Endif

        # IMPORT VARIABLE DISABLE - USED FOR LOGGING PURPOSES
        GIMPORT = 0
    Next

    If clalev([F:XINFSOH]) : Close Local File  [F:XINFSOH] : Endif
    If clalev([F:XINFSOD]) : Close Local File  [F:XINFSOD] : Endif
    If clalev([F:XINFSIT]) : Close Local File  [F:XINFSIT] : Endif
    If clalev([F:XINFTST]) : Close Local File  [F:XINFTST] : Endif
    If clalev([F:XXBPCA])  : Close Local File  [F:XXBPCA]  : Endif
    If clalev([F:XAPL])    : Close Local File  [F:XAPL]    : Endif
    If clalev([F:XSOHA])   : Close Local File  [F:XSOHA]   : Endif
    If clalev([F:XITMA])   : Close Local File  [F:XITMA]   : Endif
End

###########################################################################################
# UPDATE THE TRANSACTION AS COMPLETED
###########################################################################################
Subprog UPDATETRANS(XINFPNUM)
    Value Char XINFPNUM

    Call XERR_TRANS("SOH", XINFPNUM, [F:XINFSOH]EXPNUM, 2, 0, "SUCCESSFUL") From XINFP_ERR

    If !clalev([F:XUP]) : Local File XINFSOH [F:XUP] : Endif

    Trbegin [F:XUP]
        Update [F:XUP] Where [F:XUP]SOHNUM = XINFPNUM With [F:XUP]COMPLETED = 2

        If fstat
            Rollback
        Else
            Commit
        Endif

    If clalev([F:XUP]) : Close Local File   [F:XUP] : Endif
End

# DECLARATION OF DEFAULT VARIABLES
#####################################################################################
$OUVRE_OBJ
    # OPENING OF TABLES NEEDED
    ############################################################################################
    If clalev([F:AOE])=0  : Local File AOBJEXT    [AOE]  : Endif
    If clalev([F:AOD])=0  : Local File AOBJEXTD   [AOD]  : Endif
    If clalev([F:APX])=0  : Local File APARIMPEXP [APX]  : Endif
    If clalev([F:AOR])=0  : Local File AOBJEXTR   [AOR]  : Endif
    If clalev([F:ACC_])=0 : Local File ACCES      [ACC_] : Endif
    If clalev([F:AOB_])=0 : Local File AOBJET     [AOB_] : Endif
    If clalev([F:AWI_])=0 : Local File AWINDOW    [AWI_] : Endif
    If clalev([F:ATY_])=0 : Local File ATYPE      [ATY_] : Endif
    If clalev([F:AMK_])=0 : Local File AMSK       [AMK_] : Endif
    If clalev([F:AMZ_])=0 : Local File AMSKZON    [AMZ_] : Endif
    If clalev([F:ATB_])=0 : Local File ATABLE     [ATB_] : Endif
    If clalev([F:ATZ_])=0 : Local File ATABZON    [ATZ_] : Endif
    If clalev([F:ATI_])=0 : Local File ATABIND    [ATI_] : Endif
    If clalev([F:AMP_])=0 : Local File AMSKPAR    [AMP_] : Endif
    If clalev([F:AFC_])=0 : Local File AFONCTION  [AFC_] : Endif
    If clalev([F:ACV_])=0 : Local File ACTIV      [ACV_] : Endif
    If clalev([F:ANM_])=0 : Local File ACODNUM    [ANM_] : Endif
    If clalev([F:AOU])=0  : Local File AOBJEXTMPE [AOU]  : Endif
    If clalev([F:AOV])=0  : Local File AOBJEXTMPD [AOV]  : Endif

    # DECLARATION OF LOCAL MASKS
    ###########################################################################################3
    If clalev([M:AOE0])=0 : Local Mask AOE0       [AOE0] : Endif
    If clalev([M:AOE1])=0 : Local Mask AOE1       [AOE1] : Endif
    If clalev([M:AOE2])=0 : Local Mask AOE2       [AOE2] : Endif
    If clalev([M:IEX])=0  : Local Mask IMPTEST    [IEX]  : Endif
    If clalev([M:IMP2])=0 : Local Mask IMPOBJ2    [IMP2] : Endif

    # LOCAL VARIABLES
    ###########################################################################################3
    Local  Integer IMPSTA
    Local  Char    MESSAGE(250), BOITE_CRIT(GLONFEN) , FENETRE(GLONFEN)
    Local  Integer K , NOFIC  , NOENR,NBCRE , TYP , ER , STA, NBMOD
    Local  Integer C , NUMIMP , NBFIC , N   , L , OKTRT
    Local  Char    NOMTRT(GLONADC) , NOMVAR(40) , CHAINE(250) , SUF(30)
    Local  Char    TRTSRC(GDIMFIC)
    Local  Char    CLE(30) , NOMZONE(30) , NOMSUB(GLONASU)
    Local  Char    FIFO(GDIMFIC) , PRGBL(30)
    Local  Integer OPTCAR , NOLIB
    Local  Char    SAVFONC(GLONAFC) , SAVABR(GLONAOB) , SAVNAVIG(GLONANG)
    Local  Char    SAVPROG(GLONADC), SGTUNCPT(250)
    Local  Integer SAVPILNAV
    Local  Char    FICTMP(GDIMFIC) , FICFIN(GDIMFIC) , FICERR(GDIMFIC)
    Local  Char    REPTMP(GDIMFIC) , REPFIN(GDIMFIC) , REPERR(GDIMFIC)
    Local  Char    REPTRA(GDIMFIC)
    Local  Char    FICBAS(GDIMFIC) , REPERT(GDIMFIC) , FICORG(GDIMFIC)
    Local  Char    FICCLI(GDIMFIC)
    Local  Char    LISTEFIC(GDIMFIC)(1..1000)
    Local  Char    MACHINE(GDIMFIC) , MACTMP(GDIMFIC) , OS(10)
    Local  Char    BASPAG(GLONAVA)
    Local  Char    MODELE(GLONAOE), FICHIER(GDIMFIC), ZONTABLO(GLONAVA)
    Local  Char    SEPDEC(1) , CPTAOW(GLONANM)
    Local  Integer STAT,NBRLIGS,LIG,AOWENR,AOWSTA,II
    Local  Integer GESSAS
    Local  Char    ABREV(GLONAOB)
    Local  Integer PSTD,PSUB,PSPE,PSPV
    Local  Char    SAVCLE1(250)
    Local  Char    SAVCLE2(250)
    Local  Integer XLINE, XLINCNT
    Global Integer XTAX
    Global Decimal XINFPRND

    # CLEARING OF LOCAL VARIABLES
    ###########################################################################################
    Raz GLOTAOW,GIMP, REPTMP , REPFIN , REPERR, NOFIC, NOENR, NBCRE ,NBMOD, GPILNAV,GPILOBJ, GTUNCPT
Return

# FILLS BUFFER INFORMATION TO SCREEN
#####################################################################################
$IMP_ZONE
    Case IMPZON
        When "SOHNUM"     : [M]SOHNUM               = [F:XINFSOH]CUSORDREF #[F:XINFSOH]SOHNUM     - CHANGE MADE ON 12-05-2017 - CHANGE TO DOCUMENT NUMBER
        When "BPCORD"     : [M]BPCORD               = [F:XINFSOH]BPCORD
        When "CUSORDREF"  : [M]CUSORDREF            = [F:XINFSOH]INFREF    #[F:XINFSOH]CUSORDREF  - CHANGE MADE ON 12-05-2017 - CHANGE TO DOCUMENT NUMBER
        When "ORDDAT"     : [M]ORDDAT               = [F:XINFSOH]ORDDAT
        When "SHIDAT"     : [M]SHIDAT               = [F:XINFSOH]ORDDAT
        When "SOHTYP"     : [M]SOHTYP               = [F:XINFSOH]DOCTYP
        When "SALFCY"     : [M]SALFCY               = [F:XINFSOH]SALFCY
        When "CUR"        : [M]CUR                  = [F:XINFSOH]CUR

        When "VACBPR"     : [M]VACBPR               = [F:XXBPCA]VACBPR

        When "BPAADD"     : If [F:XINFSOH]BPAADD <> ''
                                [M]BPAADD           = [F:XINFSOH]BPAADD
                            Endif
        When "REP1"       : [M]REP1                 = [F:XINFSOH]REP1
        When "REP2"       : [M]REP2                 = [F:XINFSOH]REP2

        When "STOFCY"     : [M]STOFCY               = [F:XINFSOH]STOFCY

        When "INVDTAAMT"  : [M]INVDTAAMT(indice)    = XINFPRND * -1
    Endcase
Return

# FILLS BUFFER INFORMATION TO SCREEN
#####################################################################################
$IMP_TAB
    Case IMPZON
        When "DSTOFCY"    : [M]DSTOFCY(indice)      = [F:XINFSOD]DSTOFCY
        When "ITMREF"     : [M]ITMREF(indice)       = [F:XINFSOD]ITMREF
        When "ITMDES"     : [M]ITMDES(indice)       = [F:XINFSOD]ITMDES
        When "SAU"        : [M]SAU(indice)          = [F:XINFSOD]SAU
        When "QTY"        : [M]QTY(indice)          = abs([F:XINFSOD]QTY)
        When "WALLQTY"    : [M]WALLQTY(indice)      = abs([F:XINFSOD]QTYALL)
        When "GROPRI"     : [M]GROPRI(indice)       = abs([F:XINFSOD]GROPRI)
        When "DISCRGVAL1" : [M]DISCRGVAL1(indice)   = [F:XINFSOD]DISCRGVAL1
        When "DISCRGVAL2" : [M]DISCRGVAL2(indice)   = [F:XINFSOD]DISCRGVAL2
        When "DISCRGVAL3" : [M]DISCRGVAL3(indice)   = [F:XINFSOD]DISCRGVAL3
        When "DISCRGVAL4" : [M]DISCRGVAL4(indice)   = [F:XINFSOD]DISCRGVAL4
        When "DISCRGVAL5" : [M]DISCRGVAL5(indice)   = [F:XINFSOD]DISCRGVAL5
        When "DISCRGVAL6" : [M]DISCRGVAL6(indice)   = [F:XINFSOD]DISCRGVAL6
        When "DISCRGVAL7" : [M]DISCRGVAL7(indice)   = [F:XINFSOD]DISCRGVAL7
        When "DISCRGVAL8" : [M]DISCRGVAL8(indice)   = [F:XINFSOD]DISCRGVAL8
        When "DISCRGVAL9" : [M]DISCRGVAL9(indice)   = [F:XINFSOD]DISCRGVAL9
        When "REP1"       : [M]REP1(indice)         = [F:XINFSOD]REP1
        When "REP2"       : [M]REP2(indice)         = [F:XINFSOD]REP2
        When "DLVDAT"     : If [F:XINFSOD]DLVDAT <> [00/00/00] : [M]DLVDAT(indice) = [F:XINFSOD]DLVDAT : Endif
        When "YDLVTERM"   : [M]YDLVTERM(indice)     = [F:XINFSOD]DLVTRM   # GAP SPECIFIC FIELD, DELIVERY FIELD
        When "VACITM1"    : If [M]VACITM1(indice) = '' : [M]VACITM1(indice)  = [F:XITMA]VACITM(0) : Endif
        When "VACITM2"    : If [M]VACITM2(indice) = '' : [M]VACITM2(indice)  = [F:XITMA]VACITM(1) : Endif
        When "VACITM3"    : If [M]VACITM3(indice) = '' : [M]VACITM3(indice)  = [F:XITMA]VACITM(2) : Endif
    Endcase
Return

# FILLS THE ADDRESS SCREEN
#####################################################################################
$IMP_ADD
    Case IMPZON
        When "BPAADD"    : [M]BPAADD       = [F:XINFSOH]BPAADD
        When "BPAADDLIG" : If [F:XINFSOH]BPAADDLIG1 <> '' : [M]BPAADDLIG(0) = [F:XINFSOH]BPAADDLIG1 : Endif
                           If [F:XINFSOH]BPAADDLIG2 <> '' : [M]BPAADDLIG(1) = [F:XINFSOH]BPAADDLIG2 : Endif
                           If [F:XINFSOH]BPAADDLIG3 <> '' : [M]BPAADDLIG(2) = [F:XINFSOH]BPAADDLIG3 : Endif
        When "CRY"       : #If [F:XINFSOH]CRY        <> '' : [M]CRY          = [F:XINFSOH]CRY        : Endif
        When "SAT"       : If [F:XINFSOH]SAT        <> '' : [M]SAT          = [F:XINFSOH]SAT        : Endif
        When "POSCOD"    : If [F:XINFSOH]POSCOD     <> '' : [M]POSCOD       = [F:XINFSOH]POSCOD     : Endif
        When "CTY"       : If [F:XINFSOH]CTY        <> '' : [M]CTY          = [F:XINFSOH]CTY        : Endif

     Endcase
Return

# CREATION OF SALES ORDER
##################################################################################################
Subprog TRANS_CRE
    Gosub OUVRE_OBJ

    ABREV = "SOH"
    GFLAG = ""

    # ADDED CODE TO OPEN THE WINDOW ASSOCIATED WITH ENTRY TRANSACTION, USING GENERATED SCREENS
    # TO IMPORT DATA
    ################################################################################################
    If clalev([AWIZ]) = 0 :  Local File AWINDOW [AWIZ] : Endif
    Filter [AWIZ] Where OBJ=ABREV and TRN = GFLAG and ENAFLG=2 and MDL<>2 Order By Key AWI0
    Read [AWIZ]AWI0 First

    If fstat
        Call ECR_TRACE(mess(107,133,1),1) From GESECRAN
        End
    Endif

    Read [AOB_]ABREV = ABREV

    Call CONT_FEN(ABREV,FENETRE) From GOBJET
    If FENETRE<>""
        Read [AWI_]AWI0  = FENETRE
    Else
        Raz [F:AWI_]
    Endif

    GIMPORT = 1
    GFLAG      = ""
    GPILNAV    = 2
    GIMPORT    = 1

    NOENR += 1

    GOBJET     = 1
    GORITITCOL = 0
    GABREV     = ABREV
    GPROGRAMME = "GOBJSUB"
    GTRAITE    = "GOBJET"
    GFONCTION  = "GES"+ABREV

    Gosub DEFVAR From GOBJET

    RUPT     = 1
    IMPORTYP = 1
    OK = 1

    Call CONT_FEN(GABREV,GBOITE) From GOBJET
    If GBOITE=""
        If IMPORTYP=2
            WINPROG = ""
        Else
            Call ECR_TRACE(mess(107,133,1),1) From GESECRAN
            OK = 0
            Goto RETCLOSE
        Endif
    Else
        If dim(WINPROG)<=0
            Local Char WINPROG(GLONADC)
        Endif
        Call NOMTRTWIN(GBOITE,WINPROG) From MSKDIV
    Endif

    Call SETPROG(GABREV,PROGOBJ,PROGSUB,PROGSPE,PROGSPV,PSTD,PSUB,PSPE,PSPV) From CONTOBJ

    TUNNEL = 0
    Gosub NOMFIC From =PROGOBJ

    If evalue("clalev([F:"+ABFIC+"])")=0 : Gosub OUVFIC From =PROGOBJ : Endif

    ACTION = "AVANT_OUVRE" : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ
    GPE = 0

    Gosub OUVRE From =PROGOBJ
    If clalev([F:ACC])=0 : Local File ACCES [ACC] : Endif
    For MA=0 To dim(AMA)-1 : AMA(MA) = 1 : Next I

    ACTION = "DEFTRANS" : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ

    If clalev([F:AWI])=0 : Local File AWINDOW [AWI] : Endif
    Read [AWI]AWI2(2) = GABREV;GFLAG
    If !fstat
        GBOITE = [F:AWI]WIN
    Endif

    If dim(WINPROG)<=0
        Local Char WINPROG(GLONADC)
    Endif

    Call NOMTRTWIN(GBOITE,WINPROG) From MSKDIV

    NBMASK = -1
    If WINPROG<>"" : Gosub DEFVAR From =WINPROG : Endif
    Gosub OUVRE_MSK From GOBJET

    ACTION = "OUVRE" : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ
    If OK=0 : Goto RETCLOSE : Endif

    For MA=0 To NBMASK
        If AMA(MA) : Gosub SETMASK From =WINPROG : Endif
    Next MA

    Gosub SETCLE From =PROGOBJ
    If evalue("type([F:"+ABFIC+"]"+CLEPRIM+")")>10
        TPCLE1 = 1
    Else
        TPCLE1 = 2
    Endif
    For CL=0 To dim(CLESEC)-1
        If CLESEC(CL)<>""
            If evalue("type([F:"+ABFIC+"]"+CLESEC(CL)+")")>10
                TPCLE2(CL) = 1
            Elsif evalue("type([F:"+ABFIC+"]"+CLESEC(CL)+")")=3
                TPCLE2(CL) = 3
            Else
                TPCLE2(CL) = 2
            Endif
        Endif
    Next CL

    Gosub INIT_BOITE From =WINPROG

    # SET OBJECT TO POINT TO NEW RECORD CREATION
    ##################################################################################################
    CLECUR = 0 : Gosub RELIT From GOBJSUB
    REP = "C" : GREP = "C" : [L]SITCUR = ""
    Gosub SETBOUT From GOBJSUB : ACTCRE=1
    Gosub RAZCRE From GOBJNAV
    ACTION = "RAZCRE" : Gosub ACTION From GOBJET

    OK = 1 : GOK = 1

    # TODO - UPDATE OF MESSAGE
    # READ THE CUSTOMER RECORD
    Filter [F:XXBPCA]
    Read [F:XXBPCA]BPC0 = [F:XINFSOH]BPCORD

    # IMPORT OF DATA FOR MASK SOH0
    ##################################################################################################
    Default Mask [SOH0]
    mkstat = 0
    GNBAFF = 0
    Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2

    Call SAIMSK("SOH","IMP_ZONE","XINFP_SOH") From W0SOH0
    If mkstat
        Setmode
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR ON THE IMPORT OF SOH0",1) From GESECRAN
        GREP = "" : REP = ""
        Goto RETCLOSE
    Endif

    Setmode

    # IMPORT OF DATA FOR MASK SOH1
    ##################################################################################################
    Default Mask [SOH1]
    mkstat = 0
    GNBAFF = 0
    Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
    Call SAIMSK("SOH","IMP_ZONE","XINFP_SOH") From W0SOH1
    If mkstat
        Setmode
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR ON THE IMPORT OF SOH1",1) From GESECRAN
        GREP = "" : REP = ""
        Goto RETCLOSE
    Endif
    Setmode

    # NEW ERROR IN THAT IS NOT INITIATING THE COMPANY CODE
    # FORCE A INITIATE OF THE COMPANY CODE
    GFCY = [M:SOH0]SALFCY
    Call GETDEV([M:SOH0]SALFCY) From DEVSUB
    GCUR = GLOCALDEV
    [F:SOH]CPY = GSOCIETE

    # V2018-688, R. HULSBOS
    # MULTIPLE DELIVERY ADDRESSED, UPDATE OF THE DELIVERY ADDRESS
    If [F:XINFSOH]BPAADD <> ''
        If [M:ADB2]BPAADDLIG(0) <> [F:XINFSOH]BPAADDLIG1   |
&          [M:ADB2]BPAADDLIG(1) <> [F:XINFSOH]BPAADDLIG2   |
&          [M:ADB2]BPAADDLIG(2) <> [F:XINFSOH]BPAADDLIG3   |
&          [M:ADB2]CRY          <> [F:XINFSOH]CRY          |
&          [M:ADB2]SAT          <> [F:XINFSOH]SAT          |
&          [M:ADB2]POSCOD       <> [F:XINFSOH]POSCOD       |
&          [M:ADB2]CTY          <> [F:XINFSOH]CTY

           If clalev([M:ADC]) = 0 : Local Mask ADRBPC      [M:ADC] : Endif
           If clalev([M:TCY]) = 0 : Local File TABCOUNTRY  [M:TCY] : Endif

           [M:ADC] = [M:ADB2]
           [M:ADC]ADBFLG = 1
           [M:ADC]ADBBPR = [F:XINFSOH]BPCORD
           [M:ADC]BPAADD = [F:XINFSOH]BPAADD

           Default Mask '[SOH0],[SOH1],[M:ADC]'
           mkstat = 0
           GNBAFF = 0
           #Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
           Call SAIMSK("SOH","IMP_ADD","XINFP_SOH") From W0ADRBPC
           If mkstat
             #  Setmode
               # TODO - UPDATE OF MESSAGE
               Call ECR_TRACE("ERROR ON THE IMPORT OF ADDRESS",1) From GESECRAN
               GREP = "" : REP = ""
               Goto RETCLOSE
           Endif
           #Setmode

           [M:ADB2]       = [M:ADC]
           [M:ADB2]ADBFLG = 2

           If clalev([M:ADC]) = 1 : Close Local Mask [M:ADC] : Endif
           If clalev([M:TCY]) = 1 : Close Local File [M:TCY] : Endif
        Endif
    Endif

    [M:SOH1]APPFLG = 5

    # IMPORT OF DATA FOR MASK SOH2
    ##################################################################################################
    Default Mask [SOH2]
    mkstat = 0
    GNBAFF = 0
    Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
    Call SAIMSK("SOH","IMP_ZONE","XINFP_SOH") From W0SOH2
    If mkstat
        Setmode
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR ON THE IMPORT OF SOH2",1) From GESECRAN
        GREP = "" : REP = ""
        Goto RETCLOSE
    Endif
    Setmode

    # IMPORT OF DATA FOR MASK SOH4
    ##################################################################################################
    Default Mask "[SOH0],[SOH1],[SOH4]"
    nolign = 0
    Raz XLINCNT

    # CAPTURE THE LINES OF THE SALES ORDER
    If !clalev([F:XINFLIN]) : Local File XINFLIN [F:XINFLIN] : Endif
    If !clalev([F:XTXC])    : Local File TEXCLOB [F:XTXC]    : Endif
    If !clalev([F:XITS])    : Local File ITMSALES [F:XITS]    : Endif
    If !clalev([F:XBOMD])   : Local File BOMD     [F:XBOMD]   : Endif

    Delete [F:XINFLIN]XINFLIN0 = [F:XINFSOH]CUSORDREF

    Filter [F:XINFSOD] Where  [F:XINFSOD]SOHNUM   = [F:XINFSOH]SOHNUM and [F:XINFSOD]ROUNDING <> 2
&   Order By Key XINFSOD0

    For [F:XINFSOD]XINFSOD0
        Read [F:XITMA]ITM0 = [F:XINFSOD]ITMREF

        # RESET OF CLOB FILES COMMENTS
        Call RAZ_CLOB From ACLOB

        XLINCNT += 1

        If nolign=0
            [M]NBLIG += 1
            nolign = [M]NBLIG
            status = 73

            indice = nolign-1 : mkstat = 0
            GNBAFF = 0
            #Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
            Call SAI_NBLIG("SOH","IMP_TAB","XINFP_SOH") From W0SOH4

            If mkstat
                # Setmode
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("ERROR ON THE IMPORT OF SOH4",1) From GESECRAN
                GREP = "" : REP = ""
                Break
            Endif

            #Setmode : Raz GERREUR
        Else
            #Insa nolign-1,1,[M]NBLIG NBLIG
            status = 73
            [M]NBLIG += 1
            nolign = [M]NBLIG
            indice = nolign-1 : mkstat = 0
            GNBAFF = 0
            #Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
            Call SAI_NBLIG("SOH","IMP_TAB","XINFP_SOH") From W0SOH4

            If mkstat
                # Setmode
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("ERROR ON THE IMPORT OF SOH4",1) From GESECRAN
                GREP = "" : REP = ""
                Break
            Endif

            #Setmode : Raz GERREUR
        Endif

        # ADD THE COMMENT TO THE LINE
        If [F:XINFSOD]COMMENT <> ""
            Delete [F:XTXC]TXC0 = [F:XINFSOH]CUSORDREF + "~"+ num$([F:XINFSOD]SOHLIN)

            Raz [F:XTXC]
            [F:XTXC]CODE  = [F:XINFSOH]CUSORDREF + "~"+ num$([F:XINFSOD]SOHLIN)
            Setlob [F:XTXC]TEXTE  With [F:XINFSOD]COMMENT
            [F:XTXC]CREUSR= GUSER
            [F:XTXC]CREDAT= date$
            [F:XTXC]CRETIM= time
            Write [F:XTXC]

            [M:SOH4]SOQTEX(indice) = [F:XINFSOH]CUSORDREF + "~"+ num$([F:XINFSOD]SOHLIN)
        Endif

        [F:XINFLIN]NUM     = [F:XINFSOH]CUSORDREF
        [F:XINFLIN]INFPLIN = [F:XINFSOD]SOHLIN
        [F:XINFLIN]X3LIN   = 1000 * XLINCNT

        Write [F:XINFLIN]

        # IN THE EVENT OF A BOM ITEM, WE NEED TO CATER FOR THE EXPLODED LINES, AND HENCE TAKE INTO CONSIDERATION THE LINES ADDED
        # ONTO THE SALES ORDER
        Columns [F:XITS] (ITMREF, ITMTYP)
        Read [F:XITS]ITS0 = [F:XINFSOD]ITMREF

        If [F:XITS]ITMTYP = 3

            Columns [F:XBOMD] (ITMREF,BOMALTTYP)
            Filter [F:XBOMD]
            Filter [F:XBOMD] Where [F:XBOMD]ITMREF = [F:XINFSOD]ITMREF and [F:XBOMD]BOMALTTYP = 1 Order By Key BOD0

            For [F:XBOMD]BOD0
                XLINCNT += 1
            Next

        Endif

        $SKIPT
    Next

    If clalev([F:XINFLIN]) : Close Local File [F:XINFLIN] : Endif
    If clalev([F:XTXC])    : Close Local File [F:XTXC]    : Endif
    If clalev([F:XITS])    : Close Local File [F:XITS]    : Endif
    If clalev([F:XBOMD])   : Close Local File [F:XBOMD]   : Endif

    # V2018-682, R. HULSBOS
    # NEW WAY OF DEALING WITH INVOICING ELEMENTS
    Default Mask "[SOH0],[SOH1],[SOH2],[SOH3],[SOH4]"
    Local Integer XXXINV

    For [L]XXXINV = 0 To dim([F:XINFSOH]INVDTA) - 1
        If [F:XINFSOH]INVDTA([L]XXXINV) <> 0
            XINFPRND =  [F:XINFSOH]INVDTAAMT([L]XXXINV)

            # HEADER LEVEL DISCOUNT
            If find([F:XINFSOH]INVDTA([L]XXXINV),[M:SOH3]INVDTA(0..[M:SOH3]NBFAC))
                nolign = find([F:XINFSOH]INVDTA([L]XXXINV),[M:SOH3]INVDTA(0..[M:SOH3]NBFAC))
                indice = nolign-1 : mkstat = 0
                status = 75

                Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
                Call SAI_NBFAC("SOH","IMP_ZONE","XINFP_SOH") From W0SOH3

                If mkstat
                    Setmode
                    # TODO - UPDATE OF MESSAGE
                    Call ECR_TRACE("ERROR DURING THE UPDATING OF THE INVOICING ELEMENT",1) From GESECRAN
                    GREP = "" : REP = "" : OK = 0
                Endif

                Setmode : Raz GERREUR
            Else
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("INVOICING ELEMENT DOES NOT EXIST",1) From GESECRAN
                OK = 0
            Endif
        Endif
    Next

    If !OK :
        GREP = ""
        # TODO - UPDATE OF MESSAGE
        Call XERR_TRANS("SOH", [F:XINFSOH]SOHNUM, [F:XINFSOH]EXPNUM, 1, 0, "ERROR ON THE SALES ORDER CREATION - PLEASE REFER TO X3 LOG") From XINFP_ERR
        Goto RETCLOSE
    Endif

     # CALCULATE TOTALS FOR INVOICE LINES
    If val(left$(GVERSION,instr(instr(1,GVERSION,".")+1,GVERSION,".")-1)) > 1.7
        Local    Char     PARAM_T (25) (0..10)
        PARAM_T(0)="1"
        PARAM_T(1)="1"
        PARAM_T(2)="0"
        Call VALTTC("GESSOH",PARAM_T) From TRTVENFACR
    Else
        Call VALTTC("GESSOH") From TRTVENFACR
    Endif

    [M:SOH1]APPFLG = 5

    # IMPORT OF DATA COMPLETE - CREATE ITEMS
    ##################################################################################################
    ACTION = "VERIF_CRE"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ

    If !OK :
        GREP = ""
        # TODO - UPDATE OF MESSAGE
        Call XERR_TRANS("SOH", [F:XINFSOH]SOHNUM, [F:XINFSOH]EXPNUM, 1, 0, "ERROR ON THE SALES ORDER CREATION - PLEASE REFER TO X3 LOG") From XINFP_ERR
        Goto RETCLOSE
    Endif

    GOK = 1
    Trbegin ADOVAL
        Gosub DEFAUT From =PROGOBJ
        Raz [F]
        nolign = 1

        Gosub CHARGEFIC From SUBIMPOBJ
        Gosub INICRE From GOBJSUB
        Gosub INIEXP From SUBIMPOBJ

        ACTION = "INICRE"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ

        [F:SOH]APPFLG = 5

        # VERIFY THAT THE TAXES ARE CORRECT BEFORE UPLOADING THE TRANSACTION
        If [M:SIHV]INVATI <> [F:XINFSOH]INFTOTINCL
            GREP = ""
            GOK = 0
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE(num$([M:SIHV]INVATI) - num$([F:XINFSOH]INFTOTINCL - abs([F:XINFSOH]INVDTAAMT(3))),0) From GESECRAN
            Call ECR_TRACE("ERROR ON THE SALES ORDER CALCULATED TAXES VS INFOPOS DOCKET HEADER TAXES",1) From GESECRAN
        Endif

        If GOK < 0
            Gosub ROLL_TR1
            Goto RETCLOSE
        Elsif !GOK
            Gosub AB_TR1
            Goto RETCLOSE
        Endif

        Write
        If fstat
            GOK=0 : Call FSTA(ABFIC) From GLOCK
            Gosub AB_TR1
            Call XERR_TRANS("SOH", [F:XINFSOH]SOHNUM, [F:XINFSOH]EXPNUM, 1, 0, "ERROR ON THE SALES ORDER CREATION - PLEASE REFER TO X3 LOG") From XINFP_ERR
            Goto RETCLOSE
        Endif

        ACTION = "CREATION"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ
        If GOK < 0
            Gosub ROLL_TR1
            Goto RETCLOSE
        Elsif !GOK
            Gosub AB_TR1
            Goto RETCLOSE
        Endif

        Commit

    CLECUR1 = num$(evalue("[F]"+CLEPRIM))
    GCLE = num$(evalue("[F]"+CLEPRIM))
    For I=0 To dim(CLESEC)-1
        If CLESEC(I)<>""
            CLECUR2(I) = num$(evalue("[F]"+CLESEC(I)))
            GCLE += "\"+num$(evalue("[F]"+CLESEC(I)))
        Endif
    Next I

    CLECUR = 1

    ACTION = "APRES_CRE"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ

    Call TRACE2(0,GCLE,-1) From SUBIMPOBJ
    Call IDENT3(ABREV,IDENT,CLECUR1,CLECUR2) From GOBJTXT

    #Call ECR_TRACE(CLECUR1,0) From GESECRAN

    # TODO : TRANSACTION IS COMPLETED, FLAG AS COMPLETED
    If GOK : Call UPDATETRANS([F:XINFSOH]SOHNUM) From XINFP_SOH : Endif

    # END - RESTORE SAVED VARIABLES
    ##################################################################################################
    $RETCLOSE

    If !GOK or !OK :
        GREP = "" : GOK = 1 : OK = 1
        # TODO - UPDATE OF MESSAGE
        Call XERR_TRANS("SOH", [F:XINFSOH]SOHNUM, [F:XINFSOH]EXPNUM, 1, 0, "ERROR ON THE SALES ORDER CREATION - PLEASE REFER TO X3 LOG") From XINFP_ERR
    Endif

    GPILNAV   = SAVPILNAV
    GNAVIG(1) = SAVNAVIG
    GABREV    = SAVABR
    GFONCTION = SAVFONC
    GIMPORT   = 0
    GREP      = ""

    Unlock =GCLE
    Unlock =CLECUR1
    Unlock =CLECUR2

    ACTION = "FIN" : Gosub ACTION From GOBJET
    If VERROU : Gosub DEVERROU From GOBJET : Endif
    OK = 1 : GOK = 1

    ACTION = "FERME" : Gosub ACTION From GOBJET

    If WINPROG <> ""
        Gosub FERME_BOITE From =WINPROG
        Gosub FERME_MASK From =WINPROG
    Endif
End

# ERROR DURING CREATION PHASE - ROLLBACK
##################################################################################################
$AB_TR1
    Rollback
    ACTION = "AB_CREATION"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ
Return

$ROLL_TR1
    Rollback
    Call ROLL From GLOCK
    If GROLL : Return : Endif
Return

# ERROR DURING MODIFICATION PHASE - ROLLBACK
##################################################################################################
$AB_TR2
    Rollback
    ACTION = "AB_MODIF"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ
Return

$ROLL_TR2
    Rollback
    Call ROLL From GLOCK
    If GROLL : Return  : Endif
Return

# MODIFICATION OF SALES ORDER
##################################################################################################
Subprog TRANS_MOD
    # NEW FUNCTIONALITY TO UNLOCK THE SALES ORDERS
    ################################################################################################
    Local Char XLLOCK(250)

    [L]XLLOCK = func GLOBIENS.PRIVATE_GET_STRING_LOCK("SOH", [F:XSOHA]CPY, [F:XINFSOH]CUSORDREF)
    Delete [F:XAPL]LCKCLE = [L]XLLOCK
    If [S]fstat
        #TODO - TRANSACTION IS FAILED TO UNLOCK THE RECORD
        Call ECR_TRACE("UNABLE TO UNLOCK THE SALES ORDER",1) From GESECRAN

        Return
     Endif


    Gosub OUVRE_OBJ

    ABREV = 'SOH'

    # ADDED CODE TO OPEN THE WINDOW ASSOCIATED WITH ENTRY TRANSACTION, USING GENERATED SCREENS
    # TO IMPORT DATA
    ################################################################################################
    If clalev([AWIZ]) = 0 :  Local File AWINDOW [AWIZ] : Endif
    Filter [AWIZ] Where OBJ=ABREV and TRN = GFLAG and ENAFLG=2 and MDL<>2 Order By Key AWI0
    Read [AWIZ]AWI0 First

    If fstat
        Call ECR_TRACE(mess(107,133,1),1) From GESECRAN
        End
    Endif

    # SETTING OF GLOBAL IMPORT PARAMETERS
    ##################################################################################################
    Read [AOB_]ABREV = ABREV

    Call CONT_FEN(ABREV,FENETRE) From GOBJET
    If FENETRE<>""
        Read [AWI_]AWI0  = FENETRE
    Else
        Raz [F:AWI_]
    Endif

    GIMPORT = 1
    GFLAG      = ""
    GPILNAV    = 2
    GIMPORT    = 1

    NOENR += 1

    GOBJET     = 1
    GORITITCOL = 0
    GABREV     = ABREV
    GPROGRAMME = "GOBJSUB"
    GTRAITE    = "GOBJET"
    GFONCTION  = "GES"+ABREV

    Gosub DEFVAR From GOBJET

    RUPT       = 1
    IMPORTYP   = 1
    OK = 1

    Call CONT_FEN(GABREV,GBOITE) From GOBJET
    If GBOITE=""
        If IMPORTYP=2
            WINPROG = ""
        Else
            Call ECR_TRACE(mess(107,133,1),1) From GESECRAN : # Il n'y pas de fenÃƒÂªtre disponible pour cet objet
            OK = 0 : End
        Endif
    Else
        If dim(WINPROG)<=0
            Local Char WINPROG(GLONADC)
        Endif

        Call NOMTRTWIN(GBOITE,WINPROG) From MSKDIV
    Endif

    Call SETPROG(GABREV,PROGOBJ,PROGSUB,PROGSPE,PROGSPV,PSTD,PSUB,PSPE,PSPV) From CONTOBJ

    TUNNEL = 0
    Gosub NOMFIC From =PROGOBJ

    If evalue("clalev([F:"+ABFIC+"])")=0 : Gosub OUVFIC From =PROGOBJ : Endif

    ACTION = "AVANT_OUVRE" : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ
    GPE = 0

    Gosub OUVRE From =PROGOBJ
    If clalev([F:ACC])=0 : Local File ACCES [ACC] : Endif
    For MA=0 To dim(AMA)-1 : AMA(MA) = 1 : Next I

    ACTION = "DEFTRANS" : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ

    If clalev([F:AWI])=0 : Local File AWINDOW [AWI] : Endif
    Read [AWI]AWI2(2) = GABREV;GFLAG
    If !fstat
        GBOITE = [F:AWI]WIN
    Endif
    If dim(WINPROG)<=0
        Local Char WINPROG(GLONADC)
    Endif
    Call NOMTRTWIN(GBOITE,WINPROG) From MSKDIV

    Call AUTORIS From EXEFNC

    Raz CRE, MODI, SUPPR

    If GNBAUZ=0
        If GNBSITE=0
          GMESSAGE = mess(33,104,1)
        Else
          GMESSAGE = mess(1,123,1)
        Endif

        OK = 0
        Goto RETCLOSE_MOD
    Elsif GUSRFCY(1)="\"
        CRE   = (instr(1,GUSRAUZ(1),"C")<>0)
        MODI  = (instr(1,GUSRAUZ(1),"M")<>0)
        SUPPR = (instr(1,GUSRAUZ(1),"S")<>0)
    Endif

    Gosub INIT From GOBJNAV

    If evalue("clalev([F:"+ABFIC+"])")=0
        Gosub OUVFIC From =PROGOBJ
    Endif

    OK = 1
    ACTION = "AVANT_OUVRE" : Gosub ACTION From GOBJET
    If !OK : Goto RETCLOSE_MOD : Endif

    Gosub OUVRE From =PROGOBJ
    Gosub OUVOBJ From GOBJET
    Gosub OUVFIC_DERLU From =PROGOBJ
    Raz AMA
    For MA=0 To 16 : AMA(MA) = 1 : Next MA

    VARIANTE  = 1
    GVARIANTE = 1

    Call NOMTRTWIN(GBOITE,WINPROG) From MSKDIV

    Gosub DEFVAR From =WINPROG

    ACTION = "SETTRANS" : Gosub ACTION From GOBJET
    Gosub OUVRE_MSK From GOBJET
    Gosub SETMASK From GOBJET
    NRMASK = sum(AMA(1..NBMASK))
    INDGES = 1
    INDCUR = 1

    If dim([L]NOMKEY)>0 & [L]NOMKEY<>""
        For I=0 To evalue("[G:"+ABFIC+"]nbind")-1
            If [L]NOMKEY=evalue("[G:"+ABFIC+"]keyname("+num$(I)+")")
                INDCUR = I+1 : Break
            Endif
        Next I
    Endif

    NBMASK = -1
    If WINPROG<>"" : Gosub DEFVAR From =WINPROG : Endif
    Gosub OUVRE_MSK From GOBJET


    ACTION = "OUVRE" : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ
    If OK=0 : Goto RETCLOSE_MOD : Endif

    For MA=0 To NBMASK
        If AMA(MA) : Gosub SETMASK From =WINPROG : Endif
    Next MA

    Gosub SETCLE From =PROGOBJ
    If evalue("type([F:"+ABFIC+"]"+CLEPRIM+")")>10
        TPCLE1 = 1
    Else
        TPCLE1 = 2
    Endif
    For CL=0 To dim(CLESEC)-1
        If CLESEC(CL)<>""
            If evalue("type([F:"+ABFIC+"]"+CLESEC(CL)+")")>10
                TPCLE2(CL) = 1
            Elsif evalue("type([F:"+ABFIC+"]"+CLESEC(CL)+")")=3
                TPCLE2(CL) = 3
            Else
                TPCLE2(CL) = 2
            Endif
        Endif
    Next CL

    Gosub INIT_BOITE From =WINPROG

    OK = 1

    Gosub SETMASK From GOBJET

    # SET KEY - READ RECORD AND COMPLETE MASKS
    ##################################################################################################
    CLECUR1 = [F:XINFSOH]CUSORDREF

    Gosub AFF_CLE From GOBJSUB
    Gosub DEFAUT From =PROGOBJ
    Gosub FIL_ROLE From GOBJSUB

    FILTRE = ""

    Call FILTRE(NOMFIC,FILTRE) From ASELOBJ
    Gosub SET_FILTRE From GOBJSUB
    Gosub DEFAUT From =PROGOBJ
    Assign "[G:"+ABFIC+"]currind" With 1
    Assign "[G:"+ABFIC+"]currlen" With 0

    Case TYPGES
        When 1
            Read =

            If fstat=0
                Gosub DROIT From GOBJSUB
            Else
                OK = 0
            Endif

            If OK
                NEWCLE1 = CLE1
                For CL=0 To dim(CLESEC)-1 : NEWCLE2(CL) = CLE2(CL) : Next CL
                Gosub LECTURE From GOBJSUB
                OK = 1
            Endif
        When 3
            Assign "[G:"+ABFIC+"]currlen" With dim(CLESEC)
            Read =
            If fstat=0
                Gosub DROIT From GOBJSUB
            Else
            OK = 0
            Endif
            If OK
                Gosub LECTURE From GOBJSUB
                OK = 1
            Endif
    Endcase

    REP = "M" : GREP = "M" : MODI = 1

    Gosub SETBOUT From GOBJSUB

    ACTION = "GRISE" : Gosub ACTION From GOBJET

    Gosub VERROU From GOBJET

    If !GOK
        Goto RETCLOSE_MOD
    Endif

    If !VERROU
         # TODO - UPDATE OF MESSAGE
         Call ECR_TRACE("ERROR ON LOCKING SALES ORDER FOR MODIFICATION",1) From GESECRAN
         Goto RETCLOSE_MOD
    Endif

    # DETERMINE IF THE SALES ORDER IS CANCELLED, THEN DE-ALLOCATE STOCK AND CLOSE SO
    ###########################################################################################################
    If [F:XINFSOH]CANCELLED = 2
        Gosub CANCELLATION
        Goto RETCLOSE_MOD
    Endif

    # POINT GLOBAL CURSOR TO MODIFICATION MODE
    ##################################################################################################
    If !ACTMOD or GCONSULT
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR ON ASSIGNING OF THE MODICATION VARIABLES",1) From GESECRAN
        Goto RETCLOSE_MOD
    Endif

    OK = 1
    ACTION = "AVANT_MOD" : Gosub ACTION From GOBJET

    If !OK
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR CHANGING THE GLOBAL MODIFICATION STATUS VARIABLES",1) From GESECRAN
        Goto RETCLOSE_MOD
    Endif

    # TODO - UPDATE OF MESSAGE
    # READ THE CUSTOMER RECORD
    Filter [F:XXBPCA]
    Read [F:XXBPCA]BPC0 = [F:XINFSOH]BPCORD

    # IMPORT OF DATA FOR MASK SOH0
    ##################################################################################################
    Default Mask [SOH0]
    mkstat = 0
    GNBAFF = 0
    Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2

    Call SAIMSK("SOH","IMP_ZONE","XINFP_SOH") From W0SOH0
    If mkstat
        Setmode
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR ON THE IMPORT OF SOH0",1) From GESECRAN
        GREP = "" : REP = ""
        Goto RETCLOSE_MOD
    Endif

    Setmode

    # IF REVISION IS ON, INCREMENT VERSION NUMBER AND SET TO SAVE PREVIOUS VERSION OF SALES ORDER
    ##################################################################################################
    If GSALREV = 2
      GREV=2
      [M:SOH0]REVNUM += 1
    Endif

    # IMPORT OF DATA FOR MASK SOH1
    ##################################################################################################
    Default Mask [SOH1]
    mkstat = 0
    GNBAFF = 0
    Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
    Call SAIMSK("SOH","IMP_ZONE","XINFP_SOH") From W0SOH1
    If mkstat
        Setmode
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR ON THE IMPORT OF SOH1",1) From GESECRAN
        GREP = "" : REP = ""
        Goto RETCLOSE
    Endif
    Setmode

    # IMPORT OF DATA FOR MASK SOH2
    ##################################################################################################
    Default Mask [SOH2]
    mkstat = 0
    GNBAFF = 0
    Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
    Call SAIMSK("SOH","IMP_ZONE","XINFP_SOH") From W0SOH2
    If mkstat
        Setmode
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR ON THE IMPORT OF SOH2",1) From GESECRAN
        GREP = "" : REP = ""
        Goto RETCLOSE
    Endif
    Setmode

    # IMPORT OF DATA FOR MASK SOH3
    ##################################################################################################
    Default Mask [SOH3]
    mkstat = 0
    GNBAFF = 0
    Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
    Call SAIMSK("SOH","IMP_ZONE","XINFP_SOH") From W0SOH3
    If mkstat
        Setmode
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR ON THE IMPORT OF SOH3",1) From GESECRAN
        GREP = "" : REP = ""
        Goto RETCLOSE
    Endif
    Setmode

    # CAPTURE THE LINES OF THE SALES ORDER
    If !clalev([F:XINFLIN]) : Local File XINFLIN  [F:XINFLIN] : Endif
    If !clalev([F:XTXC])    : Local File TEXCLOB  [F:XTXC]    : Endif

    Raz XINFPRND, XLINCNT

    #Delete [F:XINFLIN]XINFLIN0 = [M:SOH0]SOHNUM

    Local Integer XINFPLIN

    # IMPORT OF DATA FOR MASK SOH4
    ##################################################################################################
    Default Mask [SOH4]
    nolign = 0
    OK = 1 : GOK = 1

    Filter [F:XINFSOD] Where [F:XINFSOD]SOHNUM   = [F:XINFSOH]SOHNUM
&   Order By Key XINFSOD0

    For [F:XINFSOD]XINFSOD0
#        If func XINFP_SOH.CALC_QTY_ONHAND([F:XINFSOD]DSTOFCY, [F:XINFSOD]ITMREF, [F:XINFSOD]QTYALL)
#            GREP = "" : REP = "" : GOK = 0
#            Break
#        Endif

        Read [F:XITMA]ITM0 = [F:XINFSOD]ITMREF

        # DETERMINE IF THE LINE HAS BEEN DELETED, STATUS NEEDS TO BE SET TO CLOSED
        ############################################################################################
        If [F:XINFSOD]CLOSED = 2
            If find([F:XINFSOD]X3LINE,[M:SOH4]SOPLIN(0..[M]NBLIG)) > 0
                    nolign = find([F:XINFSOD]X3LINE,[M:SOH4]SOPLIN(0..[M]NBLIG))

                    If [M:SOH4]SOQSTA(nolign - 1) <> 3
                        status    = 75
                        indice    = find([F:XINFSOD]X3LINE,[M:SOH4]SOPLIN(0..[M]NBLIG))-1
                        mkstat = 0
                        GNBAFF = 0
                        #Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2

                        Call SAI_NBLIG("SOH","IMP_TAB","XINFP_SOH") From W0SOH4

                        If mkstat
                            #Setmode
                            # TODO - UPDATE OF MESSAGE
                            Call ECR_TRACE("ERROR ON THE UPDATING OF A NEW LINE",1) From GESECRAN
                            GREP = "" : REP = "" : GOK = 0
                            Break
                        Endif

                        #Setmode : Raz GERREUR
                    Else
                        # TODO - UPDATE OF MESSAGE
                        Call ECR_TRACE([F:XINFSOD]SOHNUM - num$([F:XINFSOD]X3LINE) - "LINE IS ALREAD CLOSED",0) From GESECRAN
                    Endif
                Endif
        Elsif [F:XINFSOD]DELETED = 2
            nolign    = find([F:XINFSOD]X3LINE,[M:SOH4]SOPLIN(0..[M]NBLIG))

            If nolign > 0 and [M:SOH4]SOQSTA(nolign - 1) <> 3 and [M:SOH4]DLVQTY(nolign - 1) = 0 and [M:SOH4]INVQTY(nolign - 1) = 0

                status = 65
                Dela nolign-1, 1 ,[M]NBLIG-1 NBLIG
                #[M]NBLIG -= 1

                If mkstat
                    Call ECR_TRACE("ERROR WHILE DELETING THE LINE", 1) From GESECRAN
                    GREP = "" : REP = "" : GOK = 0
                    Break
                Endif

                Delete [F:XINFLIN]XINFLIN0 = [M:SOH0]SOHNUM;[F:XINFSOD]SOHLIN;[F:XINFSOD]X3LINE

            Else
                If find([F:XINFSOD]X3LINE,[M:SOH4]SOPLIN(0..[M]NBLIG))
                    # TODO - UPDATE OF MESSAGE
                    Call ECR_TRACE([M:SOH0]SOHNUM - num$([F:XINFSOD]X3LINE) - "LINE IS CLOSED CAN NOT DELETE", 0) From GESECRAN
                Endif
            Endif
        Else
            # IF THE X3LINE INDICATOR IS BLANK, MEANING IT IS A NEW LINE, THEN INSERT A NEW LINE INTO X3 SALES ORDER
            If [F:XINFSOD]X3LINE = 0 and !find([F:XINFSOD]ITMREF, [M:SOH4]ITMREF)
                status = 73
                #Insa [M]NBLIG,1,[M]NBLIG NBLIG
                [M]NBLIG += 1
                nolign = [M]NBLIG
                indice = nolign-1 : mkstat = 0
                GNBAFF = 0
                #Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
                Call SAI_NBLIG("SOH","IMP_TAB","XINFP_SOH") From W0SOH4

                If mkstat
                    #Setmode
                    # TODO - UPDATE OF MESSAGE
                    Call ECR_TRACE("ERROR ON THE INSERTING OF A NEW LINE",1) From GESECRAN
                    GREP = "" : REP = "" : GOK = 0
                    Break
                Endif

                #Setmode : Raz GERREUR

                [F:XINFLIN]NUM     = [F:XINFSOH]CUSORDREF
                [F:XINFLIN]INFPLIN = [F:XINFSOD]SOHLIN
                [F:XINFLIN]X3LIN   = 1000 * [M]NBLIG

                Write [F:XINFLIN]
            Else
                If find([F:XINFSOD]ITMREF, [M:SOH4]ITMREF)
                    nolign = find([F:XINFSOD]ITMREF, [M:SOH4]ITMREF)

                    If [M:SOH4]SOQSTA(nolign - 1) <> 3
                        status    = 75
                        indice    = nolign-1
                        mkstat = 0
                        GNBAFF = 0
                        #Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2

                        Call SAI_NBLIG("SOH","IMP_TAB","XINFP_SOH") From W0SOH4

                        If mkstat
                            #Setmode
                            # TODO - UPDATE OF MESSAGE
                            Call ECR_TRACE("ERROR ON THE UPDATING OF A NEW LINE",1) From GESECRAN
                            GREP = "" : REP = "" : GOK = 0
                            Break
                        Endif

                        #Setmode : Raz GERREUR
                    Else
                        # TODO - UPDATE OF MESSAGE
                        Call ECR_TRACE([F:XINFSOD]SOHNUM - num$([F:XINFSOD]X3LINE) - "MODICATION OF LINE NOT POSSIBLE AS LINE IS CLOSED",1) From GESECRAN
                        GOK = 0
                        Break
                    Endif

                Elsif find([F:XINFSOD]X3LINE,[M:SOH4]SOPLIN(0..[M]NBLIG)) > 0
                    nolign = find([F:XINFSOD]X3LINE,[M:SOH4]SOPLIN(0..[M]NBLIG))

                    If [M:SOH4]SOQSTA(nolign - 1) <> 3
                        status    = 75
                        indice    = find([F:XINFSOD]X3LINE,[M:SOH4]SOPLIN(0..[M]NBLIG))-1
                        mkstat = 0
                        GNBAFF = 0
                        #Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2

                        Call SAI_NBLIG("SOH","IMP_TAB","XINFP_SOH") From W0SOH4

                        If mkstat
                            #Setmode
                            # TODO - UPDATE OF MESSAGE
                            Call ECR_TRACE("ERROR ON THE UPDATING OF A NEW LINE",1) From GESECRAN
                            GREP = "" : REP = "" : GOK = 0
                            Break
                        Endif

                        #Setmode : Raz GERREUR
                    Else
                        # TODO - UPDATE OF MESSAGE
                        Call ECR_TRACE([F:XINFSOD]SOHNUM - num$([F:XINFSOD]X3LINE) - "MODICATION OF LINE NOT POSSIBLE AS LINE IS CLOSED",1) From GESECRAN
                        GOK = 0
                        Break
                    Endif
                Endif
            Endif
        Endif

        # ADD THE COMMENT TO THE LINE
        If [F:XINFSOD]COMMENT <> ""
            Delete [F:XTXC]TXC0 = [F:XINFSOH]CUSORDREF + "~"+ num$([F:XINFSOD]SOHLIN)

            Raz [F:XTXC]
            [F:XTXC]CODE  = [F:XINFSOH]CUSORDREF + "~"+ num$([F:XINFSOD]SOHLIN)
            Setlob [F:XTXC]TEXTE  With [F:XINFSOD]COMMENT
            [F:XTXC]CREUSR= GUSER
            [F:XTXC]CREDAT= date$
            [F:XTXC]CRETIM= time
            Write [F:XTXC]

            [M:SOH4]SOQTEX(indice) = [F:XINFSOH]CUSORDREF + "~"+ num$([F:XINFSOD]SOHLIN)
        Endif

        status = 72
    Next

    If clalev([F:XINFLIN]) : Close Local File [F:XINFLIN] : Endif

    If !OK or !GOK or mkstat
        GREP = ""
        Goto RETCLOSE_MOD
    Endif

#    # CALCULATE ROUNDING ISSUE
#    #############################################################################################
#    Filter [F:XXINFSID] Where [F:XXINFSID]NUM = [F:XXINFSIH]NUM and [F:XXINFSID]ROUNDING = 2
#&   Order By Key XINFSID0
#
#    For [F:XXINFSID]XINFSID0
#            XINFPRND += [F:XXINFSID]GROPRI
#    Next
#
#    # CALCULATE TOTALS FOR INVOICE LINES
#    # Call VALTTC ("GESSOH") From TRTVENFACR
#
#    # IF THERE WAS ANY ROUNDING LEVEL DISCOUNT
#    If XINFPRND <> 0
#        # HEADER LEVEL DISCOUNT
#        If find(99,[M:SOH3]INVDTA(0..[M:SOH3]NBFAC))
#            nolign = find(99,[M:SOH3]INVDTA(0..[M:SOH3]NBFAC))
#            indice = nolign-1 : mkstat = 0
#            status = 75
#
#            Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
#            Call SAI_NBFAC("SOH","IMP_TAB","XINFP_SOHD") From W0SOH3
#
#            If mkstat
#                Setmode
#                # TODO - UPDATE OF MESSAGE
#                Call ECR_TRACE("ERROR DURING THE UPDATING OF THE INVOICING ELEMENT",1) From GESECRAN
#                GREP = "" : REP = "" : OK = 0
#            Endif
#
#            Setmode : Raz GERREUR
#        Else
#            # TODO - UPDATE OF MESSAGE
#            Call ECR_TRACE("INVOICING ELEMENT DOES NOT EXIST",1) From GESECRAN
#            OK = 0
#        Endif
#    Endif

    # NEW WAY OF DEALING WITH INVOICING ELEMENTS
    Local Integer XXXINV

    For [L]XXXINV = 0 To dim([F:XINFSOH]INVDTA) - 1
        If [F:XINFSOH]INVDTA([L]XXXINV) <> 0
            XINFPRND =  [F:XINFSOH]INVDTAAMT([L]XXXINV)

            # HEADER LEVEL DISCOUNT
            If find([F:XINFSOH]INVDTA([L]XXXINV),[M:SOH3]INVDTA(0..[M:SOH3]NBFAC))
                nolign = find([F:XINFSOH]INVDTA([L]XXXINV),[M:SOH3]INVDTA(0..[M:SOH3]NBFAC))
                indice = nolign-1 : mkstat = 0
                status = 75

                Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
                Call SAI_NBFAC("SOH","IMP_ZONE","XINFP_SOH") From W0SOH3

                If mkstat
                    Setmode
                    # TODO - UPDATE OF MESSAGE
                    Call ECR_TRACE("ERROR DURING THE UPDATING OF THE INVOICING ELEMENT",1) From GESECRAN
                    GREP = "" : REP = "" : OK = 0
                Endif

                Setmode : Raz GERREUR
            Else
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("INVOICING ELEMENT DOES NOT EXIST",1) From GESECRAN
                OK = 0
            Endif
        Endif
    Next

    # CALCULATE TOTALS FOR INVOICE LINES
    If val(left$(GVERSION,instr(instr(1,GVERSION,".")+1,GVERSION,".")-1)) > 1.7
        Local    Char     PARAM_T (25) (0..10)
        PARAM_T(0)="1"
        PARAM_T(1)="1"
        PARAM_T(2)="0"
        Call VALTTC("GESSOH",PARAM_T) From TRTVENFACR
    Else
        Call VALTTC("GESSOH") From TRTVENFACR
    Endif


    [M:SOH1]APPFLG = 5

    # IMPORT OF DATA COMPLETE
    ##################################################################################################

    ACTION = "VERIF_MOD"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ
    If !OK
        GREP = ""
        Goto RETCLOSE_MOD
    Endif
    GOK=1

    # VERIFY THAT THE TAXES ARE CORRECT BEFORE UPLOADING THE TRANSACTION
#    If [M:SIHV]INVATI <> [F:XINFSOH]INFTOTINCL + [F:XINFSOH]INVDTAAMT(0) - abs([F:XINFSOH]INVDTAAMT(3))
#
#        GREP = ""
#        GOK = 0
#        # TODO - UPDATE OF MESSAGE
#        Call ECR_TRACE(num$([M:SIHV]INVATI) - num$([F:XINFSOH]INFTOTINCL + [F:XINFSOH]INVDTAAMT(0) - abs([F:XINFSOH]INVDTAAMT(3))),0) From GESECRAN
#        Call ECR_TRACE("ERROR ON THE SALES ORDER CALCULATED TAXES VS INFOPOS DOCKET HEADER TAXES",1) From GESECRAN
#        Goto RETCLOSE_MOD
#    Endif


    [F:SOH]APPFLG = 5

    Trbegin ADOVAL
        Gosub DEFAUT From =PROGOBJ
        nolign = 1

        For IMA=0 To NBMASK
            Gosub CHARGEFIC From =WINPROG
        Next IMA

        Readlock =
        If fstat=1
            GOK=-1 : Call FSTA(ABFIC) From GLOCK : Goto ROLL_TR2
        Elsif fstat
            GOK=0 : Call FSTA(ABFIC) From GLOCK : Goto AB_TR2
        Endif
        ACTION = "AVANT_MODFIC"    : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ
        If GOK < 0
            Gosub ROLL_TR2
            Goto RETCLOSE_MOD
        Elsif !GOK
            Gosub AB_TR2
            Goto RETCLOSE_MOD
        Endif

        nolign = 1

        For IMA=0 To NBMASK
            Gosub CHARGEFIC From =WINPROG
        Next IMA

        ACTION = "INIMOD"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ

        If GOK < 0
            Gosub ROLL_TR2
            Goto RETCLOSE_MOD
        Elsif !GOK
            Gosub AB_TR2
            Goto RETCLOSE_MOD
        Endif
        Rewrite
        If fstat
            GOK=0 : Call FSTA(ABFIC) From GLOCK
            Gosub AB_TR2
            Goto RETCLOSE_MOD
        Endif
        ACTION = "MODIF"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ

        If GOK < 0
            Gosub ROLL_TR2
            Goto RETCLOSE_MOD
        Elsif !GOK
            Gosub AB_TR2
            Goto RETCLOSE_MOD
        Endif
        Commit

    If GOK < 1
        Call TRACE2(2,mess(101,141,1)-[F:SOH]SOHNUM,-1) From SUBIMPOBJ : # ERROR DURING MODIFICATION
    Else
        ACTION = "APRES_MOD"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ

        Call TRACE2(1,[F:SOH]SOHNUM,-1) From SUBIMPOBJ
        Call IDENT3(ABREV,IDENT,CLECUR1,CLECUR2) From GOBJTXT

        # TODO : TRANSACTION IS COMPLETED, FLAG AS COMPLETED
        Call UPDATETRANS([F:XINFSOH]SOHNUM) From XINFP_SOH


        # CLOSE ALL OPEN LINES WHICH ARE MEANT TO BE CLOSED
        ##############################################################################################
        Filter [F:XINFSOD] Where [F:XINFSOD]SOHNUM   = [F:XINFSOH]SOHNUM and [F:XINFSOD]CLOSED = 2 and [F:XINFSOD]X3LINE <> 0
&       Order By Key XINFSOD0

        For [F:XINFSOD]XINFSOD0

            Call DIVCLESOQ([M:SOH0]SOHNUM, [F:XINFSOD]X3LINE, [F:XINFSOD]X3LINE, '')  From TRTVENCDE
        Next

    Endif

    # END - RESTORE SAVED VARIABLES
    ##################################################################################################
    $RETCLOSE_MOD

     If !GOK or !OK :
        GREP = "" : GOK = 1 : OK = 1
        # TODO - UPDATE OF MESSAGE
        Call XERR_TRANS("SOH", [F:XINFSOH]SOHNUM, [F:XINFSOH]EXPNUM, 1, 0, "ERROR ON THE SALES ORDER MODIFICATION - PLEASE REFER TO X3 LOG") From XINFP_ERR

        # NEW FUNCTIONALITY TO RELOCK THE SALES ORDERS AS THERE WAS AN ERROR
        ################################################################################################
        If [F:XSOHA]SOHNUM <> [F:XINFSOH]CUSORDREF
            Read [F:XSOHA]SOH0 = [F:XINFSOH]CUSORDREF
        Endif

        [L]XLLOCK = func GLOBIENS.PRIVATE_GET_STRING_LOCK("SOH", [F:XSOHA]CPY, [F:XINFSOH]CUSORDREF)
        Lock =[L]XLLOCK With lockwait = 0

        If [S]fstat
            #TODO - TRANSACTION IS FAILED TO UNLOCK THE RECORD
            Call ECR_TRACE("UNABLE TO RELOCK THE SALES ORDER - THIS SALES ORDER IS NOW OPEN FOR MODIFICATION!!!",1) From GESECRAN

            Return
         Endif
    Endif

    GIMPORT   = 0

    Unlock =CLECUR1
    Unlock =CLECUR2
    Unlock =GCLE

    ACTION = "FIN" : Gosub ACTION From GOBJET
    If VERROU : Gosub DEVERROU From GOBJET : Endif
    OK = 1 : GOK = 1

    ACTION = "FERME" : Gosub ACTION From GOBJET

    If WINPROG <> ""
        Gosub FERME_BOITE From =WINPROG
        Gosub FERME_MASK From =WINPROG
    Endif
End

# CANCELLATION OF SALES ORDER
######################################################################################
$CANCELLATION
    # DEALLOCATE STOCK ON THE SALES ORDER
    Local Integer WTRTALL, WALLCTM, WRAZCTM, WGENSHT, WALLPAR, WSHTFLG, WIMPCLI, WRET
    WALLPAR = 1
    WSHTFLG = 1
    WIMPCLI = 2
    WALLCTM = 1
    WRAZCTM = 1
    WGENSHT = 2
    WTRTALL = 2
    WRET    = 0

    Call ECR_TRACE(mess(98,197,1)+" "+[M:SOH0]SOHNUM + " " + mess(59,191,1),0) From GESECRAN

    Gosub TR_ALLOC From SUBSOHB

    If !GOK : Return : Endif

    # CLOSING OF THE SALES ORDER
    Call DIVCLESOH ([M:SOH0]SOHNUM, [M:SOH1]CCLREN) From TRTVENCDE
Return

# CALCULATES THE QTY ON HAND, BEFORE ALLOWING ALLOCATION
# XFCY    - STOCKING SITE
# XITM    - ITEM NUMBER
# XQTY    - ALLOCATED QTY
#####################################################################################
Funprog CALC_QTY_ONHAND(XFCY, XITMREF, XQTY)
    Value Char    XFCY
    Value Char    XITMREF
    Value Decimal XQTY

    Local Decimal XTOT

    # DETERMINE IF ITEM IS KIT ITEM
    If clalev([F:XITS]) = 0 : Local File ITMSALES  [F:XITS] : Endif
    If clalev([F:XITM]) = 0 : Local File ITMMASTER [F:XITM] : Endif

    Read [F:XITM]ITM0 = XITMREF
    Read [F:XITS]ITS0 = XITMREF

    # IF KIT NOT KIT ITEM AND STOCK MANAGED, DETERMINE QTY ON HAND
    If [F:XITS]ITMTYP = 1 and [F:XITM]STOMGTCOD <> 1 and [F:XITM]NEGSTO <> 2
        Call QTY_ONHAND(XITMREF,XFCY,XQTY,XTOT) From XINFP_SOH

        If XTOT < 0
            # TODO - UPDATE OF MESSAGE
            Call XERR_TRANS("SOH", [F:XINFSOH]SOHNUM, [F:XINFSOH]EXPNUM, 1, 0, XITMREF - " : QUANTITY TO ISSUE IS GREATER THAN STOCK AVAILABLE") From XINFP_ERR
            End 1
        Endif
    Elsif [F:XITS]ITMTYP = 3
        If clalev([F:XBOMD]) = 0 : Local File BOMD [F:XBOMD] : Endif

        Filter [F:XBOMD] Where [F:XBOMD]ITMREF = XITMREF and [F:XBOMD]BOMALTTYP = 1

        For [F:XBOMD]
            Read [F:XITM]ITM0 = [F:XBOMD]CPNITMREF
            If [F:XITM]STOMGTCOD <> 1
                Call QTY_ONHAND([F:XBOMD]CPNITMREF, XFCY, XQTY * [F:XBOMD]LIKQTY, XTOT) From XINFP_SOH

                If XTOT < 0
                    # TODO - UPDATE OF MESSAGE
                    Call XERR_TRANS("SOH", [F:XINFSOH]SOHNUM, [F:XINFSOH]EXPNUM, 1, 0, [F:XBOMD]CPNITMREF - " : QUANTITY TO ISSUE IS GREATER THAN STOCK AVAILABLE") From XINFP_ERR

                    End 1
                Endif
            Endif
        Next
    Endif
End 0

# DETERMINES THE QTY ON HAND
# XITM    - ITEM NUMBER
# XFCY    - STOCKING SITE
# XQTY    - ALLOCATED QTY
# XONHAND - CALCULATED QTY ON HAND
######################################################################################################
Subprog QTY_ONHAND(XXITM,XXFCY,XXQTY,XXONHAND)
    Value Char        XXITM
    Value Char        XXFCY
    Value Decimal     XXQTY
    Variable Decimal  XXONHAND

    If clalev([F:XITV]) = 0 : Local File  ITMMVT [F:XITV]  : Endif

    Columns [F:XITV](ITMREF,STOFCY,PHYSTO,PHYALL,GLOALL)

    Read [F:XITV]ITV0 = XXITM;XXFCY

    If !fstat
        XXONHAND = [F:XITV]PHYSTO - [F:XITV]PHYALL - [F:XITV]GLOALL - XXQTY
    Else
        XXONHAND = 0
    Endif

    If clalev([F:XITV]) = 1 : Close Local File   [F:XITV]  : Endif
End













