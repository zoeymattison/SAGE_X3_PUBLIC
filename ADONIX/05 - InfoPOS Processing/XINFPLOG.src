#<AdxTL>@(#)0.0.0.0 $Revision$ 
#------------------------------------------------------------------------------------------#
#FILE        : XINFPLOG
#AUTHOR      : GT-AOV
#DATE        : 02 FEB 21
#TO-DO       : READING INFOPOS LOGS AND WRITING INTO A ERROR TABLE
#------------------------------------------------------------------------------------------#

Call WRITELOG()
End

Subprog WRITELOG()
if !clalev([F:XER]) : local file XINFERR [F:XER] : endif
if !clalev([F:XID1]) : local file XINFDATA [F:XID1] : endif
if !clalev([F:XID2]) : local file XINFDATA [F:XID2] : endif
if !clalev([F:XID3]) : local file XINFDATA [F:XID3] : endif

Local Integer YVAR,YVAR1,YVAR2,YVAR3,YVAR4,YVAR5,YVAR6,YVAR7,YVAR8,YVAR9,YVAR10,YVAR11,YVAR12,YVAR13,YVAR14,YVAR15
Local char YNUM, YTRACE
local char YERR(254)
local char ZERR(254)

Filter [F:XID2] where [F:XID2]XNAME = 'ERRORLOG'
Read [F:XID2]XID1 first
if !fstat
  Filter [F:XID3] where [F:XID3]XNAME = 'LOG'
  Read [F:XID3]XID1 first
  if !fstat
    if [F:XID3]XVALUE = [F:XID2]XVALUE
	  call ECR_TRACE('NO NEW LOG TO UPDATE',0) from GESECRAN
	  End
	else
	  Delete [F:XER] where [F:XER]XVCRNUM<>''
	  YTRACE = [F:XID3]XVALUE
    Endif	
  Endif
endif

##Openi filpath("TRA",YTRACE,"tra",0) Using [ZZZ]
local Char XPATH(250) : XPATH ='d:\Sage\X3\folders\X3\SRV\TRA\'+YTRACE+'.tra'
openi XPATH Using [ZZZ]
Local Char XLINE(100)
Repeat
Rdseq XLINE Using [ZZZ]
#---------------------------------------------------------------------------------------------#
##PURCHASE RECEIPT
if left$(XLINE,19)="PURCHASE RECEIPTS :"
	YVAR = 1
	YNUM = right$(XLINE,len(seg$(XLINE,1,instr(1,XLINE,'PURCHASE RECEIPTS :')+20)))
endif

if left$(XLINE,5)="<0001" and YVAR=1
YERR=YERR+seg$(XLINE,7,len(XLINE))
	Filter [F:XER]
	Filter [F:XER] where [F:XER]XVCRNUM = YNUM and [F:XER]XTRATYP = "PTH"
	Read [F:XER]XER0 first
	  [F:XER]XTRATYP = "PTH"
	  [F:XER]XVCRNUM = YNUM
	  [F:XER]XVCRLIN = 0
	  [F:XER]XERROR  = YERR
	  [F:XER]XTRANUM = YTRACE
	  [F:XER]XUPDDATTIM = func AFNC.FDH(date$,"")
	if !fstat
	  Rewrite [F:XER]
	else
	  write [F:XER]
	endif
Endif
If instr(0,XLINE,'PURCHASE RECEIPTS :') <>0
  YVAR = 1
  YERR=''
Elsif instr(0,XLINE,'GENERATION OF A INCREASE ADJUSTMENTS') <>0
  YVAR = 0
  YERR = ''
Endif
#---------------------------------------------------------------------------------------------#
##INCREASE ADJUSTMENTS
if left$(XLINE,22)="INCREASE ADJUSTMENTS :"
	YVAR1 = 1
	YNUM = right$(XLINE,len(seg$(XLINE,1,instr(1,XLINE,'INCREASE ADJUSTMENTS :')+23))) ##seg$(XLINE,24,len(XLINE))
endif

if left$(XLINE,5)="<0001" and YVAR1=1
YERR=YERR+seg$(XLINE,6,len(XLINE))
	Filter [F:XER]
	Filter [F:XER] where [F:XER]XVCRNUM = YNUM and [F:XER]XTRATYP = "SMR"
	Read [F:XER]XER0 first
	  [F:XER]XTRATYP = "SMR"
	  [F:XER]XVCRNUM = YNUM
	  [F:XER]XVCRLIN = 0
	  [F:XER]XERROR  = YERR
	  [F:XER]XTRANUM = YTRACE
	  [F:XER]XUPDDATTIM = func AFNC.FDH(date$,"")
	if !fstat
	  Rewrite [F:XER]
	else
	  write [F:XER]
	endif
Endif
If instr(0,XLINE,'INCREASE ADJUSTMENTS :') <>0
  YVAR1=1
  YERR=''
Elsif instr(0,XLINE,'GENERATION OF A DECREASE ADJUSTMENTS') <>0
  YVAR1=0
  YERR=''
Endif
#---------------------------------------------------------------------------------------------#
##DECREASE ADJUSTMENTS
if left$(XLINE,22)="DECREASE ADJUSTMENTS :"
	YVAR2 = 1
	YNUM = right$(XLINE,len(seg$(XLINE,1,instr(1,XLINE,'DECREASE ADJUSTMENTS :')+23))) ##seg$(XLINE,24,len(XLINE))
endif

if left$(XLINE,5)="<0001" and YVAR2=1
YERR=YERR+seg$(XLINE,6,len(XLINE))
	Filter [F:XER]
	Filter [F:XER] where [F:XER]XVCRNUM = YNUM and [F:XER]XTRATYP = "SMO"
	Read [F:XER]XER0 first
	  [F:XER]XTRATYP = "SMO"
	  [F:XER]XVCRNUM = YNUM
	  [F:XER]XVCRLIN = 0
	  [F:XER]XERROR  = YERR
	  [F:XER]XTRANUM = YTRACE
	  [F:XER]XUPDDATTIM = func AFNC.FDH(date$,"")
	if !fstat
	  Rewrite [F:XER]
	else
	  write [F:XER]
	endif
Endif
If instr(0,XLINE,'DECREASE ADJUSTMENTS :') <>0
  YVAR2=1
  YERR=''
Elsif instr(0,XLINE,'GENERATION OF TRANSFER TO GIT LOCATION') <>0
  YVAR2=0
  YERR=''
Endif

#---------------------------------------------------------------------------------------------#
##GENERATION/UPDATE OF CUSTOMERS
if left$(XLINE,10)="CUSTOMER :"
	YVAR4 = 1
	YNUM = right$(XLINE,len(seg$(XLINE,1,instr(1,XLINE,'CUSTOMER :')+11))) ##seg$(XLINE,24,len(XLINE))
endif

if left$(XLINE,5)="<0001" and YVAR4=1
YERR=YERR+seg$(XLINE,6,len(XLINE))
	Filter [F:XER]
	Filter [F:XER] where [F:XER]XVCRNUM = YNUM and [F:XER]XTRATYP = "BPC"
	Read [F:XER]XER0 first
	  [F:XER]XTRATYP = "BPC"
	  [F:XER]XVCRNUM = YNUM
	  [F:XER]XVCRLIN = 0
	  [F:XER]XERROR  = YERR
	  [F:XER]XTRANUM = YTRACE
	  [F:XER]XUPDDATTIM = func AFNC.FDH(date$,"")
	if !fstat
	  Rewrite [F:XER]
	else
	  write [F:XER]
	endif
Endif
If instr(0,XLINE,'CUSTOMER :') <>0
  YVAR4=1
  YERR=''
Elsif instr(0,XLINE,'GENERATION OF SALES QUOTES') <>0
  YVAR4=0
  YERR=''
Endif
#---------------------------------------------------------------------------------------------#
##GENERATION OF SALES QUOTES
if left$(XLINE,13)="SALES QUOTE :"
	YVAR5 = 1
	YNUM = right$(XLINE,len(seg$(XLINE,1,instr(1,XLINE,'SALES QUOTE :')+14))) ##seg$(XLINE,24,len(XLINE))
endif

if left$(XLINE,5)="<0001" and YVAR5=1
YERR=YERR+seg$(XLINE,6,len(XLINE))
	Filter [F:XER]
	Filter [F:XER] where [F:XER]XVCRNUM = YNUM and [F:XER]XTRATYP = "SQH"
	Read [F:XER]XER0 first
	  [F:XER]XTRATYP = "SQH"
	  [F:XER]XVCRNUM = YNUM
	  [F:XER]XVCRLIN = 0
	  [F:XER]XERROR  = YERR
	  [F:XER]XTRANUM = YTRACE
	  [F:XER]XUPDDATTIM = func AFNC.FDH(date$,"")
	if !fstat
	  Rewrite [F:XER]
	else
	  write [F:XER]
	endif
Endif
If instr(0,XLINE,'SALES QUOTE :') <>0
  YVAR5=1
  YERR=''
Elsif instr(0,XLINE,'GENERATION OF SALES ORDERS') <>0
  YVAR5=0
  YERR=''
Endif
#---------------------------------------------------------------------------------------------#
##GENERATION OF SALES ORDERS
if left$(XLINE,13)="SALES ORDER :"
	YVAR6 = 1
	YNUM = right$(XLINE,len(seg$(XLINE,1,instr(1,XLINE,'SALES ORDER :')+14))) ##seg$(XLINE,24,len(XLINE))
endif

if left$(XLINE,5)="<0001" and YVAR6=1
YERR=YERR+seg$(XLINE,6,len(XLINE))
	Filter [F:XER]
	Filter [F:XER] where [F:XER]XVCRNUM = YNUM and [F:XER]XTRATYP = "SOH"
	Read [F:XER]XER0 first
	  [F:XER]XTRATYP = "SOH"
	  [F:XER]XVCRNUM = YNUM
	  [F:XER]XVCRLIN = 0
	  [F:XER]XERROR  = YERR
	  [F:XER]XTRANUM = YTRACE
	  [F:XER]XUPDDATTIM = func AFNC.FDH(date$,"")
	if !fstat
	  Rewrite [F:XER]
	else
	  write [F:XER]
	endif
Endif
If left$(XLINE,13) ='SALES ORDER :'
  YVAR6=1
  YERR=''
Elsif instr(0,XLINE,'GENERATION OF SALES INVOICES') <>0
  YVAR6=0
  YERR=''
Endif
#---------------------------------------------------------------------------------------------#
##GENERATION OF SALES INVOICES
if left$(XLINE,30)="STARTING DOCUMENT GENERATION :"
	YVAR7 = 1
	local char YCHAR : YCHAR = right$(XLINE,len(seg$(XLINE,1,instr(1,XLINE,'STARTING DOCUMENT GENERATION :')+31)))
	Local Char YCHAR1:YCHAR1=right$(YCHAR, 1+len(YCHAR)-11)
	Local integer YLEN : YLEN = len(YCHAR)-len(YCHAR1)
	YNUM = left$(YCHAR,YLEN)
endif

if left$(XLINE,5)="<0001" and YVAR7=1
YERR=YERR+seg$(XLINE,6,len(XLINE))
	Filter [F:XER]
	Filter [F:XER] where [F:XER]XVCRNUM = YNUM and [F:XER]XTRATYP = "SIH"
	Read [F:XER]XER0 first
	  [F:XER]XTRATYP = "SIH"
	  [F:XER]XVCRNUM = YNUM
	  [F:XER]XVCRLIN = 0
	  [F:XER]XERROR  = YERR
	  [F:XER]XTRANUM = YTRACE
	  [F:XER]XUPDDATTIM = func AFNC.FDH(date$,"")
	if !fstat
	  Rewrite [F:XER]
	else
	  write [F:XER]
	endif
Endif
If instr(0,XLINE,'STARTING DOCUMENT GENERATION :') <>0
  YVAR7=1
  YERR=''
Elsif instr(0,XLINE,'GENERATION OF A CUSTOMER RETURNS') <>0
  YVAR7=0
  YERR=''
Endif
#---------------------------------------------------------------------------------------------#
##GENERATION OF A CUSTOMER RETURNS
if left$(XLINE,17)="CUSTOMER RETURN :"
	YVAR8 = 1
	YNUM = right$(XLINE,len(seg$(XLINE,1,instr(1,XLINE,'CUSTOMER RETURN :')+18))) ##seg$(XLINE,24,len(XLINE))
endif

if left$(XLINE,5)="<0001" and YVAR8=1
YERR=YERR+seg$(XLINE,6,len(XLINE))
	Filter [F:XER]
	Filter [F:XER] where [F:XER]XVCRNUM = YNUM and [F:XER]XTRATYP = "SRH"
	Read [F:XER]XER0 first
	  [F:XER]XTRATYP = "SRH"
	  [F:XER]XVCRNUM = YNUM
	  [F:XER]XVCRLIN = 0
	  [F:XER]XERROR  = YERR
	  [F:XER]XTRANUM = YTRACE
	  [F:XER]XUPDDATTIM = func AFNC.FDH(date$,"")
	if !fstat
	  Rewrite [F:XER]
	else
	  write [F:XER]
	endif
Endif
If left$(XLINE,17) ='CUSTOMER RETURN :'
  YVAR8=1
  YERR=''
Elsif instr(0,XLINE,'GENERATION OF A CREDIT NOTES') <>0
  YVAR8=0
  YERR=''
Endif
#---------------------------------------------------------------------------------------------#
##GENERATION OF A CREDIT NOTES
if left$(XLINE,13)="CREDIT NOTE :"
	YVAR9 = 1
	YNUM = right$(XLINE,len(seg$(XLINE,1,instr(1,XLINE,'CREDIT NOTE :')+14))) ##seg$(XLINE,24,len(XLINE))
endif

if left$(XLINE,5)="<0001" and YVAR9=1
YERR=YERR+seg$(XLINE,6,len(XLINE))
	Filter [F:XER]
	Filter [F:XER] where [F:XER]XVCRNUM = YNUM and [F:XER]XTRATYP = "CRN"
	Read [F:XER]XER0 first
	  [F:XER]XTRATYP = "CRN"
	  [F:XER]XVCRNUM = YNUM
	  [F:XER]XVCRLIN = 0
	  [F:XER]XERROR  = YERR
	  [F:XER]XTRANUM = YTRACE
	  [F:XER]XUPDDATTIM = func AFNC.FDH(date$,"")
	if !fstat
	  Rewrite [F:XER]
	else
	  write [F:XER]
	endif
Endif
If left$(XLINE,13) ='CREDIT NOTE :'
  YVAR9=1
  YERR=''
Elsif instr(0,XLINE,'GENERATION OF PAYMENT REFUNDS') <>0
  YVAR9=0
  YERR=''
Endif
#---------------------------------------------------------------------------------------------#
##GENERATION OF PAYMENT REFUNDS
if left$(XLINE,16)="PAYMENT REFUND :"
	YVAR10 = 1
	YNUM = right$(XLINE,len(seg$(XLINE,1,instr(1,XLINE,'PAYMENT REFUND :')+17))) ##seg$(XLINE,24,len(XLINE))
endif

if left$(XLINE,5)="<0001" and YVAR10=1
YERR=YERR+seg$(XLINE,6,len(XLINE))
	Filter [F:XER]
	Filter [F:XER] where [F:XER]XVCRNUM = YNUM and [F:XER]XTRATYP = "PAYREF"
	Read [F:XER]XER0 first
	  [F:XER]XTRATYP = "PAYREF"
	  [F:XER]XVCRNUM = YNUM
	  [F:XER]XVCRLIN = 0
	  if instr(1,YERR,'Selected Item not Validated')> 0
	    [F:XER]XERROR = 'Credit note not validated ' + right$(YERR,129)
	  else
	    [F:XER]XERROR = YERR
	  Endif
	  [F:XER]XTRANUM = YTRACE
	  [F:XER]XUPDDATTIM = func AFNC.FDH(date$,"")
	if !fstat
	  Rewrite [F:XER]
	else
	  write [F:XER]
	endif
Endif
If left$(XLINE,16) ='PAYMENT REFUND :'
  YVAR10=1
  YERR=''
Elsif instr(0,XLINE,'GENERATION OF PAYMENT RECEIPTS') <>0
  YVAR10=0
  YERR=''
Endif
#---------------------------------------------------------------------------------------------#
##GENERATION OF PAYMENT RECEIPTS
if left$(XLINE,17)="PAYMENT RECEIPT :"
	YVAR11 = 1
	YNUM = right$(XLINE,len(seg$(XLINE,1,instr(1,XLINE,'PAYMENT RECEIPT :')+18))) ##seg$(XLINE,24,len(XLINE))
endif

if left$(XLINE,5)="<0001" and YVAR11=1
YERR=YERR+seg$(XLINE,6,len(XLINE))
	Filter [F:XER]
	Filter [F:XER] where [F:XER]XVCRNUM = YNUM and [F:XER]XTRATYP = "PAYREC"
	Read [F:XER]XER0 first
	  [F:XER]XTRATYP = "PAYREC"
	  [F:XER]XVCRNUM = YNUM
	  [F:XER]XVCRLIN = 0
	  [F:XER]XERROR  = YERR
	  [F:XER]XTRANUM = YTRACE
	  [F:XER]XUPDDATTIM = func AFNC.FDH(date$,"")
	if !fstat
	  Rewrite [F:XER]
	else
	  write [F:XER]
	endif
Endif
If left$(XLINE,17) ='PAYMENT RECEIPT :'
  YVAR11=1
  YERR=''
Elsif instr(0,XLINE,'GENERATION OF CBT TRANSACTIONS') <>0
  YVAR11=0
  YERR=''
Endif
#---------------------------------------------------------------------------------------------#
##GENERATION OF CBT TRANSACTIONS
if left$(XLINE,17)="CBT TRANSACTION :"
	YVAR12 = 1
	YNUM = right$(XLINE,len(seg$(XLINE,1,instr(1,XLINE,'CBT TRANSACTION :')+18))) ##seg$(XLINE,24,len(XLINE))
endif

if left$(XLINE,5)="<0001" and YVAR12=1
YERR=YERR+seg$(XLINE,6,len(XLINE))
	Filter [F:XER]
	Filter [F:XER] where [F:XER]XVCRNUM = YNUM and [F:XER]XTRATYP = "PAYCBT"
	Read [F:XER]XER0 first
	  [F:XER]XTRATYP = "PAYCBT"
	  [F:XER]XVCRNUM = YNUM
	  [F:XER]XVCRLIN = 0
	  [F:XER]XERROR  = YERR
	  [F:XER]XTRANUM = YTRACE
	  [F:XER]XUPDDATTIM = func AFNC.FDH(date$,"")
	if !fstat
	  Rewrite [F:XER]
	else
	  write [F:XER]
	endif
Endif
If left$(XLINE,17) ='CBT TRANSACTION :'
  YVAR12=1
  YERR=''
Elsif instr(0,XLINE,'GENERATION OF CBT TRANSACTIONS') <>0
  YVAR12=0
  YERR=''
Endif
#---------------------------------------------------------------------------------------------#
Until fstat <> 0
Openi Using [ZZZ]

#---------------------------------------------------------------------------------------------#
##GENERATION OF TRANSFERS
call ITH(YTRACE)

Filter [F:XID1]
Read [F:XID1]XID1 = 'ERRORLOG'
  [F:XID1]XVALUE = YTRACE
  [F:XID1]XNAME = 'ERRORLOG'
  [F:XID1]XUPDDATTIM = func AFNC.FDH(date$,"")
if !fstat
  call ECR_TRACE('LOG '+YTRACE+' UPDATED',0) from GESECRAN
  Rewrite [F:XID1]
else
  call ECR_TRACE('LOG '+YTRACE+' UPDATED',0) from GESECRAN
  Write [F:XID1]
endif

End




###############################################################################################
Subprog ITH(ZTRACE)
value char ZTRACE

if !clalev([F:XER]) : local file XINFERR [F:XER] : endif

Local Integer ZVAR
Local char ZNUM
local char ZERR(254)

Openi filpath('d:\Sage\X3\folders\X3\SRV\TRA\',ZTRACE,"tra",0) Using [ZZZ]
Local Char XLINE(100)
Repeat
Rdseq XLINE Using [ZZZ]

##GENERATION OF TRANSFERS OUT
if left$(XLINE,10)="TRANSFER :"
	ZVAR= 1
	ZNUM = right$(XLINE,len(seg$(XLINE,1,instr(1,XLINE,'TRANSFER :')+11))) ##seg$(XLINE,24,len(XLINE))
endif
if left$(XLINE,5)="<0001" and ZVAR=1
ZERR=ZERR+seg$(XLINE,6,len(XLINE))
	Filter [F:XER]
	Filter [F:XER] where [F:XER]XVCRNUM = ZNUM
	Read [F:XER]XER0 first
	  [F:XER]XTRATYP = "ITH"
	  [F:XER]XVCRNUM = ZNUM
	  [F:XER]XVCRLIN = 0
	  [F:XER]XERROR  = ZERR
	  [F:XER]XTRANUM = ZTRACE
	  [F:XER]XUPDDATTIM = func AFNC.FDH(date$,"")
	if !fstat
	  Rewrite [F:XER]
	else
	  write [F:XER]
	endif
Endif

If instr(0,XLINE,'TRANSFER :') <>0
  ZVAR=1
  ZERR=''
Elsif instr(0,XLINE,'GENERATION OF TRANSFERS IN') <>0
  ZVAR=0
  ZERR=''
Elsif instr(0,XLINE,'GENERATION/UPDATE OF CUSTOMERS') <>0
  ZVAR=0
  ZERR=''
Elsif instr(0,XLINE,'GENERATION OF TRANSFER FROM GIT LOCATION') <>0
  ZVAR=0
  ZERR=''
Elsif instr(0,XLINE,'GENERATION OF TRANSFERS OUT') <>0
  ZVAR=0
  ZERR=''
Endif

Until instr(0,XLINE,'GENERATION/UPDATE OF CUSTOMERS') <>0

Openi Using [ZZZ]


if !clalev([F:XITH]) : local file XINFITH [F:XITH] : endif
if !clalev([F:XER1]) : local file XINFERR [F:XER1] : endif

for [F:XER1] where [F:XER1]XTRATYP ='ITH'
  Filter [F:XITH]
  filter [F:XITH] where [F:XITH]VCRNUM = [F:XER1]XVCRNUM
  Read [F:XITH]XINFITH0 first
  if !fstat
	if [F:XITH]VCRTYP = 1 and [F:XITH]FLOWTYP = 1
	  [F:XER1]XTRATYP = "ITH TO GIT"
	endif
	if [F:XITH]VCRTYP = 1 and [F:XITH]FLOWTYP = 2
	  [F:XER1]XTRATYP = "ITH FROM GIT"
	endif
	if [F:XITH]VCRTYP = 2 and [F:XITH]FLOWTYP = 1
	  [F:XER1]XTRATYP = "ITH OUT"
	endif
	if [F:XITH]VCRTYP = 2 and [F:XITH]FLOWTYP = 2
	  [F:XER1]XTRATYP = "ITH IN"
	endif
  endif
  Rewrite [F:XER1]
next
end


###############################################################################################























































































































































































































































