#Call CREATE_TRANS() From XINFP_UTIL
#Call POST_INVOICES() From XINFP_UTIL
Call INSERT_PAYMENTS() From XINFP_UTIL
End

##########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When Default
    Endcase
Return

# CREATES THE EXPORT FILE OF THE INVOICES THAT WERE IN ERROR
###########################################################################################
Subprog CREATE_TRANS
    Local Char    XLINE(255), XMESSAGE(255)
    If !clalev([F:XINFPSIH]) : Local File SINVOICE  [F:XINFPSIH] : Endif
    If !clalev([F:XXSIH])    : Local File SINVOICE  [F:XXSIH]    : Endif
    If !clalev([F:XINFPSIV]) : Local File SINVOICEV [F:XINFPSIV] : Endif
    If !clalev([F:XINFUTIL]) : Local File XINFUTIL  [F:XINFUTIL] : Endif

    ## CREATE FILE FOR IMPORT
    #################################################################################
    adxifs = ';' : adxirs = chr$(13)+chr$(10)

    ## OPEN FILE
    #################################################################################
    Openo filpath("INFOPOS","FIX-OUTPUT-" + date$,'TXT') Using [FIC1]


    Link [F:XINFUTIL] With [F:XINFPSIH]SIH0 = [F:XINFUTIL]VCRNUM,[F:XINFPSIV]SIV0 = [F:XINFUTIL]VCRNUM  As [XXXX]

    For [XXXX]
        Look [F:XXSIH]SIH0 = [F:XINFPSIH]NUM + "-A1"

        If fstat
            # HEADER LINE
            XLINE =   "V;"  + [F:XINFPSIV]SALFCY
            XLINE +=  ";"   + num$([F:XINFPSIH]INVTYP)
            XLINE +=  ";"   + [F:XINFPSIH]NUM + "-A1"
            XLINE + = ";"   + [F:XINFPSIV]BPCINV
            XLINE +=  ";"   + [F:XINFPSIH]CUR
            If [F:XINFPSIV]INVDAT < gdat$(01,08,2018)
                XLINE +=  ";"   + format$("D:DDMMYYYY",gdat$(01,08,2018))
            Else
                XLINE +=  ";"   + format$("D:DDMMYYYY",[F:XINFPSIV]INVDAT)
            Endif

            Wrseq XLINE Using [FIC1]

            # DETAIL LINE
            XLINE =   "D;CREDITNOTE;Credit Note Correction;UN;1,0.01;;"

            Wrseq XLINE Using [FIC1]
        Endif
    Next

    ## CLOSE FILE
    #################################################################################
    Openo Using [FIC1]

    If clalev([F:XINFPSIH]) : Close Local File [F:XINFPSIH] : Endif
    If clalev([F:XXSIH])    : Close Local File [F:XXSIH]    : Endif
    If clalev([F:XINFPSIV]) : Close Local File [F:XINFPSIV] : Endif
    If clalev([F:XINFUTIL]) : Close Local File [F:XINFUTIL] : Endif
End

# POSTS THE INVOICES THAT WERE CREATED TO FIX THE ISSUES
###########################################################################################
Subprog POST_INVOICES
    If !clalev([F:XINFPSIH]) : Local File SINVOICE  [F:XINFPSIH] : Endif
    If !clalev([F:XXSIH])    : Local File SINVOICE  [F:XXSIH]    : Endif
    If !clalev([F:XINFPSIV]) : Local File SINVOICEV [F:XINFPSIV] : Endif
    If !clalev([F:XINFUTIL]) : Local File XINFUTIL  [F:XINFUTIL] : Endif

    Call OUVRE_TRACE("BATCH POSTING") From LECFIC
    Call ECR_TRACE("----------------------------------", 0) From GESECRAN

    Link [F:XINFUTIL] With [F:XINFPSIH]SIH0 = [F:XINFUTIL]VCRNUM,[F:XINFPSIV]SIV0 = [F:XINFUTIL]VCRNUM  As [XXXX]

    For [XXXX]
        Look [F:XXSIH]SIH0 = [F:XINFPSIH]NUM + "-A"

        If !fstat
            Filter [F:XINFPSIV] Where  [F:XINFPSIV]NUM = [F:XINFPSIH]NUM + "-A" and [F:XINFPSIV]INVSTA = 3 Order By Key SIV0
            Look [F:XINFPSIV] First

            If fstat
                Call POST_INV([F:XINFPSIH]NUM + "-A")
            Endif
        Endif

    Next

    Call FERME_TRACE From LECFIC
    Call LEC_TRACE From LECFIC

    If clalev([F:XINFPSIH]) : Close Local File [F:XINFPSIH] : Endif
    If clalev([F:XXSIH])    : Close Local File [F:XXSIH]    : Endif
    If clalev([F:XINFPSIV]) : Close Local File [F:XINFPSIV] : Endif
    If clalev([F:XINFUTIL]) : Close Local File [F:XINFUTIL] : Endif
End

#####################################################################################
# InfoPOS INTEGRATION CODE - POSTING AND INVOICE
#
# @DESCRIPTION   - POST AN INVOICE
# @PARAM         - XINV : INVOICE NUMBER
#
#####################################################################################
Subprog POST_INV(XINV)
    Value    Char    XINV

    Local Integer  OK, NBPCE, WRET
    Local Char     CRITERE(250), SYMBOLE(50)
    Local Integer  WCDTUNL
    Local Char     WPARAM(GLONADP)
    Local Char     WTRS(3)

    If clalev([F:SIH]) = 0 : Local File SINVOICE    [SIH] : Endif
    If clalev([F:SIV]) = 0 : Local File SINVOICEV   [SIV] : Endif
    If clalev([F:SID]) = 0 : Local File SINVOICED   [SID] : Endif
    If clalev([F:SVF]) = 0 : Local File SVCRFOOT    [SVF] : Endif
    If clalev([F:SVV]) = 0 : Local File SVCRVAT     [SVV] : Endif
    If clalev([F:FCY]) = 0 : Local File FACILITY    [FCY] : Endif
    If clalev([F:CPY]) = 0 : Local File COMPANY     [CPY] : Endif
    If clalev([F:BPR]) = 0 : Local File BPARTNER    [BPR] : Endif
    If clalev([F:BPC]) = 0 : Local File BPCUSTOMER  [BPC] : Endif
    If clalev([F:GAC]) = 0 : Local File GACCOUNT    [GAC] : Endif
    If clalev([F:CAC]) = 0 : Local File GACCCODE    [CAC] : Endif
    If clalev([F:DSP]) = 0 : Local File CADSP       [DSP] : Endif
    If clalev([F:CCE]) = 0 : Local File CACCE       [CCE] : Endif
    If clalev([F:AUZ]) = 0 : Local File CAAUZ       [AUZ] : Endif
    If clalev([F:TCU]) = 0 : Local File TABCUR      [TCU] : Endif
    If clalev([F:TCH]) = 0 : Local File TABCHANGE   [TCH] : Endif
    If clalev([F:TUN]) = 0 : Local File TABUNIT     [TUN] : Endif
    If clalev([F:GTE]) = 0 : Local File GTYPACCENT  [GTE] : Endif
    If clalev([F:FIY]) = 0 : Local File FISCALYEAR  [FIY] : Endif
    If clalev([F:PER]) = 0 : Local File PERIOD      [PER] : Endif
    If clalev([F:DUD]) = 0 : Local File GACCDUDATE  [DUD] : Endif
    If clalev([F:GAU]) = 0 : Local File GAUTACE     [GAU] : Endif
    If clalev([F:JOU]) = 0 : Local File GJOURNAL    [JOU] : Endif
    If clalev([F:ITM]) = 0 : Local File ITMMASTER   [ITM] : Endif
    If clalev([F:SDH]) = 0 : Local File SDELIVERY   [SDH] : Endif
    If clalev([F:STJ]) = 0 : Local File STOJOU      [STJ] : Endif
    If clalev([F:ABR]) = 0 : Local File ABATRQT     [ABR] : Endif

    If GMODU(2)=2 : If clalev([F:JST])=0 : Local File GAJOUSTA [JST] : Endif : Endif

    If clalev([F:SI2]) = 0 : Local File SINVOICE    [SI2] : Endif

    # OPENING OF MASK TO BE USED DURING THE POSTING PROCEDURE
    If clalev([M:ORDK]) = 0 : Local Mask ORDK [M:ORDK] : Raz [M:ORDK] : Endif

    If clalev([M:SIH0]) = 0 : Local Mask SIH0 [M:SIH0] : Raz [M:SIH0] : Endif
    If clalev([M:SIH1]) = 0 : Local Mask SIH1 [M:SIH1] : Raz [M:SIH1] : Endif
    If clalev([M:SIH2]) = 0 : Local Mask SIH2 [M:SIH2] : Raz [M:SIH2] : Endif
    If clalev([M:SIH4]) = 0 : Local Mask SIH4 [M:SIH4] : Raz [M:SIH4] : Endif
    If clalev([M:SIHV]) = 0 : Local Mask SIHV [M:SIHV] : Raz [M:SIHV] : Endif

    Filter [F:SI2]

    Call PARAMUTIL("SCDTUNL",WPARAM,"","") From SUBAUS
    WCDTUNL=val(WPARAM)
    If WCDTUNL = 0 : WCDTUNL = 1 : Endif

    NBPCE = 0

    # GLOBAL VARIABLES ASSIGNEMENT FOR LOADING OF DIMENSIONS
    Read [F:SI2]SIH0 = XINV

    OK = 2
    Call CONTFCY([F:SI2]FCY) From CPTSUB
    Call GETCPY([F:SI2]FCY,"",0,"") From TRTX3CPT

    If mkstat : XGOK = 0 : OK = 1 : End : Endif

    # IF DIRECT BILL FROM MODULE SALES
    # RETRIEVE THE INVENTORY TRANSACTION
    # IF INVOICE WITH STOCK MOVEMENT, CONTROL OF THE CLIENT
    Call GETDEV([F:SI2]FCY)  From DEVSUB
    Call GLOBVAR([F:SI2]FCY) From WWGLOBVEN

    Read [F:SIV]SIV0 = [F:SI2]NUM

    If fstat : OK = 1  : End : Endif

    SYMBOLE = "SIV"+[F:SI2]NUM

    Lock =SYMBOLE With lockwait=0

    If fstat=1
        If GTRACE<>"" : Call ECR_TRACE([F:SI2]NUM-mess(10,100,1),1) From GESECRAN : Endif
    Else
        Call VALIDATION(2,[F:SI2]NUM) From TRTVENFACV

        Unlock =SYMBOLE
    Endif

    Raz GREP
End

# INSERTS AN ADDITIONAL LINE IN THE PAYMENT STAGING TABLE
###########################################################################################
Subprog INSERT_PAYMENTS
    If !clalev([F:XINFPSIH]) : Local File SINVOICE  [F:XINFPSIH] : Endif
    If !clalev([F:XXSIH])    : Local File SINVOICE  [F:XXSIH]    : Endif
    If !clalev([F:XINFPSIV]) : Local File SINVOICEV [F:XINFPSIV] : Endif
    If !clalev([F:XINFPYD])  : Local File XINFPYD   [F:XINFPYD]  : Endif
    If !clalev([F:XINFPYD2])  : Local File XINFPYD   [F:XINFPYD2]  : Endif
    If !clalev([F:XINFUTIL]) : Local File XINFUTIL  [F:XINFUTIL] : Endif

    Call OUVRE_TRACE("INSERT PAYMENT") From LECFIC
    Call ECR_TRACE("----------------------------------", 0) From GESECRAN

    GOK = 1

    Trbegin [F:XINFPYD]

    Link [F:XINFUTIL] With [F:XINFPSIH]SIH0 = [F:XINFUTIL]VCRNUM,[F:XINFPSIV]SIV0 = [F:XINFUTIL]VCRNUM  As [XXXX]

    For [XXXX]
       # Decrease the original payment line amount to that of the invoice in X3
       Filter [F:XINFPYD] Where [F:XINFPYD]NUM = [F:XINFUTIL]NUM and [F:XINFPYD]VCRNUM = [F:XINFUTIL]VCRNUM Order By Key XINFPYD0
       Read [F:XINFPYD] First

       [F:XINFPYD]AMTLIN = [F:XINFPSIH]AMTATI
       Rewrite  [F:XINFPYD]

       If fstat
          Call ECR_TRACE("Fail", 1) From GESECRAN
          GOK = 0
          Break
       Else
          Call ECR_TRACE("OK", 0) From GESECRAN
       Endif


        Filter [F:XINFPYD2] Where [F:XINFPYD2]NUM = [F:XINFUTIL]NUM and [F:XINFPYD2]VCRNUM = [F:XINFUTIL]VCRNUM + "-A" Order By Key XINFPYD0
        Read [F:XINFPYD2] First

        If fstat
           Raz [F:XINFPYD2]

           [F:XINFPYD2]NUM    = [F:XINFUTIL]NUM
           [F:XINFPYD2]LIN    = 1
           [F:XINFPYD2]VCRNUM = [F:XINFUTIL]VCRNUM + "-A1"
           [F:XINFPYD2]VCRTYP = [F:XINFUTIL]VCRTYP
           [F:XINFPYD2]AMTLIN = 0.01

           Write [F:XINFPYD2]

           If fstat
              Call ECR_TRACE("Fail", 1) From GESECRAN
              GOK = 0
              Break
           Else
              Call ECR_TRACE("OK", 0) From GESECRAN
           Endif
        Else
           [F:XINFPYD2]VCRNUM = [F:XINFUTIL]VCRNUM + "-A1"
           [F:XINFPYD2]AMTLIN = 0.01

           Rewrite [F:XINFPYD2]

           If fstat
              Call ECR_TRACE("Fail", 1) From GESECRAN
              GOK = 0
              Break
           Else
              Call ECR_TRACE("OK", 0) From GESECRAN
           Endif
        Endif
    Next

    If GOK
        Commit
    Else
        Rollback
    Endif

    Call FERME_TRACE From LECFIC
    Call LEC_TRACE From LECFIC

    If clalev([F:XINFPSIH]) : Close Local File [F:XINFPSIH] : Endif
    If clalev([F:XXSIH])    : Close Local File [F:XXSIH]    : Endif
    If clalev([F:XINFPSIV]) : Close Local File [F:XINFPSIV] : Endif
    If clalev([F:XINFPYD])  : Close Local File [F:XINFPYD]  : Endif
    If clalev([F:XINFPYD2])  : Close Local File [F:XINFPYD2]  : Endif
    If clalev([F:XINFUTIL]) : Close Local File [F:XINFUTIL] : Endif
End









