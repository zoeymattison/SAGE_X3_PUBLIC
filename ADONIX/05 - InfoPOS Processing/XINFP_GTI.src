###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES TRANSFER OUT VIA GIT, CREATES MISC ISSUE THEN MISC RECEIPT INTO GIT LOCATION
########################################################################################################################
Subprog GTI_TRANS()
    If !clalev([F:XINFITH]) : Local File XINFITH  [F:XINFITH] : Endif
    If !clalev([F:XINFITD]) : Local File XINFITD  [F:XINFITD] : Endif
    If !clalev([F:XINFITS]) : Local File XINFITS  [F:XINFITS] : Endif
    If !clalev([F:XSMHA])   : Local File SMVTH    [F:XSMHA]   : Endif
    If !clalev([M:IMP2])    : Local Mask IMPOBJ2  [M:IMP2]    : Endif

    # TODO - UPDATE OF MESSAGE
    Call ECR_TRACE("GENERATION OF TRANSFER FROM GIT LOCATION",0) From GESECRAN
    Call ECR_TRACE("---------------------------------------",0) From GESECRAN

    Filter [F:XINFITH] Where [F:XINFITH]VCRTYP = 1  and [F:XINFITH]FLOWTYP = 2 and [F:XINFITH]POSTED <> 2 and [F:XINFITH]XFLAG = 0
&   Order By Key XINFITH0

    For [F:XINFITH]XINFITH0
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("TRANSFER :" - [F:XINFITH]VCRNUM ,0) From GESECRAN

        # TODO - UPDATE OF MESSAGE
        # DETERMINE IF TRANSFER OUT EXISTS
        Look [F:XSMHA]SMH0 = 20;[F:XINFITH]VCRNUM+"-O"

        If fstat
            # CALL THE CREATION OF THE TRANSFER OUT OF GIT
            Call TRANS_CREO From XINFP_GTI
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("TRANSFER OUT EXISTS",0) From GESECRAN

            # TODO - UPDATE OF MESSAGE
            # DETERMINE IF TRANSFER IN EXISTS
            Filter [F:XSMHA]
            Look [F:XSMHA]SMH0 = 19;[F:XINFITH]VCRNUM+"-I"

            If fstat
                # CALL THE CREATION OF THE TRANSFER INTO GIT
                Call TRANS_CREI From XINFP_GTI
            Else
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("TRANSFER IN EXISTS",0) From GESECRAN
                Call ECR_TRACE("TRANSFER COMPLETED",0) From GESECRAN

                # UPDATE THE TRANSACTION AS INTEGRATED
                Call UPDATETRANS([F:XINFITH]VCRNUM) From XINFP_GTI
            Endif
        Endif

        # IMPORT VARIABLE DISABLE - USED FOR LOGGING PURPOSES
        GIMPORT = 0
    Next

    If clalev([F:XINFITH]) : Close Local File  [F:XINFITH] : Endif
    If clalev([F:XINFITD]) : Close Local File  [F:XINFITD] : Endif
    If clalev([F:XINFITS]) : Close Local File  [F:XINFITS] : Endif
    If clalev([F:XSMHA])   : Close Local File  [F:XSMHA]   : Endif
    If clalev([M:IMP2])    : Close Local Mask  [M:IMP2]    : Endif
End

###########################################################################################
# UPDATE THE TRANSACTION AS COMPLETED
###########################################################################################
Subprog UPDATETRANS(XINFPNUM)
    Value Char XINFPNUM
    If !clalev([F:XUP]) : Local File XINFITH [F:XUP] : Endif

    Call XERR_TRANS("IBT", XINFPNUM, [F:XINFITH]EXPNUM, 2, 0, "SUCCESSFUL") From XINFP_ERR

    Trbegin [F:XUP]
        Update [F:XUP] Where [F:XUP]VCRNUM = XINFPNUM With [F:XUP]POSTED = 2

        If fstat
            Rollback
        Else
            Commit
        Endif

    If clalev([F:XUP]) : Close Local File   [F:XUP] : Endif
End

# CREATION OF TRANSFER OUT
##################################################################################################
Subprog TRANS_CREO
    Local Char    XLINE(255), XMESSAGE(255)
    Local Integer XLIN

    GOK = 1

    ## CREATE TRANSFER OUT FILE FOR IMPORT
    #################################################################################
    adxifs = ';' : adxirs = chr$(13)+chr$(10)

    ## OPEN FILE
    #################################################################################
    Openo filpath("INFOPOS",[F:XINFITH]VCRNUM+"-O",'TXT') Using [FIC1]

    XLINE =   "E;20"
    XLINE +=  ";"   + [F:XINFITH]VCRNUM+"-O"
    XLINE +=  ";"   + [F:XINFITH]FCYFROM
    XLINE + = ";"   + num$([F:XINFITH]IPTDAT)
    XLINE +=  ";"   + [F:XINFITH]VCRDES + "-" + [F:XINFITH]FCYTO

    Wrseq XLINE Using [FIC1]

    # LOADS THE CONTENT OF THE DETAILED LINES
    Filter [F:XINFITD] Where [F:XINFITD]VCRNUM = [F:XINFITH]VCRNUM
&   Order By Key XINFITD0

    For [F:XINFITD]XINFITD0
        # WRITE THE LINE DETAIL RECORD INFORMATION
        ########################################################################################################
        XLINE =   "L;"  + num$([F:XINFITD]VCRLIN)
        XLINE +=  ";"   + [F:XINFITD]ITMREF
        XLINE +=  ";"   + [F:XINFITD]UOM
        XLINE +=  ";"   + num$([F:XINFITD]QTYR)
        XLINE +=  ";"   + num$(func XINFPPRI([F:XINFITD]ITMREF, [F:XINFITH]FCYFROM, [F:XINFITH]IPTDAT))   #num$([F:XINFSMD]PRI)

        Wrseq XLINE Using [FIC1]

        # WRITE THE STOCK LINE
        ########################################################################################################
        Filter [F:XINFITS] Where [F:XINFITS]VCRNUM = [F:XINFITD]VCRNUM and
&                                [F:XINFITS]VCRLIN = [F:XINFITD]VCRLIN
&       Order By Key XINFITS0

        For [F:XINFITS]XINFITS0
            XLINE  = "S;A;"
            XLINE += [F:XINFITS]SAU
            XLINE += ";1;;;"+ [F:XINFITS]SERNUM

            Wrseq XLINE Using [FIC1]
        Next
    Next

    ## CLOSE FILE
    #################################################################################
    Openo Using [FIC1]

    # WRITING OF FILE SUCCESSFUL, IMPORT THE FILE
    #############################################################################################################
    If GOK
        # CALLS THE IMPORT PROCESS
        # Call IMPORTSIL(IMPT, FIL) From GIMPOBJ
        # @ IMPT - TEMPLATE TO BE USED
        # @ FIL  - FILE + LOCATION
        ###############################################################
        Raz [M:IMP2]

        [M:IMP2]MODIMP = "XINFPITO"
        [M:IMP2]NOMIMP = filpath("INFOPOS",[F:XINFITH]VCRNUM+"-O",'TXT')
        [M:IMP2]TYPEXP = 2

        Call IMPORTSIL([M:IMP2]MODIMP,[M:IMP2]NOMIMP) From GIMPOBJ

        Look [F:XSMHA]SMH0 = 20;[F:XINFITH]VCRNUM+"-O"

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("ERROR ON THE TRANSFER OUT CREATION",1) From GESECRAN
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("SUCCESS ON THE TRANSFER OUT CREATION",0) From GESECRAN

            # TODO - UPDATE OF MESSAGE
            # DETERMINE IF TRANSFER IN EXISTS
            Filter [F:XSMHA]
            Look [F:XSMHA]SMH0 = 19;[F:XINFITH]VCRNUM+"-I"

            If fstat
                # CALL THE CREATION OF THE TRANSFER INTO GIT
                Call TRANS_CREI From XINFP_GTI
            Else
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("TRANSFER IN EXISTS",0) From GESECRAN
                Call ECR_TRACE("TRANSFER COMPLETED",0) From GESECRAN

                # UPDATE THE TRANSACTION AS INTEGRATED
                Call UPDATETRANS([F:XINFITH]VCRNUM) From XINFP_GTI
            Endif
        Endif
    Endif

    # DELETE OF CREATED FILE
    #############################################################################################################
    Local Integer STAT

    Call EFFACE(filpath("INFOPOS",[F:XINFITH]VCRNUM+"-O",'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFITH]VCRNUM+"-O" + ".TXT",'ERR'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFITH]VCRNUM+"-O",'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFITH]VCRNUM+"-O" + ".TXT",'ERR'),STAT) From ORDSYS
End

# CREATION OF TRANSFER IN
##################################################################################################
Subprog TRANS_CREI
    Local Char    XLINE(255), XMESSAGE(255)
    Local Integer XLIN

    GOK = 1

    ## CREATE TRANSFER IN FILE FOR IMPORT
    #################################################################################
    adxifs = ';' : adxirs = chr$(13)+chr$(10)

    ## OPEN FILE
    #################################################################################
    Openo filpath("INFOPOS",[F:XINFITH]VCRNUM+"-I",'TXT') Using [FIC1]

    XLINE =   "E;19"
    XLINE +=  ";"   + [F:XINFITH]VCRNUM+"-I"
    XLINE +=  ";"   + [F:XINFITH]FCYTO
    XLINE + = ";"   + num$([F:XINFITH]IPTDAT)
    XLINE +=  ";"   + [F:XINFITH]VCRDES + "-" + [F:XINFITH]FCYFROM

    Wrseq XLINE Using [FIC1]

    # LOADS THE CONTENT OF THE DETAILED LINES
    Filter [F:XINFITD] Where [F:XINFITD]VCRNUM = [F:XINFITH]VCRNUM
&   Order By Key XINFITD0

    For [F:XINFITD]XINFITD0
        # WRITE THE LINE DETAIL RECORD INFORMATION
        ########################################################################################################
        XLINE =   "L;"  + num$([F:XINFITD]VCRLIN)
        XLINE +=  ";"   + [F:XINFITD]ITMREF
        XLINE +=  ";"   + [F:XINFITD]UOM
        XLINE +=  ";"   + num$([F:XINFITD]QTYR)
        XLINE +=  ";"   + num$(func XINFPPRI([F:XINFITD]ITMREF, [F:XINFITH]FCYTO, [F:XINFITH]IPTDAT))   #num$([F:XINFSMD]PRI)

        Wrseq XLINE Using [FIC1]

        # WRITE THE STOCK LINE
        ########################################################################################################
        Filter [F:XINFITS] Where [F:XINFITS]VCRNUM = [F:XINFITD]VCRNUM and
&                                [F:XINFITS]VCRLIN = [F:XINFITD]VCRLIN
&       Order By Key XINFITS0

        For [F:XINFITS]XINFITS0
            XLINE  = "S;A;"
            XLINE += [F:XINFITS]SAU
            XLINE += ";1;;;"+ [F:XINFITS]SERNUM

            Wrseq XLINE Using [FIC1]
        Next

        If [F:XINFITD]QTYD <> 0
            # WRITE THE LINE DETAIL RECORD INFORMATION
            ########################################################################################################
            XLINE =   "L;"  + num$([F:XINFITD]VCRLIN)
            XLINE +=  ";"   + [F:XINFITD]ITMREF
            XLINE +=  ";"   + [F:XINFITD]UOM
            XLINE +=  ";"   + num$([F:XINFITD]QTYD)
            XLINE +=  ";"   + num$(func XINFPPRI([F:XINFITD]ITMREF, [F:XINFITH]FCYTO, [F:XINFITH]IPTDAT))   #num$([F:XINFSMD]PRI)

            Wrseq XLINE Using [FIC1]

            # WRITE THE STOCK LINE
            ########################################################################################################
            Filter [F:XINFITS] Where [F:XINFITH]VCRNUM = [F:XINFITD]VCRNUM and
&                                    [F:XINFITH]VCRLIN = [F:XINFITD]VCRLIN
&           Order By Key XINFITS0

            For [F:XINFITS]XINFITS0
                XLINE  = "S;R;"
                XLINE += [F:XINFITS]SAU
                XLINE += ";1;;;"+ [F:XINFITS]SERNUM

                Wrseq XLINE Using [FIC1]
            Next
        Endif
    Next

    ## CLOSE FILE
    #################################################################################
    Openo Using [FIC1]

    # WRITING OF FILE SUCCESSFUL, IMPORT THE FILE
    #############################################################################################################
    If GOK
        # CALLS THE IMPORT PROCESS
        # Call IMPORTSIL(IMPT, FIL) From GIMPOBJ
        # @ IMPT - TEMPLATE TO BE USED
        # @ FIL  - FILE + LOCATION
        ###############################################################
        Raz [M:IMP2]

        [M:IMP2]MODIMP = "XINFPITR"
        [M:IMP2]NOMIMP = filpath("INFOPOS",[F:XINFITH]VCRNUM+"-I",'TXT')
        [M:IMP2]TYPEXP = 2

        Call IMPORTSIL([M:IMP2]MODIMP,[M:IMP2]NOMIMP) From GIMPOBJ

        Filter [F:XSMHA]
        Look [F:XSMHA]SMH0 = 19;[F:XINFITH]VCRNUM+"-I"

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("ERROR ON THE TRANSFER IN CREATION",1) From GESECRAN
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("SUCCESS ON THE TRANSFER IN CREATION",0) From GESECRAN

            # UPDATE THE TRANSACTION AS INTEGRATED
            Call UPDATETRANS([F:XINFITH]VCRNUM) From XINFP_GTI
        Endif
    Endif

    # DELETE OF CREATED FILE
    #############################################################################################################
    Local Integer STAT

    Call EFFACE(filpath("INFOPOS",[F:XINFITH]VCRNUM+"-I",'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFITH]VCRNUM+"-I" + ".TXT",'ERR'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFITH]VCRNUM+"-I",'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFITH]VCRNUM+"-I" + ".TXT",'ERR'),STAT) From ORDSYS
End

########################################################################################################################
# SUBPROG THAT FIND THE PRICE BASED ON ITEM COSTING METHOD
#
########################################################################################################################
Funprog XINFPPRI(XINFPITM,XINFPFCY,XINFPDAT)
    Value Char XINFPITM
    Value Char XINFPFCY
    Value Date XINFPDAT

    Local Decimal XINFPPRI
    Local Integer WCSTCOD,WSTAT

    If !clalev([F:ITC]) : Local File ITMCOST    [F:ITC] : Endif
    If !clalev([F:ITM]) : Local File ITMMASTER  [F:ITM] : Endif
    If !clalev([F:ITV]) : Local File ITMMVT     [F:ITV] : Endif
    If !clalev([F:ITF]) : Local File ITMFACILIT [F:ITF] : Endif
    If !clalev([F:TCM]) : Local File TABCOSTMET [F:TCM] : Endif

    Read [ITM]ITM0 = XINFPITM
    Read [ITF]ITF0 = XINFPITM;XINFPFCY

    Call GETTCM([F:ITF]ITMREF,[F:ITF]STOFCY,GBIDC1,GBIDI1) From STKVAL

    WCSTCOD = [F:TCM]ISSVLTCOD

    Call GETPRI([F:ITF]ITMREF,[F:ITF]STOFCY,XINFPDAT,1,"","",WCSTCOD,XINFPPRI,WSTAT) #From STKVAL

    If clalev([F:ITC]) : Close Local File [F:ITC] : Endif
    If clalev([F:ITM]) : Close Local File [F:ITM] : Endif
    If clalev([F:ITV]) : Close Local File [F:ITV] : Endif
    If clalev([F:ITF]) : Close Local File [F:ITF] : Endif
    If clalev([F:TCM]) : Close Local File [F:TCM] : Endif


End ar2(XINFPPRI)

Subprog GETPRI(LITM,LFCY,LDAT,LQTY,LLOT,LSLO,LVLT,LPRI,LRET)
Value    Char    LITM
Value    Char    LFCY
Value    Date    LDAT
Value    Decimal LQTY
Value    Char    LLOT
Value    Char    LSLO
Value    Integer LVLT
Variable Decimal LPRI
Variable Integer LRET

Raz LRET

Local Integer WMET : WMET = LVLT
If clalev ([M:SDP])
    Raz [M:SDP]
Else
    Local Mask SAIDECPRI [SDP]    # Au moins nécessaire dans le cas de l'état valorisé au coût standard
Endif
    Case [L]WMET
        When 1 : Gosub TRT_DEF1 From STKVAL    # Standard
        When 2 : Gosub TRT_DEF2 From STKVAL    # Standard actualisé
        When 3 : Gosub TRT_DEF3 From STKVAL    # Dernier prix
        When 4 : Gosub TRT_DEF4 From STKVAL    # PMP
        When 5 : Gosub TRT_DEF5 From STKVAL    # FIFO
        When 6 : Gosub TRT_DEF6 From STKVAL    # PM Lot
        When 7 : LPRI=LORDPRI                  # Prix ordre
        When 8 : Gosub TRT_DEF8 From STKVAL    # LIFO
        When 9 : Gosub TRT_DEF9 From STKVAL    # Dernier prix d'achat
        When 10: Gosub TRT_DEF10 From STKVAL    # Standard budget
        When 11: Gosub TRT_DEF11 From STKVAL    # Standard simulé

    Endcase
End













