###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES TRANSFER IN, CREATES PTH
########################################################################################################################
Subprog IBR_TRANS()
    If !clalev([F:XINFITH]) : Local File XINFITH   [F:XINFITH] : Endif
    If !clalev([F:XINFITD]) : Local File XINFITD   [F:XINFITD] : Endif
    If !clalev([F:XINFITS]) : Local File XINFITS   [F:XINFITS] : Endif
    If !clalev([F:XSTJA])   : Local File STOJOU    [F:XSTJA]   : Endif
    If !clalev([F:XPTHA])   : Local File PRECEIPT  [F:XPTHA]   : Endif
    If !clalev([F:XPOHA])   : Local File PORDER    [F:XPOHA]   : Endif
    If !clalev([F:XPOQA])   : Local File PORDERQ   [F:XPOQA]   : Endif
    If !clalev([F:XSDHA])   : Local File SDELIVERY [F:XSDHA]   : Endif
    If !clalev([M:IMP2])    : Local Mask IMPOBJ2   [M:IMP2]    : Endif

    # TODO - UPDATE OF MESSAGE
    Call ECR_TRACE("GENERATION OF TRANSFERS IN",0) From GESECRAN
    Call ECR_TRACE("--------------------X-------------------",0) From GESECRAN
#GT-AOV 17/01/2020 added filter XFLAG
##Filter [F:XINFITH] Where [F:XINFITH]VCRNUM='STR230008498'
    Filter [F:XINFITH] Where [F:XINFITH]VCRTYP = 2  and [F:XINFITH]FLOWTYP = 2 and [F:XINFITH]POSTED <> 2 and [F:XINFITH]XFLAG = 0
&   Order By Key XINFITH0

    For [F:XINFITH]XINFITH0
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("TRANSFER :" - [F:XINFITH]VCRNUM ,0) From GESECRAN

        # TODO - UPDATE OF MESSAGE
        # DETERMINE IF TRANSFER REQUEST PTH EXISTS
        Look [F:XPTHA]PTH0 = [F:XINFITH]VCRNUM

        If fstat
            # TODO - UPDATE OF MESSAGE
            # DETERMINE IF TRANSFER OUT REQUEST PO EXISTS
            Filter [F:XPOHA]
            Filter [F:XPOHA] Where [F:XPOHA]ORDREF = [F:XINFITH]VCRDES Order By Key POH0
            Read [F:XPOHA]POH0 First

            If fstat
                # TODO - UPDATE OF MESSAGE
                Call XERR_TRANS("IBT", [F:XINFITH]VCRNUM, [F:XINFITH]EXPNUM, 1, 0, [F:XINFITH]VCRDES - ": INITIAL TRANSFER REQUEST DOES NOT EXIT - PLEASE REFER TO X3 LOG") From XINFP_ERR

            Else
                # TODO - UPDATE OF MESSAGE
                # THIS WAS MODIFIED TO USE THE AUTO SO NUMBER GENERATED WHEN THE PO WAS GENERATED
                Filter [F:XSDHA]
                Filter [F:XSDHA] Where [F:XSDHA]SDHNUM = [F:XINFITH]VCRDES and [F:XSDHA]CFMFLG = 2 Order By Key SDH0
                Read [F:XSDHA]SDH0 First

                If !fstat
                    Call TRANS_CRE From XINFP_IBR
                Else
                    # TODO - UPDATE OF MESSAGE
                    Call XERR_TRANS("IBT", [F:XINFITH]VCRNUM, [F:XINFITH]EXPNUM, 1, 0, [F:XINFITH]VCRDES - ": INITIAL TRANSFER REQUEST NOT COMPLETE - PLEASE REFER TO X3 LOG") From XINFP_ERR

                Endif
            Endif
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("SUCCESS ON THE PURCHASE RECEIPT CREATION",0) From GESECRAN
            Call UPDATETRANS([F:XINFITH]VCRNUM) From XINFP_IBR
        Endif

        # IMPORT VARIABLE DISABLE - USED FOR LOGGING PURPOSES
        GIMPORT = 0
    Next

    If clalev([F:XINFITH]) : Close Local File  [F:XINFITH] : Endif
    If clalev([F:XINFITD]) : Close Local File  [F:XINFITD] : Endif
    If clalev([F:XINFITS]) : Close Local File  [F:XINFITS] : Endif
    If clalev([F:XSTJA])   : Close Local File  [F:XSTJA]   : Endif
    If clalev([F:XPTHA])   : Close Local File  [F:XPTHA]   : Endif
    If clalev([F:XPOHA])   : Close Local File  [F:XPOHA]   : Endif
    If clalev([F:XPOQA])   : Close Local File  [F:XPOQA]   : Endif
    If clalev([F:XSDHA])   : Close Local File  [F:XSDHA]   : Endif
    If clalev([M:IMP2])    : Close Local Mask  [M:IMP2]    : Endif
End

###########################################################################################
# UPDATE THE TRANSACTION AS COMPLETED
###########################################################################################
Subprog UPDATETRANS(XINFPNUM)
    Value Char XINFPNUM
    If !clalev([F:XUP]) : Local File XINFITH [F:XUP] : Endif

    Call XERR_TRANS("IBT", XINFPNUM, [F:XINFITH]EXPNUM, 2, 0, "SUCCESSFUL") From XINFP_ERR

    Trbegin [F:XUP]
        Update [F:XUP] Where [F:XUP]VCRNUM = XINFPNUM With [F:XUP]POSTED = 2

        If fstat
            Rollback
        Else
            Commit
        Endif

    If clalev([F:XUP]) : Close Local File   [F:XUP] : Endif
End

# CREATION OF PURCHASE RECEIPTS
##################################################################################################
Subprog TRANS_CRE
    Local Char    XLINE(255), XMESSAGE(255)

    GOK = 1

    # DELETE OF CREATED FILE
    #############################################################################################################
    Local Integer STAT

    Call EFFACE(filpath("tmp",[F:XINFITH]VCRNUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFITH]VCRNUM,'TXT')+".err",STAT) From ORDSYS

    ## CREATE PURCHASE RECEIPTS FILE FOR IMPORT
    #################################################################################
    adxifs = ';' : adxirs = chr$(13)+chr$(10)

    ## OPEN FILE
    #################################################################################
    Openo filpath("INFOPOS",[F:XINFITH]VCRNUM,'TXT') Using [FIC1]

    XLINE =   "E;"  + [F:XINFITH]FCYTO
    XLINE +=  ";"   + num$(format$("D:DDMMYYYY",[F:XINFITH]IPTDAT))
    XLINE +=  ";"   + [F:XINFITH]VCRNUM
    XLINE + = ";"   + [F:XINFITH]FCYFROM
    XLINE +=  ";"   + [F:XINFITH]VCRDES
##call ECR_TRACE(XLINE,0) from GESECRAN
    Wrseq XLINE Using [FIC1]

    # LOADS THE CONTENT OF THE DETAILED PURCHASE ORDER LINES
    Filter [F:XINFITD] Where [F:XINFITD]VCRNUM = [F:XINFITH]VCRNUM
&   Order By Key XINFITD0

    For [F:XINFITD]XINFITD0
        Filter [F:XPOQA] Where [F:XPOQA]POHNUM = [F:XPOHA]POHNUM   and
&                              [F:XPOQA]ITMREF = [F:XINFITD]ITMREF
&       Order By Key POQ0

        Read [F:XPOQA]POQ0 First

        # WRITE THE LINE DETAIL RECORD INFORMATION
        ########################################################################################################
        XLINE =   "L;"  + [F:XPOQA]POHNUM
        XLINE +=  ";"   + num$([F:XPOQA]POPLIN)
        XLINE +=  ";"   + [F:XPOQA]ITMREF
        XLINE +=  ";"   + num$([F:XINFITD]QTYR + [F:XINFITD]QTYD)
        XLINE +=  ";"
##call ECR_TRACE(XLINE,0) from GESECRAN
        Wrseq XLINE Using [FIC1]

        # THIS WAS THE CODE BEFORE HAND FOR THE INSERTION OF THE STOCK ALLOCATION LINE INFORMATION
        # THIS HAS NOW BEEN UPDATED
        #        # WRITE THE STOCK LINE - ACCEPTED STOCK
        #        ########################################################################################################
        #        XLINE  = "S;A;"
        #        XLINE += [F:XPOQA]UOM
        #        XLINE += ";" + num$([F:XINFITD]QTYR) +";;;"
        #
        #        Wrseq XLINE Using [FIC1]
        #
        #        # WRITE THE STOCK LINE - DAMAGED STOCK
        #        ########################################################################################################
        #        If [F:XINFITD]QTYD <> 0
        #              XLINE  = "S;R;"
        #              XLINE += [F:XPOQA]UOM
        #              XLINE += ";" + num$([F:XINFITD]QTYD) +";;;"
        #
        #              Wrseq XLINE Using [FIC1]
        #        Endif

        # LOAD THE ALLOCATED DETAIL RECORD FROM THE SHIPMENT THAT WAS CREATED
        #######################################################################################################
        Filter [F:XSTJA] Where [F:XSTJA]VCRNUMORI = [F:XINFITH]VCRDES and [F:XSTJA]VCRTYP = 4 and [F:XSTJA]TRSTYP = 4  and [F:XSTJA]VCRLINORI = [F:XPOQA]POPLIN
&       Order By [F:XSTJA]MVTSEQ Asc

        For [F:XSTJA]
            XLINE  = "S;A;"
            XLINE += [F:XSTJA]PCU

            XLINE += ";" + num$(abs([F:XSTJA]QTYPCU)) +";;;"
##call ECR_TRACE(XLINE,0) from GESECRAN
            Wrseq XLINE Using [FIC1]
        Next


#        # WRITE THE STOCK LINE - TO BE COMPLETED WHEN SERIAL NUMBER IS INTRODUCED
#        ########################################################################################################
#        Filter [F:XINFITS] Where [F:XINFITS]VCRNUM   = [F:XINFITD]VCRNUM and
#&                                [F:XINFITS]VCRLIN   = [F:XINFITD]VCRLIN
#&       Order By Key XINFITS0
#
#        For [F:XINFITS]XINFITS0
#            XLINE  = "S;A;"
#            XLINE += [F:XINFITS]SAU
#            XLINE += ";1;;;"+ [F:XINFITS]SERNUM
#
#            Wrseq XLINE Using [FIC1]
#        Next

        $SKIPT
    Next

    ## CLOSE FILE
    #################################################################################
    Openo Using [FIC1]

    # WRITING OF FILE SUCCESSFUL, IMPORT THE FILE
    #############################################################################################################
    If GOK
        # CALLS THE IMPORT PROCESS
        # Call IMPORTSIL(IMPT, FIL) From GIMPOBJ
        # @ IMPT - TEMPLATE TO BE USED
        # @ FIL  - FILE + LOCATION
        ###############################################################
        Raz [M:IMP2]

        [M:IMP2]MODIMP = "XINFPPTH"
        [M:IMP2]NOMIMP = filpath("INFOPOS",[F:XINFITH]VCRNUM,'TXT')
        [M:IMP2]TYPEXP = 2

        Call IMPORTSIL([M:IMP2]MODIMP,[M:IMP2]NOMIMP) From GIMPOBJ

        Look [F:XPTHA]PTH0 = [F:XINFITH]VCRNUM

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call XERR_TRANS("IBT", [F:XINFITH]VCRNUM, [F:XINFITH]EXPNUM, 1, 0, "ERROR ON THE PURCHASE RECEIPT CREATION - PLEASE REFER TO X3 LOG") From XINFP_ERR
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("SUCCESS ON THE PURCHASE RECEIPT CREATION",0) From GESECRAN
            Call UPDATETRANS([F:XINFITH]VCRNUM) From XINFP_IBR
        Endif
    Endif

    # DELETE OF CREATED FILE
    #############################################################################################################
    Call EFFACE(filpath("INFOPOS",[F:XINFITH]VCRNUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFITH]VCRNUM,'TXT')+".err",STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFITH]VCRNUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFITH]VCRNUM,'TXT')+".err",STAT) From ORDSYS
End































