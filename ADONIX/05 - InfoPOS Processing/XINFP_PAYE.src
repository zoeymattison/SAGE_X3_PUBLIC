#                   : @nn@ – DD/MM/YYYY , XXXXX , NMA
###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES PAYMENT
########################################################################################################################
Subprog PAYE_TRANS()
    If !clalev([F:XINFPYH]) : Local File XINFPYH    [F:XINFPYH] : Endif
    If !clalev([F:XINFPYD]) : Local File XINFPYD    [F:XINFPYD] : Endif
    If !clalev([F:XPYHA])   : Local File PAYMENTH   [F:XPYHA]   : Endif
    If !clalev([F:XSIHA])   : Local File SINVOICE   [F:XSIHA]   : Endif
    If !clalev([F:XTYPA])   : Local File TABPAYTYP  [F:XTYPA]   : Endif
    If !clalev([F:XINFHAA]) : Local File GACCENTRYA [F:XINFHAA] : Endif
    If !clalev([F:XINFFCY]) : Local File FACILITY   [F:XINFFCY] : Endif
    If !clalev([F:XINFDUD]) : Local File GACCDUDATE [F:XINFDUD] : Endif

    #Sleep 25

    Columns [F:XINFFCY] (FCY, FINFLG, FINRSPFCY)

    # TODO - UPDATE OF MESSAGE
    Call ECR_TRACE("GENERATION OF PAYMENT REFUNDS",0) From GESECRAN
    Call ECR_TRACE("---------------------------- ",0) From GESECRAN

    Filter [F:XINFPYH] Where [F:XINFPYH]SNS = 1 and [F:XINFPYH]PAYFLG <> 2
&   Order By Key XINFPYH0

    For [F:XINFPYH]XINFPYH0
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("PAYMENT REFUND :" - [F:XINFPYH]NUM,0) From GESECRAN

        # @RH@ - 08/01/2018 - CLEAR ALL ERRORS ASSOCIATED WITH THE CURRENT RECORD
        ##############################################################################################################
        Call DELETE_ERRORS([F:XINFPYH]NUM) From XINFP_ERR

        # TODO - UPDATE OF MESSAGE
        # DETERMINE IF PAYMENT REFUND EXISTS
        Filter [F:XPYHA]

        Filter [F:XPYHA] Where [F:XPYHA]REF = [F:XINFPYH]NUM Order By Key PYH0
        Look [F:XPYHA]PYH0 First

        If fstat
            # CALL THE CREATION OF THE PAYMENT REFUND
            Call TRANS_CRE From XINFP_PAYE

            GIMPORT = 0
        Else
            Filter [F:XPYHA] Where [F:XPYHA]REF = [F:XINFPYH]NUM and [F:XPYHA]STA = 9 Order By Key PYH0
            Look [F:XPYHA]PYH0 First

            If fstat
                Call POST([F:XINFPYH]NUM) From XINFP_PAYE
            Else
                Call UPDATETRANS([F:XINFPYH]NUM) From XINFP_PAYE

                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("PAYMENT EXISTS AND IS POSTED",0) From GESECRAN
            Endif
        Endif

        Columns [F:XPYHA]

        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("*****************************",0) From GESECRAN
    Next

    If clalev([F:XINFPYH]) : Close Local File [F:XINFPYH] : Endif
    If clalev([F:XINFPYD]) : Close Local File [F:XINFPYD] : Endif
    If clalev([F:XPYHA])   : Close Local File [F:XPYHA]   : Endif
    If clalev([F:XINFFCY]) : Close Local File [F:XINFFCY] : Endif
    If clalev([F:XSIHA])   : Close Local File [F:XSIHA]   : Endif
    If clalev([F:XINFHAA]) : Close Local File [F:XINFHAA] : Endif
    If clalev([F:XINFDUD]) : Close Local File [F:XINFDUD] : Endif
End

###########################################################################################
# UPDATE THE TRANSACTION AS COMPLETED
###########################################################################################
Subprog UPDATETRANS(XINFPNUM)
    Value Char XINFPNUM

    Call XERR_TRANS("PAY", XINFPNUM, [F:XINFPYH]EXPNUM, 2, 0, "SUCCESSFUL") From XINFP_ERR

    If !clalev([F:XUP]) : Local File XINFPYH [F:XUP] : Endif

    Trbegin [F:XUP]
        Update [F:XUP] Where [F:XUP]NUM = XINFPNUM With [F:XUP]PAYFLG = 2

        If fstat
            Rollback
        Else
            Commit
        Endif

    If clalev([F:XUP]) : Close Local File   [F:XUP] : Endif
End

# CREATION OF PAYMENT REFUND
##################################################################################################
Subprog TRANS_CRE
    Local Char    XLINE(255), XMESSAGE(255)

    # DELETE OF CREATED FILE
    #############################################################################################################
    Local Integer STAT

    # DELETE OF CREATED FILE
    #############################################################################################################
    Call EFFACE(filpath("INFOPOS",[F:XINFPYH]NUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFPYH]NUM,'TXT')+".ERR",STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFPYH]NUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFPYH]NUM,'TXT')+".ERR",STAT) From ORDSYS

    GOK = 1

    ## CREATE FILE FOR IMPORT
    #################################################################################
    adxifs = ';' : adxirs = chr$(13)+chr$(10)

    If [F:XINFFCY]FCY <> [F:XINFPYH]BANFCY
        Read [F:XINFFCY]FCY0 = [F:XINFPYH]BANFCY
    Endif

    If [F:XTYPA]PAYTYP <>  [F:XINFPYH]PAYTYP
        Read [F:XTYPA]TPY0 = [F:XINFPYH]PAYTYP;[F:XINFFCY]LEG

        If fstat
            Read [F:XTYPA]TPY0 = [F:XINFPYH]PAYTYP
        Endif
    Endif

    ## OPEN FILE
    #################################################################################
    Openo filpath("INFOPOS",[F:XINFPYH]NUM,'TXT') Using [FIC1]

    XLINE  = "P;" + [F:XINFPYH]NUM
    XLINE += ";"  + [F:XINFPYH]PAYTYP
    XLINE += ";"  + [F:XINFPYH]BPR
    XLINE += ";"  #+ [F:XINFPYH]COA
    XLINE += ";"  #+ [F:XINFPYH]ACC
    XLINE += ";"  + [F:XINFPYH]PAM
    XLINE += ";"  + [F:XINFFCY]FINRSPFCY
    XLINE += ";"  + [F:XINFPYH]BAN
    XLINE += ";"  + num$([F:XTYPA]SNS)
    XLINE += ";"  + [F:XINFPYH]CUR
    XLINE += ";"  + num$([F:XINFPYH]AMTCUR)
    XLINE += ";"  + format$("D:DDMMYYYY",[F:XINFPYH]ACCDAT)
    XLINE += ";"  + [F:XINFPYH]DES
    XLINE += ";"  + [F:XINFPYH]NUM #[F:XINFPYH]REF
     CALL ECR_TRACE(XLINE,0) FROM GESECRAN
    Wrseq XLINE Using [FIC1]

    #Columns [F:XSIHA] (NUM, ACCNUM)
    #Columns [F:XINFHAA] (ACCNUM, DIE, CCE)

    # LOADS THE CONTENT OF THE DETAILED INVOICE LINES
    Filter [F:XINFPYD] Where [F:XINFPYD]NUM = [F:XINFPYH]NUM
&   Order By Key XINFPYD0

    For [F:XINFPYD]XINFPYD0
        # DETERMINE IF THE CREDIT NOTE EXISTS IN X3 BEFORE GENERATING PAYMENT
        If [F:XINFPYD]VCRNUM <> ''
            Filter [F:XSIHA] Where [F:XSIHA]NUM = [F:XINFPYD]VCRNUM and [F:XSIHA]STA = 3 Order By Key SIH0
            Look [F:XSIHA]SIH0 First

            If fstat :
                Filter [F:XINFDUD] Where [F:XINFDUD]NUM = [F:XINFPYD]VCRNUM Order By Key DUD0
                Look [F:XINFDUD]DUD0 First

                If fstat
                    # TODO - UPDATE OF MESSAGE
                    Call ECR_TRACE([F:XINFPYD]VCRNUM - "MATCHING INVOICE DOESNT EXIST IN X3",1) From GESECRAN
                    GOK = 0
                    Break
                Endif
            Endif
        Endif

        # WRITE THE LINE DETAIL RECORD INFORMATION
        ########################################################################################################
        XLINE  = "D"
        XLINE += ";"#+ [F:XINFPYD]DENCOD
        XLINE += ";"#+ [F:XINFPYD]COA
        XLINE += ";"#+ [F:XINFPYD]ACC
        XLINE += ";"+ [F:XINFPYH]BPR
        XLINE += ";"+ [F:XINFPYD]VCRTYP
        XLINE += ";"+ [F:XINFPYD]VCRNUM
        XLINE += ";"+ [F:XINFPYH]CUR
        XLINE += ";"+ num$([F:XINFPYD]AMTLIN)
CALL ECR_TRACE(XLINE,0) FROM GESECRAN
        Wrseq XLINE Using [FIC1]

        # WRITE THE LINE ANALITICAL RECORD INFORMATION
        ########################################################################################################
#        Read [F:XSIHA]SIH0 Curr
#
#        Filter [F:XINFHAA]
#        Filter [F:XINFHAA] Where ACCNUM = [F:XSIHA]ACCNUM Order By Key DAA0
#        Read [F:XINFHAA]DAA0 First
#
#        XLINE  = "A"
#
#        For XINFI = 0 To dim([F:XINFHAA]DIE) -1
#            XLINE += ";" + [F:XINFHAA]DIE(XINFI)  + ";" + [F:XINFHAA]CCE(XINFI)
#        Next
#
#        For XINFI = dim([F:XINFHAA]DIE) To 19
#            XLINE += ";" + [F:XINFHAA]DIE(XINFI)  + ";" + [F:XINFHAA]CCE(XINFI)
#        Next
#
#        XLINE += ";" + num$([F:XINFPYD]AMTLIN) + ";0"
#        Wrseq XLINE Using [FIC1]

         If  [F:XINFFCY]LEGCPY = "GAP"
            XLINE = "A;SIT;" + [F:XINFPYH]BANFCY + ";ORD;;EMP;;DEP;;REG;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;" + num$([F:XINFPYD]AMTLIN) + ";0"
CALL ECR_TRACE(XLINE,0) FROM GESECRAN
            Wrseq XLINE Using [FIC1]
         Endif

        $SKIPT
    Next

    ## CLOSE FILE
    #################################################################################
    Openo Using [FIC1]

    # WRITING OF FILE SUCCESSFUL, IMPORT THE FILE
    #############################################################################################################
    If GOK
        # CALLS THE IMPORT PROCESS
        # Call IMPORTSIL(IMPT, FIL) From GIMPOBJ
        # @ IMPT - TEMPLATE TO BE USED
        # @ FIL  - FILE + LOCATION
        ###############################################################
        If !clalev([M:IMP2]) : Local Mask IMPOBJ2[IMP2] : Endif
        Raz [M:IMP2]

        [M:IMP2]MODIMP = "XINFPPAY"
        [M:IMP2]NOMIMP = filpath("INFOPOS",[F:XINFPYH]NUM,'TXT')
        [M:IMP2]TYPEXP = 2

        Call IMPORTSIL([M:IMP2]MODIMP,[M:IMP2]NOMIMP) From GIMPOBJ

        # TODO - VERIFY THAT PAYMENT HAS BEEN INTEGRATED
        Filter [F:XPYHA] Where [F:XPYHA]REF = [F:XINFPYH]NUM Order By Key PYH0
        Look [F:XPYHA]PYH0 First

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call XERR_TRANS("PAY", [F:XINFPYH]NUM, [F:XINFPYH]EXPNUM, 1, 0, "ERROR ON THE PAYMENT CREATION - PLEASE REFER TO X3 LOG "+[F:XINFPYD]VCRNUM) From XINFP_ERR
        Else
            # VALIDATE PAYMENT
            GIMPORT = 0
            Call POST([F:XINFPYH]NUM) From XINFP_PAYE

        Endif
    Endif

    # DELETE OF CREATED FILE
    #############################################################################################################
    Call EFFACE(filpath("INFOPOS",[F:XINFPYH]NUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFPYH]NUM,'TXT')+".ERR",STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFPYH]NUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFPYH]NUM,'TXT')+".ERR",STAT) From ORDSYS
End

# PAYMENT POSTING PROCEDURE
##################################################################################################
Subprog POST (XINFPNUM)
    Value     Char    XINFPNUM

    If !clalev([F:TPY]) : Local File TABPAYTYP [TPY] : Endif
    If !clalev([F:PYH]) : Local File PAYMENTH   [PYH] : Endif
    If !clalev([F:PYD]) : Local File PAYMENTD   [PYD] : Endif
    If !clalev([F:PYA]) : Local File PAYMENTA   [PYA] : Endif
    If !clalev([F:PYL]) : Local File PAYLOT     [PYL] : Endif
    If !clalev([F:DUD]) : Local File GACCDUDATE [DUD] : Endif
    If !clalev([F:BID]) : Local File BID        [BID] : Endif
    If !clalev([F:TCU]) : Local File TABCUR     [TCU] : Endif
    If !clalev([F:BPC]) : Local File BPCUSTOMER [BPC] : Endif
    If !clalev([F:BPS]) : Local File BPSUPPLIER [BPS] : Endif
    If !clalev([F:CAC]) : Local File GACCCODE   [CAC] : Endif
    If !clalev([F:GAC]) : Local File GACCOUNT   [GAC] : Endif
    If !clalev([F:HAE]) : Local File GACCENTRY  [HAE] : Endif
    If !clalev([F:DAE]) : Local File GACCENTRYD [DAE] : Endif
    If !clalev([F:BPA]) : Local File BPADDRESS  [BPA] : Endif

    Local Integer OK, STAT, OKTCA, SIGN, I, ADDGAC
    Local Char    CODCPT(GLONCAC)
    Local Char    DEVISE(GLONCUR)
    Local Char    DEVLED(GLONCUR) : # Devise du référentiel principal général (celui qui gère les échéances)
    Local Char    OLDCCE(GLONCCE)(dim([F:PYA]CCE)-1)
    Local Char    COMPTE(GLONGAC)
    Local Char    PLAN(GLONCOA)
    Local Char    BAN(GLONBAN)
    Local Decimal PYHAMTLOC, PYHAMTCUR, ARD
    Local Char    IDT_LIN(5)
    I=max(1,nbrecord([F:TPY]))
    Local Char    LOTID(5)(I), LOTCOD(20)(I)
    Local Integer LOTX(I), NBLOT
    Local Decimal EXERCICE, PERIODE

    Global Integer GNBPLAN                               : # Nb de plans comptables (max 10)
    Global Integer GNBAXE                                : # Nb d'axes à saisir (max 20)
    Global Char    GPLAN(GLONCOA)(1..10)                 : # Plans (COA)
    Global Char    GAXE(GLONDIE)(1..max(GOPTCANA,20))    : # Axes (DIE)
    Global Integer GOBLIG(1..max(GOPTCANA,20))           : # Obligatoire (O/N)
    Global Integer GTYPLED(1..10)                        : # Types référentiels

    If dim(GTYPGEN)<0
        Global Integer GTYPGEN
        Global Integer GTYPANA
    Endif

    Filter [F:PYH] Where [F:PYH]REF = XINFPNUM and [F:PYH]STA = 1  Order By Key PYH0
    Read [F:PYH]PYH0 First

    # TODO - IF MATCHING PAYMENT DOESNT EXIST, THEN DO NOTHING
    If fstat
        # TODO - UPDATE OF MESSAGE
        Call XERR_TRANS("PAY", [F:XINFPYH]NUM, [F:XINFPYH]EXPNUM, 1, 0, "MATCHING PAYMENT DOESNT EXIST, UNABLE TO PROCESS POSTING") From XINFP_ERR
        End
    Endif

    Call LECTURE("TPY",[F:PYH]PAYTYP,"") From CONTOBJ
    Call GETSOC([F:PYH]FCY) From DEVSUB
    Call LEC_TPY_LEG(GCURLEG,[F:PYH]PAYTYP) From CPTLEC
    Call SETPLAN([F:PYH]CPY,GNBPLAN,GPLAN,GTYPLED,GNBAXE,GAXE,GOBLIG) From CPTDIV
    Call SETCUR(1,[F:PYH]CPY,DEVLED) From CPTDIV
    Call SETMAINREF([F:PYH]CPY,GTYPGEN,GTYPANA) From CPTDIV

    Local Char VALBOUT(250) , PARBOUT(250)(1..20)
    PARBOUT(1) = "9"
    PARBOUT(2) = "3"
    PARBOUT(3) = [F:PYH]NUM
    FLGEXE = 1
    GACTION = "PAYCPT"
    Call TRAITE_CHAR(VALBOUT,PARBOUT,"","PAYCPT","DPAYCPT",3,"XYPAYCPT") From GTRAITE

    Filter [F:PYH]
    Filter [F:PYH] Where [F:PYH]REF = XINFPNUM and [F:PYH]STA = 9 Order By Key PYH0
    Look [F:PYH]PYH0 First

    If !fstat
        Call UPDATETRANS(XINFPNUM) From XINFP_PAYE
    Else
        # TODO - UPDATE OF MESSAGE
        Call XERR_TRANS("PAY", [F:XINFPYH]NUM, [F:XINFPYH]EXPNUM, 1, 0, "ERROR DURING PAYMENT POSTING - PLEASE REFER TO X3 LOG") From XINFP_ERR
    Endif

    If clalev([F:PYA])  : Close Local File [F:PYA]  : Endif
    If clalev([F:PYD])  : Close Local File [F:PYD]  : Endif
    If clalev([F:PYH])  : Close Local File [F:PYH]  : Endif
    If clalev([F:PYHA]) : Close Local File [F:PYHA] : Endif
    If clalev([F:BPR])  : Close Local File [F:BPR]  : Endif
    If clalev([F:BPA])  : Close Local File [F:BPA]  : Endif
    If clalev([F:CAC])  : Close Local File [F:CAC]  : Endif
    If clalev([F:BPR])  : Close Local File [F:BPR]  : Endif
    If clalev([F:CPY])  : Close Local File [F:CPY]  : Endif
    If clalev([F:FCY])  : Close Local File [F:FCY]  : Endif
    If clalev([F:CAC])  : Close Local File [F:CAC]  : Endif
    If clalev([F:GAC])  : Close Local File [F:GAC]  : Endif
    If clalev([F:BAN])  : Close Local File [F:BAN]  : Endif
    If clalev([F:ADI])  : Close Local File [F:ADI]  : Endif
    If clalev([F:TPY])  : Close Local File [F:TPY]  : Endif
End













