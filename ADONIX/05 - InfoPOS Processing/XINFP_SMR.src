#                   : @nn@ – DD/MM/YYYY , XXXXX , NMA
###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES INCREASE ADJUSTMENTS
########################################################################################################################
Subprog SMR_TRANS()
    If !clalev([F:XINFSMH]) : Local File XINFSMH    [F:XINFSMH] : Endif
    If !clalev([F:XINFSMD]) : Local File XINFSMD    [F:XINFSMD] : Endif
    If !clalev([F:XINFSMS]) : Local File XINFSMS    [F:XINFSMS] : Endif
    If !clalev([F:XSMHA])   : Local File SMVTH      [F:XSMHA]   : Endif
    If !clalev([F:XSTC])    : Local File STOLOC     [F:XSTC]    : Endif
    If !clalev([F:XSTO])    : Local File STOCK      [F:XSTO]    : Endif
    If !clalev([M:IMP2])    : Local Mask IMPOBJ2    [M:IMP2]    : Endif
    If !clalev([F:XSITF])   : Local File ITMFACILIT [F:XSITF]   : Endif
    If !clalev([F:XSITM])   : Local File ITMMASTER  [F:XSITM]   : Endif

    # TODO - UPDATE OF MESSAGE
    Call ECR_TRACE("GENERATION OF A INCREASE ADJUSTMENTS",0) From GESECRAN
    Call ECR_TRACE("------------------------------------",0) From GESECRAN

    Filter [F:XINFSMH] Where [F:XINFSMH]VCRTYP = 19 and [F:XINFSMH]GENFLG <> 2
&   Order By Key XINFSMH0

    For [F:XINFSMH]XINFSMH0
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("INCREASE ADJUSTMENTS :" - [F:XINFSMH]VCRNUM ,0) From GESECRAN

        # TODO - UPDATE OF MESSAGE
        # DETERMINE IF INCREASE ADJUSTMENT EXISTS
        Look [F:XSMHA]SMH0 = [F:XINFSMH]VCRTYP;[F:XINFSMH]VCRNUM

        If fstat
            # CALL THE CREATION OF THE INCREASE ADJUSTMENT
            Call TRANS_CRE From XINFP_SMR
        Else
            # UPDATE THE TRANSACTION AS INTEGRATED
            Call UPDATETRANS([F:XINFSMH]VCRNUM) From XINFP_SMR

            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("INCREASE ADJUSTMENT EXISTS",0) From GESECRAN
        Endif

        # IMPORT VARIABLE DISABLE - USED FOR LOGGING PURPOSES
        GIMPORT = 0
    Next

    If clalev([F:XINFSMH]) : Close Local File  [F:XINFSMH] : Endif
    If clalev([F:XINFSMD]) : Close Local File  [F:XINFSMD] : Endif
    If clalev([F:XINFSMD]) : Close Local File  [F:XINFSMS] : Endif
    If clalev([F:XSMHA])   : Close Local File  [F:XSMHA]   : Endif
    If clalev([F:XSTC])    : Close Local File  [F:XSTC]    : Endif
    If clalev([F:XSTO])    : Close Local File  [F:XSTO]    : Endif
    If clalev([M:IMP2])    : Close Local Mask  [M:IMP2]    : Endif
    If clalev([F:XSITF])   : Close Local File  [F:XSITF]   : Endif
    If clalev([F:XSITM])   : Close Local File  [F:XSITM]   : Endif
End

###########################################################################################
# UPDATE THE TRANSACTION AS COMPLETED
###########################################################################################
Subprog UPDATETRANS(XINFPNUM)
    Value Char XINFPNUM

    Call XERR_TRANS("ADJ", XINFPNUM, [F:XINFSMH]EXPNUM, 2, 0, "SUCCESSFUL") From XINFP_ERR

    If !clalev([F:XUP]) : Local File XINFSMH [F:XUP] : Endif

    Trbegin [F:XUP]
        Update [F:XUP] Where [F:XUP]VCRNUM = XINFPNUM With [F:XUP]GENFLG = 2

        If fstat
            Rollback
        Else
            Commit
        Endif

    If clalev([F:XUP]) : Close Local File   [F:XUP] : Endif
End

# CREATION OF INCREASE ADJUSTMENT
##################################################################################################
Subprog TRANS_CRE
    Local Char    XLINE(255), XMESSAGE(255), XDEFLOC(255)
    Local Decimal XQTY
    Local Integer XSTAT

    GOK = 1

    # DELETE OF CREATED FILE
    #############################################################################################################
    Call EFFACE(filpath("INFOPOS",[F:XINFSMH]VCRNUM,'TXT'),XSTAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFSMH]VCRNUM + ".TXT",'ERR'),XSTAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFSMH]VCRNUM,'TXT'),XSTAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFSMH]VCRNUM + ".TXT",'ERR'),XSTAT) From ORDSYS

    ## CREATE FILE FOR IMPORT
    #################################################################################
    adxifs = ';' : adxirs = chr$(13)+chr$(10)

    ## OPEN FILE
    #################################################################################
    Openo filpath("INFOPOS",[F:XINFSMH]VCRNUM,'TXT') Using [FIC1]

    XLINE =   "E;"  + num$([F:XINFSMH]VCRTYP)
    XLINE +=  ";"   + [F:XINFSMH]VCRNUM
    XLINE +=  ";"   + [F:XINFSMH]STOFCY
    XLINE + = ";"   + num$(format$("D:DDMMYYYY",[F:XINFSMH]IPTDAT))
    XLINE +=  ";"   + [F:XINFSMH]VCRDES
call ECR_TRACE(XLINE,0) from GESECRAN
    Wrseq XLINE Using [FIC1]

    # LOADS THE CONTENT OF THE DETAILED LINES
    Filter [F:XINFSMD] Where [F:XINFSMD]VCRTYP = [F:XINFSMH]VCRTYP and
&                            [F:XINFSMD]VCRNUM = [F:XINFSMH]VCRNUM
&   Order By Key XINFSMD0

    For [F:XINFSMD]XINFSMD0
        # WRITE THE LINE DETAIL RECORD INFORMATION
        ########################################################################################################
        XLINE =   "L;"  + num$([F:XINFSMD]VCRLIN)
        XLINE +=  ";"   + [F:XINFSMD]ITMREF
        XLINE +=  ";"   + [F:XINFSMD]PCU
        XLINE +=  ";"   + num$([F:XINFSMD]QTYPCU)
        XLINE +=  ";"   + num$([F:XINFSMD]PRI)
call ECR_TRACE(XLINE,0) from GESECRAN
        Wrseq XLINE Using [FIC1]

        Read [F:XSITF]ITF0 =  [F:XINFSMD]ITMREF;[F:XINFSMH]STOFCY

        # WRITE THE STOCK LINE
        ########################################################################################################
        If [F:XSITF]LOCMGTCOD = 2
            Read [F:XSITF]ITF0 =  [F:XINFSMD]ITMREF;[F:XINFSMH]STOFCY
            Read [F:XSITM]ITM0 =  [F:XINFSMD]ITMREF

            Raz [L]XQTY

            Filter [F:XINFSMS] Where [F:XINFSMS]VCRTYP = [F:XINFSMD]VCRTYP and
&                                    [F:XINFSMS]VCRNUM = [F:XINFSMD]VCRNUM and
&                                    [F:XINFSMS]VCRLIN = [F:XINFSMD]VCRLIN
&           Order By Key XINFSMS0

            For [F:XINFSMS]XINFSMS0
                XLINE  = "S;A"
                XLINE += ";" + [F:XSITM]STU

                Raz [L]XQTY

                If [F:XSITM]STU = [F:XINFSMD]PCU
                    [L]XQTY = abs([F:XINFSMD]QTYPCU)
                Elsif [F:XSITM]SAU = [F:XINFSMD]PCU
                    [L]XQTY = abs([F:XINFSMD]QTYPCU)*[F:XSITM]SAUSTUCOE
                Elsif find([F:XSITM]PCU,[F:XINFSMD]PCU)
                    [L]XQTY = abs([F:XINFSMD]QTYPCU) * [F:XSITM]PCUSTUCOE(find([F:XSITM]PCU,[F:XINFSMD]PCU)-1)
                Else
                    # TODO - UPDATE OF MESSAGE
                    Call ECR_TRACE("UNABLE TO DETERMINE THE SALES UNIT CONVERSION FACTOR FOR " - [F:XINFSMD]PCU,1) From GESECRAN
                    GOK = 0
                    Break 2
                Endif

                XLINE += ";" + num$([L]XQTY)

                If [F:XINFSMS]LOC <> ''
                    XLINE += ";" + [F:XINFSMS]LOC
                Else
                    Raz XDEFLOC

                    Case [F:XSITF]LOCNUM
                        When [F:XSITF]LOCNUM(0) = 1 : [L]XDEFLOC = [F:XSITF]DEFLOC(0)
                        When [F:XSITF]LOCNUM(1) = 1 : [L]XDEFLOC = [F:XSITF]DEFLOC(1)
                        When [F:XSITF]LOCNUM(2) = 1 : [L]XDEFLOC = [F:XSITF]DEFLOC(2)
                        When [F:XSITF]LOCNUM(3) = 1 : [L]XDEFLOC = [F:XSITF]DEFLOC(3)
                        When [F:XSITF]LOCNUM(4) = 1 : [L]XDEFLOC = [F:XSITF]DEFLOC(4)
                        When Default
                    Endcase

                    If [L]XDEFLOC <> '' and  [L]XDEFLOC <> '*'
                        XLINE += ";" + [L]XDEFLOC
                    Else
                        Filter [F:XSTO] Where [F:XSTO]ITMREF = [F:XINFSMD]ITMREF and
&                                             [F:XSTO]STOFCY = [F:XINFSMH]STOFCY and
&                                             [F:XSTO]LOCTYP = [F:XINFSMS]LOCTYP and
&                                             [F:XSTO]PCU    = [F:XINFSMD]PCU
&                       Order By Key STO4
                        Read [F:XSTO]STO4 First

                        If !fstat
                             XLINE += ";" + [F:XSTO]LOC
                        Else
                            # TODO - UPDATE OF MESSAGE
                            Call ECR_TRACE("UNABLE TO DETERMINE THE RECEIPT LOCATION",0) From GESECRAN
                            GOK = 0
                            Break 2
                        Endif
                    Endif
                Endif

                XLINE += ";" + [F:XINFSMS]LOT
                XLINE += ";" + [F:XINFSMS]SERNUM
call ECR_TRACE(XLINE,0) from GESECRAN
                Wrseq XLINE Using [FIC1]
            Next
        Endif

        $SKIPT
    Next

    ## CLOSE FILE
    #################################################################################
    Openo Using [FIC1]

    # WRITING OF FILE SUCCESSFUL, IMPORT THE FILE
    #############################################################################################################
    If GOK
        # CALLS THE IMPORT PROCESS
        # Call IMPORTSIL(IMPT, FIL) From GIMPOBJ
        # @ IMPT - TEMPLATE TO BE USED
        # @ FIL  - FILE + LOCATION
        ###############################################################
        Raz [M:IMP2]

        [M:IMP2]MODIMP = "XINFPSMR"
        [M:IMP2]NOMIMP = filpath("INFOPOS",[F:XINFSMH]VCRNUM,'TXT')
        [M:IMP2]TYPEXP = 2

        Call IMPORTSIL([M:IMP2]MODIMP,[M:IMP2]NOMIMP) From GIMPOBJ

        Look [F:XSMHA]SMH0 = [F:XINFSMH]VCRTYP;[F:XINFSMH]VCRNUM

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("ERROR ON THE INCREASE ADJUSTMENTS CREATION",1) From GESECRAN
        Else
             # TODO - UPDATE THE TRANSACTION AS INTEGRATED
            Call UPDATETRANS([F:XINFSMH]VCRNUM) From XINFP_SMR

            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("SUCCESS ON THE INCREASE ADJUSTMENTS CREATION",0) From GESECRAN
        Endif
    Endif

    # DELETE OF CREATED FILE
    #############################################################################################################
    Call EFFACE(filpath("INFOPOS",[F:XINFSMH]VCRNUM,'TXT'),XSTAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFSMH]VCRNUM + ".TXT",'ERR'),XSTAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFSMH]VCRNUM,'TXT'),XSTAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFSMH]VCRNUM + ".TXT",'ERR'),XSTAT) From ORDSYS
End







