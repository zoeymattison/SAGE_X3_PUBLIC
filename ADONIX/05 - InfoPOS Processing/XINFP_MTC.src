###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES TRANSFER OUT, CREATES PO/SO/SDH
########################################################################################################################
Subprog MTC_TRANS()
    If !clalev([F:XINFMTC]) : Local File XINFMTC    [F:XINFMTC] : Endif
    If !clalev([F:XSIHI])   : Local File SINVOICE   [F:XSIHI]   : Endif
    If !clalev([F:XSIHC])   : Local File SINVOICE   [F:XSIHC]   : Endif
    If !clalev([F:XSIVI])   : Local File SINVOICEV  [F:XSIVI]   : Endif
    If !clalev([F:XSIVC])   : Local File SINVOICEV  [F:XSIVC]   : Endif

    # OPENING OF LOCAL TABLES
    If !clalev([F:DUDA])    : Local File GACCDUDATE [F:DUDA] : Endif
    If !clalev([F:CPY])     : Local File COMPANY    [F:CPY]  : Endif
    If !clalev([F:FCY])     : Local File FACILITY   [F:FCY]  : Endif
    If !clalev([F:GCM])     : Local File GACM       [F:GCM]  : Endif
    If !clalev([F:LED])     : Local File GLED       [F:LED]  : Endif
    If !clalev([F:FIY])     : Local File FISCALYEAR [F:FIY]  : Endif
    If !clalev([F:PER])     : Local File PERIOD     [F:PER]  : Endif
    If !clalev([F:TCU])     : Local File TABCUR     [F:TCU]  : Endif
    If !clalev([F:GAC])     : Local File GACCOUNT   [F:GAC]  : Endif
    If !clalev([F:HAE])     : Local File GACCENTRY  [F:HAE]  : Endif
    If !clalev([F:HAEX])    : Local File GACCENTRY  [F:HAEX] : Endif
    If !clalev([F:DAE])     : Local File GACCENTRYD [F:DAE]  : Endif
    If !clalev([F:DAE2])    : Local File GACCENTRYD [F:DAE2] : Endif
    If !clalev([F:DAEX])    : Local File GACCENTRYD [F:DAEX] : Endif
    If !clalev([F:DAEZ])    : Local File GACCENTRYD [F:DAEZ] : Endif
    If !clalev([F:DUD])     : Local File GACCDUDATE [F:DUD]  : Endif
    If !clalev([F:MTC])     : Local File MATCHCODE  [F:MTC]  : Endif
    If !clalev([F:BPR])     : Local File BPARTNER   [F:BPR]  : Endif
    If !clalev([F:GTE])     : Local File GTYPACCENT [F:GTE]  : Endif
    If !clalev([F:MTB])     : Local File MTCBATCH   [F:MTB]  : Endif
    If !clalev([F:ATZ])     : Local File ATABZON    [F:ATZ]  : Endif
    If !clalev([F:ATY])     : Local File ATYPE      [F:ATY]  : Endif
    If !clalev([F:ADW])     : Local File ADOVAL     [F:ADW]  : Endif

    # OPENING OF LOCAL MASKS
    If !clalev([M:LTE])     : Local Mask LETTRECH   [M:LTE]  : Endif
    If !clalev([M:LTR])     : Local Mask LETTRAGE   [M:LTR]  : Endif

    # DECLARATION OF LOCAL VARIABLES
    Local Integer CLECUR, OK
    Local Char    CRITERE(250) , SOCIETE(GLONCPY) , SITE(GLONFCY) , SITCUR(GLONFCY)
    Local Char    COMPTE(GLONGAC) , TIERS(GLONBPR) , SYMBCPT(50)
    Local Char    CPTCUR(GLONGAC) , BPRCUR(GLONBPR)
    Local Date    DATDEBCUR, DATFINCUR
    Local Char    MESSAGE(250) , PCETYP(GLONGTE)(1..10) , PCENUM(GLONVCR)(1..10)
    Local Char    MESSAGE(250) , XPCETYP(GLONGTE)(1..10) , XPCENUM(GLONVCR)(1..10)
    Local Integer MAXECT
    Local Integer XNBPCE
    Local Integer CAS , FLDEV , PLEIN , STA, XLED
    Local Integer I , J , K
    Local Integer IL , JL , KL , LL
    Local Integer ECRLET
    Local Date    SAVD1 , SAVD2 , SAVC1 , SAVC2
    Local Integer SUITE , RETOUR
    Local Char    VALPAR(30), XACC(30)
    Local Date    DATEVT
    Local Char    FILT(250)
    Local Integer R , XNBECH, NEG
    Local Integer XACCNUM(1..100)
    Local Integer XDUDLIG(1..100)
    Local Decimal XAMTIPT(1..100)
    Local Decimal XTOTDEB , XTOTCRE , XIPTDEB , XIPTCRE , XMTIPT
    Local Char    XTPTTYPE(30)
    Local Char    XCOA(30)

    # TODO - UPDATE OF MESSAGE
    Call ECR_TRACE("PROCESSING OF MATCHING ROUTINE :",0) From GESECRAN
    Call ECR_TRACE("---------------------------------------",0) From GESECRAN
##Filter [F:XINFMTC] Where [F:XINFMTC]NUM = 'IN0001000133'
    Filter [F:XINFMTC] Where [F:XINFMTC]POSTED <> 2
&   Order By Key XINFMTC0

    For [F:XINFMTC]XINFMTC0
        Read [F:XSIVI]SIV0 = [F:XINFMTC]INVNUM

        If !fstat
            Read [F:XSIVC]SIV0 = [F:XINFMTC]CRNNUM

            If !fstat
                # IF BOTH INVOICE AND CREDIT NOTE IS POSTED, THEN PROCEED WITH THE MATHCING
                If [F:XSIVI]INVSTA = 3 and [F:XSIVC]INVSTA = 3
                    Gosub MATCH From XINFP_MTC
                Else
                    # TODO - UPDATE OF MESSAGE
                    Call ECR_TRACE("INVOICE/CREDIT NOTE NOT POSTED :" - [F:XINFMTC]INVNUM - '/' - [F:XINFMTC]CRNNUM,1) From GESECRAN
                Endif
            Else
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("CREDIT NOTE DOES NOT EXIST :" - [F:XINFMTC]CRNNUM,1) From GESECRAN
            Endif
        Else
           # TODO - UPDATE OF MESSAGE
           Call ECR_TRACE("INVOICE DOES NOT EXIST :" - [F:XINFMTC]INVNUM,1) From GESECRAN
        Endif
    Next

    # CLOSING LOCAL FILES
    If clalev([F:XINFMTC]) : Close Local File  [F:XINFMTC] : Endif
    If clalev([F:XSIVI])   : Close Local File  [F:XSIVI]   : Endif
    If clalev([F:XSIVC])   : Close Local File  [F:XSIVC]   : Endif
    If clalev([F:XSIHI])   : Close Local File  [F:XSIHI]   : Endif
    If clalev([F:XSIHC])   : Close Local File  [F:XSIHC]   : Endif
    If clalev([F:DUDA])    : Close Local File  [F:DUDA]    : Endif
    If clalev([F:CPY])     : Close Local File  [F:CPY]     : Endif
    If clalev([F:FCY])     : Close Local File  [F:FCY]     : Endif
    If clalev([F:GCM])     : Close Local File  [F:GCM]     : Endif
    If clalev([F:LED])     : Close Local File  [F:LED]     : Endif
    If clalev([F:FIY])     : Close Local File  [F:FIY]     : Endif
    If clalev([F:PER])     : Close Local File  [F:PER]     : Endif
    If clalev([F:TCU])     : Close Local File  [F:TCU]     : Endif
    If clalev([F:GAC])     : Close Local File  [F:GAC]     : Endif
    If clalev([F:HAE])     : Close Local File  [F:HAE]     : Endif
    If clalev([F:HAEX])    : Close Local File  [F:HAEX]    : Endif
    If clalev([F:DAE])     : Close Local File  [F:DAE]     : Endif
    If clalev([F:DAE2])    : Close Local File  [F:DAE2]    : Endif
    If clalev([F:DAEX])    : Close Local File  [F:DAEX]    : Endif
    If clalev([F:DAEZ])    : Close Local File  [F:DAEZ]    : Endif
    If clalev([F:DUD])     : Close Local File  [F:DUD]     : Endif
    If clalev([F:MTC])     : Close Local File  [F:MTC]     : Endif
    If clalev([F:BPR])     : Close Local File  [F:BPR]     : Endif
    If clalev([F:GTE])     : Close Local File  [F:GTE]     : Endif
    If clalev([F:MTB])     : Close Local File  [F:MTB]     : Endif
    If clalev([F:ATZ])     : Close Local File  [F:ATZ]     : Endif
    If clalev([F:ATY])     : Close Local File  [F:ATY]     : Endif
    If clalev([F:ADW])     : Close Local File  [F:ADW]     : Endif

    # CLOSING LOCAL MASKS
    If clalev([M:LTE])     : Close Local Mask  [M:LTE]     : Endif
    If clalev([M:LTR])     : Close Local Mask  [M:LTR]     : Endif

    # KILLING LOCAL VARIABLES
    Kill [L]
End

# RUNNING THE MATCHING PROCESS
###########################################################################################
$MATCH
    # READ MAIN LEDGER INFORMATION AND CHART OF ACCCOUNTS
    Call LECLEDMAIN(1,[F:XSIVI]CPY,XLED) From CPTDIV
    Call LECPLAN([F:XSIVI]CPY,XLED,XCOA) From CPTDIV

    Call SETMAINREF([F:XSIVI]CPY,GTYPGEN,GTYPANA) From CPTDIV

    # READ CONTROL ACCOUNT OF THE CUSTOMER
    Call CONTROL([F:XSIVI]BPCINV, XCOA, XACC) From XINFP_MTC

    # POPULATE MATCHING WINDOW
    Raz [M:LTE], XTOTDEB , XTOTCRE , XIPTDEB , XIPTCRE , XMTIPT

    [M:LTE]CUR = [F:GCM]CUR(GTYPGEN-1)

    FLDEV = 2

    Call LECTURE("GAC", XACC, XCOA) From CONTOBJ

    [M:LTE]FRWCUR = [F:GAC]FRWCUR

    # LOAD THE INVOICE DETAILS
    Read [F:XSIHI]SIH0 = [F:XSIVI]NUM
    Filter [F:DAEX]
##Call ECR_TRACE(num$(GTYPGEN) -[F:XSIVI]CPY - XACC - [F:XSIVI]BPCINV - [F:XSIHI]GTE - [F:XSIVI]NUM,0) From GESECRAN
##Call ECR_TRACE(num$(GTYPGEN) -[F:XSIVC]CPY - XACC - [F:XSIVC]BPCINV - [F:XSIHC]GTE - [F:XSIVC]NUM,0) From GESECRAN
    Filter [F:DAEX] Where [F:DAEX]LEDTYP = GTYPGEN         and
&                         [F:DAEX]CPY    = [F:XSIVI]CPY    and
&                         [F:DAEX]ACC    = XACC            and
&                         [F:DAEX]BPR    = [F:XSIVI]BPCINV and
&                         [F:DAEX]TYP    = [F:XSIHI]GTE    and
&                         [F:DAEX]NUM    = [F:XSIVI]NUM
&   Order By Key DAE0

    For [F:DAEX]DAE0
        Call CHARGECH2([F:DAEX]ACCNUM, FLDEV, [F:XSIVI]BPCINV, NEG, XTOTDEB , XTOTCRE , XIPTDEB , XIPTCRE , XMTIPT) From XINFP_MTC
##call ECR_TRACE('in loop',0) from GESECRAN
        ## IF INVOICE IS ALREADY PATIALLY MATCHED, THE CRITERIA OF PREVIOUS APPLICATION NEED TO BE APPLIED TO MATCHING SCREEN
        If [F:DAEX]MTC <> ""
            ## FILL MATCHING CRITERIA FOR ALREADY MATCHED ITEMS
            Filter [F:DAEZ] Where [F:DAEZ]CPY = [F:XSIVI]CPY    and
&                                 [F:DAEZ]ACC = XACC           and
&                                 [F:DAEZ]BPR = [F:XSIVI]BPCINV and
&                                 [F:DAEZ]MTC = [F:DAEX]MTC
&           Order By Key DAE0

            For [F:DAEZ]DAE0
                Call CHARGECH2([F:DAEZ]ACCNUM, FLDEV, [F:XSIVI]BPCINV, NEG,XTOTDEB , XTOTCRE , XIPTDEB , XIPTCRE , XMTIPT) From XINFP_MTC
            Next
        Endif
    Next

    Filter [F:DAEX]

    # LOAD THE CREDIT DETAILS
    Read [F:XSIHC]SIH0 = [F:XSIVC]NUM
    Filter [F:DAEX]

    Call ECR_TRACE(num$(GTYPGEN) -[F:XSIVC]CPY - XACC - [F:XSIVC]BPCINV - [F:XSIHC]GTE - [F:XSIVC]NUM,0) From GESECRAN

    Filter [F:DAEX] Where [F:DAEX]LEDTYP = GTYPGEN        and
&                         [F:DAEX]CPY    = [F:XSIVC]CPY    and
&                         [F:DAEX]ACC    = XACC           and
&                         [F:DAEX]BPR    = [F:XSIVC]BPCINV and
&                         [F:DAEX]TYP    = [F:XSIHC]GTE   and
&                         [F:DAEX]NUM    = [F:XSIVC]NUM
&   Order By Key DAE0

    For [F:DAEX]DAE0
        Call CHARGECH2([F:DAEX]ACCNUM, FLDEV, [F:XSIVI]BPCINV, NEG,XTOTDEB , XTOTCRE , XIPTDEB , XIPTCRE , XMTIPT) From XINFP_MTC
    Next

    Filter [F:DAEX]

    Filter [F:DAEX]
    Filter [F:DAE]

    GOK = 1 : Raz PCENUM, PCETYP, XPCENUM, XPCETYP, XNBPCE, STA

    Trbegin [DAE], [DUD], [MTC]
##call ECR_TRACE(num$(GOK) + ' a',0) from GESECRAN
        CAS = 2
        Gosub EPUR_MTCBATCH
##call ECR_TRACE(num$(GOK) + ' b',0) from GESECRAN
        If !GOK : Rollback : Return :  Endif

        Call LETTRAGE([M:LTE]NBLIG,[M:LTE]ACCNUM,[M:LTE]DUDLIG,[M:LTE]NIPT,CAS,0,STA,MESSAGE,PCETYP,PCENUM) From CPTLET
##call ECR_TRACE(num$(GOK) + ' c',0) from GESECRAN
        If !GOK : Rollback :Return : Endif

        For I=1 To dim(PCENUM)
            If PCENUM(I)<>""
                XNBPCE += 1
                XPCETYP(XNBPCE) = PCETYP(I)
                XPCENUM(XNBPCE) = PCENUM(I)
            Endif
        Next
##call ECR_TRACE(num$(GOK) + ' d',0) from GESECRAN
        ## PROPAGATION OF LETTERING ON OTHER REFERENCE
        For R=1 To len(mess(0,2644,1))
            Call PROPAGE([F:XSIVI]CPY,GTYPGEN,[M:LTE]NBLIG,[M:LTE]ACCNUM,R,XNBECH,XACCNUM) From CPTLET
			##call ECR_TRACE(num$(GOK) + ' e',0) from GESECRAN
            If XNBECH>=2
                Call LETTRAGE(XNBECH,XACCNUM,XDUDLIG,XAMTIPT,CAS,0,STA,MESSAGE,PCETYP,PCENUM) From CPTLET
				##call ECR_TRACE(num$(GOK) + ' f',0) from GESECRAN
                If GOK<1 : Break : Endif

                For I=1 To dim(PCENUM)
                    If PCENUM(I)<>""
                        XNBPCE += 1
                        XPCETYP(XNBPCE) = PCETYP(I)
                        XPCENUM(XNBPCE) = PCENUM(I)
                    Endif
                Next
            Endif
        Next R
##call ECR_TRACE(num$(GOK) + ' g',0) from GESECRAN
        If !GOK
            Rollback

            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("FAILED TO MATCH INVOICE/CREDIT NOTE :" - [F:XINFMTC]INVNUM - '/' - [F:XINFMTC]CRNNUM,1) From GESECRAN
        Else
            Commit

            Call UPDATETRANS([F:XINFMTC]NUM) From XINFP_MTC

            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("INVOICE/CREDIT NOTE MATCHED :" - [F:XINFMTC]INVNUM - '/' - [F:XINFMTC]CRNNUM,0) From GESECRAN
        Endif
Return

# CREATE MATCHING PAIRS
###############################################################################################################
Subprog CHARGECH2(CRIT,FLDEV,TIERS,NEG,TOTDEB , TOTCRE , IPTDEB , IPTCRE , MTIPT)
    Value    Integer CRIT
    Value    Integer FLDEV
    Value    Char    TIERS
    Variable Integer NEG
    Variable Decimal TOTDEB , TOTCRE , IPTDEB , IPTCRE , MTIPT
    Local    Integer I , NOL

    NOL = [M:LTE]NBLIG

    Read [DAE]DAE2 = CRIT

    If find([DAE]ACCNUM,[LTE]ACCNUM(0..[LTE]NBLIG-1)) : End : Endif

    If fstat=0
        Read [HAE]HAE0 = [F:DAE]TYP;[F:DAE]NUM
        If fstat : Raz [F:HAE] : Endif

        If left$([F:HAE]REFINT,3)<>"MTC"
            Call SETMAINREF([F:DAE]CPY,GTYPGEN,GTYPANA) From CPTDIV
            If TIERS<>"" &  GTYPGEN = [F:DAE]LEDTYP
                For [DUD]DUD1 Where ACCNUM=[F:DAE]ACCNUM
                    nolign  = NOL+1
                    [M:LTE] = [F:DAE]
                    [M:LTE] = [F:HAE]
                    [M:LTE] = [F:DUD]
                    [M:LTE]DEVPCE(NOL) = [F:HAE]CUR

                    Case FLDEV
                        When 1
                            [M:LTE]AMT(NOL) = [F:DUD]AMTLOC
                            [M:LTE]IPT(NOL) = [F:DUD]PAYLOC
                            [M:LTE]TMP(NOL) = [F:DUD]TMPLOC
                        When 2
                            [M:LTE]AMT(NOL) = [F:DUD]AMTCUR
                            [M:LTE]IPT(NOL) = [F:DUD]PAYCUR
                            [M:LTE]TMP(NOL) = [F:DUD]TMPCUR
                    Endcase
                    [M:LTE]OIPT(NOL) = [M:LTE]IPT(NOL)
                    If [M:LTE]AMT(NOL)<0 : NEG=1 : Endif
                    If [F:DAE]SNS>0
                        [M:LTE]SNS(NOL) = 1
                        TOTDEB += [M:LTE]AMT(NOL)-[M:LTE]TMP(NOL)
                        IPTDEB += [M:LTE]IPT(NOL)
                    Else
                        [M:LTE]SNS(NOL) = 2
                        TOTCRE += [M:LTE]AMT(NOL)-[M:LTE]TMP(NOL)
                        IPTCRE += [M:LTE]IPT(NOL)
                    Endif
                    NOL += 1
                Next
            Else
                NOL += 1
                nolign  = NOL
                [M:LTE] = [F:HAE]
                [M:LTE] = [F:DAE]
                [M:LTE]DEVPCE(NOL) = [F:HAE]CUR
            Endif : # TIERS
        Endif : # REFINT
    Endif : # fstat


    [M:LTE]NBLIG = NOL
    # INIT REPETITIONS CODE
    For I=0 To [M:LTE]NBLIG-1
        Case [M:LTE]SNS(I)
            When 1
                If IPTDEB<TOTCRE
                    MTIPT = min(TOTCRE-IPTDEB,[M:LTE]AMT(I)-[M:LTE]IPT(I)-[M:LTE]TMP(I))
                    [M:LTE]IPT(I)  += MTIPT
                    [M:LTE]NIPT(I) += MTIPT
                    IPTDEB         += MTIPT
                Else
                    If [M:LTE]IPT(I)>0
                        MTIPT = min(IPTDEB-TOTCRE,[M:LTE]IPT(I)+[M:LTE]TMP(I))
                    Else
                        MTIPT = max(IPTDEB-TOTCRE,[M:LTE]IPT(I)+[M:LTE]TMP(I))
                    Endif

                    [M:LTE]IPT(I)  -= MTIPT
                    [M:LTE]NIPT(I) -= MTIPT
                    IPTDEB         -= MTIPT
                Endif
            When 2
                If IPTCRE<TOTDEB
                    MTIPT = min(TOTDEB-IPTCRE,[M:LTE]AMT(I)-[M:LTE]IPT(I)-[M:LTE]TMP(I))
                    [M:LTE]IPT(I)  += MTIPT
                    [M:LTE]NIPT(I) += MTIPT
                    IPTCRE         += MTIPT
                Else
                    If [M:LTE]IPT(I)<0
                        MTIPT = max(IPTCRE-TOTDEB,[M:LTE]IPT(I)+[M:LTE]TMP(I))
                    Else
                        MTIPT = min(IPTCRE-TOTDEB,[M:LTE]IPT(I)+[M:LTE]TMP(I))
                    Endif
                    [M:LTE]IPT(I)  -= MTIPT
                    [M:LTE]NIPT(I) -= MTIPT
                    IPTCRE         -= MTIPT
                Endif
      Endcase
  Next I

End

## IT PURIFIES THE LETTERING ON HOLD WHEN TRYING TO LETTERS THE GROUP THAT WAS WAITING FOR LETTERING IN MTCBATCH
###############################################################################################################
$EPUR_MTCBATCH
    Local Integer T, OKK, NBACCNUM
    Local Integer NUML
    Local Integer MAXLET
    Local Char    PARAMMTC(10)

    Call PARAM("","MTCNBR",PARAMMTC) From ADOVAL
    MAXLET = max(1000,val(PARAMMTC))

    Local Integer TABACCNUM(1..MAXLET)

    Filter [MTB] Where ACCNUM=[M:LTE]ACCNUM(0) & DUDLIG=[M:LTE]DUDLIG(0)
    Read [MTB]MTB0 First

    Filter [MTB]

    If !fstat
        [L]NUML = [F:MTB]MTCNUM : NBACCNUM = 0

        For [MTB]MTB0 Where MTCNUM = [L]NUML
            T = find([F:MTB]ACCNUM,[M:LTE]ACCNUM(0..[M:LTE]NBLIG-1))

            If T & [F:MTB]DUDLIG = [M:LTE]DUDLIG(T-1)
                If NBACCNUM >= MAXLET
                    GOK = 0 : STA=1 : MESSAGE = mess(42,114,1)
                    Break
                Endif
                OKK = 1 : TABACCNUM(T) = [F:MTB]ACCNUM : NBACCNUM += 1
            Else
                OKK = 0 : Break
            Endif
        Next

        If !GOK : Return : Endif

        If OKK
            If [M:LTE]NBLIG = NBACCNUM
                Delete [MTB] Where MTCNUM = [L]NUML
                If fstat=1
                    GOK=-1 : GLOCK="$MTCBATCH"-num$([L]NUML)
                Endif
            Endif
        Endif
    Endif
Return

# FIND CONTROL ACCOUNT OF THE CUSTOMER
###############################################################################################################
Subprog CONTROL(XXBPRNUM, XXCOA, XXACC)
    Value    Char XXBPRNUM
    Value    Char XXCOA
    Variable Char XXACC

    If !clalev([F:XCACA]) : Local File GACCCODE   [F:XCACA] : Endif
    If !clalev([F:XBPCA]) : Local File BPCUSTOMER [F:XBPCA] : Endif

    Read [F:XBPCA]BPC0 = XXBPRNUM
    If [F:XBPCA]ACCCOD<>""
        Read [F:XCACA]CAC0 = 2;[F:XBPCA]ACCCOD; XXCOA
    Endif

    XXACC = [F:XCACA]ACC(0)

    Close File [F:XCACA], [F:XBPCA]
End

###########################################################################################
# UPDATE THE TRANSACTION AS COMPLETED
###########################################################################################
Subprog UPDATETRANS(XINFPNUM)
    Value Char XINFPNUM
    If !clalev([F:XUP]) : Local File XINFMTC [F:XUP] : Endif

    Call XERR_TRANS("MTC", XINFPNUM, [F:XINFMTC]EXPNUM, 2, 0, "SUCCESSFUL") From XINFP_ERR

    Trbegin [F:XUP]
        Update [F:XUP] Where [F:XUP]NUM = XINFPNUM With [F:XUP]POSTED = 2

        If fstat
            Rollback
        Else
            Commit
        Endif

    If clalev([F:XUP]) : Close Local File   [F:XUP] : Endif
End
















