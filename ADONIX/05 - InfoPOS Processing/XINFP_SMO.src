###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES DECREASE ADJUSTMENTS
########################################################################################################################
Subprog SMO_TRANS()
    If !clalev([F:XINFSMH]) : Local File XINFSMH  [F:XINFSMH] : Endif
    If !clalev([F:XINFSMD]) : Local File XINFSMD  [F:XINFSMD] : Endif
    If !clalev([F:XINFSMS]) : Local File XINFSMS  [F:XINFSMS] : Endif
    If !clalev([F:XSTC])    : Local File STOLOC   [F:XSTC]    : Endif
    If !clalev([F:XSMHA])   : Local File SMVTH    [F:XSMHA]   : Endif
    If !clalev([M:IMP2])    : Local Mask IMPOBJ2  [M:IMP2]    : Endif
	If !clalev([F:XSITF])   : Local File ITMFACILIT [F:XSITF]   : Endif

    # TODO - UPDATE OF MESSAGE
    Call ECR_TRACE("GENERATION OF A DECREASE ADJUSTMENTS",0) From GESECRAN
    Call ECR_TRACE("------------------------------------",0) From GESECRAN
##Filter [F:XINFSMH] Where [F:XINFSMH]VCRNUM = 'IT0001001996'
    Filter [F:XINFSMH] Where [F:XINFSMH]VCRTYP = 20 and [F:XINFSMH]GENFLG <> 2
&   Order By Key XINFSMH0

    For [F:XINFSMH]XINFSMH0
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("DECREASE ADJUSTMENTS :" - [F:XINFSMH]VCRNUM ,0) From GESECRAN

        # TODO - UPDATE OF MESSAGE
        # DETERMINE IF INCREASE ADJUSTMENT EXISTS
        Look [F:XSMHA]SMH0 = [F:XINFSMH]VCRTYP;[F:XINFSMH]VCRNUM

        If fstat
            # CALL THE CREATION OF THE INCREASE ADJUSTMENT
            Call TRANS_CRE From XINFP_SMO
        Else
            # UPDATE THE TRANSACTION AS INTEGRATED
            Call UPDATETRANS([F:XINFSMH]VCRNUM) From XINFP_SMO

            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("DECREASE ADJUSTMENT EXISTS",0) From GESECRAN
        Endif

        # IMPORT VARIABLE DISABLE - USED FOR LOGGING PURPOSES
        GIMPORT = 0
    Next

    If clalev([F:XINFSMH]) : Close Local File  [F:XINFSMH] : Endif
    If clalev([F:XINFSMD]) : Close Local File  [F:XINFSMD] : Endif
    If clalev([F:XINFSMD]) : Close Local File  [F:XINFSMS] : Endif
    If clalev([F:XSMHA])   : Close Local File  [F:XSMHA]   : Endif
    If clalev([F:XSTC])    : Close Local File  [F:XSTC]    : Endif
    If clalev([M:IMP2])    : Close Local Mask  [M:IMP2]    : Endif
End

###########################################################################################
# UPDATE THE TRANSACTION AS COMPLETED
###########################################################################################
Subprog UPDATETRANS(XINFPNUM)
    Value Char XINFPNUM
    If !clalev([F:XUP]) : Local File XINFSMH [F:XUP] : Endif

    Call XERR_TRANS("ADJ", XINFPNUM, [F:XINFSMH]EXPNUM, 2, 0, "SUCCESSFUL") From XINFP_ERR

    Trbegin [F:XUP]
        Update [F:XUP] Where [F:XUP]VCRNUM = XINFPNUM With [F:XUP]GENFLG = 2

        If fstat
            Rollback
        Else
            Commit
        Endif

    If clalev([F:XUP]) : Close Local File   [F:XUP] : Endif
End

# CREATION OF DECREASE ADJUSTMENTS
##################################################################################################
Subprog TRANS_CRE
    Local Char    XLINE(255), XMESSAGE(255)

    GOK = 1

    ## CREATE DECREASE ADJUSTMENTS FILE FOR IMPORT
    #################################################################################
    adxifs = ';' : adxirs = chr$(13)+chr$(10)

    ## OPEN FILE
    #################################################################################
    Openo filpath("INFOPOS",[F:XINFSMH]VCRNUM,'TXT') Using [FIC1]

    XLINE =   "E;"  + num$([F:XINFSMH]VCRTYP)
    XLINE +=  ";"   + [F:XINFSMH]VCRNUM
    XLINE +=  ";"   + [F:XINFSMH]STOFCY
    XLINE + = ";"   + num$(format$("D:DDMMYYYY",[F:XINFSMH]IPTDAT))
    XLINE +=  ";"   + [F:XINFSMH]VCRDES

    Wrseq XLINE Using [FIC1]

    # LOADS THE CONTENT OF THE DETAILED LINES
    Filter [F:XINFSMD] Where [F:XINFSMD]VCRTYP = [F:XINFSMH]VCRTYP and
&                            [F:XINFSMD]VCRNUM = [F:XINFSMH]VCRNUM
&   Order By Key XINFSMD0

    For [F:XINFSMD]XINFSMD0
        # WRITE THE LINE DETAIL RECORD INFORMATION
        ########################################################################################################
        XLINE =   "L;"  + num$([F:XINFSMD]VCRLIN)
        XLINE +=  ";"   + [F:XINFSMD]ITMREF
        XLINE +=  ";"   + [F:XINFSMD]PCU
        XLINE +=  ";"   + num$([F:XINFSMD]QTYPCU)
        XLINE +=  ";"   + num$(func XINFPPRI([F:XINFSMD]ITMREF, [F:XINFSMH]STOFCY, [F:XINFSMH]IPTDAT))   #num$([F:XINFSMD]PRI)

        Wrseq XLINE Using [FIC1]

        # WRITE THE STOCK LINE
        ########################################################################################################
        Filter [F:XINFSMS] Where [F:XINFSMS]VCRTYP = [F:XINFSMD]VCRTYP and
&                                [F:XINFSMS]VCRNUM = [F:XINFSMD]VCRNUM and
&                                [F:XINFSMS]VCRLIN = [F:XINFSMD]VCRLIN
&       Order By Key XINFSMS0

        For [F:XINFSMS]XINFSMS0
            XLINE  = "S;A"
            XLINE += ";" + [F:XINFSMD]PCU
            XLINE += ";" + num$([F:XINFSMD]QTYPCU)

            If [F:XINFSMS]LOC <> ''
                XLINE += ";" + [F:XINFSMS]LOC
            Else
                Read [F:XSTC]STC3 = [F:XINFSMH]STOFCY;[F:XINFSMS]LOCTYP

                If !fstat
                    XLINE += ";" + [F:XSTC]LOC
                Else
				    Filter [F:XSITF] where [F:XSITF]ITMREF = [F:XINFSMD]ITMREF and [F:XSITF]STOFCY = [F:XINFSMH]STOFCY
					Read [F:XSITF]ITF0 first
					If !fstat
						If [F:XSITF]LOCMGTCOD = 2
							# TODO - UPDATE OF MESSAGE
							Call ECR_TRACE("UNABLE TO DETERMINE THE SALES LOCATION",0) From GESECRAN
							GOK = 0
							Break 2
						Else
							 XLINE += ";" + ''
						Endif
					Endif
                Endif
            Endif

            XLINE += ";" + [F:XINFSMS]LOT
            XLINE += ";" + [F:XINFSMS]SERNUM

            Wrseq XLINE Using [FIC1]
        Next

        $SKIPT
    Next

    ## CLOSE FILE
    #################################################################################
    Openo Using [FIC1]

    # WRITING OF FILE SUCCESSFUL, IMPORT THE FILE
    #############################################################################################################
    If GOK
        # CALLS THE IMPORT PROCESS
        # Call IMPORTSIL(IMPT, FIL) From GIMPOBJ
        # @ IMPT - TEMPLATE TO BE USED
        # @ FIL  - FILE + LOCATION
        ###############################################################
        Raz [M:IMP2]

        [M:IMP2]MODIMP = "XINFPSMO"
        [M:IMP2]NOMIMP = filpath("INFOPOS",[F:XINFSMH]VCRNUM,'TXT')
        [M:IMP2]TYPEXP = 2

        Call IMPORTSIL([M:IMP2]MODIMP,[M:IMP2]NOMIMP) From GIMPOBJ

        Look [F:XSMHA]SMH0 = [F:XINFSMH]VCRTYP;[F:XINFSMH]VCRNUM

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("ERROR ON THE DECREASE ADJUSTMENTS CREATION",1) From GESECRAN
        Else
            # UPDATE THE TRANSACTION AS INTEGRATED
            Call UPDATETRANS([F:XINFSMH]VCRNUM) From XINFP_SMO

            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("SUCCESS ON THE DECREASE ADJUSTMENTS CREATION",0) From GESECRAN
        Endif
    Endif

    # DELETE OF CREATED FILE
    #############################################################################################################
    Local Integer STAT

    Call EFFACE(filpath("INFOPOS",[F:XINFSMH]VCRNUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFSMH]VCRNUM + ".TXT",'ERR'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFSMH]VCRNUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFSMH]VCRNUM + ".TXT",'ERR'),STAT) From ORDSYS
End

########################################################################################################################
# SUBPROG THAT FIND THE PRICE BASED ON ITEM COSTING METHOD
#
########################################################################################################################
Funprog XINFPPRI(XINFPITM,XINFPFCY,XINFPDAT)
    Value Char XINFPITM
    Value Char XINFPFCY
    Value Date XINFPDAT

    Local Decimal XINFPPRI
    Local Integer WCSTCOD,WSTAT

    If !clalev([F:ITC]) : Local File ITMCOST    [F:ITC] : Endif
    If !clalev([F:ITM]) : Local File ITMMASTER  [F:ITM] : Endif
    If !clalev([F:ITV]) : Local File ITMMVT     [F:ITV] : Endif
    If !clalev([F:ITF]) : Local File ITMFACILIT [F:ITF] : Endif
    If !clalev([F:TCM]) : Local File TABCOSTMET [F:TCM] : Endif

    Read [ITM]ITM0 = XINFPITM
    Read [ITF]ITF0 = XINFPITM;XINFPFCY

    Call GETTCM([F:ITF]ITMREF,[F:ITF]STOFCY,GBIDC1,GBIDI1) From STKVAL

    WCSTCOD = [F:TCM]ISSVLTCOD

    Call GETPRI([F:ITF]ITMREF,[F:ITF]STOFCY,XINFPDAT,1,"","",WCSTCOD,XINFPPRI,WSTAT) #From STKVAL

    If clalev([F:ITC]) : Close Local File [F:ITC] : Endif
    If clalev([F:ITM]) : Close Local File [F:ITM] : Endif
    If clalev([F:ITV]) : Close Local File [F:ITV] : Endif
    If clalev([F:ITF]) : Close Local File [F:ITF] : Endif
    If clalev([F:TCM]) : Close Local File [F:TCM] : Endif


End ar2(XINFPPRI)

Subprog GETPRI(LITM,LFCY,LDAT,LQTY,LLOT,LSLO,LVLT,LPRI,LRET)
Value    Char    LITM
Value    Char    LFCY
Value    Date    LDAT
Value    Decimal LQTY
Value    Char    LLOT
Value    Char    LSLO
Value    Integer LVLT
Variable Decimal LPRI
Variable Integer LRET

Raz LRET

Local Integer WMET : WMET = LVLT
If clalev ([M:SDP])
    Raz [M:SDP]
Else
    Local Mask SAIDECPRI [SDP]    # Au moins nécessaire dans le cas de l'état valorisé au coût standard
Endif
    Case [L]WMET
        When 1 : Gosub TRT_DEF1 From STKVAL    # Standard
        When 2 : Gosub TRT_DEF2 From STKVAL    # Standard actualisé
        When 3 : Gosub TRT_DEF3 From STKVAL    # Dernier prix
        When 4 : Gosub TRT_DEF4 From STKVAL    # PMP
        When 5 : Gosub TRT_DEF5 From STKVAL    # FIFO
        When 6 : Gosub TRT_DEF6 From STKVAL    # PM Lot
        When 7 : LPRI=LORDPRI                  # Prix ordre
        When 8 : Gosub TRT_DEF8 From STKVAL    # LIFO
        When 9 : Gosub TRT_DEF9 From STKVAL    # Dernier prix d'achat
        When 10: Gosub TRT_DEF10 From STKVAL    # Standard budget
        When 11: Gosub TRT_DEF11 From STKVAL    # Standard simulé

    Endcase
End













