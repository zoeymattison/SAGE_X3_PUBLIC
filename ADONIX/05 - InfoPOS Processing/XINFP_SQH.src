###########################################################################################
# Script            : XINFP_SQH
# Creation date     : 19/06/2018
# Version           : 1.0.0
# Authors (Company) : RH (InfoPOS)
# Module            : SALES
# ----------------------------------------------------------------------------------------
# Project code      : InfoPOS X3 INTEGRATION
# Description       : SALES QUOTE INTEGRATION
#-----------------------------------------------------------------------------------------
#
# Evolutions        : (sequence, reference (Bug reference),) date, author, description
#                   : @nn@ – DD/MM/YYYY , XXXXX , NMA
###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When "IMP_ZONE" : Gosub IMP_ZONE
        When "IMP_TAB"  : Gosub IMP_TAB
        When "IMP_ADD"  : Gosub IMP_ADD
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES SALES QUOTE
########################################################################################################################
Subprog SQH_TRANS()
    If !clalev([F:XINFSQH]) : Local File XINFSQH [F:XINFSQH] : Endif
    If !clalev([F:XINFSQD]) : Local File XINFSQD [F:XINFSQD] : Endif
    If !clalev([F:XSQHA])   : Local File SQUOTE  [F:XSQHA]   : Endif

    # TODO - UPDATE OF MESSAGE
    Call ECR_TRACE("GENERATION OF SALES QUOTES",0) From GESECRAN
    Call ECR_TRACE("--------------------------",0) From GESECRAN

    Filter [F:XINFSQH] Where [F:XINFSQH]COMPLETED <> 2 Order By Key XINFSQH0

    For [F:XINFSQH]XINFSQH0
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("SALES QUOTE :" - [F:XINFSQH]CUSQUOREF,0) From GESECRAN

        # @RH@ - 19/06/2018 - CLEAR ALL ERRORS ASSOCIATED WITH THE CURRENT RECORD
        ##############################################################################################################
        Call DELETE_ERRORS([F:XINFSQH]SQHNUM) From XINFP_ERR

        # DETERMINE IF SALES QUOTE EXISTS
        Look [F:XSQHA]SQH0 = [F:XINFSQH]CUSQUOREF

        If fstat
            # CALL THE CREATION OF THE SALES ORDER
            Call TRANS_CRE From XINFP_SQH
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("SALES QUOTE EXISTS",0) From GESECRAN

        Endif

        # IMPORT VARIABLE DISABLE - USED FOR LOGGING PURPOSES
        GIMPORT = 0
    Next

    If clalev([F:XINFSQH]) : Close Local File  [F:XINFSQH] : Endif
    If clalev([F:XINFSQD]) : Close Local File  [F:XINFSQD] : Endif
    If clalev([F:XSQHA])   : Close Local File  [F:XSQHA]   : Endif
End

###########################################################################################
# UPDATE THE TRANSACTION AS COMPLETED
###########################################################################################
Subprog UPDATETRANS(XINFPNUM)
    Value Char XINFPNUM

    Call XERR_TRANS("SQH", XINFPNUM, [F:XINFSQH]EXPNUM, 2, 0, "SUCCESSFUL") From XINFP_ERR

    If !clalev([F:XUP]) : Local File XINFSQH [F:XUP] : Endif

    Trbegin [F:XUP]
        Update [F:XUP] Where [F:XUP]SQHNUM = XINFPNUM With [F:XUP]COMPLETED = 2

        If fstat
            Rollback
        Else
            Commit
        Endif

    If clalev([F:XUP]) : Close Local File   [F:XUP] : Endif
End

# DECLARATION OF DEFAULT VARIABLES
#####################################################################################
$OUVRE_OBJ
    # OPENING OF TABLES NEEDED
    ############################################################################################
    If clalev([F:AOE])=0  : Local File AOBJEXT    [AOE]  : Endif
    If clalev([F:AOD])=0  : Local File AOBJEXTD   [AOD]  : Endif
    If clalev([F:APX])=0  : Local File APARIMPEXP [APX]  : Endif
    If clalev([F:AOR])=0  : Local File AOBJEXTR   [AOR]  : Endif
    If clalev([F:ACC_])=0 : Local File ACCES      [ACC_] : Endif
    If clalev([F:AOB_])=0 : Local File AOBJET     [AOB_] : Endif
    If clalev([F:AWI_])=0 : Local File AWINDOW    [AWI_] : Endif
    If clalev([F:ATY_])=0 : Local File ATYPE      [ATY_] : Endif
    If clalev([F:AMK_])=0 : Local File AMSK       [AMK_] : Endif
    If clalev([F:AMZ_])=0 : Local File AMSKZON    [AMZ_] : Endif
    If clalev([F:ATB_])=0 : Local File ATABLE     [ATB_] : Endif
    If clalev([F:ATZ_])=0 : Local File ATABZON    [ATZ_] : Endif
    If clalev([F:ATI_])=0 : Local File ATABIND    [ATI_] : Endif
    If clalev([F:AMP_])=0 : Local File AMSKPAR    [AMP_] : Endif
    If clalev([F:AFC_])=0 : Local File AFONCTION  [AFC_] : Endif
    If clalev([F:ACV_])=0 : Local File ACTIV      [ACV_] : Endif
    If clalev([F:ANM_])=0 : Local File ACODNUM    [ANM_] : Endif
    If clalev([F:AOU])=0  : Local File AOBJEXTMPE [AOU]  : Endif
    If clalev([F:AOV])=0  : Local File AOBJEXTMPD [AOV]  : Endif

    # DECLARATION OF LOCAL MASKS
    ###########################################################################################3
    If clalev([M:AOE0])=0 : Local Mask AOE0       [AOE0] : Endif
    If clalev([M:AOE1])=0 : Local Mask AOE1       [AOE1] : Endif
    If clalev([M:AOE2])=0 : Local Mask AOE2       [AOE2] : Endif
    If clalev([M:IEX])=0  : Local Mask IMPTEST    [IEX]  : Endif
    If clalev([M:IMP2])=0 : Local Mask IMPOBJ2    [IMP2] : Endif

    # LOCAL VARIABLES
    ###########################################################################################3
    Local  Integer IMPSTA
    Local  Char    MESSAGE(250), BOITE_CRIT(GLONFEN) , FENETRE(GLONFEN)
    Local  Integer K , NOFIC  , NOENR,NBCRE , TYP , ER , STA, NBMOD
    Local  Integer C , NUMIMP , NBFIC , N   , L , OKTRT
    Local  Char    NOMTRT(GLONADC) , NOMVAR(40) , CHAINE(250) , SUF(30)
    Local  Char    TRTSRC(GDIMFIC)
    Local  Char    CLE(30) , NOMZONE(30) , NOMSUB(GLONASU)
    Local  Char    FIFO(GDIMFIC) , PRGBL(30)
    Local  Integer OPTCAR , NOLIB
    Local  Char    SAVFONC(GLONAFC) , SAVABR(GLONAOB) , SAVNAVIG(GLONANG)
    Local  Char    SAVPROG(GLONADC), SGTUNCPT(250)
    Local  Integer SAVPILNAV
    Local  Char    FICTMP(GDIMFIC) , FICFIN(GDIMFIC) , FICERR(GDIMFIC)
    Local  Char    REPTMP(GDIMFIC) , REPFIN(GDIMFIC) , REPERR(GDIMFIC)
    Local  Char    REPTRA(GDIMFIC)
    Local  Char    FICBAS(GDIMFIC) , REPERT(GDIMFIC) , FICORG(GDIMFIC)
    Local  Char    FICCLI(GDIMFIC)
    Local  Char    LISTEFIC(GDIMFIC)(1..1000)
    Local  Char    MACHINE(GDIMFIC) , MACTMP(GDIMFIC) , OS(10)
    Local  Char    BASPAG(GLONAVA)
    Local  Char    MODELE(GLONAOE), FICHIER(GDIMFIC), ZONTABLO(GLONAVA)
    Local  Char    SEPDEC(1) , CPTAOW(GLONANM)
    Local  Integer STAT,NBRLIGS,LIG,AOWENR,AOWSTA,II
    Local  Integer GESSAS
    Local  Char    ABREV(GLONAOB)
    Local  Integer PSTD,PSUB,PSPE,PSPV
    Local  Char    SAVCLE1(250)
    Local  Char    SAVCLE2(250)
    Local  Integer XLINE, XLINCNT
    Global Integer XTAX
    Global Decimal XINFPRND

    # CLEARING OF LOCAL VARIABLES
    ###########################################################################################
    Raz GLOTAOW,GIMP, REPTMP , REPFIN , REPERR, NOFIC, NOENR, NBCRE ,NBMOD, GPILNAV,GPILOBJ, GTUNCPT
Return

# FILLS BUFFER INFORMATION TO SCREEN
#####################################################################################
$IMP_ZONE
    Case IMPZON
        When "SALFCY"     : [M]SALFCY               = [F:XINFSQH]SALFCY
        When "SQHTYP"     : [M]SQHTYP               = [F:XINFSQH]SQHTYP
        When "SQHNUM"     : [M]SQHNUM               = [F:XINFSQH]CUSQUOREF
        When "BPCORD"     : [M]BPCORD               = [F:XINFSQH]BPCORD
        When "CUSQUOREF"  : [M]CUSQUOREF            = [F:XINFSQH]INFREF
        When "QUODAT"     : [M]QUODAT               = [F:XINFSQH]QUODAT

        When "REP1"       : [M]REP1                 = [F:XINFSQH]REP1
        When "REP2"       : [M]REP2                 = [F:XINFSQH]REP2
        When "STOFCY"     : [M]STOFCY               = [F:XINFSQH]SALFCY

        When "INVDTAAMT"  : [M]INVDTAAMT(indice)    = XINFPRND * -1
    Endcase
Return

# FILLS BUFFER INFORMATION TO SCREEN
#####################################################################################
$IMP_TAB
    Case IMPZON
        When "DSTOFCY"    : [M]DSTOFCY(indice)      = [F:XINFSQD]DSTOFCY
        When "ITMREF"     : [M]ITMREF(indice)       = [F:XINFSQD]ITMREF
        When "ITMDES"     : [M]ITMDES(indice)       = [F:XINFSQD]ITMDES
        When "SAU"        : [M]SAU(indice)          = [F:XINFSQD]SAU
        When "QTY"        : [M]QTY(indice)          = [F:XINFSQD]QTY
        When "GROPRI"     : [M]GROPRI(indice)       = [F:XINFSQD]GROPRI
        When "DISCRGVAL1" : [M]DISCRGVAL1(indice)   = [F:XINFSQD]DISCRGVAL1
        When "DISCRGVAL2" : [M]DISCRGVAL2(indice)   = [F:XINFSQD]DISCRGVAL2
        When "REP1"       : [M]REP1(indice)         = [F:XINFSQD]REP1
        When "REP2"       : [M]REP2(indice)         = [F:XINFSQD]REP2
    Endcase
Return

# FILLS THE ADDRESS SCREEN
#####################################################################################
$IMP_ADD
    Case IMPZON
        When "BPAADD"    : [M]BPAADD       = [F:XINFSQH]BPAADD
        When "BPAADDLIG" : If [F:XINFSQH]BPAADDLIG1 <> '' : [M]BPAADDLIG(0) = [F:XINFSQH]BPAADDLIG1 : Endif
                           If [F:XINFSQH]BPAADDLIG2 <> '' : [M]BPAADDLIG(1) = [F:XINFSQH]BPAADDLIG2 : Endif
                           If [F:XINFSQH]BPAADDLIG3 <> '' : [M]BPAADDLIG(2) = [F:XINFSQH]BPAADDLIG3 : Endif
        When "CRY"       : #If [F:XINFSOH]CRY        <> '' : [M]CRY          = [F:XINFSQH]CRY        : Endif
        When "SAT"       : If [F:XINFSQH]SAT        <> '' : [M]SAT          = [F:XINFSQH]SAT        : Endif
        When "POSCOD"    : If [F:XINFSQH]POSCOD     <> '' : [M]POSCOD       = [F:XINFSQH]POSCOD     : Endif
        When "CTY"       : If [F:XINFSQH]CTY        <> '' : [M]CTY          = [F:XINFSQH]CTY        : Endif
     Endcase
Return

# CREATION OF SALES QUOTE
##################################################################################################
Subprog TRANS_CRE
    Gosub OUVRE_OBJ

    ABREV = "SQH"
    GFLAG = ""

    # ADDED CODE TO OPEN THE WINDOW ASSOCIATED WITH ENTRY TRANSACTION, USING GENERATED SCREENS
    # TO IMPORT DATA
    ################################################################################################
    If clalev([AWIZ]) = 0 :  Local File AWINDOW [AWIZ] : Endif
    Filter [AWIZ] Where OBJ=ABREV and TRN = GFLAG and ENAFLG=2 and MDL<>2 Order By Key AWI0
    Read [AWIZ]AWI0 First

    If fstat
        Call ECR_TRACE(mess(107,133,1),1) From GESECRAN
        End
    Endif

    Read [AOB_]ABREV = ABREV

    Call CONT_FEN(ABREV,FENETRE) From GOBJET
    If FENETRE<>""
        Read [AWI_]AWI0  = FENETRE
    Else
        Raz [F:AWI_]
    Endif

    GIMPORT = 1
    GFLAG      = ""
    GPILNAV    = 2
    GIMPORT    = 1

    NOENR += 1

    GOBJET     = 1
    GORITITCOL = 0
    GABREV     = ABREV
    GPROGRAMME = "GOBJSUB"
    GTRAITE    = "GOBJET"
    GFONCTION  = "GES"+ABREV

    Gosub DEFVAR From GOBJET

    RUPT     = 1
    IMPORTYP = 1
    OK = 1

    Call CONT_FEN(GABREV,GBOITE) From GOBJET
    If GBOITE=""
        If IMPORTYP=2
            WINPROG = ""
        Else
            Call ECR_TRACE(mess(107,133,1),1) From GESECRAN
            OK = 0
            Goto RETCLOSE
        Endif
    Else
        If dim(WINPROG)<=0
            Local Char WINPROG(GLONADC)
        Endif
        Call NOMTRTWIN(GBOITE,WINPROG) From MSKDIV
    Endif

    Call SETPROG(GABREV,PROGOBJ,PROGSUB,PROGSPE,PROGSPV,PSTD,PSUB,PSPE,PSPV) From CONTOBJ

    TUNNEL = 0
    Gosub NOMFIC From =PROGOBJ

    If evalue("clalev([F:"+ABFIC+"])")=0 : Gosub OUVFIC From =PROGOBJ : Endif

    ACTION = "AVANT_OUVRE" : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ
    GPE = 0

    Gosub OUVRE From =PROGOBJ
    If clalev([F:ACC])=0 : Local File ACCES [ACC] : Endif
    For MA=0 To dim(AMA)-1 : AMA(MA) = 1 : Next I

    ACTION = "DEFTRANS" : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ

    If clalev([F:AWI])=0 : Local File AWINDOW [AWI] : Endif
    Read [AWI]AWI2(2) = GABREV;GFLAG
    If !fstat
        GBOITE = [F:AWI]WIN
    Endif

    If dim(WINPROG)<=0
        Local Char WINPROG(GLONADC)
    Endif

    Call NOMTRTWIN(GBOITE,WINPROG) From MSKDIV

    NBMASK = -1
    If WINPROG<>"" : Gosub DEFVAR From =WINPROG : Endif
    Gosub OUVRE_MSK From GOBJET

    ACTION = "OUVRE" : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ
    If OK=0 : Goto RETCLOSE : Endif

    For MA=0 To NBMASK
        If AMA(MA) : Gosub SETMASK From =WINPROG : Endif
    Next MA

    Gosub SETCLE From =PROGOBJ
    If evalue("type([F:"+ABFIC+"]"+CLEPRIM+")")>10
        TPCLE1 = 1
    Else
        TPCLE1 = 2
    Endif
    For CL=0 To dim(CLESEC)-1
        If CLESEC(CL)<>""
            If evalue("type([F:"+ABFIC+"]"+CLESEC(CL)+")")>10
                TPCLE2(CL) = 1
            Elsif evalue("type([F:"+ABFIC+"]"+CLESEC(CL)+")")=3
                TPCLE2(CL) = 3
            Else
                TPCLE2(CL) = 2
            Endif
        Endif
    Next CL

    Gosub INIT_BOITE From =WINPROG

    # SET OBJECT TO POINT TO NEW RECORD CREATION
    ##################################################################################################
    CLECUR = 0 : Gosub RELIT From GOBJSUB
    REP = "C" : GREP = "C" : [L]SITCUR = "" : XHEADDISC = 0
    Gosub SETBOUT From GOBJSUB : ACTCRE=1
    Gosub RAZCRE From GOBJNAV
    ACTION = "RAZCRE" : Gosub ACTION From GOBJET

    OK = 1 : GOK = 1

    # IMPORT OF DATA FOR MASK SQH0
    ##################################################################################################
    Default Mask [SQH0]
    mkstat = 0
    GNBAFF = 0
    Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2

    Call SAIMSK("SQH","IMP_ZONE","XINFP_SQH") From W0SQH0
    If mkstat
        Setmode
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR ON THE IMPORT OF SQH0",1) From GESECRAN
        GREP = "" : REP = ""
        Goto RETCLOSE
    Endif

    Setmode

    # IMPORT OF DATA FOR MASK SQH1
    ##################################################################################################
    Default Mask [SQH1]
    mkstat = 0
    GNBAFF = 0
    Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
    Call SAIMSK("SQH","IMP_ZONE","XINFP_SQH") From W0SQH1
    If mkstat
        Setmode
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR ON THE IMPORT OF SQH1",1) From GESECRAN
        GREP = "" : REP = ""
        Goto RETCLOSE
    Endif
    Setmode

    # V2018-688, R. HULSBOS
    # MULTIPLE DELIVERY ADDRESSED, UPDATE OF THE DELIVERY ADDRESS
    If [F:XINFSQH]BPAADD <> ''
        If [M:ADB2]BPAADDLIG(0) <> [F:XINFSQH]BPAADDLIG1   |
&          [M:ADB2]BPAADDLIG(1) <> [F:XINFSQH]BPAADDLIG2   |
&          [M:ADB2]BPAADDLIG(2) <> [F:XINFSQH]BPAADDLIG3   |
&          [M:ADB2]CRY          <> [F:XINFSQH]CRY          |
&          [M:ADB2]SAT          <> [F:XINFSQH]SAT          |
&          [M:ADB2]POSCOD       <> [F:XINFSQH]POSCOD       |
&          [M:ADB2]CTY          <> [F:XINFSQH]CTY

           If clalev([M:ADC]) = 0 : Local Mask ADRBPC      [M:ADC] : Endif
           If clalev([M:TCY]) = 0 : Local File TABCOUNTRY  [M:TCY] : Endif

           [M:ADC] = [M:ADB2]
           [M:ADC]ADBFLG = 1
           [M:ADC]ADBBPR = [F:XINFSQH]BPCORD
           [M:ADC]BPAADD = [F:XINFSQH]BPAADD

           Default Mask '[SQH0],[SQH1],[M:ADC]'
           mkstat = 0
           GNBAFF = 0
           #Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
           Call SAIMSK("SQH","IMP_ADD","XINFP_SQH") From W0ADRBPC
           If mkstat
             #  Setmode
               # TODO - UPDATE OF MESSAGE
               Call ECR_TRACE("ERROR ON THE IMPORT OF ADDRESS",1) From GESECRAN
               GREP = "" : REP = ""
               Goto RETCLOSE
           Endif
           #Setmode

           [M:ADB2]       = [M:ADC]
           [M:ADB2]ADBFLG = 2

           If clalev([M:ADC]) = 1 : Close Local Mask [M:ADC] : Endif
           If clalev([M:TCY]) = 1 : Close Local File [M:TCY] : Endif
        Endif
    Endif

    # IMPORT OF DATA FOR MASK SQH3
    ##################################################################################################
    Default Mask [SQH3]
    mkstat = 0
    GNBAFF = 0
    Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
    Call SAIMSK("SQH","IMP_ZONE","XINFP_SQH") From W0SQH3
    If mkstat
        Setmode
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR ON THE IMPORT OF SQH3",1) From GESECRAN
        GREP = "" : REP = ""
        Goto RETCLOSE
    Endif
    Setmode

    # IMPORT OF DATA FOR MASK SQH2
    ##################################################################################################
    Default Mask [SQH2]
    nolign = 0
    Raz XLINCNT

    # CAPTURE THE LINES OF THE SALES QUOTE
    If !clalev([F:XINFLIN]) : Local File XINFLIN  [F:XINFLIN] : Endif
    If !clalev([F:XTXC])    : Local File TEXCLOB  [F:XTXC]    : Endif
    If !clalev([F:XITS])    : Local File ITMSALES [F:XITS]    : Endif
    If !clalev([F:XBOMD])   : Local File BOMD     [F:XBOMD]   : Endif

    Delete [F:XINFLIN]XINFLIN0 = [F:XINFSQH]SQHNUM

    Filter [F:XINFSQD] Where  [F:XINFSQD]SQHNUM = [F:XINFSQH]SQHNUM
&   Order By Key XINFSQD0

    For [F:XINFSQD]XINFSQD0
        If nolign=0
            [M]NBLIG += 1
            nolign = [M]NBLIG
            status = 73
        Elsif status<>65 & status<>72
            status = 75
        Endif

        XLINCNT += 1

        If nolign=0
            [M]NBLIG += 1
            nolign = [M]NBLIG
            status = 73

            indice = nolign-1 : mkstat = 0
            GNBAFF = 0
            #Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
            Call SAI_NBLIG("SQH","IMP_TAB","XINFP_SQH") From W0SQH2

            If mkstat
                # Setmode
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("ERROR ON THE IMPORT OF SQH2",1) From GESECRAN
                GREP = "" : REP = ""
                Break
            Endif

            #Setmode : Raz GERREUR
        Else
            #Insa nolign-1,1,[M]NBLIG NBLIG
            status = 73
            [M]NBLIG += 1
            nolign = [M]NBLIG
            indice = nolign-1 : mkstat = 0
            GNBAFF = 0
            #Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
            Call SAI_NBLIG("SQH","IMP_TAB","XINFP_SQH") From W0SQH2

            If mkstat
                # Setmode
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("ERROR ON THE IMPORT OF SQH2",1) From GESECRAN
                GREP = "" : REP = ""
                Break
            Endif

            #Setmode : Raz GERREUR
        Endif

        # ADD THE COMMENT TO THE LINE
        If [F:XINFSQD]COMMENT <> ""
            Delete [F:XTXC]TXC0 = [F:XINFSQH]SQHNUM + "~"+ num$([F:XINFSQD]SQDLIN)

            Raz [F:XTXC]
            [F:XTXC]CODE  = [F:XINFSQH]SQHNUM + "~"+ num$([F:XINFSQD]SQDLIN)
            Setlob [F:XTXC]TEXTE  With [F:XINFSQD]COMMENT
            [F:XTXC]CREUSR= GUSER
            [F:XTXC]CREDAT= date$
            [F:XTXC]CRETIM= time
            Write [F:XTXC]

            [M:SQH2]SQDTEX(indice) = [F:XINFSQH]SQHNUM + "~"+ num$([F:XINFSQD]SQDLIN)
        Endif

        Raz [F:XINFLIN]

        [F:XINFLIN]NUM     = [F:XINFSQH]CUSQUOREF
        [F:XINFLIN]INFPLIN = [F:XINFSQD]SQDLIN
        [F:XINFLIN]X3LIN   = 1000 * XLINCNT

        Write [F:XINFLIN]

        # IN THE EVENT OF A BOM ITEM, WE NEED TO CATER FOR THE EXPLODED LINES, AND HENCE TAKE INTO CONSIDERATION THE LINES ADDED
        # ONTO THE SALES ORDER
        Columns [F:XITS] (ITMREF, ITMTYP)
        Read [F:XITS]ITS0 = [F:XINFSQD]ITMREF

        If [F:XITS]ITMTYP = 3

            Columns [F:XBOMD] (ITMREF,BOMALTTYP)
            Filter [F:XBOMD]
            Filter [F:XBOMD] Where [F:XBOMD]ITMREF = [F:XINFSQD]ITMREF and [F:XBOMD]BOMALTTYP = 1 Order By Key BOD0

            For [F:XBOMD]BOD0
                XLINCNT += 1
            Next

        Endif

        $SKIPT
    Next

    If clalev([F:XINFLIN]) : Close Local File [F:XINFLIN] : Endif
    If clalev([F:XTXC])    : Close Local File [F:XTXC]    : Endif
    If clalev([F:XITS])    : Close Local File [F:XITS]    : Endif
    If clalev([F:XBOMD])   : Close Local File [F:XBOMD]   : Endif

    # V2018-682, R. HULSBOS
    # NEW WAY OF DEALING WITH INVOICING ELEMENTS
    Default Mask "[SQH0],[SQH1],[SQH2],[SQH3]"
    Local Integer XXXINV

    For [L]XXXINV = 0 To dim([F:XXINFSIH]INVDTA) - 1
        If [F:XINFSQH]INVDTA([L]XXXINV) <> 0
            XINFPRND =  [F:XINFSQH]INVDTAAMT([L]XXXINV)

            # HEADER LEVEL DISCOUNT
            If find([F:XINFSQH]INVDTA([L]XXXINV),[M:SQH3]INVDTA(0..[M:SQH3]NBFAC))
                nolign = find([F:XINFSQH]INVDTA([L]XXXINV),[M:SQH3]INVDTA(0..[M:SQH3]NBFAC))
                indice = nolign-1 : mkstat = 0
                status = 75

                Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
                Call SAI_NBFAC("SQH","IMP_TAB","XINFP_SQH") From W0SQH3

                If mkstat
                    Setmode
                    # TODO - UPDATE OF MESSAGE
                    Call ECR_TRACE("ERROR DURING THE UPDATING OF THE INVOICING ELEMENT",1) From GESECRAN
                    GREP = "" : REP = "" : OK = 0
                Endif

                Setmode : Raz GERREUR
            Else
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("INVOICING ELEMENT DOES NOT EXIST",1) From GESECRAN
                OK = 0
            Endif
        Endif
    Next

    If !OK :
        GREP = ""
        # TODO - UPDATE OF MESSAGE
        Call XERR_TRANS("SQH", [F:XINFSQH]SQHNUM, [F:XINFSQH]EXPNUM, 1, 0, "ERROR ON THE SALES QUOTE CREATION - PLEASE REFER TO X3 LOG") From XINFP_ERR
        Goto RETCLOSE
    Endif

    # IMPORT OF DATA COMPLETE - CREATE ITEMS
    ##################################################################################################
    ACTION = "VERIF_CRE"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ

    If !OK :
        GREP = ""
        # TODO - UPDATE OF MESSAGE
        Call XERR_TRANS("SQH", [F:XINFSQH]SQHNUM, [F:XINFSQH]EXPNUM, 1, 0, "ERROR ON THE SALES QUOTE CREATION - PLEASE REFER TO X3 LOG") From XINFP_ERR
        Goto RETCLOSE
    Endif

    # VERIFY THAT THE TAXES ARE CORRECT BEFORE UPLOADING THE TRANSACTION
    If [M:SIHV]INVATI <> [F:XINFSQH]INFTOTINCL - abs([F:XINFSQH]INVDTAAMT(3))
        GREP = ""
        GOK = 0
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE(num$([M:SIHV]INVATI) - num$([F:XINFSQH]INFTOTINCL - abs([F:XINFSQH]INVDTAAMT(3))),0) From GESECRAN

        # TODO - UPDATE OF MESSAGE
        Call XERR_TRANS("SQH", [F:XINFSQH]SQHNUM, [F:XINFSQH]EXPNUM, 1, 0, "ERROR ON THE SALES QUOTE CALCULATED TAXES VS INFOPOS QUOTE HEADER TAXES - PLEASE REFER TO X3 LOG") From XINFP_ERR
        Goto RETCLOSE
    Endif

    GOK = 1
    Trbegin ADOVAL
        Gosub DEFAUT From =PROGOBJ
        Raz [F]
        nolign = 1

        Gosub CHARGEFIC From SUBIMPOBJ
        Gosub INICRE From GOBJSUB
        Gosub INIEXP From SUBIMPOBJ

        ACTION = "INICRE"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ

        If GOK < 0
            Gosub ROLL_TR1
            Goto RETCLOSE
        Elsif !GOK
            Gosub AB_TR1
            Goto RETCLOSE
        Endif

        Write
        If fstat
            GOK=0 : Call FSTA(ABFIC) From GLOCK
            Gosub AB_TR1
            Goto RETCLOSE
        Endif

        ACTION = "CREATION"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ
        If GOK < 0
            Gosub ROLL_TR1
            Goto RETCLOSE
        Elsif !GOK
            Gosub AB_TR1
            Goto RETCLOSE
        Endif

        Commit

    CLECUR1 = num$(evalue("[F]"+CLEPRIM))
    GCLE = num$(evalue("[F]"+CLEPRIM))
    For I=0 To dim(CLESEC)-1
        If CLESEC(I)<>""
            CLECUR2(I) = num$(evalue("[F]"+CLESEC(I)))
            GCLE += "\"+num$(evalue("[F]"+CLESEC(I)))
        Endif
    Next I

    CLECUR = 1

    ACTION = "APRES_CRE"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ

    Call TRACE2(0,GCLE,-1) From SUBIMPOBJ
    Call IDENT3(ABREV,IDENT,CLECUR1,CLECUR2) From GOBJTXT

    #Call ECR_TRACE(CLECUR1,0) From GESECRAN

    # TODO : TRANSACTION IS COMPELTED, FLAG AS COMPELTED
    If GOK : Call UPDATETRANS([F:XINFSQH]SQHNUM) From XINFP_SQH : Endif


    # END - RESTORE SAVED VARIABLES
    ##################################################################################################
    $RETCLOSE

    GPILNAV   = SAVPILNAV
    GNAVIG(1) = SAVNAVIG
    GABREV    = SAVABR
    GFONCTION = SAVFONC
    GIMPORT   = 0
    GREP      = ""

    Unlock =GCLE
    Unlock =CLECUR1
    Unlock =CLECUR2

    ACTION = "FIN" : Gosub ACTION From GOBJET
    If VERROU : Gosub DEVERROU From GOBJET : Endif
    OK = 1 : GOK = 1

    ACTION = "FERME" : Gosub ACTION From GOBJET

    If WINPROG <> ""
        Gosub FERME_BOITE From =WINPROG
        Gosub FERME_MASK From =WINPROG
    Endif
End

# ERROR DURING CREATION PHASE - ROLLBACK
##################################################################################################
$AB_TR1
    Rollback
    ACTION = "AB_CREATION"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ
Return

$ROLL_TR1
    Rollback
    Call ROLL From GLOCK
    If GROLL : Return : Endif
Return

# ERROR DURING MODIFICATION PHASE - ROLLBACK
##################################################################################################
$AB_TR2
    Rollback
    ACTION = "AB_MODIF"     : Gosub ACTION From GOBJSUB : Gosub DEFAUT From =PROGOBJ
Return

$ROLL_TR2
    Rollback
    Call ROLL From GLOCK
    If GROLL : Return  : Endif
Return




