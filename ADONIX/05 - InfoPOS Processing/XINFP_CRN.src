    If !clalev ([F:SLT]) : Local File SALTRS  [F:SLT] : Endif

    Gosub OUVRE_SIHX From TRTVENFACC

    If clalev([F:CFL])  Close Local File [CFL] : Endif
    Local File CPTANALIN [CFL]

Return

#####################################################################################
# InfoPOS INTEGRATION CODE - POSTING AND CREDIT NOTE
#
# @DESCRIPTION   - POST AN INVOICE
# @PARAM         - XINV : CREDIT NOTE NUMBER
#
#####################################################################################
Subprog POST_CRN(XCRN)
    Value    Char    XCRN

    Local Integer  OK, NBPCE, WRET
    Local Char     CRITERE(250), SYMBOLE(50)
    Local Integer  WCDTUNL
    Local Char     WPARAM(GLONADP)
    Local Char     WTRS(3)

    If clalev([F:SIH]) = 0 : Local File SINVOICE    [SIH] : Endif
    If clalev([F:SIV]) = 0 : Local File SINVOICEV   [SIV] : Endif
    If clalev([F:SID]) = 0 : Local File SINVOICED   [SID] : Endif
    If clalev([F:SVF]) = 0 : Local File SVCRFOOT    [SVF] : Endif
    If clalev([F:SVV]) = 0 : Local File SVCRVAT     [SVV] : Endif
    If clalev([F:FCY]) = 0 : Local File FACILITY    [FCY] : Endif
    If clalev([F:CPY]) = 0 : Local File COMPANY     [CPY] : Endif
    If clalev([F:BPR]) = 0 : Local File BPARTNER    [BPR] : Endif
    If clalev([F:BPC]) = 0 : Local File BPCUSTOMER  [BPC] : Endif
    If clalev([F:GAC]) = 0 : Local File GACCOUNT    [GAC] : Endif
    If clalev([F:CAC]) = 0 : Local File GACCCODE    [CAC] : Endif
    If clalev([F:DSP]) = 0 : Local File CADSP       [DSP] : Endif
    If clalev([F:CCE]) = 0 : Local File CACCE       [CCE] : Endif
    If clalev([F:AUZ]) = 0 : Local File CAAUZ       [AUZ] : Endif
    If clalev([F:TCU]) = 0 : Local File TABCUR      [TCU] : Endif
    If clalev([F:TCH]) = 0 : Local File TABCHANGE   [TCH] : Endif
    If clalev([F:TUN]) = 0 : Local File TABUNIT     [TUN] : Endif
    If clalev([F:GTE]) = 0 : Local File GTYPACCENT  [GTE] : Endif
    If clalev([F:FIY]) = 0 : Local File FISCALYEAR  [FIY] : Endif
    If clalev([F:PER]) = 0 : Local File PERIOD      [PER] : Endif
    If clalev([F:DUD]) = 0 : Local File GACCDUDATE  [DUD] : Endif
    If clalev([F:GAU]) = 0 : Local File GAUTACE     [GAU] : Endif
    If clalev([F:JOU]) = 0 : Local File GJOURNAL    [JOU] : Endif
    If clalev([F:ITM]) = 0 : Local File ITMMASTER   [ITM] : Endif
    If clalev([F:SDH]) = 0 : Local File SDELIVERY   [SDH] : Endif
    If clalev([F:STJ]) = 0 : Local File STOJOU      [STJ] : Endif
    If clalev([F:ABR]) = 0 : Local File ABATRQT     [ABR] : Endif

    If GMODU(2)=2 : If clalev([F:JST])=0 : Local File GAJOUSTA [JST] : Endif : Endif

    If clalev([F:SI2]) = 0 : Local File SINVOICE    [SI2] : Endif

    # OPENING OF MASK TO BE USED DURING THE POSTING PROCEDURE
    If clalev([M:ORDK]) = 0 : Local Mask ORDK [M:ORDK] : Raz [M:ORDK] : Endif

    If clalev([M:SIH0]) = 0 : Local Mask SIH0 [M:SIH0] : Raz [M:SIH0] : Endif
    If clalev([M:SIH1]) = 0 : Local Mask SIH1 [M:SIH1] : Raz [M:SIH1] : Endif
    If clalev([M:SIH2]) = 0 : Local Mask SIH2 [M:SIH2] : Raz [M:SIH2] : Endif
    If clalev([M:SIH4]) = 0 : Local Mask SIH4 [M:SIH4] : Raz [M:SIH4] : Endif
    If clalev([M:SIHV]) = 0 : Local Mask SIHV [M:SIHV] : Raz [M:SIHV] : Endif

    Filter [F:SI2]

    Call PARAMUTIL("SCDTUNL",WPARAM,"","") From SUBAUS
    WCDTUNL=val(WPARAM)
    If WCDTUNL = 0 : WCDTUNL = 1 : Endif

    NBPCE = 0

    # GLOBAL VARIABLES ASSIGNEMENT FOR LOADING OF DIMENSIONS
    Read [F:SI2]SIH0 = XCRN

    OK = 2
    Call CONTFCY([F:SI2]FCY) From CPTSUB
    Call GETCPY([F:SI2]FCY,"",0,"") From TRTX3CPT

    If mkstat : XGOK = 0 : OK = 1 : End : Endif

    # IF DIRECT BILL FROM MODULE SALES
    # RETRIEVE THE INVENTORY TRANSACTION
    # IF INVOICE WITH STOCK MOVEMENT, CONTROL OF THE CLIENT
    Call GETDEV([F:SI2]FCY)  From DEVSUB
    Call GLOBVAR([F:SI2]FCY) From WWGLOBVEN

    Read [F:SIV]SIV0 = [F:SI2]NUM

    If fstat : OK = 1  : End : Endif

    SYMBOLE = "SIV"+[F:SI2]NUM

    Lock =SYMBOLE With lockwait=0

    If fstat=1
        If GTRACE<>"" : Call ECR_TRACE([F:SI2]NUM-mess(10,100,1),1) From GESECRAN : Endif
    Else
        Call VALIDATION(2,[F:SI2]NUM) From TRTVENFACV

        Unlock =SYMBOLE

        Filter [F:SI2] Where [F:SI2]NUM = XCRN and [F:SI2]STA = 3 Order By Key SIH0
        Look [F:SI2]SIH0 First

        If !fstat
            Call UPDATETRANS([F:XINFSIH]NUM) From XINFP_CRN
        Else
            # TODO - UPDATE OF MESSAGE
            Call XERR_TRANS("CRN", [F:XINFSIH]NUM, [F:XINFSIH]EXPNUM, 1, 0, "SALES RETURN ERROR ON POSTING - PLEASE REFER TO X3 LOG") From XINFP_ERR
        Endif
    Endif

    Raz GREP
End

# CREATION OF SALES CREDIT NOTE
##################################################################################################
Subprog TRANS_CRE
##call ECR_TRACE('CRE1',0) from GESECRAN
    # USED TO DETERMINE THE SALES ENTRY TRANSACTION
    ######################################################################
    If clalev([F:SLT]) = 0 : Local File SALTRS      [SLT] : Endif
    #Call PARAM("","TRSFAC",GTRSFAC) From ADOVAL
    #GFLAG=GTRSFAC
    #Read [SLT]SLT0=5;GFLAG
    #If fstat
        GFLAG=""
    Filter [SLT] Where STRTYP=5 & ENAFLG=2 & find (INVTYP,2)

    Read [SLT] SLT0 First
    Filter [SLT]
    If fstat
      If GTRACE<>""
          Call ECR_TRACE(mess(287,192,1),1) From GESECRAN
        Endif
      Endif
      GFLAG=[F:SLT]STRNUM
    #Endif

    [F:SLT]PRNCOD1  =1 : # On force l'impression d'étiquettes à "Non"
    [F:SLT]PRNNBFLG1=1 : # On force le nbre d'impression à "Non"

    Gosub OUVRE_OBJ
    Local Integer GINVTYP

    ABREV = "SIH"

    Read [AOB_]ABREV = ABREV

    Call CONT_FEN(ABREV,FENETRE) From GOBJET
    If FENETRE<>""
        Read [AWI_]AWI0  = FENETRE
    Else
        Raz [F:AWI_]
    Endif

    GIMPORT = 1
    #GFLAG      = ""
    GPILNAV    = 2
    #GIMPORT    = 1
    GINVTYP = 2

    NOENR += 1

    GOBJET     = 1
    GORITITCOL = 0
    GABREV     = ABREV
    GPROGRAMME = "GOBJSUB"
    GTRAITE    = "GOBJET"
    GFONCTION  = "GES"+ABREV
    GFONC1     = "GES"+ABREV

    Gosub DEFVAR From GOBJET

    RUPT     = 1
    IMPORTYP = 1
    OK = 1

    Call CONT_FEN(GABREV,GBOITE) From GOBJET
    If GBOITE=""
        If IMPORTYP=2
            WINPROG = ""
        Else
            Call ECR_TRACE(mess(107,133,1),1) From GESECRAN
            OK = 0
            Goto RETCLOSE
        Endif
    Else
        If dim(WINPROG)<=0
            Local Char WINPROG(GLONADC)
        Endif
        Call NOMTRTWIN(GBOITE,WINPROG) From MSKDIV
    Endif

    Call SETPROG(GABREV,PROGOBJ,PROGSUB,PROGSPE,PROGSPV,PSTD,PSUB,PSPE,PSPV) From CONTOBJ

    TUNNEL = 0
    Gosub NOMFIC From =PROGOBJ

    If evalue("clalev([F:"+ABFIC+"])")=0 : Gosub OUVFIC From =PROGOBJ : Endif

    ACTION = "AVANT_OUVRE" : Gosub ACTION From GOBJET
    GPE = 0

    Gosub OUVRE From =PROGOBJ
    If clalev([F:ACC])=0 : Local File ACCES [ACC] : Endif
    For MA=0 To dim(AMA)-1 : AMA(MA) = 1 : Next I

    ACTION = "DEFTRANS" : Gosub ACTION From GOBJET
    Local Integer TYPFAC : FACTYP = 2
    GFACTYP = 2

    If clalev([F:AWI])=0 : Local File AWINDOW [AWI] : Endif
    Read [AWI]AWI2(2) = GABREV;GFLAG
    If !fstat
        GBOITE = [F:AWI]WIN
    Endif

    If dim(WINPROG)<=0
        Local Char WINPROG(GLONADC)
    Endif

    Call NOMTRTWIN(GBOITE,WINPROG) From MSKDIV

    NBMASK = -1
    If WINPROG<>"" : Gosub DEFVAR From =WINPROG : Endif
    Gosub OUVRE_MSK From GOBJET

    ACTION = "OUVRE" : Gosub ACTION From GOBJET
    If OK=0 : Goto RETCLOSE : Endif

    FACTYP = 2
    GFACTYP = 2

    If clalev([F:TSV]) = 0 : Local File TABSIVTYP   [F:TSV] : Endif
    If clalev([F:TCA]) = 0 : Local File TABCOUAFF   [F:TCA] : Endif
    If clalev([F:DUD]) = 0 : Local File GACCDUDATE  [F:DUD] : Endif
    If clalev([F:DAE]) = 0 : Local File GACCENTRYD  [F:DAE] : Endif
    If clalev([F:SLT]) = 0 : Local File SALTRS      [F:SLT] : Endif

#    Call PARAM("","TRSFAC",GTRSFAC) From ADOVAL
#    GFLAG=GTRSFAC
#    Read [SLT]SLT0=5;GFLAG
#    If fstat
        GFLAG=""
        Filter [SLT] Where STRTYP=5 & ENAFLG=2 & find (INVTYP,2)

        Read [SLT] SLT0 First
        Filter [SLT]
        If fstat
          If GTRACE<>""
              Call ECR_TRACE(mess(287,192,1),1) From GESECRAN
              End
          Endif
        Endif
        GFLAG=[F:SLT]STRNUM
    #Endif
    [F:SLT]STKFLG   = 2
    [F:SLT]PRNCOD1  = 1
    [F:SLT]PRNNBFLG1= 1

    GSLTSTKFLG=[F:SLT]STKFLG
    GSLTENTCOD=[F:SLT]ENTCOD
    WSLTTRSCOD=[F:SLT]TRSCOD
    WSLTTRSFAM=[F:SLT]TRSFAM

    Gosub OUVRE_SIHX From TRTVENFACC

    #----- Changement pseudo table CPTFOOTLNK par CPTANALIN bis -----#
    If clalev([F:CFL])  Close Local File [CFL] : Endif
    Local File CPTANALIN [CFL]

    For MA=0 To NBMASK
        If AMA(MA) : Gosub SETMASK From =WINPROG : Endif
    Next MA

    Gosub SETCLE From =PROGOBJ
    If evalue("type([F:"+ABFIC+"]"+CLEPRIM+")")>10
        TPCLE1 = 1
    Else
        TPCLE1 = 2
    Endif
    For CL=0 To dim(CLESEC)-1
        If CLESEC(CL)<>""
            If evalue("type([F:"+ABFIC+"]"+CLESEC(CL)+")")>10
                TPCLE2(CL) = 1
            Elsif evalue("type([F:"+ABFIC+"]"+CLESEC(CL)+")")=3
                TPCLE2(CL) = 3
            Else
                TPCLE2(CL) = 2
            Endif
        Endif
    Next CL

    Gosub INIT_BOITE From =WINPROG

    Raz [M:SIH0]
    Raz [M:SIH1]
    Raz [M:SIH2]
    Raz [M:SIH4]

    # SET OBJECT TO POINT TO NEW RECORD CREATION
    ##################################################################################################
    CLECUR = 0 : Gosub RELIT From GOBJSUB
    REP = "C" : GREP = "C" : [L]SITCUR = ""
    Gosub SETBOUT From GOBJSUB : ACTCRE=1
    Gosub RAZCRE From GOBJNAV
    ACTION = "RAZCRE" : Gosub ACTION From GOBJET

    OK = 1 : GOK = 1

    # SET DEFAULT SCREENS
    Default Mask "[M:SIH0],[M:SIH1],[M:SIH2],[M:SIH4]"

    # IMPORT OF DATA FOR MASK SIH0
    ##################################################################################################
    Default Mask [SIH0]
    mkstat = 0
    GNBAFF = 0
    Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2

    Call SAIMSK("SIH","IMP_ZONE","XINFP_CRN") From W0SIH0
    If mkstat
        Setmode
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR ON THE IMPORT OF SIH0",1) From GESECRAN
        GREP = "" : REP = ""
        Goto RETCLOSE
    Endif

    Setmode

    # NEW ERROR IN THAT IS NOT INITIATING THE COMPANY CODE
    # FORCE A INITIATE OF THE COMPANY CODE
    GFCY = [M:SIH0]SALFCY
    Call GETDEV([M:SIH0]SALFCY) From DEVSUB
    GCUR = GLOCALDEV

    # IMPORT OF DATA FOR MASK SIH1
    ##################################################################################################
    Default Mask [SIH1]
    mkstat = 0
    GNBAFF = 0
    Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
    Call SAIMSK("SIH","IMP_ZONE","XINFP_CRN") From W0SIH1
    If mkstat
        Setmode
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR ON THE IMPORT OF SIH1",1) From GESECRAN
        GREP = "" : REP = ""
        Goto RETCLOSE
    Endif
    Setmode

    # IMPORT OF DATA FOR MASK SIH2
    ##################################################################################################
    Default Mask [SIH2]
    mkstat = 0
    GNBAFF = 0
    Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
    Call SAIMSK("SIH","IMP_ZONE","XINFP_CRN") From W0SIH2
    If mkstat
        Setmode
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("ERROR ON THE IMPORT OF SIH2",1) From GESECRAN
        GREP = "" : REP = ""
        Goto RETCLOSE
    Endif
    Setmode

    # IMPORT OF DATA FOR MASK SIH4
    ##################################################################################################
    If clalev([F:SRH]) = 0 : Local File SRETURN  [F:SRH] : Endif
    If clalev([F:SRD]) = 0 : Local File SRETURND [F:SRD] : Endif

    Default Mask [SIH4]
    nolign  = 1
    Local Char GBOXSR1(30), GBOXSVIC1(30),GBOXSD1(30), GBOXSO3(30), GBOXSI1(30), GBOXCO1(30), GBOXSR3(30)

    GBOXSR1 = "GAU_CHE2"
    currbox = GBOXSR1
    OK = 1 : GOK = 1

    ACTION = "DEB_PICK"
    Gosub ACTION From GOBJET

    # @RH@ - 21/02/2018 - IN THE CASE OF A RETURN POSSIBLE HAVING BEEN GENERATED WITH ANOTHER RECORD PREFIX ARTrans
    ##############################################################################################################
    Local Char XRET(30)

    Look [F:XSRHA]SRH0 = left$([F:XINFSIH]INVREF,instr(0,[F:XINFSIH]INVREF,"-")) +"ARTrans"

    If fstat
        XRET = [F:XINFSIH]INVREF
    Else
        XRET = left$([F:XINFSIH]INVREF,instr(0,[F:XINFSIH]INVREF,"-")) +"ARTrans"
    Endif


    # @RH@ - 05/12/2017 , CHANGE OF DOCUMENT NUMBER BEING POPULATED FROM INFOPOS
    # Filter [F:SRD] Where [F:SRD]SRHNUM = [F:XINFSIH]NUM
    Filter [F:SRD] Where [F:SRD]SRHNUM = XRET
&   Order By Key SRD0

    For [F:SRD]SRD0
        nolign = [M:SIH4]NBLIG
        Insa nolign,1,[M:SIH4]NBLIG [M:SIH4]NBLIG
        [M:SIH4]NBLIG += 1
        nolign = [M:SIH4]NBLIG
        NOL = nolign-1
        status = 0

        Read [F:XINFLIN]XINFLIN2 = [F:XINFSIH]INVREF;[F:SRD]SRDLIN

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("MATCHING CUSTOMER RETURN LINE NOT FOUND",1) From GESECRAN
            GOK = 0
            Break
        Endif

        Filter [F:XINFSID] Where [F:XINFSID]NUM    =  [F:XINFSIH]NUM and
&                                [F:XINFSID]SIDLIN =  [F:XINFLIN]INFPLIN
&       Order By Key XINFSID0

        Read [F:XINFSID]XINFSID0 First

        #ACTION = "PICKE"
        #Gosub ACTION From GOBJET

        Read [F:ITM]ITM0 = [F:SRD]ITMREF

        Call ALISRDSIH(NOL) From TRTVENFAC
        Call LINNUM("SIDLIN") From TABLEAUX

        Call APRES_LIGNE(NOL,1) From SUBSIHB
        nolign  = NOL+1
        GNETMAR=1

        [M:SIH1]SIHORI=6
        Diszo [M:SIH1]STOFCY

        # Pas de gestion des stocks
        Default Mask [SIH4]
        Call STKRAZGRILIG("SIH4", NOL) From TRTVENSTK

        Call RECH_ORINUM From SUBSIHB

        If !GOK : Break : Endif
    Next

    Filter [F:SRD]

    # COMPLETE SELECTION
    ACTION = "FIN_PICK"
    Gosub ACTION From GOBJET

    # IF ANY ERROR DURING THE LOADING OF THE LINES, FAIL TRANSACTION
    If !OK or !GOK :
        GREP = ""
        Goto RETCLOSE
    Endif

    # CALCULATION OF INVOICE TOTALS
    If [F:TCU]CUR<>[M:SIH0]CUR
        Read [TCU]TCU0=[M:SIH0]CUR
    Endif

    Raz [M:SIHV], [M:SIHX]

    Local Char     WKU_MAJ(30) : WKU_MAJ="2"

    If [F:TCU]CUR<>[M:SIH0]CUR
        Read [TCU]TCU0=[M:SIH0]CUR
    Endif

    # V2018-682, R. HULSBOS
    # NEW WAY OF DEALING WITH INVOICING ELEMENTS
    Local Integer XXXINV

    For [L]XXXINV = 0 To dim([F:XINFSIH]INVDTA) - 1
        If [F:XINFSIH]INVDTA([L]XXXINV) <> 0
            XINFPRND =  [F:XINFSIH]INVDTAAMT([L]XXXINV)

            # HEADER LEVEL DISCOUNT
            If find([F:XINFSIH]INVDTA([L]XXXINV),[M:SIH2]INVDTA(0..[M:SIH2]NBFAC))
                nolign = find([F:XINFSIH]INVDTA([L]XXXINV),[M:SIH2]INVDTA(0..[M:SIH2]NBFAC))
                indice = nolign-1 : mkstat = 0
                status = 75

                Setmode INBAFF,IAFFCOD,IAFFMASK,IAFFCHP,IAFFIND,IAFFTXT,IAFFRANG,IAFFOPT1,IAFFOPT2
                Call SAI_NBFAC("SIH","IMP_ZONE","XINFP_CRN") From W0SIH2

                If mkstat
                    Setmode
                    # TODO - UPDATE OF MESSAGE
                    Call ECR_TRACE("ERROR DURING THE UPDATING OF THE INVOICING ELEMENT",1) From GESECRAN
                    GREP = "" : REP = "" : OK = 0
                Endif

                Setmode : Raz GERREUR
            Else
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("INVOICING ELEMENT DOES NOT EXIST",1) From GESECRAN
                OK = 0
            Endif
        Endif
    Next

    Gosub CHARG_TABLEAUX From TRTVENFACC
    Gosub CAL_FACTURE    From TRTVENFACC

    # CALCULATION OF THE LINE TAX AMOUNTS
    Gosub TAXES_LIGNES   From TRTVENFACV

    # SETS THE PRINTED FLAG AS PRINTED IN THE EVENT OF THE INTERFACE SPECIFYING IT SHOULD DO SO
    If [F:XINFSIH]PRINT = 2
        [M:SIH1]STARPT = 2
        [F:SIH]STARPT = 2
        [F:SIV]STARPT = 2
    Endif

    # IMPORT OF DATA COMPLETE - CREATE ITEMS
    ##################################################################################################
    ACTION = "VERIF_CRE"     : Gosub ACTION From GOBJET

    # VERIFY THAT THE TAXES ARE CORRECT BEFORE UPLOADING THE TRANSACTION
    If [M:SIHV]INVATI <> [F:XINFSIH]INFTOTINCL - abs([F:XINFSIH]INVDTAAMT(3))
        GREP = ""
        GOK = 0 : OK = 0
        # TODO - UPDATE OF MESSAGE
        ##Call ECR_TRACE(num$([M:SIHV]INVATI) - num$([F:XINFSIH]INFTOTINCL - abs([F:XINFSIH]INVDTAAMT(3))),0) From GESECRAN
        Call ECR_TRACE("ERROR ON THE SALES CREDIT NOTE CALCULATED TAXES VS INFOPOS DOCKET HEADER TAXES",1) From GESECRAN

    Endif

    If !OK :
        GREP = ""
        Goto RETCLOSE
    Endif

    GOK = 1
    Trbegin ADOVAL
        Gosub DEFAUT From =PROGOBJ
        Raz [F]
        nolign = 1

        For IMA=0 To NBMASK
          Gosub CHARGEFIC From =WINPROG
        Next IMA

        Gosub INICRE From GOBJSUB

        ACTION = "INICRE"     : Gosub ACTION From GOBJET

        [F:SIV]INVSTA = [M:SIH1]INVSTA
        [F:SIH]STA    = [F:SIV]INVSTA

        Call ACCNUM([F:SIH]ACCNUM) From SUBGAS

        If GOK < 0
            Gosub ROLL_TR1
            Goto RETCLOSE
        Elsif !GOK
            Gosub AB_TR1
            Goto RETCLOSE
        Endif

        Write
        If fstat
            GOK=0 : Call FSTA(ABFIC) From GLOCK
            Gosub AB_TR1
            Goto RETCLOSE
        Endif

        ACTION = "CREATION"     : Gosub ACTION From GOBJET
        Call CRE_ECHEANCES From TRTVENFACC

        If GOK < 0
            Gosub ROLL_TR1
            Goto RETCLOSE
        Elsif !GOK
            Gosub AB_TR1
            Goto RETCLOSE
        Endif

        Commit

    Default File "[F:SIH], [F:SID]"

    CLECUR1 = num$(evalue("[F]"+CLEPRIM))
    GCLE = num$(evalue("[F]"+CLEPRIM))
    For I=0 To dim(CLESEC)-1
        If CLESEC(I)<>""
            CLECUR2(I) = num$(evalue("[F]"+CLESEC(I)))
            GCLE += "\"+num$(evalue("[F]"+CLESEC(I)))
        Endif
    Next I

    CLECUR = 1

    ACTION = "APRES_CRE"     : Gosub ACTION From GOBJET

    Call TRACE2(0,GCLE,-1) From SUBIMPOBJ
    Call IDENT3(ABREV,IDENT,CLECUR1,CLECUR2) From GOBJTXT

    If [F:SIV]NUM <> ""
        Unlock =[F:SIV]NUM

        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("SALES CREDIT NOTE SUCCESSFUL : " - [F:SIV]NUM,0) From GESECRAN

        Call POST_CRN([F:SIV]NUM) From XINFP_CRN
    Endif

    $RETCLOSE

    Kill [L]

    If clalev([M:SIHV])  = 1 : Close Local Mask [M:SIHV] : Endif
    If clalev([M:SIHX])  = 1 : Close Local Mask [M:SIHX] : Endif
    If clalev([F:TCA])   = 1 : Close Local File [F:TCA]  : Endif
    If clalev([F:ACV])   = 1 : Close Local File [F:ACV]  : Endif
    If clalev([F:TSV])   = 1 : Close Local File [F:TSV]  : Endif
    If clalev([F:GAU])   = 1 : Close Local File [F:GAU]  : Endif
    If clalev([F:ANM])   = 1 : Close Local File [F:ANM]  : Endif
    If clalev([F:SID1])  = 1 : Close Local File [F:SID1] : Endif
    If clalev([F:BPA])   = 1 : Close Local File [F:BPA]  : Endif
    If clalev([F:TRU])   = 1 : Close Local File [F:TRU]  : Endif
    If clalev([F:SRU])   = 1 : Close Local File [F:SRU]  : Endif
    If clalev([F:SWW])   = 1 : Close Local File [F:SWW]  : Endif
    If clalev([F:POQ])   = 1 : Close Local File [F:POQ]  : Endif
    If clalev([F:GCM])   = 1 : Close Local File [F:GCM]  : Endif
    If clalev([M:ALP])   = 1 : Close Local Mask [M:ALP]  : Endif
    If clalev([M:SOW])   = 1 : Close Local Mask [M:SOW]  : Endif
    If clalev([M:SCL])   = 1 : Close Local Mask [M:SCL]  : Endif
    If clalev([M:STOK])  = 1 : Close Local Mask [M:STOK] : Endif
    If clalev([M:ORDK])  = 1 : Close Local Mask [M:ORDK] : Endif
    If clalev([M:MACW])  = 1 : Close Local Mask [M:MACW] : Endif
    If clalev([F:SIV1])  = 1 : Close Local File [F:SIV1] : Endif
    If clalev([M:ENTW])  = 1 : Close Local Mask [M:ENTW] : Endif
    If clalev([M:STW])   = 1 : Close Local Mask [M:STW]  : Endif
    If clalev([M:SVW])   = 1 : Close Local Mask [M:SVW]  : Endif
    If clalev([F:TCM])   = 1 : Close Local File [F:TCM]  : Endif
    If clalev([F:SVF])   = 1 : Close Local File [F:SVF]  : Endif
    If clalev([F:SVV])   = 1 : Close Local File [F:SVV]  : Endif
    If clalev([F:SID])   = 1 : Close Local File [F:SID]  : Endif
    If clalev([F:SIH])   = 1 : Close Local File [F:SIH]  : Endif
    If clalev([F:SIV])   = 1 : Close Local File [F:SIV]  : Endif
    If clalev([F:CAL])   = 1 : Close Local File [F:CAL]  : Endif
    If clalev([F:SFI])   = 1 : Close Local File [F:SFI]  : Endif
End
##call ECR_TRACE('CRE2',0) from GESECRAN
# ERROR DURING CREATION PHASE - ROLLBACK
##################################################################################################
$AB_TR1
    Rollback
    ACTION = "AB_CREATION"     : Gosub ACTION From GOBJET
Return

$ROLL_TR1
    Rollback
    Call ROLL From GLOCK
    If GROLL : Return : Endif
Return
















