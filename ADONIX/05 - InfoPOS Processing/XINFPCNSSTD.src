#<AdxTL>@(#)0.0.0.0 $Revision$ 
###########################################################################################
# Script            : XINFPCNSSTD
# Creation date     : 18/09/2018
# Version           : 1.0.0
# Authors (Company) : RH (InfoPOS)
# Module            : SUPERVISOR - PAYMENT INQUIRY WINDOW
# ----------------------------------------------------------------------------------------
# Project code      : InfoPOS X3 INTEGRATION
# Description       : MAIN ACTION OF THE INTEGRATION COMPONENT INTEGRATION
#-----------------------------------------------------------------------------------------
#
# Evolutions        : (sequence, reference (Bug reference),) date, author, description
#                   : @nn@ – DD/MM/YYYY , XXXXX , NMA
###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
   Case ACTION
        When "OUVRE"   : Gosub OUVRE
        When "LECTURE" : Gosub LECTURE
        When "SORTIE"  : Gosub SORTIE
    Endcase
Return

# SORT ORDER
###########################################################################################
$SORTIE

Return

# DECLARATION OF DEFAULT VARIABLES AND FILES
###########################################################################################
$OUVRE
    Local Char    CRITERE(250)(1..4), XNUM(250)
    Local Integer ICRIT
    Local Integer XINFP

    Local File PAYMENTD [F:XPYD]

    Raz XINFP

    Link [F:SIH] With [F:SIV]SIV0 = [F:SIH]NUM As [XLK1]
&   Order By Key SIH0
Return

# READING OF INFORMATION
###########################################################################################
$LECTURE
    Gosub CHANGE_MSK From GCONSULT

    MAXLIG = dim([M:XINFPW1]SIHNUM)

#    If CHGPAG < 0 : NOL = MAXLIG : Endif
#    If CHGPAG > 0 : NOL = 0 : Endif
NOL = 0

    If XINFP = 0 : XINFP = 1 : Return : Endif

    Gosub ADD_FILTER

    # ------------------------------------------------------- #
    # CHGPAG = 1    :    Search                               #
    # ------ = 2    :    Next                                 #
    #        = 3    :    F5 (Update page)                     #
    # CHGPAG = -1   :    Last                                 #
    # ------ = -2   :    Previous (previous page)             #
    # ------------------------------------------------------- #

    If CHGPAG > 0
        SUITE=1
        If CHGPAG = 1
            RETOUR = 1
        Elsif CHGPAG = 2
            RETOUR = 2
        Endif

        Filter [XLK1] Where evalue(CRITERE) Order By Key SIH0
    Else
        RETOUR=1
        If CHGPAG = -1
            SUITE = 1
        Else
            SUITE = 2
        Endif

        Filter [XLK1] Where evalue(CRITERE) Order By Key SIH0 Desc
    Endif

    If CHGPAG<>2 & CHGPAG<>-2 : Raz [M:XINFPW1] : Endif

    For [XLK1] With Nohint
        Gosub LOAD_DETAILS

        If CHGPAG > 0
            If NOL >= MAXLIG-1 : SUITE = 2 : Break : Endif
            NOL+=1
            If NOL = 0
                [L]XNUM = [F:SIH]NUM
            Endif
        Else
            If NOL <= 0 : RETOUR = 2 : Break: Endif
            NOL -= 1
            If NOL= MAXLIG-1
               [L]XNUM = [F:SIH]NUM
            Endif
        Endif
    Next

    Filter [XLK1]
Return

# APPLYING FILTER CRITERIA TO THE LOADING OF THE FILE
######################################################################################
$ADD_FILTER
    Raz CRITERE, ICRIT

    # COMPANY RECORD
    If [M:XINFPW0]CPY <> ""
        Call ADDCRIT(CRITERE,ICRIT,"CPY",'[F:SIH]CPY="'+[M:XINFPW0]CPY+'"'," & ") From GOBJSUB
    Endif

    # SITE
    If [M:XINFPW0]FCY <> ""
        Call ADDCRIT(CRITERE,ICRIT,"FCY",'[F:SIH]FCY="'+[M:XINFPW0]FCY+'"'," & ") From GOBJSUB
    Endif

    # NUM
    If [M:XINFPW0]NUM <> ""
        Call ADDCRIT(CRITERE,ICRIT,"NUM",'[F:SIH]NUM="'+[M:XINFPW0]NUM+'"'," & ") From GOBJSUB
    Endif

    # CUSTOMER
    If [M:XINFPW0]BPR <> ""
        Call ADDCRIT(CRITERE,ICRIT,"BPR",'[F:SIH]BPR="'+[M:XINFPW0]BPR+'"'," & ") From GOBJSUB
    Endif

    # INVOICE TYPE
    If [M:XINFPW0]INVFLG = 2 and [M:XINFPW0]CREFLG = 2
        Call ADDCRIT(CRITERE,ICRIT,"INVTYP",'FIND([F:SIV]INVTYP,1,2)'," & ") From GOBJSUB
    Endif

    If [M:XINFPW0]INVFLG = 2 and [M:XINFPW0]CREFLG <> 2
        Call ADDCRIT(CRITERE,ICRIT,"INVTYP",'[F:SIV]INVTYP = 1'," & ") From GOBJSUB
    Endif

    If [M:XINFPW0]CREFLG = 2 and [M:XINFPW0]INVFLG <> 2
        Call ADDCRIT(CRITERE,ICRIT,"INVTYP",'[F:SIV]INVTYP = 2'," & ") From GOBJSUB
    Endif

    # ACCOUNTING DATES
    If [M:XINFPW0]STRDAT<>[0/0/0]
        Call ADDCRIT(CRITERE, ICRIT,"ACCDAT",'[F:SIH]ACCDAT>=['+format$(GFMD,[M:XINFPW0]STRDAT)+']'," & ") From GOBJSUB
    Endif

    If [M:XINFPW0]ENDDAT<>[0/0/0]
        Call ADDCRIT(CRITERE, ICRIT,"ACCDAT",'[F:SIH]ACCDAT<=['+format$(GFMD,[M:XINFPW0]ENDDAT)+']'," & ") From GOBJSUB
    Endif

    # IN THE EVENT THAT THE NEXT AND LAST BUTTON IS PRESSED
    Case CHGPAG
        When 3 : Call ADDCRIT(CRITERE,ICRIT,"NUM",'[F:SIH]NUM > "' + [L]XNUM + '"'," & ") From GOBJSUB
        When 2 : Call ADDCRIT(CRITERE,ICRIT,"NUM",'[F:SIH]NUM > "' + [L]XNUM + '"'," & ") From GOBJSUB
        When -2 : Call ADDCRIT(CRITERE,ICRIT,"NUM",'[F:SIH]NUM < "' + [L]XNUM + '"'," & ") From GOBJSUB
    Endcase

Return

# LOAD THE DETAILS SCREEN WITH INVOICE INFORMATION
######################################################################################
$LOAD_DETAILS
    If NBLU = 1
        If CHGPAG=2 | CHGPAG=-2 : Raz [XLK1] : Endif
        NBLU = 2
    Endif

    nolign = NOL + 1

    Filter [F:XPYD]
    Filter [F:XPYD] Where [F:XPYD]VCRNUM = [F:SIH]NUM Order By Key PYD0
    Read [F:XPYD] First

    [M:XINFPW1]SIHNUM(nolign-1) = [F:SIH]NUM
    [M:XINFPW1]PYHNUM(nolign-1) = [F:XPYD]NUM
    [M:XINFPW1]AMTATI(nolign-1) = [F:SIH]AMTATI
    [M:XINFPW1]AMTLIN(nolign-1) = [F:XPYD]AMTLIN

Return




