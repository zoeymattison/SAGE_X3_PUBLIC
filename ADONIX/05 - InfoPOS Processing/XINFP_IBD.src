###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES SHIPMENTS / DELIVERIES
########################################################################################################################
Subprog TRANS_CRESDH()
    # TODO - UPDATE OF MESSAGE
    Call ECR_TRACE("GENERATION OF A SHIPMENT / DELIVERY",0) From GESECRAN

    Call TRANS_CRE From XINFP_IBD
End

# CREATION OF DELIVERY
##################################################################################################
Subprog TRANS_CRE
    Local Char    XLINE(255), XMESSAGE(255)
if !clalev ([F:YPOH]) : local file PORDER [F:YPOH] : endif
local char YSOH
Filter [F:YPOH] where [F:YPOH]POHNUM = [F:XINFITH]VCRNUM
Read [F:YPOH]POH0 First
if !fstat
  YSOH = [F:YPOH]OCNNUM 
endif
    Read [F:XSOHA]SOH0 = YSOH
    ##Read [F:XSOHA]SOH0 = [F:XINFITH]VCRNUM

    # DELETE OF CREATED FILE
    #############################################################################################################
    Local Integer STAT

    Call EFFACE(filpath("INFOPOS",[F:XINFITH]VCRNUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFITH]VCRNUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFITH]VCRNUM,'TXT')+".err",STAT) From ORDSYS

    GOK = 1

    ## CREATE SHIPMENT FILE FOR IMPORT
    #################################################################################
    adxifs = ';' : adxirs = chr$(13)+chr$(10)

    ## OPEN FILE
    #################################################################################
    Openo filpath("INFOPOS",[F:XINFITH]VCRNUM,'TXT') Using [FIC1]

    XLINE =   "H;"  + [F:XSOHA]SALFCY
    XLINE +=  ";"   + [F:XSOHA]STOFCY
    XLINE +=  ";"   + [F:XINFITH]VCRNUM  ##[F:XSOHA]SOHNUM
    XLINE + = ";"   + [F:XSOHA]BPCORD
    XLINE +=  ";"   + [F:XSOHA]CUR
    XLINE +=  ";"   + format$("D:DDMMYYYY",[F:XINFITH]IPTDAT)
    XLINE +=  ";"   + format$("D:DDMMYYYY",[F:XINFITH]IPTDAT)

    Wrseq XLINE Using [FIC1]

    # LOADS THE CONTENT OF THE DETAILED ORDER LINES
    Filter [F:XINFITD]
    Filter [F:XINFITD] Where [F:XINFITD]VCRNUM = [F:XINFITH]VCRNUM
&   Order By Key XINFITD0

    For [F:XINFITD]XINFITD0
        # READ MATCHING SALES ORDER LINE
##call ECR_TRACE('SO-'+[F:XSOQA]SOHNUM+' SOPLIN-'+num$([F:XSOQA]SOPLIN)+' ITM-'+[F:XSOQA]ITMREF+ ' ITMITD='+[F:XINFITD]ITMREF,0) from GESECRAN
        Link [F:XSOQA] With [F:XSOPA]SOP3 = [F:XSOQA]SOHNUM;[F:XSOQA]SOPLIN As [XLK1]
&                       Where [F:XSOQA]SOHNUM = [F:XSOHA]SOHNUM and
&                             [F:XSOQA]ITMREF = [F:XINFITD]ITMREF
&       Order By Key SOQ0

        Read [XLK1]SOQ0 First

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("UNABLE TO DETERMINE THE SALES ORDER LINE",0) From GESECRAN
            GOK = 0
            Break
        Endif

        # DETERMINE IF THERE IS STOCK ON HAND
        If !func CALC_QTY_ONHAND([F:XSOPA]SALFCY, [F:XSOQA]ITMREF, [F:XSOQA]QTYSTU)
            GOK = 0
            Break
        Endif

        # WRITE THE LINE DETAIL RECORD INFORMATION
        ########################################################################################################
        XLINE =   "L;"  + [F:XSOPA]SOHNUM
        XLINE +=  ";"   + num$([F:XSOPA]SOPLIN)
        XLINE + = ";"   + [F:XSOPA]ITMREF
        XLINE +=  ";"   + [F:XSOPA]SAU
        XLINE +=  ";"   + num$([F:XINFITD]QTYR)
        XLINE +=  ";"   + num$([F:XSOPA]GROPRI)

        Wrseq XLINE Using [FIC1]

        # WRITE THE STOCK LINE
        ########################################################################################################
        Filter [F:XINFITS] Where [F:XINFITS]VCRNUM = [F:XINFITD]VCRNUM and
&                                [F:XINFITS]VCRLIN = [F:XINFITD]VCRLIN
&       Order By Key XINFITS0

        For [F:XINFITS]XINFITS0
            XLINE  = "S;A;"
            XLINE += [F:XINFITS]SAU
            XLINE += ";1;;;"+ [F:XINFITS]SERNUM

            Wrseq XLINE Using [FIC1]
        Next

        $SKIPT
    Next

    ## CLOSE FILE
    #################################################################################
    Openo Using [FIC1]

    # WRITING OF FILE SUCCESSFUL, IMPORT THE FILE
    #############################################################################################################
    If GOK
        # CALLS THE IMPORT PROCESS
        # Call IMPORTSIL(IMPT, FIL) From GIMPOBJ
        # @ IMPT - TEMPLATE TO BE USED
        # @ FIL  - FILE + LOCATION
        ###############################################################
        Raz [M:IMP2]

        [M:IMP2]MODIMP = "XINFPISDH"
        [M:IMP2]NOMIMP = filpath("INFOPOS",[F:XINFITH]VCRNUM,'TXT')
        [M:IMP2]TYPEXP = 2

        Call IMPORTSIL([M:IMP2]MODIMP,[M:IMP2]NOMIMP) From GIMPOBJ

        # TODO - UPDATE OF MESSAGE
        # DETERMINE IF SHIPMENT / DELIVERY EXISTS
        Filter [F:XSDHA]
        Look [F:XSDHA]SDH0 = [F:XINFITH]VCRNUM

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call XERR_TRANS("IBT", [F:XINFITH]VCRNUM, [F:XINFITH]EXPNUM, 1, 0, "ERROR ON THE SHIPMENT / DELIVERY CREATION - PLEASE REFER TO X3 LOG") From XINFP_ERR
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("SUCCESS ON THE SHIPMENT CREATION",0) From GESECRAN

            # VALIDATE SHIPMENT
            Call GETCPY([F:XINFITH]FCYTO,"",0,"") From TRTX3CPT

            Call VALIDATION([F:XINFITH]VCRNUM) From TRTVENLIVV

            If GOK
                # UPDATE THE TRANSACTION AS INTEGRATED
                Call UPDATETRANS([F:XINFITH]VCRNUM) From XINFP_IBS
            Endif
        Endif
    Endif

    # DELETE OF CREATED FILE
    #############################################################################################################
    Local Integer STAT

    Call EFFACE(filpath("INFOPOS",[F:XINFITH]VCRNUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFITH]VCRNUM + ".TXT",'ERR'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFITH]VCRNUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFITH]VCRNUM + ".TXT",'ERR'),STAT) From ORDSYS
End

# COMPLETES SALES ORDER SCREEN OF ITEMS TO SHIP
# XFCY    - STOCKING SITE
# XITM    - ITEM NUMBER
# XQTY    - ALLOCATED QTY
#####################################################################################
Funprog CALC_QTY_ONHAND(XFCY, XITMREF, XQTY)
    Value Char    XFCY
    Value Char    XITMREF
    Value Decimal XQTY

    Local Decimal XTOT

    # DETERMINE IF ITEM IS KIT ITEM
    If clalev([F:XITS]) = 0 : Local File ITMSALES  [F:XITS] : Endif
    If clalev([F:XITM]) = 0 : Local File ITMMASTER [F:XITM] : Endif

    Read [F:XITM]ITM0 = XITMREF
    Read [F:XITS]ITS0 = XITMREF

    # IF KIT NOT KIT ITEM AND STOCK MANAGED, DETERMINE QTY ON HAND
    If [F:XITS]ITMTYP = 1 and [F:XITM]STOMGTCOD <> 1 and [F:XITM]NEGSTO <> 2
        Call QTY_ONHAND(XITMREF,XFCY,XQTY,XTOT) From XINFP_SDH

        If XQTY > XTOT
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE(XITMREF - " : QUANTITY TO ISSUE IS GREATER THAN STOCK AVAILABLE",0) From GESECRAN
            End 0
        Endif
    Elsif [F:XITS]ITMTYP = 3
        If clalev([F:XBOMD]) = 0 : Local File BOMD [F:XBOMD] : Endif

        Filter [F:XBOMD] Where [F:XBOMD]ITMREF = XITMREF and [F:XBOMD]BOMALTTYP = 1

        For [F:XBOMD]
            Read [F:XITM]ITM0 = [F:XBOMD]CPNITMREF
            If [F:XITM]STOMGTCOD <> 1
                Call QTY_ONHAND([F:XBOMD]CPNITMREF, XFCY, XQTY, XTOT) From XINFP_SDH

                If (XQTY * [F:XBOMD]LIKQTY) > XTOT
                    # TODO - UPDATE OF MESSAGE
                    Call ECR_TRACE([F:XBOMD]CPNITMREF - " : QUANTITY TO ISSUE IS GREATER THAN STOCK AVAILABLE",0) From GESECRAN
                    End 0
                Endif
            Endif
        Next
    Endif
End 1

# DETERMINES THE QTY ON HAND
# XITM    - ITEM NUMBER
# XFCY    - STOCKING SITE
# XQTY    - ALLOCATED QTY
# XONHAND - CALCULATED QTY ON HAND
######################################################################################################
Subprog QTY_ONHAND(XITM,XFCY,XQTY,XONHAND)
    Value Char        XITM
    Value Char        XFCY
    Value Decimal     XQTY
    Variable Decimal  XONHAND

    If clalev([F:XITV]) = 0 : Local File  ITMMVT [F:XITV]  : Endif

    Columns [F:XITV](ITMREF,STOFCY,PHYSTO,REJSTO,CTLSTO,PHYALL,REJALL,CTLALL,GLOALL)

    Read [F:XITV]ITV0 = XITM;XFCY

    If !fstat
        XONHAND = ([F:XITV]PHYSTO + [F:XITV]REJSTO + [F:XITV]CTLSTO + XQTY) - [F:XITV]PHYALL - [F:XITV]REJALL - [F:XITV]CTLALL - [F:XITV]GLOALL
    Else
        XONHAND = 0
    Endif

    If clalev([F:XITV]) = 1 : Close Local File   [F:XITV]  : Endif
End













