###########################################################################################
# Script            : XINFP_IBS
# Creation date     : 13/02/2018
# Version           : 1.0.0
# Authors (Company) : RH (InfoPOS)
# Module            : STOCK
# ----------------------------------------------------------------------------------------
# Project code      : InfoPOS X3 INTEGRATION
# Description       : TRANSFER OUT VIA POH/SOH/SDH/PTH - INTEGRATION
#-----------------------------------------------------------------------------------------
#
# Evolutions        : (sequence, reference (Bug reference),) date, author, description
#                   : @nn@ – DD/MM/YYYY , XXXXX , NMA
###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES TRANSFER OUT, CREATES PO/SO/SDH
########################################################################################################################
Subprog IBS_TRANS()
    If !clalev([F:XINFITH]) : Local File XINFITH   [F:XINFITH] : Endif
    If !clalev([F:XINFITD]) : Local File XINFITD   [F:XINFITD] : Endif
    If !clalev([F:XINFITS]) : Local File XINFITS   [F:XINFITS] : Endif
    If !clalev([F:XPOHA])   : Local File PORDER    [F:XPOHA]   : Endif
    If !clalev([F:XSOHA])   : Local File SORDER    [F:XSOHA]   : Endif
    If !clalev([F:XSOPA])   : Local File SORDERP   [F:XSOPA]   : Endif
    If !clalev([F:XSOQA])   : Local File SORDERQ   [F:XSOQA]   : Endif
    If !clalev([F:XSDHA])   : Local File SDELIVERY [F:XSDHA]   : Endif
    If !clalev([M:IMP2])    : Local Mask IMPOBJ2   [M:IMP2]    : Endif

    # TODO - UPDATE OF MESSAGE
    Call ECR_TRACE("GENERATION OF TRANSFERS OUT",0) From GESECRAN
    Call ECR_TRACE("-------------------X--------------------",0) From GESECRAN
#GT-AOV 17/01/2020 added filter XFLAG
##Filter [F:XINFITH] Where [F:XINFITH]VCRNUM = 'STR120006649'
    Filter [F:XINFITH] Where [F:XINFITH]VCRTYP = 2  and [F:XINFITH]FLOWTYP = 1 and [F:XINFITH]POSTED <> 2 and [F:XINFITH]XFLAG = 0
&   Order By Key XINFITH0

    For [F:XINFITH]XINFITH0
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("TRANSFER :" - [F:XINFITH]VCRNUM ,0) From GESECRAN

        # TODO - UPDATE OF MESSAGE
        # DETERMINE IF TRANSFER REQUEST PO EXISTS
        Look [F:XPOHA]POH0 = [F:XINFITH]VCRNUM

        If fstat
            # CALL THE CREATION OF THE TRANSFER PO
            Call TRANS_CREPO From XINFP_IBP

            # TODO - UPDATE OF MESSAGE
            # DETERMINE IF TRANSFER REQUEST DELIVERY EXISTS
            Look [F:XSDHA]SDH0 = [F:XINFITH]VCRNUM

            If fstat
                # CALL THE CREATION OF THE TRANSFER DELIVERY
                Call TRANS_CRESDH From XINFP_IBD
            Else
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("TRANSFER OUT DELIVERY EXISTS",0) From GESECRAN
                Call ECR_TRACE("TRANSFER COMPLETED",0) From GESECRAN

                # TODO - UPDATE OF MESSAGE
                Filter [F:XSDHA]
                Filter [F:XSDHA] Where [F:XSDHA]SDHNUM = [F:XINFITH]VCRNUM and [F:XSDHA]CFMFLG = 2 Order By Key SDH0
                Look [F:XSDHA]SDH0 First

                # UPDATE THE TRANSACTION AS INTEGRATED
                Call UPDATETRANS([F:XINFITH]VCRNUM) From XINFP_IBS
            Endif           
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("TRANSFER OUT PO EXISTS",0) From GESECRAN

            # TODO - UPDATE OF MESSAGE
            # DETERMINE IF TRANSFER REQUEST DELIVERY EXISTS
            Filter [F:XSDHA]
            Filter [F:XSDHA] Where [F:XSDHA]SDHNUM = [F:XINFITH]VCRNUM Order By Key SDH0
            Look [F:XSDHA]SDH0 First

            If fstat
                # CALL THE CREATION OF THE TRANSFER DELIVERY
                Call TRANS_CRESDH From XINFP_IBD
            Else
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("TRANSFER OUT DELIVERY EXISTS",0) From GESECRAN

                # TODO - UPDATE OF MESSAGE
                Filter [F:XSDHA]
                Filter [F:XSDHA] Where [F:XSDHA]SDHNUM = [F:XINFITH]VCRNUM and [F:XSDHA]CFMFLG = 2 Order By Key SDH0
                Look [F:XSDHA]SDH0 First

                If fstat
                    # VALIDATE SHIPMENT
                    Call GETCPY([F:XINFITH]FCYTO,"",0,"") From TRTX3CPT

                    Call VALIDATION([F:XINFITH]VCRNUM) From TRTVENLIVV

                    If GOK
                        # UPDATE THE TRANSACTION AS INTEGRATED
                        Call UPDATETRANS([F:XINFITH]VCRNUM) From XINFP_IBS
                    Endif
                Else
                    Call ECR_TRACE("TRANSFER COMPLETED",0) From GESECRAN

                    # UPDATE THE TRANSACTION AS INTEGRATED
                    Call UPDATETRANS([F:XINFITH]VCRNUM) From XINFP_IBS
                Endif
            Endif
        Endif

        # IMPORT VARIABLE DISABLE - USED FOR LOGGING PURPOSES
        GIMPORT = 0
    Next

    If clalev([F:XINFITH]) : Close Local File  [F:XINFITH] : Endif
    If clalev([F:XINFITD]) : Close Local File  [F:XINFITD] : Endif
    If clalev([F:XINFITS]) : Close Local File  [F:XINFITS] : Endif
    If clalev([F:XSMHA])   : Close Local File  [F:XSMHA]   : Endif
    If clalev([F:XSOHA])   : Close Local File  [F:XSOHA]   : Endif
    If clalev([F:XSOPA])   : Close Local File  [F:XSOPA]   : Endif
    If clalev([F:XSOQA])   : Close Local File  [F:XSOQA]   : Endif
    If clalev([F:XSDHA])   : Close Local File  [F:XSDHA]   : Endif
    If clalev([M:IMP2])    : Close Local Mask  [M:IMP2]    : Endif
End

###########################################################################################
# UPDATE THE TRANSACTION AS COMPLETED
###########################################################################################
Subprog UPDATETRANS(XINFPNUM)
    Value Char XINFPNUM
    If !clalev([F:XUP]) : Local File XINFITH [F:XUP] : Endif

    Call XERR_TRANS("IBT", XINFPNUM, [F:XINFITH]EXPNUM, 2, 0, "SUCCESSFUL") From XINFP_ERR

    Trbegin [F:XUP]
        Update [F:XUP] Where [F:XUP]VCRNUM = XINFPNUM With [F:XUP]POSTED = 2

        If fstat
            Rollback
        Else
            Commit
        Endif

    If clalev([F:XUP]) : Close Local File   [F:XUP] : Endif
End


































