###########################################################################################
# Script            : XINFP_PAYE
# Creation date     : 19/12/2017
# Version           : 1.0.0
# Authors (Company) : RH (InfoPOS)
# Module            : COMMON DATA
# ----------------------------------------------------------------------------------------
# Project code      : InfoPOS X3 INTEGRATION
# Description       : PAYMENT (REFUND - EXPENSE) INTEGRATION
#-----------------------------------------------------------------------------------------
#
# Evolutions        : (sequence, reference (Bug reference),) date, author, description
#                   : @nn@ – DD/MM/YYYY , XXXXX , NMA
###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES PAYMENT
########################################################################################################################
Subprog BPC_TRANS()
    If !clalev([F:XINFBPC]) : Local File XINFBPC    [F:XINFBPC] : Endif
    If !clalev([F:XINFBPA]) : Local File XINFBPA    [F:XINFBPA] : Endif
    If !clalev([F:XBPCA])   : Local File BPCUSTOMER [F:XBPCA]   : Endif
    If !clalev([F:XBCGA])   : Local File BPCCATEG   [F:XBCGA]   : Endif
    If !clalev([F:XBPAA])   : Local File BPADDRESS  [F:XBPAA]   : Endif

    # TODO - UPDATE OF MESSAGE
    Call ECR_TRACE("GENERATION/UPDATE OF CUSTOMERS",0) From GESECRAN
    Call ECR_TRACE("---------------X-------------- ",0) From GESECRAN

    Filter [F:XINFBPC] Where [F:XINFBPC]BPCNUM = '76500-66661'
##    Filter [F:XINFBPC] Where [F:XINFBPC]STAFLG <> 2
##&   Order By Key XINFBPC0

    For [F:XINFBPC]XINFBPC0
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("CUSTOMER :" - [F:XINFBPC]BPCNUM,0) From GESECRAN

        # @RH@ - 08/01/2018 - CLEAR ALL ERRORS ASSOCIATED WITH THE CURRENT RECORD
        ##############################################################################################################
        Call DELETE_ERRORS([F:XINFBPC]BPCNUM) From XINFP_ERR

        Call TRANS_CRE From XINFP_BPC
    Next

    If clalev([F:XINFBPC]) : Close Local File [F:XINFBPC] : Endif
    If clalev([F:XINFBPA]) : Close Local File [F:XINFBPA] : Endif
    If clalev([F:XBPCA])   : Close Local File [F:XBPCA]   : Endif
    If clalev([F:XBCGA])   : Close Local File [F:XBCGA]   : Endif
    If clalev([F:XBPAA])   : Close Local File [F:XBPAA]   : Endif
End

###########################################################################################
# UPDATE THE TRANSACTION AS COMPLETED
###########################################################################################
Subprog UPDATETRANS(XINFPNUM)
    Value Char    XINFPNUM

    Call XERR_TRANS("BPC", [F:XINFBPC]BPCNUM, [F:XINFBPC]EXPNUM, 2, 0, "SUCCESSFUL") From XINFP_ERR

    If !clalev([F:XUP]) : Local File XINFBPC [F:XUP] : Endif

    Trbegin [F:XUP]
        Update [F:XUP] Where [F:XUP]BPCNUM = XINFPNUM With [F:XUP]STAFLG = 2

        If fstat
            Rollback
        Else
            Commit
        Endif

    If clalev([F:XUP]) : Close Local File   [F:XUP] : Endif
End

# CREATION/UPDATE OF CUSTOMERS
##################################################################################################
Subprog TRANS_CRE
    Local Char    XLINE(255), XLINE2(255), XMESSAGE(255)
    Local Char    XLAN(30), XCUR(30), XBCGCOD(30), XBPAADD(30), XBPAADD2(30)
    Local Integer XSTAT, XDEF, XENA, XFND

    # DELETE OF CREATED FILE
    ############################################################################################################
    Call EFFACE(filpath("tmp",[F:XINFBPC]BPCNUM,'TXT') + ".err",[L]XSTAT) From ORDSYS

    GOK = 1

    # TODO - UPDATE OF MESSAGE
    # @RH@ - 19/12/2017 , IF THE CUSTOMER IS CREATED THEN THE LANGUAGE AND CURRENCY
    # DEFAULTS FROM THE CUSTOMER CATEGORY, BUT WHEN ITS MODIFICATION, THIS VALUES
    # MIGHT BE BLANK, SO TO ACCOMODATE THIS, WE WILL MAKE SURE IT DEFAULTS TO
    # ORIGINAL VALUES IF THE INCOMING VALUES ARE BLANK
    ################################################################################
    Columns [F:XBCGA] (BCGCOD, CUR)

    If [F:XINFBPC]BCGCOD = ''
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("NO CUSTOMER CATEGORY SPECIFIED, PLEASE UPDATE CONFIGURATION IN BACK OFFICE",1) From GESECRAN

        End
    Endif

    If [F:XINFBPC]CUR = ''
        Read [F:XBCGA]BCG0 = [F:XINFBPC]BCGCOD

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("NO CUSTOMER CATEGORY SPECIFIED, UNABLE TO DETERMINE CUSTOMER CURRENCY" - num$(fstat) - [F:XINFBPC]BCGCOD ,1) From GESECRAN

            End
        Endif

        [L]XCUR = [F:XBCGA]CUR
    Else
        [L]XCUR    = [F:XINFBPC]CUR
    Endif


    ## CREATE FILE FOR IMPORT
    #################################################################################
    adxifs = ';' : adxirs = chr$(13)+chr$(10)

    ## OPEN FILE
    #################################################################################
    Openo filpath("INFOPOS",[F:XINFBPC]BPCNUM,'TXT') Using [FIC1]
	
	#---GT-AOV 05-NOV-2020 - IF !NOUPDATE!,DO NOT UPDATE-----#
If !clalev([F:YBPDL])   : Local File BPDLVCUST [F:YBPDL]	: Endif
If !clalev([F:YBPCA])   : Local File BPCUSTOMER [F:YBPCA]	: Endif
If !clalev([F:YBPDA])   : Local File BPADDRESS [F:YBPDA]	: Endif
Filter [F:YBPCA] where BPCNUM= [F:XINFBPC]BPCNUM
Read [F:YBPCA]BPC0 first
if !fstat
	XFND = 2
	XBPAADD2 = [F:YBPCA]BPAADD
	if toupper([F:XINFBPC]BCGCOD)="!NOUPDATE!"
		XLINE  = "B;" + [F:YBPCA]BCGCOD
	Else
		XLINE  = "B;" + [F:XINFBPC]BCGCOD
	Endif
	if toupper([F:XINFBPC]BPCNUM)="!NOUPDATE!"
		XLINE += ";"  + [F:YBPCA]BPCNUM
	Else
		XLINE += ";"  + [F:XINFBPC]BPCNUM
	Endif
	##if toupper([F:XINFBPC]BPCNUM)="!NOUPDATE!"  ##GTAOV commented - If customer already exists do not update BPCINV
		XLINE += ";"  + [F:YBPCA]BPCNUM
	##Else
	##	XLINE += ";"  + [F:XINFBPC]BPCNUM
	##Endif
	if toupper([F:XINFBPC]BPCNAM)="!NOUPDATE!"
		XLINE += ";"  + [F:YBPCA]BPCNAM
	Else
		XLINE += ";"  + [F:XINFBPC]BPCNAM
	Endif
	#if toupper([F:XINFBPC]OSTCTL)="!NOUPDATE!"
		#XLINE += ";" #+ num$([F:YBPCA]OSTCTL)
	#Else
		XLINE += ";" + num$([F:XINFBPC]OSTCTL)
	#
	#Endif
	if toupper([F:XINFBPC]CUR)="!NOUPDATE!"
		XLINE += ";"  + [F:YBPCA]XCUR
	Else
		XLINE += ";"  + [L]XCUR
	Endif
	if toupper([F:XINFBPC]TSCCOD1)="!NOUPDATE!"
		XLINE += ";"  + [F:YBPCA]TSCCOD(0)
	Else
		XLINE += ";"  + [F:XINFBPC]TSCCOD1
	Endif
	if toupper([F:XINFBPC]TSCCOD2)="!NOUPDATE!"
		XLINE += ";"  + [F:YBPCA]TSCCOD(1)
	Else
		XLINE += ";"  + [F:XINFBPC]TSCCOD2
	Endif
	if toupper([F:XINFBPC]TSCCOD3)="!NOUPDATE!"
		XLINE += ";"  + [F:YBPCA]TSCCOD(2)
	Else
		XLINE += ";"  + [F:XINFBPC]TSCCOD3
	Endif
	if toupper([F:XINFBPC]TSCCOD4)="!NOUPDATE!"
		XLINE += ";"  + [F:YBPCA]TSCCOD(3)
	Else
		XLINE += ";"  + [F:XINFBPC]TSCCOD4
	Endif
	if toupper([F:XINFBPC]TSCCOD5)="!NOUPDATE!"
		XLINE += ";"  + [F:YBPCA]TSCCOD(4)
	Else
		XLINE += ";"  + [F:XINFBPC]TSCCOD5
	Endif
Else
    XLINE  = "B;" + [F:XINFBPC]BCGCOD
    XLINE += ";"  + [F:XINFBPC]BPCNUM
    XLINE += ";"  + [F:XINFBPC]BPCNUM
    XLINE += ";"  + [F:XINFBPC]BPCNAM
    XLINE += ";"  + num$([F:XINFBPC]OSTCTL)
    XLINE += ";"  + [L]XCUR
    XLINE += ";"  + [F:XINFBPC]TSCCOD1
    XLINE += ";"  + [F:XINFBPC]TSCCOD2
    XLINE += ";"  + [F:XINFBPC]TSCCOD3
    XLINE += ";"  + [F:XINFBPC]TSCCOD4
    XLINE += ";"  + [F:XINFBPC]TSCCOD5
Endif

If XFND = 2 and toupper([F:XINFBPA]BPAADD) = "!NOUPDATE!"
	XLINE += ";" + XBPAADD2
	XLINE += ";" + XBPAADD2
Else
    # READ THE DEFAULT ADDRESS
    Filter [F:XINFBPA]
    Filter [F:XINFBPA] Where [F:XINFBPA]BPCNUM = [F:XINFBPC]BPCNUM and [F:XINFBPA]BPAADDFLG = 2 Order By Key XINFBPA0
    Read [F:XINFBPA]XINFBPA0 First
    XLINE += ";" + [F:XINFBPA]BPAADD

    # READ THE DEFAULT SHIPTO ADDRESS
    Filter [F:XINFBPA]
    Filter [F:XINFBPA] Where [F:XINFBPA]BPCNUM = [F:XINFBPC]BPCNUM and [F:XINFBPA]BPDADDFLG = 2 Order By Key XINFBPA0
    Read [F:XINFBPA]XINFBPA0 First
    XLINE += ";" + [F:XINFBPA]BPAADD
Endif
Call ECR_TRACE(XLINE,0) From GESECRAN
    Wrseq XLINE Using [FIC1]

    # WRITE THE ADDRESS DETAIL RECORD INFORMATION
    ########################################################################################################
    Filter [F:XINFBPA] Where [F:XINFBPA]BPCNUM = [F:XINFBPC]BPCNUM
&   Order By Key XINFBPA0

    For [F:XINFBPA]XINFBPA0
Filter [F:YBPDA]
Filter [F:YBPDA] where [F:YBPDA]BPANUM = [F:XINFBPC]BPCNUM Order By Key BPA0
if !fstat
        XLINE  = "A"
	if toupper([F:XINFBPA]BPAADD)="!NOUPDATE!"
        XLINE += ";" + [F:YBPDA]BPAADD
	else
		XLINE += ";" + [F:XINFBPA]BPAADD
	endif
	if toupper([F:XINFBPA]BPADES)="!NOUPDATE!"
        XLINE += ";" + [F:YBPDA]BPADES
	else
		XLINE += ";" + [F:XINFBPA]BPADES
	endif
	if toupper([F:XINFBPA]BPAADDLIG1)="!NOUPDATE!"
        XLINE += ";" + [F:YBPDA]BPAADDLIG(0)
	else
		XLINE += ";" + [F:XINFBPA]BPAADDLIG1
	endif
	if toupper([F:XINFBPA]BPAADDLIG2)="!NOUPDATE!"
        XLINE += ";" + [F:YBPDA]BPAADDLIG(1)
	else
		XLINE += ";" + [F:XINFBPA]BPAADDLIG2
	endif
	if toupper([F:XINFBPA]BPAADDLIG3)="!NOUPDATE!"
        XLINE += ";" + [F:YBPDA]BPAADDLIG(2)
	else
		XLINE += ";" + [F:XINFBPA]BPAADDLIG3
	endif

	if toupper([F:XINFBPA]POSCOD)="!NOUPDATE!"
        XLINE2 = ";" + [F:YBPDA]POSCOD
	else
		XLINE2 = ";" + [F:XINFBPA]POSCOD
	endif
	if toupper([F:XINFBPA]CTY)="!NOUPDATE!"
        XLINE2 += ";" + [F:YBPDA]CTY
	else
		XLINE2 += ";" + [F:XINFBPA]CTY
	endif
	if toupper([F:XINFBPA]SAT)="!NOUPDATE!"
        XLINE2 += ";" + [F:YBPDA]SAT
	else
		XLINE2 += ";" + [F:XINFBPA]SAT
	endif
	if toupper([F:XINFBPA]CRY)="!NOUPDATE!"
        XLINE2 += ";" + [F:YBPDA]CRY
	else
		XLINE2 += ";" + [F:XINFBPA]CRY
	endif
Else
        XLINE  = "A"
        XLINE += ";" + [F:XINFBPA]BPAADD
        XLINE += ";" + [F:XINFBPA]BPADES
        XLINE += ";" + [F:XINFBPA]BPAADDLIG1
        XLINE += ";" + [F:XINFBPA]BPAADDLIG2
        XLINE += ";" + [F:XINFBPA]BPAADDLIG3


        XLINE2 = ";" + [F:XINFBPA]POSCOD
        XLINE2 += ";" + [F:XINFBPA]CTY
        XLINE2 += ";" + [F:XINFBPA]SAT
        XLINE2 += ";" + [F:XINFBPA]CRY
Endif

Filter [F:YBPDA]
Filter [F:YBPDA] where [F:YBPDA]BPANUM = [F:XINFBPC]BPCNUM Order By Key BPA0
if !fstat
        # THIS WAS ADDED TO MAKE SURE THAT WE NEVER EXCEED THE FIELD LENGHT OF THE TELEPHONE NUMBER OF THE CUSTOMER TABLES
        # IF THE LENGHT OF THE FIELD IS GREATER THAN THAT OF THE DIMENTION OF
		if toupper([F:XINFBPA]TEL)="!NOUPDATE!"
			XLINE2 += ";" + [F:YBPDA]TEL
		else
			If len([F:XINFBPA]TEL) > type([F:XBPAA]TEL)
				XLINE2 += ";" + left$([F:XINFBPA]TEL,type([F:XBPAA]TEL))
			Else
				XLINE2 += ";" + [F:XINFBPA]TEL
			Endif
		endif

        # THIS WAS ADDED TO MAKE SURE THAT WE NEVER EXCEED THE FIELD LENGHT OF THE TELEPHONE NUMBER OF THE CUSTOMER TABLES
        # IF THE LENGHT OF THE FIELD IS GREATER THAN THAT OF THE DIMENTION OF
		if toupper([F:XINFBPA]FAX)="!NOUPDATE!"
			XLINE2 += ";" + [F:YBPDA]FAX
		else
			If len([F:XINFBPA]FAX) > type([F:XBPAA]FAX)
				XLINE2 += ";" + left$([F:XINFBPA]FAX,type([F:XBPAA]FAX))
			Else
				XLINE2 += ";" + [F:XINFBPA]FAX
			Endif
		Endif
		
		if toupper([F:XINFBPA]MOB)="!NOUPDATE!"
			XLINE2 += ";" + [F:YBPDA]MOB
		else
			XLINE2 += ";" + [F:XINFBPA]MOB
		endif

		if toupper([F:XINFBPA]EMAIL)="!NOUPDATE!"
			XLINE2 += ";" + [F:YBPDA]WEB(0)
		else		
			XLINE2 += ";" + [F:XINFBPA]EMAIL
		endif
else
        # THIS WAS ADDED TO MAKE SURE THAT WE NEVER EXCEED THE FIELD LENGHT OF THE TELEPHONE NUMBER OF THE CUSTOMER TABLES
        # IF THE LENGHT OF THE FIELD IS GREATER THAN THAT OF THE DIMENTION OF
        If len([F:XINFBPA]TEL) > type([F:XBPAA]TEL)
            XLINE2 += ";" + left$([F:XINFBPA]TEL,type([F:XBPAA]TEL))
        Else
            XLINE2 += ";" + [F:XINFBPA]TEL
        Endif

        # THIS WAS ADDED TO MAKE SURE THAT WE NEVER EXCEED THE FIELD LENGHT OF THE TELEPHONE NUMBER OF THE CUSTOMER TABLES
        # IF THE LENGHT OF THE FIELD IS GREATER THAN THAT OF THE DIMENTION OF
        If len([F:XINFBPA]FAX) > type([F:XBPAA]FAX)
            XLINE2 += ";" + left$([F:XINFBPA]FAX,type([F:XBPAA]FAX))
        Else
            XLINE2 += ";" + [F:XINFBPA]FAX
        Endif

        XLINE2 += ";" + [F:XINFBPA]MOB
        XLINE2 += ";" + [F:XINFBPA]EMAIL
endif
Call ECR_TRACE(XLINE + XLINE2,0) From GESECRAN
        Wrseq XLINE + XLINE2 Using [FIC1]

        # WRITE THE SHIPTO ADDRESS DETAIL RECORD INFORMATION
        ########################################################################################################
        If [F:XINFBPA]ENAFLG = 2 
			Filter [F:YBPDL] where BPCNUM= [F:XINFBPC]BPCNUM and BPAADD = [F:XINFBPA]BPAADD
			Read [F:YBPDL]BPD0 first
			if !fstat
				if toupper([F:XINFBPC]BPCNAM)="!NOUPDATE!"
					XLINE  = "D;" + [F:XINFBPA]BPAADD + ";" + [F:YBPDL]BPDNAM
				else
					XLINE  = "D;" + [F:XINFBPA]BPAADD + ";" + [F:XINFBPC]BPCNAM
				endif
			Else
				XLINE  = "D;" + [F:XINFBPA]BPAADD + ";" + [F:XINFBPC]BPCNAM
			Endif
			CALL ECR_TRACE(XLINE,0) from GESECRAN
              Wrseq XLINE Using [FIC1]
        Endif
##CALL ECR_TRACE(num$([F:XINFBPA]ENAFLG)+ " ENAFLG",0) from GESECRAN
		##GTAOV : If no default ship-to-address stop creation
		 If [F:XINFBPA]ENAFLG = 2 
			XENA = 2
		 Endif
		
        $SKIPT
    Next
Call ECR_TRACE(XLINE,0) From GESECRAN
    Wrseq XLINE Using [FIC1]
##CALL ECR_TRACE(num$(XENA) + " ENA",0) from GESECRAN
	if XENA <> 2
		# TODO - UPDATE OF MESSAGE
            Call XERR_TRANS("BPC", [F:XINFBPC]BPCNUM, [F:XINFBPC]EXPNUM, 1, 0, "NO DEFAULT SHIP-TO-ADDRESS FOUND - PLEASE REFER TO X3 LOG") From XINFP_ERR
	Endif
	
	# TODO - UPDATE OF MESSAGE IF NO CUSTOMER NAME
	If [F:XINFBPC]BPCNAM = ''
		Call XERR_TRANS("BPC", [F:XINFBPC]BPCNUM, [F:XINFBPC]EXPNUM, 1, 0, "CUSTOMER NAME NOT FOUND - PLEASE REFER TO X3 LOG") From XINFP_ERR
		XENA = 0
	Endif

    ## CLOSE FILE
    #################################################################################
    Openo Using [FIC1]

    # WRITING OF FILE SUCCESSFUL, IMPORT THE FILE
    #############################################################################################################
    If GOK
        # CALLS THE IMPORT PROCESS
        # Call IMPORTSIL(IMPT, FIL) From GIMPOBJ
        # @ IMPT - TEMPLATE TO BE USED
        # @ FIL  - FILE + LOCATION
        ###############################################################
        If !clalev([M:IMP2]) : Local Mask IMPOBJ2[IMP2] : Endif
        Raz [M:IMP2]

        [M:IMP2]MODIMP = "XINFPBPC"
        [M:IMP2]NOMIMP = filpath("INFOPOS",[F:XINFBPC]BPCNUM,'TXT')
        [M:IMP2]TYPEXP = 2
		
		If XENA = 2
        Call IMPORTSIL([M:IMP2]MODIMP,[M:IMP2]NOMIMP) From GIMPOBJ
		Endif
		
        GIMPORT = 0

        If filinfo(filpath("tmp",[F:XINFBPC]BPCNUM,'TXT')+".err",7) > 0 or filinfo(filpath("INFOPOS",[F:XINFBPC]BPCNUM,'TXT')+".err",7) > 0 or XENA <> 2
            # TODO - UPDATE OF MESSAGE
            Call XERR_TRANS("BPC", [F:XINFBPC]BPCNUM, [F:XINFBPC]EXPNUM, 1, 0, "ERROR ON THE CUSTOMER CREATION/UPDATE - PLEASE REFER TO X3 LOG") From XINFP_ERR
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("CUSTOMER CREATION/UPDATE SUCCESSFUL",0) From GESECRAN
			
			##GTAOV - NOT TO UPDATE FLAG IF NO DEFAULT SHIP-TO-ADDRESS SET.
			Local integer YFOUND : YFOUND = 0
			call YCHECKSHIPTO([F:XINFBPC]BPCNUM,YFOUND)
			if YFOUND = 2 
            Call UPDATETRANS([F:XINFBPC]BPCNUM) From XINFP_BPC
			Endif
        Endif
    Endif

    # DELETE OF CREATED FILE
    ############################################################################################################
    Call EFFACE(filpath("INFOPOS",[F:XINFBPC]BPCNUM,'TXT'),[L]XSTAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFBPC]BPCNUM,'TXT')+".err",[L]XSTAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFBPC]BPCNUM,'TXT'),[L]XSTAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFBPC]BPCNUM,'TXT')+".err",[L]XSTAT) From ORDSYS
End

############################################################################################################
SUBPROG YCHECKSHIPTO(YBPCNUM,YFLAG)
VALUE CHAR YBPCNUM
VARIABLE INTEGER YFLAG

if !clalev([F:YBPC]) : local file BPCUSTOMER [F:YBPC] : endif
if !clalev([F:YBPD]) : local file BPDLVCUST [F:YBPD] : endif

filter [F:YBPC] where [F:YBPC]BPCNUM = YBPCNUM
Read [F:YBPC]BPC0 first
if !fstat
  filter [F:YBPD] where [F:YBPD]BPCNUM = [F:YBPC]BPCNUM
  Read [F:YBPD]BPD0 first
  if fstat
	YFLAG = 0
  else
    YFLAG = 2 
  endif
endif

END YFLAG

############################################################################################################





























