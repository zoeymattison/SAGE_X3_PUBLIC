#<AdxTL>@(#)0.0.0.0 $Revision$ InfoPOS Internal
###########################################################################################
# Script            : XINFP_INT
# Creation date     : 06/11/2017
# Version           : 1.0.0
# Authors (Company) : RH (InfoPOS)
# Module            : SUPERVISOR - PROCESS EXECUTION
# ----------------------------------------------------------------------------------------
# Project code      : InfoPOS X3 INTEGRATION
# Description       : MAIN ACTION OF THE INTEGRATION COMPONENT INTEGRATION
#-----------------------------------------------------------------------------------------
#
# Evolutions        : (sequence, reference (Bug reference),) date, author, description
#                   : @nn@ – DD/MM/YYYY , XXXXX , NMA
###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When "INIT"    : Gosub INIT    From XINFP_INT
        When "EXEC"    : Gosub EXEC    From XINFP_INT
        When "TERMINE" : Gosub TERMINE From XINFP_INT
        When Default
    Endcase
Return

# INIT OF THE VARIABLES AND TABLES THAT IS USED FOR THE STD PROCESS
###########################################################################################
$INIT

Return

# EXECUTION OF THE MAIN PROCESS CODE
###########################################################################################
$EXEC
    # READ THE RUNNING INDICATOR, IF THERE IS A DOWNLOAD IN PROGRESS DO NO START THE INTEGRATION
    If !clalev([F:XINFINT]) : Local File XINFINT     [F:XINFINT] : Endif

    Filter [F:XINFINT] Where [F:XINFINT]RUNNING = 2 Order By Key XINFINT0
    Read [F:XINFINT]XINFINT0 First

    # RECORD EXISTS, DO NOT RUN INTEGRATION
    If !fstat
        Call ECR_TRACE("DOWNLOAD IN PROGRESS UNABLE TO RUN THE INTEGRATION", 1) From GESECRAN
    Else
        # RECORD DOES NOT EXIST, RUN THE INTEGRATION
        #TODO - PRINT APPROPRIATE MESSAGE FOR THE LOG HEADER
        If !GSERVEUR
            Call OUVRE_TRACE("TESTING OF THE INTEGRATION MODULES" - time$) From LECFIC
            Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Else
            Call ECR_TRACE("INFOPOS TRANSACTION INTEGRATION PROCESS", 0) From GESECRAN
            Call ECR_TRACE("----------------------------------", 0) From GESECRAN
            Call ECR_TRACE("PARAMETERS    : NONE",0) From GESECRAN
            Call ECR_TRACE("COMPANY GROUP : NONE",0) From GESECRAN
            Call ECR_TRACE("SITE GROUP    : NONE",0) From GESECRAN
            Call ECR_TRACE("----------------------------------", 0) From GESECRAN
            Call ECR_TRACE("----------------------------------", 0) From GESECRAN
            Call ECR_TRACE("START TIME : " + num$(time$),0) From GESECRAN
            Call ECR_TRACE("----------------------------------", 0) From GESECRAN
            Call ECR_TRACE("", 0) From GESECRAN
            Call ECR_TRACE("", 0) From GESECRAN
        Endif

        # STOCK
        ##########################################################################################
        #TODO - PRINT APPROPRIATE MESSAGE FOR PURCHASE RECEIPTS
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call PTH_TRANS From XINFP_PTH

         #TODO - PRINT APPROPRIATE MESSAGE FOR POSITIVE ADJUSTMENTS
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call SMR_TRANS From XINFP_SMR

        #TODO - PRINT APPROPRIATE MESSAGE FOR NEGATIVE ADJUSTMENTS
        #Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        #Call SMO_TRANS From XINFP_SMO

        #TODO - PRINT APPROPRIATE MESSAGE FOR MOVEMENT OUT OF SITE A to GIT
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call GTO_TRANS From XINFP_GTO

        #TODO - PRINT APPROPRIATE MESSAGE FOR MOVEMENT OUT GIT TO SITE B
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call GTI_TRANS From XINFP_GTI

        #TODO - PRINT APPROPRIATE MESSAGE FOR MOVEMENT OUT USING INTERSITE TRANSFERS - PO/SO/SDH/PTH
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call IBS_TRANS From XINFP_IBS

        #TODO - PRINT APPROPRIATE MESSAGE FOR MOVEMENT IN USING INTERSITE TRANSFERS - PO/SO/SDH/PTH
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call IBR_TRANS From XINFP_IBR

        # COMMON DATA
        ##########################################################################################
        #TODO - PRINT APPROPRIATE MESSAGE FOR CUSTOMERS
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call BPC_TRANS From XINFP_BPC

        # SALES
        ##########################################################################################
        #TODO - PRINT APPROPRIATE MESSAGE FOR SALES QUOTES
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call SQH_TRANS From XINFP_SQH

        #TODO - PRINT APPROPRIATE MESSAGE FOR SALES ORDERS
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call SOH_TRANS From XINFP_SOH

        #TODO - PRINT APPROPRIATE MESSAGE FOR SALES DELIVERIES/SHIPMENTS
        #Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        #Call SDH_TRANS From XINFP_SDH

        #TODO - PRINT APPROPRIATE MESSAGE FOR SALES INVOICES
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call SIH_TRANS From XINFP_SIHD

        #TODO - PRINT APPROPRIATE MESSAGE FOR CUSTOMER RETURNS
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call SRH_TRANS From XINFP_SRH

        #TODO - PRINT APPROPRIATE MESSAGE FOR SALES CREDIT MEMOS
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call CRN_TRANS From XINFP_CRN

        # THIS IS HERE TO GIVE TIME TO INVOICE POSTING TO PROCESS BEFORE APPLYING INVOICES
        Sleep 25

        # AP/AR ACCOUNTING
        ##########################################################################################
        #TODO - PRINT APPROPRIATE MESSAGE FOR EXPENSES DOCUMENTS
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call PAYE_TRANS From XINFP_PAYE

        #TODO - PRINT APPROPRIATE MESSAGE FOR REVENUE DOCUMENTS
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call PAYR_TRANS From XINFP_PAYR

        #TODO - PRINT APPROPRIATE MESSAGE FOR CBT TRANSACTIONS
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call CBT_TRANS From XINFP_CBT

        # AR ADJUSTMENTS - MATCHING
        ##########################################################################################
        #TODO - PRINT APPROPRIATE MESSAGE FOR MATCHING OF DOCUMENTS
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Call MTC_TRANS From XINFP_MTC

        #TODO - IF NOT IN BATCH MODE, CLOSE THE LOG FILE AND PRINT IT OUT
        If !GSERVEUR
            Call OUVRE_TRACE("COMPLETION OF INTEGRATION RUN" - time$) From LECFIC

            Call FERME_TRACE From LECFIC
            Call LEC_TRACE From LECFIC
        Else
			If !clalev([F:XID]) : local file XINFDATA[F:XID] : endif
			Filter [F:XID] where [F:XID]XNAME = 'LOG'
			Read [F:XID]XID1 first
			  [F:XID]XUPDDATTIM = func AFNC.FDH(date$,"")
			  [F:XID]XNAME = 'LOG'
			  [F:XID]XVALUE = seg$(GTRACE,50,len(GTRACE)) # issue 20240305_X3_1 the file path is no longer correct. I updated the value MOZM
			if !fstat
			  Rewrite [F:XID]
			else
			  Write [F:XID]
			endif
			Close file [F:XID]
			
            Call ECR_TRACE("----------------------------------", 0) From GESECRAN
            Call ECR_TRACE(" COMPLETION TIME : " + num$(time$),0) From GESECRAN
            Call ECR_TRACE("----------------------------------", 0) From GESECRAN
        Endif
    Endif

    If clalev([F:XINFINT]) : Close Local File  [F:XINFINT] : Endif
Return

# TERMINATION OF THE PROCESS CODE, CLOSING OF OPEN TABLES AND KILLING OFF OF VARIABLES
###########################################################################################
$TERMINE

Return


















