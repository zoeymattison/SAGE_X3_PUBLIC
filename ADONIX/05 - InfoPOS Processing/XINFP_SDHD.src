###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES SHIPMENTS / DELIVERIES
########################################################################################################################
Subprog SDH_TRANS(XINFPSOHNUM, XINFPNUM , XINFPSTA)
    Value Char XINFPSOHNUM
    Value Char XINFPNUM
    Variable Integer XINFPSTA

    If !clalev([F:XSOH])    : Local File SORDER      [F:XSOH]    : Endif
    If !clalev([F:XSOP])    : Local File SORDERP     [F:XSOP]    : Endif
    If !clalev([F:XSOQ])    : Local File SORDERQ     [F:XSOQ]    : Endif
    If !clalev([F:XSITF])   : Local File ITMFACILIT  [F:XSITF]   : Endif
    If !clalev([F:XSITM])   : Local File ITMMASTER   [F:XSITM]   : Endif
    If !clalev([F:XSTC])    : Local File STOLOC      [F:XSTC]    : Endif
    If !clalev([F:XSTO])    : Local File STOCK       [F:XSTO]    : Endif
    If !clalev([F:XSDHA])   : Local File SDELIVERY   [F:XSDHA]   : Endif
    If !clalev([M:IMP2])    : Local Mask IMPOBJ2     [M:IMP2]    : Endif
    If !clalev([F:XXBPCA])  : Local File BPCUSTOMER  [F:XXBPCA]  : Endif
    If !clalev([F:XINFLIN]) : Local File XINFLIN     [F:XINFLIN] : Endif

    GOK = 1 : OK = 1

    # TODO - UPDATE OF MESSAGE
    # READ THE CUSTOMER RECORD, IF THE CUSTOMER IS ON HOLD, DO NOT EVEN PROCEED
    Filter [F:XXBPCA] Where [F:XXBPCA]BPCNUM = [F:XINFSIH]BPCINV and [F:XXBPCA]OSTCTL = 3 Order By Key BPC0
    Look [F:XXBPCA]BPC0 First

    If fstat
        Look [F:XSOH]SOH0 = XINFPSOHNUM

        # TODO - RECORD DOESNT EXIST
        If fstat
            # TODO - UPDATE OF MESSAGE
            Call XERR_TRANS("SIH", [F:XINFSIH]NUM, [F:XINFSIH]EXPNUM, 1, 0, "SALES ORDER DOESNT EXIST, UNABLE TO PROCESS SHIPMENT / DELIVERY") From XINFP_ERR
            XINFPSTA = 0
            End
        Endif

        Read [F:XSOH]SOH0 Curr

        Call ECR_TRACE("SHIPMENT / DELIVERY :" - XINFPNUM, 0) From GESECRAN

        # @RH@ - 05/12/2017 , CHANGE OF DOCUMENT NUMBER BEING POPULATED FROM INFOPOS
        # Filter [F:XSDHA] Where [F:XSDHA]SDHNUM = [F:XINFSIH]NUM Order By Key SDH0
        Filter [F:XSDHA] Where [F:XSDHA]SDHNUM = [F:XINFSIH]INVREF Order By Key SDH0
        Look [F:XSDHA]SDH0 First

        If fstat
            Call TRANS_CRE(XINFPSOHNUM) From XINFP_SDHD
        Else
            # @RH@ - 05/12/2017 , CHANGE OF DOCUMENT NUMBER BEING POPULATED FROM INFOPOS
            # Filter [F:XSDHA] Where [F:XSDHA]SDHNUM = [F:XINFSIH]NUM and [F:XSDHA]CFMFLG = 2 Order By Key SDH0
            Filter [F:XSDHA] Where [F:XSDHA]SDHNUM = [F:XINFSIH]INVREF and [F:XSDHA]CFMFLG = 2 Order By Key SDH0
            Look [F:XSDHA]SDH0 First

            If fstat
                # VALIDATE SHIPMENT
                Call GETCPY([F:XINFSIH]STOFCY,"",0,"") From TRTX3CPT

                # @RH@ - 05/12/2017 , CHANGE OF DOCUMENT NUMBER BEING POPULATED FROM INFOPOS
                # Call VALIDATION([F:XINFSIH]nNUM) From TRTVENLIVV
                Call VALIDATION([F:XINFSIH]INVREF) From TRTVENLIVV

                # @RH@ - 05/12/2017 , CHANGE OF DOCUMENT NUMBER BEING POPULATED FROM INFOPOS
                # Filter [F:XSDHA] Where [F:XSDHA]SDHNUM = [F:XINFSIH]NUM and [F:XSDHA]CFMFLG = 2 Order By Key SDH0
                Filter [F:XSDHA] Where [F:XSDHA]SDHNUM = [F:XINFSIH]INVREF and [F:XSDHA]CFMFLG = 2 Order By Key SDH0
                Look [F:XSDHA]SDH0 First

                If !fstat
                    Call UPDATETRANS([F:XINFSIH]NUM) From XINFP_SDHD
                Endif

                XINFPSTA = GOK
            Else
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("DELIVERY IS COMPLETE :" - [F:XINFSIH]INVREF,0) From GESECRAN

                Call UPDATETRANS([F:XINFSIH]NUM) From XINFP_SDHD

                XINFPSTA = 1
            Endif
        Endif
    Else
        # TODO - UPDATE OF MESSAGE
        Call XERR_TRANS("SIH", [F:XINFSIH]NUM, [F:XINFSIH]EXPNUM, 1, 0, "CUSTOMER ON HOLD, UNABLE TO GENERATE SALES SHIPMENT : " - [F:XINFSIH]BPCINV) From XINFP_ERR
        XINFPSTA = 0
    Endif

    If clalev([F:XSOH])    : Close Local File  [F:XSOH]    : Endif
    If clalev([F:XSOP])    : Close Local File  [F:XSOP]    : Endif
    If clalev([F:XSOQ])    : Close Local File  [F:XSOQ]    : Endif
    If clalev([F:XSITF])   : Close Local File  [F:XSITF]   : Endif
    If clalev([F:XSITM])   : Close Local File  [F:XSITM]   : Endif
    If clalev([F:XSTC])    : Close Local File  [F:XSTC]    : Endif
    If clalev([F:XSTO])    : Close Local File  [F:XSTO]    : Endif
    If clalev([F:XSDHA])   : Close Local File  [F:XSDHA]   : Endif
    If clalev([M:IMP2])    : Close Local Mask  [M:IMP2]    : Endif
    If clalev([F:XINFLIN]) : Close Local File  [F:XINFLIN] : Endif
    If clalev([F:XXBPCA])  : Close Local File  [F:XXBPCA]  : Endif
End

###########################################################################################
# UPDATE THE TRANSACTION AS COMPLETED
###########################################################################################
Subprog UPDATETRANS(XINFPNUM)
    Value Char XINFPNUM
    If !clalev([F:XUP]) : Local File XINFSIH [F:XUP] : Endif

    Trbegin [F:XUP]
        Update [F:XUP] Where [F:XUP]NUM = XINFPNUM With [F:XUP]SHIFLG = 2

        If fstat
            Rollback
        Else
            Commit
        Endif

    If clalev([F:XUP]) : Close Local File   [F:XUP] : Endif
End

# CREATION OF DELIVERY
##################################################################################################
Subprog TRANS_CRE(XXINFPSOHNUM)
    Value Char XXINFPSOHNUM
    Local Char    XLINE(255), XMESSAGE(255), XDEFLOC(255)
    Local Integer XLINNUM
    Local Decimal XQTY

    # DELETE OF CREATED FILE
    #############################################################################################################
    Local Integer STAT

    Call EFFACE(filpath("INFOPOS",[F:XINFSIH]NUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFSIH]NUM,'TXT')+".ERR",STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFSIH]NUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFSIH]NUM,'TXT')+".ERR",STAT) From ORDSYS

    GOK = 1

    ## CREATE SHIPMENT FILE FOR IMPORT
    #################################################################################
    adxifs = ';' : adxirs = chr$(13)+chr$(10)

    ## OPEN FILE
    #################################################################################
    Openo filpath("INFOPOS",[F:XINFSIH]NUM,'TXT') Using [FIC1]

    XLINE =   "H;"  + [F:XSOH]SALFCY
    XLINE +=  ";"   + [F:XSOH]STOFCY

    If [F:XINFSIH]SDHTYP <> ""
        XLINE +=  ";"   + [F:XINFSIH]SDHTYP
    Else
        XLINE +=  ";"   + [F:XSOH]SDHTYP
    Endif

    XLINE +=  ";"   + [F:XINFSIH]INVREF
    XLINE + = ";"   + [F:XSOH]BPCORD
    XLINE + = ";"   + [F:XSOH]BPAADD
    XLINE +=  ";"   + [F:XINFSIH]CUR
    XLINE +=  ";"   + format$("D:DDMMYYYY",[F:XINFSIH]INVDAT)
    XLINE +=  ";"   + format$("D:DDMMYYYY",[F:XINFSIH]INVDAT)
    #XLINE +=  ";1;" + [F:XINFSIH]NUM
##call ECR_TRACE(XLINE,0) from GESECRAN
    Wrseq XLINE Using [FIC1]

    # LOADS THE CONTENT OF THE DETAILED INVOICE LINES
    Filter [F:XINFSID] Where [F:XINFSID]NUM = [F:XINFSIH]NUM and [F:XINFSID]ROUNDING <> 2
&   Order By Key XINFSID0

    For [F:XINFSID]XINFSID0
        If [F:XINFSIH]X3SOH <> 2
            Read [F:XINFLIN]XINFLIN1 = XXINFPSOHNUM;[F:XINFSID]SIDLIN

            If fstat
                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("UNABLE TO DETERMINE THE SALES ORDER LINE",0) From GESECRAN
                GOK = 0
                Break
            Endif

            [L]XLINNUM = [F:XINFLIN]X3LIN
        Else
            [L]XLINNUM = [F:XINFSID]SOHLIN
        Endif

        # DETERMINE IF THERE IS STOCK ON HAND
        If !func CALC_QTY_ONHAND([F:XINFSID]DSTOFCY, [F:XINFSID]ITMREF, [F:XINFSID]QTY, XXINFPSOHNUM, [L]XLINNUM)
            GOK = 0
            Break
        Endif

        # WRITE THE LINE DETAIL RECORD INFORMATION
        ########################################################################################################
        XLINE =   "L;"  + XXINFPSOHNUM
        XLINE +=  ";"   + num$([L]XLINNUM)
        XLINE + = ";"   + [F:XINFSID]ITMREF
        XLINE +=  ";"   + [F:XINFSID]SAU
        XLINE +=  ";"   + num$(abs([F:XINFSID]QTY))
        XLINE +=  ";"   + num$(abs([F:XINFSID]GROPRI))
##call ECR_TRACE(XLINE,0) from GESECRAN
        Wrseq XLINE Using [FIC1]

        Read [F:XSITF]ITF0 =  [F:XINFSID]ITMREF;[F:XINFSID]DSTOFCY
        Read [F:XSITM]ITM0 =  [F:XINFSID]ITMREF

        # WRITE THE STOCK LINE
        ########################################################################################################
        If [F:XSITF]LOCMGTCOD = 2

            Filter [F:XINFSIS] Where [F:XINFSIS]NUM = [F:XINFSIH]NUM and [F:XINFSIS]SIDLIN = [F:XINFSID]SIDLIN
&           Order By Key XINFSIS0

            For [F:XINFSIS]XINFSIS0
                XLINE  = "S;A"
                XLINE += ";" + [F:XSITM]STU

                Raz [L]XQTY

                If [F:XSITM]STU = [F:XINFSID]SAU
                    [L]XQTY = abs([F:XINFSID]QTY)
                Elsif [F:XSITM]SAU = [F:XINFSID]SAU
                    [L]XQTY = abs([F:XINFSID]QTY)*[F:XSITM]SAUSTUCOE
                Elsif find([F:XINFSID]SAU,[F:XSITM]PCU)
                    [L]XQTY = abs([F:XINFSID]QTY) * [F:XSITM]PCUSTUCOE(find([F:XINFSID]SAU,[F:XSITM]PCU)-1)
                Else
                    # TODO - UPDATE OF MESSAGE
                    Call ECR_TRACE("UNABLE TO DETERMINE THE SALES UNIT CONVERSION FACTOR FOR " - [F:XINFSID]SAU,1) From GESECRAN
                    GOK = 0
                    Break 2
                Endif

                XLINE += ";"+ num$([L]XQTY)

                If [F:XINFSIS]LOC <> ''
                    XLINE += ";" + [F:XINFSIS]LOC
                Else
                    If !clalev([F:XSITF])   : Local File ITMFACILIT  [F:XSITF]   : Endif

                    If find(3,[F:XSITF]LOCNUM) and [F:XSITF]DEFLOC(find(3,[F:XSITF]LOCNUM) - 1) <> '*'
                        XLINE += ";" + [F:XSITF]DEFLOC(find(3,[F:XSITF]LOCNUM) - 1)
                    Else
                        If  [F:XSITM]NEGSTO <> 2
                            Filter [F:XSTO] Where [F:XSTO]ITMREF = [F:XINFSID]ITMREF  and
&                                                 [F:XSTO]STOFCY = [F:XINFSID]DSTOFCY and
&                                                 [F:XSTO]LOCTYP = [F:XINFSIS]LOCTYP  and
&                                                 [F:XSTO]PCU    = [F:XSITM]SAU       and
&                                                 [F:XSTO]QTYPCU > [L]XQTY
&                           Order By Key STO4
                            Read [F:XSTO]STO4 First

                            If !fstat
                                 XLINE += ";" + [F:XSTO]LOC
                            Else
                                # TODO - UPDATE OF MESSAGE
                                Call ECR_TRACE([F:XINFSID]ITMREF - [F:XINFSID]DSTOFCY - [F:XINFSIS]LOCTYP - [F:XSITM]SAU - ": UNABLE TO DETERMINE THE SALES LOCATION - NG",1) From GESECRAN
                                GOK = 0
                                Break 2
                            Endif
                        Else
                            Filter [F:XSTO] Where [F:XSTO]ITMREF = [F:XINFSID]ITMREF  and
&                                                 [F:XSTO]STOFCY = [F:XINFSID]DSTOFCY and
&                                                 [F:XSTO]LOCTYP = [F:XINFSIS]LOCTYP  and
&                                                 [F:XSTO]PCU    = [F:XSITM]SAU
&                           Order By Key STO4
                            Read [F:XSTO]STO4 First

                            If !fstat
                                 XLINE += ";" + [F:XSTO]LOC
                            Else
                                # TODO - UPDATE OF MESSAGE
                                Call ECR_TRACE([F:XINFSID]ITMREF - [F:XINFSID]DSTOFCY  - [F:XINFSIS]LOCTYP - [F:XSITM]SAU - ": UNABLE TO DETERMINE THE SALES LOCATION - N",1) From GESECRAN
                                GOK = 0
                                Break 2
                            Endif
                        Endif

                    Endif
                Endif

                XLINE += ";" + [F:XINFSIS]LOT
                XLINE += ";" + [F:XINFSIS]SERNUM
##call ECR_TRACE(XLINE,0) from GESECRAN
                Wrseq XLINE Using [FIC1]
            Next
        Else
#            XLINE  = "S;A"
#            XLINE += ";" + [F:XINFSID]SAU
#            XLINE += ";" + num$(abs([F:XINFSID]QTY))
#            XLINE += ";"
#            XLINE += ";"
#            XLINE += ";"
#
#            Wrseq XLINE Using [FIC1]
        Endif

        Filter [F:XINFSIS]

        $SKIPT
    Next

    Filter [F:XINFSID]

    ## CLOSE FILE
    #################################################################################
    Openo Using [FIC1]

    # WRITING OF FILE SUCCESSFUL, IMPORT THE FILE
    #############################################################################################################
    If GOK
        # CALLS THE IMPORT PROCESS
        # Call IMPORTSIL(IMPT, FIL) From GIMPOBJ
        # @ IMPT - TEMPLATE TO BE USED
        # @ FIL  - FILE + LOCATION
        ###############################################################
        Raz [M:IMP2]

        [M:IMP2]MODIMP = "XINFPSDH"
        [M:IMP2]NOMIMP = filpath("INFOPOS",[F:XINFSIH]NUM,'TXT')
        [M:IMP2]TYPEXP = 2
        GMODIF = 2

        Call IMPORTSIL([M:IMP2]MODIMP,[M:IMP2]NOMIMP) From GIMPOBJ

##Filter [F:XSDHA]
##Look [F:XSDHA]SDH0 = [F:XINFSIH]INVREF
##        If fstat
##Call IMPORTSIL([M:IMP2]MODIMP,[M:IMP2]NOMIMP) From GIMPOBJ
##call ECR_TRACE("END",0) from GESECRAN
##        Endif

        Filter [F:XSDHA]
        # @RH@ - 05/12/2017 , CHANGE OF DOCUMENT NUMBER BEING POPULATED FROM INFOPOS
        # Look [F:XSDHA]SDH0 = [F:XINFSIH]NUM
        Look [F:XSDHA]SDH0 = [F:XINFSIH]INVREF

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call XERR_TRANS("SIH", [F:XINFSIH]NUM, [F:XINFSIH]EXPNUM, 1, 0, "ERROR ON THE SHIPMENT CREATION - PLEASE REFER TO X3 LOG") From XINFP_ERR
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("SUCCESS ON THE SHIPMENT CREATION",0) From GESECRAN

            # VALIDATE SHIPMENT
            Call GETCPY([F:XINFSIH]STOFCY,"",0,"") From TRTX3CPT

            # @RH@ - 05/12/2017 , CHANGE OF DOCUMENT NUMBER BEING POPULATED FROM INFOPOS
            # Call VALIDATION([F:XINFSIH]NUM) From TRTVENLIVV
            Call VALIDATION([F:XINFSIH]INVREF) From TRTVENLIVV

            # @RH@ - 05/12/2017 , CHANGE OF DOCUMENT NUMBER BEING POPULATED FROM INFOPOS
            # Filter [F:XSDHA] Where [F:XSDHA]SDHNUM = [F:XINFSIH]NUM and [F:XSDHA]CFMFLG = 2 Order By Key SDH0
            Filter [F:XSDHA] Where [F:XSDHA]SDHNUM = [F:XINFSIH]INVREF and [F:XSDHA]CFMFLG = 2 Order By Key SDH0
            Look [F:XSDHA]SDH0 First

            If !fstat
                Call UPDATETRANS([F:XINFSIH]NUM) From XINFP_SDHD
            Endif
        Endif
    Endif

    # IF ANY OPEN TABLES CLOSE THE OPEN TABLES
    #############################################################################################################
    If clalev ([F:SDH]) : Close Local File [F:SDH] : Endif
    If clalev ([F:SDD]) : Close Local File [F:SDD] : Endif
    If clalev ([F:ITM]) : Close Local File [F:ITM] : Endif
    If clalev ([F:ITS]) : Close Local File [F:ITS] : Endif
    If clalev ([F:ITF]) : Close Local File [F:ITF] : Endif
    If clalev ([F:STA]) : Close Local File [F:STA] : Endif
    If clalev ([F:STL]) : Close Local File [F:STL] : Endif
    If clalev ([F:STO]) : Close Local File [F:STO] : Endif
    If clalev ([F:STS]) : Close Local File [F:STS] : Endif
    If clalev ([F:STJ]) : Close Local File [F:STJ] : Endif
    If clalev ([F:SOH]) : Close Local File [F:SOH] : Endif
    If clalev ([F:SOQ]) : Close Local File [F:SOQ] : Endif
    If clalev ([F:REO]) : Close Local File [F:REO] : Endif
    If clalev ([F:MVC]) : Close Local File [F:MVC] : Endif
    If clalev ([F:LCM]) : Close Local File [F:LCM] : Endif
    If clalev ([F:BPR]) : Close Local File [F:BPR] : Endif
    If clalev ([F:SRU]) : Close Local File [F:SRU] : Endif

    # DELETE OF CREATED FILE
    #############################################################################################################
    Call EFFACE(filpath("INFOPOS",[F:XINFSIH]NUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFSIH]NUM+".ERR",'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFSIH]NUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFSIH]NUM,'TXT')+".ERR",STAT) From ORDSYS
End

# COMPLETES SALES ORDER SCREEN OF ITEMS TO SHIP
# XFCY    - STOCKING SITE
# XITM    - ITEM NUMBER
# XQTY    - ALLOCATED QTY
#####################################################################################
Funprog CALC_QTY_ONHAND(XFCY, XITMREF, XQTY, XXINFPSOHNUM, XLINNUM)
    Value Char    XFCY
    Value Char    XITMREF
    Value Decimal XQTY
    Value Char    XXINFPSOHNUM
    Value Integer XLINNUM

    Local Decimal XTOT

    # DETERMINE IF ITEM IS KIT ITEM
    If clalev([F:XITS]) = 0  : Local File ITMSALES  [F:XITS]  : Endif
    If clalev([F:XITM]) = 0  : Local File ITMMASTER [F:XITM]  : Endif
    If clalev([F:X1SOQ]) = 0 : Local File SORDERQ   [F:X1SOQ] : Endif

    Filter [F:X1SOQ] Where [F:X1SOQ]SOHNUM = XXINFPSOHNUM and [F:X1SOQ]SOPLIN = XLINNUM Order By Key SOQ0

    Read [F:X1SOQ]SOQ0 First

    If [F:X1SOQ]ALLQTY <> XQTY or [F:X1SOQ]ALLQTY <= XQTY
        Read [F:XITM]ITM0 = XITMREF
        Read [F:XITS]ITS0 = XITMREF

        # IF KIT NOT KIT ITEM AND STOCK MANAGED, DETERMINE QTY ON HAND
        If [F:XITS]ITMTYP = 1 and [F:XITM]STOMGTCOD <> 1 and [F:XITM]NEGSTO <> 2
            Call QTY_ONHAND(XITMREF,XFCY,(XQTY - [F:X1SOQ]ALLQTY),XTOT) From XINFP_SDHD

            If XTOT < 0
                # TODO - UPDATE OF MESSAGE
                Call XERR_TRANS("SIH", [F:XINFSIH]NUM, [F:XINFSIH]EXPNUM, 1, 0, XITMREF - " : QUANTITY TO ISSUE IS GREATER THAN STOCK AVAILABLE") From XINFP_ERR
                End 0
            Endif
        Elsif [F:XITS]ITMTYP = 3
            If clalev([F:XBOMD]) = 0 : Local File BOMD [F:XBOMD] : Endif

            Filter [F:XBOMD] Where [F:XBOMD]ITMREF = XITMREF and [F:XBOMD]BOMALTTYP = 1

            For [F:XBOMD]
                Read [F:XITM]ITM0 = [F:XBOMD]CPNITMREF
                If [F:XITM]STOMGTCOD <> 1
                    Call QTY_ONHAND([F:XBOMD]CPNITMREF, XFCY, (XQTY - [F:X1SOQ]ALLQTY) * [F:XBOMD]LIKQTY, XTOT) From XINFP_SDHD

                    If XTOT < 0
                        # TODO - UPDATE OF MESSAGE
                        Call XERR_TRANS("SIH", [F:XINFSIH]NUM, [F:XINFSIH]EXPNUM, 1, 0, [F:XBOMD]CPNITMREF - " : QUANTITY TO ISSUE IS GREATER THAN STOCK AVAILABLE") From XINFP_ERR

                        End 0
                    Endif
                Endif
            Next
        Endif
    Endif
End 1

# DETERMINES THE QTY ON HAND
# XITM    - ITEM NUMBER
# XFCY    - STOCKING SITE
# XQTY    - ALLOCATED QTY
# XONHAND - CALCULATED QTY ON HAND
######################################################################################################
Subprog QTY_ONHAND(XXITM,XXFCY,XXQTY,XXONHAND)
    Value Char        XXITM
    Value Char        XXFCY
    Value Decimal     XXQTY
    Variable Decimal  XXONHAND

    If clalev([F:XITV]) = 0 : Local File  ITMMVT [F:XITV]  : Endif

    Columns [F:XITV](ITMREF,STOFCY,PHYSTO,PHYALL,GLOALL)

    Read [F:XITV]ITV0 = XXITM;XXFCY

    If !fstat
        XXONHAND = [F:XITV]PHYSTO - [F:XITV]PHYALL - [F:XITV]GLOALL - XXQTY
    Else
        XXONHAND = -1
    Endif

    If clalev([F:XITV]) = 1 : Close Local File   [F:XITV]  : Endif
End





































