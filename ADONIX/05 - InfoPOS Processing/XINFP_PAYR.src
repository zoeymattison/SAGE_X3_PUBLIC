###########################################################################################
# Script            : XINFP_PAYR
# Creation date     : 19/10/2017
# Version           : 1.0.0
# Authors (Company) : RH (InfoPOS)
# Module            : SALES
# ----------------------------------------------------------------------------------------
# Project code      : InfoPOS X3 INTEGRATION
# Description       : PAYMENT (PAYMENT - REVENUE) INTEGRATION
#-----------------------------------------------------------------------------------------
#
# Evolutions        : (sequence, reference (Bug reference),) date, author, description
#                   : @nn@ – DD/MM/YYYY , XXXXX , NMA
###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When "IMP_ZONE" : Gosub IMP_ZONE
        When "IMP_TAB"  : Gosub IMP_ZONE
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES PAYMENT
########################################################################################################################
Subprog PAYR_TRANS()
    If !clalev([F:XINFPYH]) : Local File XINFPYH    [F:XINFPYH] : Endif
    If !clalev([F:XINFPYD]) : Local File XINFPYD    [F:XINFPYD] : Endif
    If !clalev([F:XPYHA])   : Local File PAYMENTH   [F:XPYHA]   : Endif
    If !clalev([F:XSIHA])   : Local File SINVOICE   [F:XSIHA]   : Endif
    If !clalev([F:XTYPA])   : Local File TABPAYTYP  [F:XTYPA]   : Endif
    If !clalev([F:XINFHAA]) : Local File GACCENTRYA [F:XINFHAA] : Endif
    If !clalev([F:XINFFCY]) : Local File FACILITY   [F:XINFFCY] : Endif
    If !clalev([F:XINFDUD]) : Local File GACCDUDATE [F:XINFDUD] : Endif
    If !clalev([F:XSOHA])   : Local File SORDER     [F:XSOHA]   : Endif
    If !clalev([F:XSVVA])   : Local File SVCRVAT    [F:XSVVA]   : Endif

    Columns [F:XINFFCY] (FCY, FINFLG, FINRSPFCY)

    # TODO - UPDATE OF MESSAGE
    Call ECR_TRACE("GENERATION OF PAYMENT RECEIPTS",0) From GESECRAN
    Call ECR_TRACE("------------------------------",0) From GESECRAN
##filter [F:XINFPYH] Where [F:XINFPYH]NUM='CB0001073435'
    Filter [F:XINFPYH] Where [F:XINFPYH]SNS = 2 and [F:XINFPYH]PAYFLG <> 2
&   Order By Key XINFPYH0

    For [F:XINFPYH]XINFPYH0
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("PAYMENT RECEIPT :" - [F:XINFPYH]NUM,0) From GESECRAN

        # @RH@ - 08/01/2018 - CLEAR ALL ERRORS ASSOCIATED WITH THE CURRENT RECORD
        ##############################################################################################################
        Call DELETE_ERRORS([F:XINFPYH]NUM) From XINFP_ERR

        # TODO - UPDATE OF MESSAGE
        # DETERMINE IF PAYMENT REFUND EXISTS
        Filter [F:XPYHA]

        Filter [F:XPYHA] Where [F:XPYHA]REF = [F:XINFPYH]NUM Order By Key PYH0
        Look [F:XPYHA]PYH0 First

        If fstat
            # CALL THE CREATION OF THE PAYMENT REFUND
            Call TRANS_CRE From XINFP_PAYR

            GIMPORT = 0
        Else
            Filter [F:XPYHA] Where [F:XPYHA]REF = [F:XINFPYH]NUM and [F:XPYHA]STA = 9 Order By Key PYH0
            Look [F:XPYHA]PYH0 First

            If fstat
                Call POST([F:XINFPYH]NUM) From XINFP_PAYR
            Else
                Call UPDATETRANS([F:XINFPYH]NUM) From XINFP_PAYR

                # TODO - UPDATE OF MESSAGE
                Call ECR_TRACE("PAYMENT EXISTS AND IS POSTED",0) From GESECRAN
            Endif
        Endif

        Columns [F:XPYHA]

        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("*****************************",0) From GESECRAN
    Next

    If clalev([F:XINFPYH]) : Close Local File [F:XINFPYH] : Endif
    If clalev([F:XINFPYD]) : Close Local File [F:XINFPYD] : Endif
    If clalev([F:XPYHA])   : Close Local File [F:XPYHA]   : Endif
    If clalev([F:XINFFCY]) : Close Local File [F:XINFFCY] : Endif
    If clalev([F:XSIHA])   : Close Local File [F:XSIHA]   : Endif
    If clalev([F:XINFHAA]) : Close Local File [F:XINFHAA] : Endif
    If clalev([F:XINFDUD]) : Close Local File [F:XINFDUD] : Endif
    If clalev([F:XSOHA])   : Close Local File [F:XSOHA]   : Endif
    If clalev([M:XSVVA])   : Close Local File [M:XSVVA]   : Endif
End

###########################################################################################
# UPDATE THE TRANSACTION AS COMPLETED
###########################################################################################
Subprog UPDATETRANS(XINFPNUM)
    Value Char XINFPNUM

    Call XERR_TRANS("PAY", XINFPNUM, [F:XINFPYH]EXPNUM, 2, 0, "SUCCESSFUL") From XINFP_ERR

    If !clalev([F:XUP]) : Local File XINFPYH [F:XUP] : Endif

    Trbegin [F:XUP]
        Update [F:XUP] Where [F:XUP]NUM = XINFPNUM With [F:XUP]PAYFLG = 2

        If fstat
            Rollback
        Else
            Commit
        Endif

    If clalev([F:XUP]) : Close Local File   [F:XUP] : Endif
End

# CREATION OF PAYMENT REFUND
##################################################################################################
Subprog TRANS_CRE
    Local Char    XLINE(255), XMESSAGE(255)
    Local Integer XINFI

    Raz [F:XSOHA]

    # DELETE OF CREATED FILE
    #############################################################################################################
    Local Integer STAT

    Call EFFACE(filpath("tmp",[F:XINFPYH]NUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFPYH]NUM,'TXT')+".err",STAT) From ORDSYS

    GOK = 1

    ## CREATE FILE FOR IMPORT
    #################################################################################
    adxifs = ';' : adxirs = chr$(13)+chr$(10)

    If [F:XINFFCY]FCY <> [F:XINFPYH]BANFCY
        Read [F:XINFFCY]FCY0 = [F:XINFPYH]BANFCY
    Endif

    If [F:XTYPA]PAYTYP <>  [F:XINFPYH]PAYTYP
        Read [F:XTYPA]TPY0 = [F:XINFPYH]PAYTYP;[F:XINFFCY]LEG

        If fstat
            Read [F:XTYPA]TPY0 = [F:XINFPYH]PAYTYP
        Endif
    Endif

    ## OPEN FILE
    #################################################################################
    Openo filpath("INFOPOS",[F:XINFPYH]NUM,'TXT') Using [FIC1]

    XLINE  = "P;" + [F:XINFPYH]NUM
    XLINE += ";"  + [F:XINFPYH]PAYTYP
    XLINE += ";"  + [F:XINFPYH]BPR
    XLINE += ";"  #+ [F:XINFPYH]COA
    XLINE += ";"  #+ [F:XINFPYH]ACC
    XLINE += ";"  + [F:XINFPYH]PAM
    XLINE += ";"  + [F:XINFFCY]FINRSPFCY
    XLINE += ";"  + [F:XINFPYH]BAN
    XLINE += ";"  + num$([F:XTYPA]SNS)
    XLINE += ";"  + [F:XINFPYH]CUR
    XLINE += ";"  + num$([F:XINFPYH]AMTCUR)
    XLINE += ";"  + format$("D:DDMMYYYY",[F:XINFPYH]ACCDAT)
    XLINE += ";"  + [F:XINFPYH]DES
    XLINE += ";"  + [F:XINFPYH]NUM #[F:XINFPYH]REF

    Wrseq XLINE Using [FIC1]

    #Columns [F:XSIHA] (NUM, ACCNUM)
    #Columns [F:XINFHAA] (ACCNUM, DIE, CCE)

    # LOADS THE CONTENT OF THE DETAILED INVOICE LINES
    Filter [F:XINFPYD] Where [F:XINFPYD]NUM = [F:XINFPYH]NUM 
&   Order By Key XINFPYD0

    For [F:XINFPYD]XINFPYD0
        # DETERMINE IF INVOICE IS POSTED
        If [F:XINFPYD]VCRNUM <> '' and [F:XINFPYD]SOH <> 2
            Filter [F:XSIHA] Where [F:XSIHA]NUM = [F:XINFPYD]VCRNUM and [F:XSIHA]STA = 3 Order By Key SIH0
            Look [F:XSIHA]SIH0 First

            If fstat :
call ECR_TRACE([F:XINFPYD]VCRNUM+ ' VCRNUM',0) from GESECRAN
                Filter [F:XINFDUD] Where [F:XINFDUD]NUM = [F:XINFPYD]VCRNUM Order By Key DUD0
                Look [F:XINFDUD]DUD0 First

                If fstat
                    # TODO - UPDATE OF MESSAGE
call ECR_TRACE([F:XINFPYD]VCRNUM+ ' VCRNUM not found in DUD',0) from GESECRAN
                    Call ECR_TRACE("MATCHING INVOICE DOESNT EXIST IN X3 - "+[F:XINFPYD]VCRNUM,1) From GESECRAN
                    GOK = 0
                    Break
                Endif
            Endif
        # IN THE EVENT OF A PREPAYMENT, CHECK THAT DEPOSIT ALLOCATION EXIST AGAINST THE SO
        Elsif [F:XINFPYD]VCRNUM <> '' and [F:XINFPYD]SOH = 2
            Filter [F:XINFDUD] Where [F:XINFDUD]TYP = "*SO" and
&                                    [F:XINFDUD]NUM = [F:XINFPYD]VCRNUM and
&                                    [F:XINFDUD]DUDDAT = [F:XINFPYH]ACCDAT and
&                                    [F:XINFDUD]AMTCUR = [F:XINFPYH]AMTCUR
&           Order By Key DUD0
            Look [F:XINFDUD]DUD0 First

            If fstat

                Read [F:XSOHA]SOH0 = [F:XINFPYD]VCRNUM

                If [F:XSOHA]ORDSTA = 1
                    Call GENERATE_PREPAYMENT(GOK) From XINFP_PAYR
                Else
                    # TODO - UPDATE OF MESSAGE
                    If [F:XSOHA]ORDSTA = 2
                        Call ECR_TRACE("ORDER CLOSED, PROCESSSING NOT POSSIBLE",1) From GESECRAN
                    Elsif [F:XSOHA]INVSTA <> 1
                        Call ECR_TRACE("ORDER PARTIALLY/COMPLETELY INVOICES, PROCESSSING NOT POSSIBLE",1) From GESECRAN
                    Endif
                    GOK = 0
                Endif

                If !GOK
                    Break
                Endif
            Endif
        Endif

        # WRITE THE LINE DETAIL RECORD INFORMATION
        ########################################################################################################
        XLINE  = "D"
        XLINE += ";"#+ [F:XINFPYD]DENCOD
        XLINE += ";"#+ [F:XINFPYD]COA
        XLINE += ";"#+ [F:XINFPYD]ACC
        XLINE += ";"+ [F:XINFPYH]BPR
        XLINE += ";"+ [F:XINFPYD]VCRTYP
        XLINE += ";"+ [F:XINFPYD]VCRNUM
        XLINE += ";"+ [F:XINFPYH]CUR
        XLINE += ";"+ num$([F:XINFPYD]AMTLIN)

        Wrseq XLINE Using [FIC1]

        # WRITE THE LINE ANALITICAL RECORD INFORMATION
        ########################################################################################################
#        Read [F:XSIHA]SIH0 Curr
#
#        Filter [F:XINFHAA]
#        Filter [F:XINFHAA] Where ACCNUM = [F:XSIHA]ACCNUM Order By Key DAA0
#        Read [F:XINFHAA]DAA0 First
#
#        XLINE  = "A"
#
#        For XINFI = 0 To dim([F:XINFHAA]DIE) -1
#            XLINE += ";" + [F:XINFHAA]DIE(XINFI)  + ";" + [F:XINFHAA]CCE(XINFI)
#        Next
#
#        For XINFI = dim([F:XINFHAA]DIE) To 19
#            XLINE += ";" + [F:XINFHAA]DIE(XINFI)  + ";" + [F:XINFHAA]CCE(XINFI)
#        Next
#
#        XLINE += ";" + num$([F:XINFPYD]AMTLIN) + ";0"
         If  [F:XINFFCY]LEGCPY = "GAP"
            XLINE = "A;SIT;" + [F:XINFPYH]BANFCY + ";ORD;;EMP;;DEP;;REG;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;" + num$([F:XINFPYD]AMTLIN) + ";0"

            Wrseq XLINE Using [FIC1]
         Endif
#        Wrseq XLINE Using [FIC1]

        $SKIPT
    Next

    ## CLOSE FILE
    #################################################################################
    Openo Using [FIC1]

    # WRITING OF FILE SUCCESSFUL, IMPORT THE FILE
    #############################################################################################################
    If GOK
        # CALLS THE IMPORT PROCESS
        # Call IMPORTSIL(IMPT, FIL) From GIMPOBJ
        # @ IMPT - TEMPLATE TO BE USED
        # @ FIL  - FILE + LOCATION
        ###############################################################
        If !clalev([M:IMP2]) : Local Mask IMPOBJ2[IMP2] : Endif
        Raz [M:IMP2]

        [M:IMP2]MODIMP = "XINFPPAY"
        [M:IMP2]NOMIMP = filpath("INFOPOS",[F:XINFPYH]NUM,'TXT')
        [M:IMP2]TYPEXP = 2

        Call IMPORTSIL([M:IMP2]MODIMP,[M:IMP2]NOMIMP) From GIMPOBJ

        # TODO - VERIFY THAT PAYMENT HAS BEEN INTEGRATED
        Filter [F:XPYHA] Where [F:XPYHA]REF = [F:XINFPYH]NUM Order By Key PYH0
        Look [F:XPYHA]PYH0 First

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call XERR_TRANS("PAY", [F:XINFPYH]NUM, [F:XINFPYH]EXPNUM, 1, 0, "ERROR ON THE PAYMENT CREATION - PLEASE REFER TO X3 LOG") From XINFP_ERR
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("SUCCESS ON THE PAYMENT CREATION",0) From GESECRAN

            # VALIDATE PAYMENT
            GIMPORT = 0
            Call POST([F:XINFPYH]NUM) From XINFP_PAYR

        Endif
    Endif

    # DELETE OF CREATED FILE
    #############################################################################################################
    Call EFFACE(filpath("INFOPOS",[F:XINFPYH]NUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFPYH]NUM,'TXT')+".err",STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFPYH]NUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFPYH]NUM,'TXT')+".err",STAT) From ORDSYS
End

# PAYMENT POSTING PROCEDURE
##################################################################################################
Subprog POST (XINFPNUM)
    Value     Char    XINFPNUM

    If !clalev([F:TPY]) : Local File TABPAYTYP [TPY] : Endif
    If !clalev([F:PYH]) : Local File PAYMENTH   [PYH] : Endif
    If !clalev([F:PYD]) : Local File PAYMENTD   [PYD] : Endif
    If !clalev([F:PYA]) : Local File PAYMENTA   [PYA] : Endif
    If !clalev([F:PYL]) : Local File PAYLOT     [PYL] : Endif
    If !clalev([F:DUD]) : Local File GACCDUDATE [DUD] : Endif
    If !clalev([F:BID]) : Local File BID        [BID] : Endif
    If !clalev([F:TCU]) : Local File TABCUR     [TCU] : Endif
    If !clalev([F:BPC]) : Local File BPCUSTOMER [BPC] : Endif
    If !clalev([F:BPS]) : Local File BPSUPPLIER [BPS] : Endif
    If !clalev([F:CAC]) : Local File GACCCODE   [CAC] : Endif
    If !clalev([F:GAC]) : Local File GACCOUNT   [GAC] : Endif
    If !clalev([F:HAE]) : Local File GACCENTRY  [HAE] : Endif
    If !clalev([F:DAE]) : Local File GACCENTRYD [DAE] : Endif
    If !clalev([F:BPA]) : Local File BPADDRESS  [BPA] : Endif

    Local Integer OK, STAT, OKTCA, SIGN, I, ADDGAC
    Local Char    CODCPT(GLONCAC)
    Local Char    DEVISE(GLONCUR)
    Local Char    DEVLED(GLONCUR) : # Devise du référentiel principal général (celui qui gère les échéances)
    Local Char    OLDCCE(GLONCCE)(dim([F:PYA]CCE)-1)
    Local Char    COMPTE(GLONGAC)
    Local Char    PLAN(GLONCOA)
    Local Char    BAN(GLONBAN)
    Local Decimal PYHAMTLOC, PYHAMTCUR, ARD
    Local Char    IDT_LIN(5)
    I=max(1,nbrecord([F:TPY]))
    Local Char    LOTID(5)(I), LOTCOD(20)(I)
    Local Integer LOTX(I), NBLOT
    Local Decimal EXERCICE, PERIODE

    Global Integer GNBPLAN                               : # Nb de plans comptables (max 10)
    Global Integer GNBAXE                                : # Nb d'axes à saisir (max 20)
    Global Char    GPLAN(GLONCOA)(1..10)                 : # Plans (COA)
    Global Char    GAXE(GLONDIE)(1..max(GOPTCANA,20))    : # Axes (DIE)
    Global Integer GOBLIG(1..max(GOPTCANA,20))           : # Obligatoire (O/N)
    Global Integer GTYPLED(1..10)                        : # Types référentiels

    If dim(GTYPGEN)<0
        Global Integer GTYPGEN
        Global Integer GTYPANA
    Endif

    Filter [F:PYH] Where [F:PYH]REF = XINFPNUM and [F:PYH]STA = 1  Order By Key PYH0
    Read [F:PYH]PYH0 First

    # TODO - IF MATCHING PAYMENT DOESNT EXIST, THEN DO NOTHING
    If fstat
        # TODO - UPDATE OF MESSAGE
        Call XERR_TRANS("PAY", [F:XINFPYH]NUM, [F:XINFPYH]EXPNUM, 1, 0, "MATCHING PAYMENT DOESNT EXIST, UNABLE TO PROCESS POSTING") From XINFP_ERR
        End
    Endif

    Call LECTURE("TPY",[F:PYH]PAYTYP,"") From CONTOBJ
    Call GETSOC([F:PYH]FCY) From DEVSUB
    Call LEC_TPY_LEG(GCURLEG,[F:PYH]PAYTYP) From CPTLEC
    Call SETPLAN([F:PYH]CPY,GNBPLAN,GPLAN,GTYPLED,GNBAXE,GAXE,GOBLIG) From CPTDIV
    Call SETCUR(1,[F:PYH]CPY,DEVLED) From CPTDIV
    Call SETMAINREF([F:PYH]CPY,GTYPGEN,GTYPANA) From CPTDIV

    Local Char VALBOUT(250) , PARBOUT(250)(1..20)
    PARBOUT(1) = "9"
    PARBOUT(2) = "3"
    PARBOUT(3) = [F:PYH]NUM
    FLGEXE = 1
    GACTION = "PAYCPT"
    Call TRAITE_CHAR(VALBOUT,PARBOUT,"","PAYCPT","DPAYCPT",3,"XYPAYCPT") From GTRAITE

    Filter [F:PYH]
    Filter [F:PYH] Where [F:PYH]REF = XINFPNUM and [F:PYH]STA = 9 Order By Key PYH0
    Look [F:PYH]PYH0 First

    If !fstat
        Call UPDATETRANS(XINFPNUM) From XINFP_PAYR
    Else
        # TODO - UPDATE OF MESSAGE
        Call XERR_TRANS("PAY", [F:XINFPYH]NUM, [F:XINFPYH]EXPNUM, 1, 0, "ERROR DURING PAYMENT POSTING - PLEASE REFER TO X3 LOG") From XINFP_ERR
    Endif

    If clalev([F:PYA])  : Close Local File [F:PYA]  : Endif
    If clalev([F:PYD])  : Close Local File [F:PYD]  : Endif
    If clalev([F:PYH])  : Close Local File [F:PYH]  : Endif
    If clalev([F:PYHA]) : Close Local File [F:PYHA] : Endif
    If clalev([F:BPR])  : Close Local File [F:BPR]  : Endif
    If clalev([F:BPA])  : Close Local File [F:BPA]  : Endif
    If clalev([F:CAC])  : Close Local File [F:CAC]  : Endif
    If clalev([F:BPR])  : Close Local File [F:BPR]  : Endif
    If clalev([F:CPY])  : Close Local File [F:CPY]  : Endif
    If clalev([F:FCY])  : Close Local File [F:FCY]  : Endif
    If clalev([F:CAC])  : Close Local File [F:CAC]  : Endif
    If clalev([F:GAC])  : Close Local File [F:GAC]  : Endif
    If clalev([F:BAN])  : Close Local File [F:BAN]  : Endif
    If clalev([F:ADI])  : Close Local File [F:ADI]  : Endif
    If clalev([F:TPY])  : Close Local File [F:TPY]  : Endif
End

# GENERATE THE DEPOSIT ENTRY AGAINST THE SO FOR ALLOCATION OF AMOUNT AGAINST A SO
###############################################################################################################
Subprog GENERATE_PREPAYMENT(XOK)
    Variable Integer XOK

    If !clalev([M:DIA]) : Local Mask DUDX [M:DIA]  : Endif

    # DECLARING OF LOCAL VARIABLES
    Local Char PARAM(250)(1..5)
    Local Char ACTION(30)

    XOK = 1

    # TODO - UPDATE OF MESSAGE
    Call ECR_TRACE("PREPAYMENT FOR SALES ORDER: " - [F:XSOHA]SOHNUM,0) From GESECRAN

    Raz [M:DIA]

    Gosub OUVRE_OBJ From XINFP_PAYR

    # READ THE SALES ORDER IN THE SYSTEM
    Read [F:XSVVA]SVV1 = 20;[F:XSOHA]SOHNUM;1

    If !fstat
        # SAVING OF GLOBAL
        #######################################################################
        GACTION  = "TRTMODACO"

        # SETTING OF THE GLOBAL VARIABLES
        #######################################################################
        PARAM(1) = "5"
        PARAM(2) = [F:XSOHA]SOHNUM
        PARAM(3) = "1"
        PARAM(4) = ""

        Call LECMAINPLAN(1,[F:XSOHA]CPY,GCOA) From CPTDIV

        # START OF THE IMPORT PROCEDURE
        #######################################################################
        [L]ACTION = "INIT"     : Gosub ACTION From TRTTPT
        [L]ACTION = "INIT_DIA" : Gosub ACTION From TRTTPT

        # IMPORT OF DATA FOR MASK DUDX
        ##################################################################################################
        Default Mask [M:DIA]

        GMODIF = 2
        mkstat = 0
        GNBAFF  = 0
        GIMPORT = 1
        GSOCIETE =  [F:XSOHA]CPY

        If [F:XINFFCY]FINFLG = 1
            GFINRSP = [F:XINFFCY]FINRSPFCY
        Else
            GFINRSP = [F:XINFPYH]BANFCY
        Endif

        If  [M:DIA]NBLIG = 0
            [M:DIA]NBLIG += 1
            [S]nolign = [M:DIA]NBLIG
            [S]indice = nolign - 1
            status = 73
        Else
            If [M:DIA]NBLIG + 1 < maxtab([M:DIA]PAM)
                Insa nolign-1,1,[M:DIA]NBLIG NBLIG
                [M:DIA]NBLIG += 1
                indice = nolign-1
                status = 72
            Else
                 # TODO - UPDATE OF MESSAGE
                 Call XERR_TRANS("PAY", [F:XINFPYH]NUM, [F:XINFPYH]EXPNUM, 1, 0, "CAN NOT CONTAIN MORE THAN"  - num$(maxtab([M:DIA]PAM)) - "LINES") From XINFP_ERR

                 Goto SKIPPRE
            Endif
        Endif

        Call SAI_NBLIG("","IMP_TAB","XINFP_PAYR") From W0DUDX

        GIMPORT = 0

        If mkstat
            XOK = 0
        Else
            # INPUT COMPLETE, WRITE PRE-PAYMENT INFORMATION
            ##################################################################################################
            [L]ACTION = "EXEC"     : Gosub ACTION From TRTTPT
            [L]ACTION = "TERMINE"  : Gosub ACTION From TRTTPT

           Filter [F:XINFDUD] Where [F:XINFDUD]TYP = "*SO" and
&                                   [F:XINFDUD]NUM = [F:XSOHA]SOHNUM and
&                                   [F:XINFDUD]DUDDAT = [F:XINFPYH]ACCDAT and
&                                   [F:XINFDUD]AMTCUR = [F:XINFPYH]AMTCUR
&           Order By Key DUD0
            Look [F:XINFDUD] First

            If fstat
                XOK = 0
            Endif
        Endif
    Else
         # TODO - UPDATE OF MESSAGE
         Call XERR_TRANS("PAY", [F:XINFPYH]NUM, [F:XINFPYH]EXPNUM, 1, 0, "SALES ORDER DOESNT EXIST") From XINFP_ERR
    Endif

    $SKIPPRE

    If clalev([M:DIA]) : Close Local Mask [M:DIA]  : Endif
    Kill [L]ACTION,[L]PARAM
End

# DECLARATION OF DEFAULT VARIABLES
#####################################################################################
$OUVRE_OBJ
    # OPENING OF TABLES NEEDED
    ###########################################################################################3
    If clalev([F:AOE])=0  : Local File AOBJEXT    [AOE]  : Endif
    If clalev([F:AOD])=0  : Local File AOBJEXTD   [AOD]  : Endif
    If clalev([F:APX])=0  : Local File APARIMPEXP [APX]  : Endif
    If clalev([F:AOR])=0  : Local File AOBJEXTR   [AOR]  : Endif
    If clalev([F:ACC_])=0 : Local File ACCES      [ACC_] : Endif
    If clalev([F:AOB_])=0 : Local File AOBJET     [AOB_] : Endif
    If clalev([F:AWI_])=0 : Local File AWINDOW    [AWI_] : Endif
    If clalev([F:ATY_])=0 : Local File ATYPE      [ATY_] : Endif
    If clalev([F:AMK_])=0 : Local File AMSK       [AMK_] : Endif
    If clalev([F:AMZ_])=0 : Local File AMSKZON    [AMZ_] : Endif
    If clalev([F:ATB_])=0 : Local File ATABLE     [ATB_] : Endif
    If clalev([F:ATZ_])=0 : Local File ATABZON    [ATZ_] : Endif
    If clalev([F:ATI_])=0 : Local File ATABIND    [ATI_] : Endif
    If clalev([F:AMP_])=0 : Local File AMSKPAR    [AMP_] : Endif
    If clalev([F:AFC_])=0 : Local File AFONCTION  [AFC_] : Endif
    If clalev([F:ACV_])=0 : Local File ACTIV      [ACV_] : Endif
    If clalev([F:ANM_])=0 : Local File ACODNUM    [ANM_] : Endif
    If clalev([F:AOU])=0  : Local File AOBJEXTMPE [AOU]  : Endif
    If clalev([F:AOV])=0  : Local File AOBJEXTMPD [AOV]  : Endif

    # DECLARATION OF LOCAL MASKS
    ###########################################################################################3
    If clalev([M:AOE0])=0 : Local Mask AOE0       [AOE0] : Endif
    If clalev([M:AOE1])=0 : Local Mask AOE1       [AOE1] : Endif
    If clalev([M:AOE2])=0 : Local Mask AOE2       [AOE2] : Endif
    If clalev([M:IEX])=0  : Local Mask IMPTEST    [IEX]  : Endif
    If clalev([M:IMP2])=0 : Local Mask IMPOBJ2    [IMP2] : Endif

    # LOCAL VARIABLES
    ###########################################################################################3
    Local Integer IMPSTA
    Local Char    MESSAGE(250), BOITE_CRIT(GLONFEN) , FENETRE(GLONFEN)
    Local Integer K , NOFIC  , NOENR,NBCRE , TYP , ER , STA, NBMOD
    Local Integer C , NUMIMP , NBFIC , N   , L , OKTRT
    Local Char    NOMTRT(GLONADC) , NOMVAR(40) , CHAINE(250) , SUF(30)
    Local Char    TRTSRC(GDIMFIC)
    Local Char    CLE(30) , NOMZONE(30) , NOMSUB(GLONASU)
    Local Char    FIFO(GDIMFIC) , PRGBL(30)
    Local Integer OPTCAR , NOLIB
    Local Char    SAVFONC(GLONAFC) , SAVABR(GLONAOB) , SAVNAVIG(GLONANG)
    Local Char    SAVPROG(GLONADC) , SAVFONC1(GLONAFC)
    Local Integer SAVPILNAV
    Local Char    FICTMP(GDIMFIC) , FICFIN(GDIMFIC) , FICERR(GDIMFIC)
    Local Char    REPTMP(GDIMFIC) , REPFIN(GDIMFIC) , REPERR(GDIMFIC)
    Local Char    REPTRA(GDIMFIC)
    Local Char    FICBAS(GDIMFIC) , REPERT(GDIMFIC) , FICORG(GDIMFIC)
    Local Char    FICCLI(GDIMFIC)
    Local Char    LISTEFIC(GDIMFIC)(1..1000)
    Local Char    MACHINE(GDIMFIC) , MACTMP(GDIMFIC) , OS(10)
    Local Char    BASPAG(GLONAVA)
    Local Char    MODELE(GLONAOE), FICHIER(GDIMFIC), ZONTABLO(GLONAVA)
    Local Char    SEPDEC(1) , CPTAOW(GLONANM)
    Local Integer STAT,NBRLIGS,LIG,AOWENR,AOWSTA,II
    Local Integer GESSAS
    Local Char    ABREV(GLONAOB)
    Local Integer PSTD,PSUB,PSPE,PSPV
    Local Char    SAVCLE1(30)
    Local Char    SAVCLE2(30)

    # CLEARING OF LOCAL VARIABLES
    ###########################################################################################
    Raz GLOTAOW,GIMP, REPTMP , REPFIN , REPERR, NOFIC, NOENR, NBCRE ,NBMOD, GPILNAV,GPILOBJ, GTUNCPT
Return


# IMPORT OF THE FIELDS REQUIRED FOR FIELDS
##################################################################################################
$IMP_ZONE
    Case IMPZON
        When "NUM"     :  [M]NUM              = [F:XSOHA]SOHNUM
        When "SNSFLG"  :  [M]SNSFLG           = 1
        When "PAM"     :  [M]PAM(nolign-1)    = [F:XINFPYH]PAM
        When "AMTCUR"  :  [M]AMTCUR(nolign-1) = [F:XINFPYH]AMTCUR
        When "DUDDAT"  :  [M]DUDDAT(nolign-1) = [F:XINFPYH]ACCDAT
        When "VAT"     :  [M]VAT(nolign-1)    = [F:XSVVA]VAT
    Endcase
Return




























