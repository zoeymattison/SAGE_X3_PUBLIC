###########################################################################################

###########################################################################################
# ACTION METHOD
###########################################################################################
$ACTION
    Case ACTION
        When Default
    Endcase
Return

########################################################################################################################
# SUBPROG THAT CREATES SHIPMENTS / DELIVERIES
########################################################################################################################
Subprog SDH_TRANS()
    If !clalev([F:XINFSIH]) : Local File XINFSIH   [F:XINFSIH] : Endif
    If !clalev([F:XINFSID]) : Local File XINFSID   [F:XINFSID] : Endif
    If !clalev([F:XINFSIS]) : Local File XINFSIS   [F:XINFSIS] : Endif
    If !clalev([F:XSOH])    : Local File SORDER    [F:XSOH]    : Endif
    If !clalev([F:XSOP])    : Local File SORDERP   [F:XSOP]    : Endif
    If !clalev([F:XSOQ])    : Local File SORDERQ   [F:XSOQ]    : Endif
    If !clalev([F:XSDHA])   : Local File SDELIVERY [F:XSDHA]   : Endif
    If !clalev([M:IMP2])    : Local Mask IMPOBJ2   [M:IMP2]    : Endif

    Filter [F:XINFSIH] Where [F:XINFSIH]INVTYP = 1
&   Order By Key XINFSIH0

    For [F:XINFSIH]XINFSIH0
        # TODO - UPDATE OF MESSAGE
        Call ECR_TRACE("GENERATION OF A SHIPMENT / DELIVERY",0) From GESECRAN

        # TODO - UPDATE OF MESSAGE
        # DETERMINE IF SHIPMENT / DELIVERY EXISTS
        Look [F:XSDHA]SDH0 = [F:XINFSIH]NUM

        If fstat
            # CALL THE CREATION OF THE SALES SHIPMENT / DELIVERY
            Call TRANS_CRE From XINFP_SDH
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("SALES SHIPMENT / DELIVERY EXISTS",0) From GESECRAN
        Endif

        # IMPORT VARIABLE DISABLE - USED FOR LOGGING PURPOSES
        GIMPORT = 0
    Next

    If clalev([F:XINFSIH]) : Close Local File  [F:XINFSIH] : Endif
    If clalev([F:XINFSID]) : Close Local File  [F:XINFSID] : Endif
    If clalev([F:XSOH])    : Close Local File  [F:XSOH]    : Endif
    If clalev([F:XSOP])    : Close Local File  [F:XSOP]    : Endif
    If clalev([F:XSOQ])    : Close Local File  [F:XSOQ]    : Endif
    If clalev([F:XSDHA])   : Close Local File  [F:XSDHA]   : Endif
    If clalev([M:IMP2])    : Close Local Mask  [M:IMP2]    : Endif
End

# CREATION OF DELIVERY
##################################################################################################
Subprog TRANS_CRE
    Local Char    XLINE(255), XMESSAGE(255)

    # TODO - DETERMINE IF A SALES ORDER NEEDS TO BE CREATED AND OR IF THERE ALREADY EXISTS A RECORD
    If [F:XINFSIH]SOHNUM = "" and [F:XINFSIH]DIRECT = 2
        Call ECR_TRACE("----------------------------------", 0) From GESECRAN

        Call SOH_TRANS([F:XINFSIH]NUM) From XINFP_SOHD

        Call ECR_TRACE("----------------------------------", 0) From GESECRAN

        Read [F:XSOH]SOH0 = [F:XINFSIH]NUM
    Else
        Read [F:XSOH]SOH0 = [F:XINFSIH]SOHNUM
    Endif

    # TODO - RECORD DOESNT EXIST
    If fstat
        # TODO - DETERMINE IF A SALES ORDER NEEDS TO BE CREATED AND OR IF THERE ALREADY EXISTS A RECORD
        Call ECR_TRACE("SALES ORDER DOESNT EXIST, UNABLE TO PROCESS DELIVERY", 1) From GESECRAN
        End
    Endif


    ## CREATE SHIPMENT FILE FOR IMPORT
    #################################################################################
    adxifs = ';' : adxirs = chr$(13)+chr$(10)

    ## OPEN FILE
    #################################################################################
    Openo filpath("INFOPOS",[F:XINFSIH]NUM,'TXT') Using [FIC1]

    XLINE =   "H;"  + [F:XSOH]SALFCY
    XLINE +=  ";"   + [F:XSOH]STOFCY
    XLINE +=  ";"   + [F:XSOH]SOHNUM
    XLINE + = ";"   + [F:XSOH]BPCORD
    XLINE +=  ";"   + [F:XSOH]CUR
    XLINE +=  ";"   + num$(format$("D:MMDDYYYY",[F:XINFSIH]INVDAT))
    XLINE +=  ";"   + num$(format$("D:MMDDYYYY",[F:XINFSIH]INVDAT))
    #XLINE +=  ";1;" + [F:XINFSIH]NUM

    Wrseq XLINE Using [FIC1]

    # LOADS THE CONTENT OF THE DETAILED INVOICE LINES
    Filter [F:XINFSID] Where [F:XINFSID]NUM = [F:XINFSIH]NUM
&   Order By Key XINFSID0

    For [F:XINFSID]XINFSID0
        # READ MATCHING SALES ORDER LINE
        Link [F:XSOQ] With [F:XSOP]SOP3 = [F:XSOQ]SOHNUM;[F:XSOQ]SOPLIN As [XLK1]
&                       Where [F:XSOQ]SOHNUM = [F:XSOH]SOHNUM
&       Order By Key SOQ0

        Read [XLK1]SOQ0 First

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("UNABLE TO DETERMINE THE SALES ORDER LINE",0) From GESECRAN
            GOK = 0
            Break
        Endif

        # DETERMINE IF THERE IS STOCK ON HAND
        If !func CALC_QTY_ONHAND([F:XSOP]SALFCY, [F:XSOQ]ITMREF, [F:XSOQ]QTYSTU)
            GOK = 0
            Break
        Endif

        # WRITE THE LINE DETAIL RECORD INFORMATION
        ########################################################################################################
        XLINE =   "L;"  + [F:XSOP]SOHNUM
        XLINE +=  ";"   + num$([F:XSOP]SOPLIN)
        XLINE + = ";"   + [F:XSOP]ITMREF
        XLINE +=  ";"   + [F:XSOP]SAU
        XLINE +=  ";"   + num$([F:XINFSID]QTY)
        XLINE +=  ";"   + num$([F:XSOP]GROPRI)

        Wrseq XLINE Using [FIC1]

        # WRITE THE STOCK LINE
        ########################################################################################################
        Filter [F:XINFSIS] Where [F:XINFSIS]NUM    = [F:XINFSID]NUM and
&                                [F:XINFSIS]SIDLIN = [F:XINFSID]SIDLIN
&       Order By Key XINFSIS0

        For [F:XINFSIS]XINFSIS0
            XLINE  = "S;A;"
            XLINE += [F:XSOP]SAU
            XLINE += ";1;;;"+ [F:XINFSIS]SERNUM

            Wrseq XLINE Using [FIC1]
        Next

        $SKIPT
    Next

    ## CLOSE FILE
    #################################################################################
    Openo Using [FIC1]

    # WRITING OF FILE SUCCESSFUL, IMPORT THE FILE
    #############################################################################################################
    If GOK
        # CALLS THE IMPORT PROCESS
        # Call IMPORTSIL(IMPT, FIL) From GIMPOBJ
        # @ IMPT - TEMPLATE TO BE USED
        # @ FIL  - FILE + LOCATION
        ###############################################################
        Raz [M:IMP2]

        [M:IMP2]MODIMP = "XINFPSDH"
        [M:IMP2]NOMIMP = filpath("INFOPOS",[F:XINFSIH]NUM,'TXT')
        [M:IMP2]TYPEXP = 2

        Call IMPORTSIL([M:IMP2]MODIMP,[M:IMP2]NOMIMP) From GIMPOBJ

        # TODO - UPDATE OF MESSAGE
        # DETERMINE IF SHIPMENT / DELIVERY EXISTS
        Look [F:XSDHA]SDH0 = [F:XINFSIH]NUM

        If fstat
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("ERROR ON THE SHIPMENT CREATION",1) From GESECRAN
        Else
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE("SUCCESS ON THE SHIPMENT CREATION",0) From GESECRAN

            # VALIDATE SHIPMENT
            Call GETCPY([F:XINFSIH]STOFCY,"",0,"") From TRTX3CPT

            Call VALIDATION([F:XINFSIH]NUM) From TRTVENLIVV
        Endif
    Endif

    # DELETE OF CREATED FILE
    #############################################################################################################
    Local Integer STAT

    Call EFFACE(filpath("INFOPOS",[F:XINFSIH]NUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("INFOPOS",[F:XINFSIH]NUM + ".TXT",'ERR'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFSIH]NUM,'TXT'),STAT) From ORDSYS
    Call EFFACE(filpath("tmp",[F:XINFSIH]NUM + ".TXT",'ERR'),STAT) From ORDSYS
End

# COMPLETES SALES ORDER SCREEN OF ITEMS TO SHIP
# XFCY    - STOCKING SITE
# XITM    - ITEM NUMBER
# XQTY    - ALLOCATED QTY
#####################################################################################
Funprog CALC_QTY_ONHAND(XFCY, XITMREF, XQTY)
    Value Char    XFCY
    Value Char    XITMREF
    Value Decimal XQTY

    Local Decimal XTOT

    # DETERMINE IF ITEM IS KIT ITEM
    If clalev([F:XITS]) = 0 : Local File ITMSALES  [F:XITS] : Endif
    If clalev([F:XITM]) = 0 : Local File ITMMASTER [F:XITM] : Endif

    Read [F:XITM]ITM0 = XITMREF
    Read [F:XITS]ITS0 = XITMREF

    # IF KIT NOT KIT ITEM AND STOCK MANAGED, DETERMINE QTY ON HAND
    If [F:XITS]ITMTYP = 1 and [F:XITM]STOMGTCOD <> 1 and [F:XITM]NEGSTO <> 2
        Call QTY_ONHAND(XITMREF,XFCY,XQTY,XTOT) From XINFP_SDH

        If XQTY > XTOT
            # TODO - UPDATE OF MESSAGE
            Call ECR_TRACE(XITMREF - " : QUANTITY TO ISSUE IS GREATER THAN STOCK AVAILABLE",0) From GESECRAN
            End 0
        Endif
    Elsif [F:XITS]ITMTYP = 3
        If clalev([F:XBOMD]) = 0 : Local File BOMD [F:XBOMD] : Endif

        Filter [F:XBOMD] Where [F:XBOMD]ITMREF = XITMREF and [F:XBOMD]BOMALTTYP = 1

        For [F:XBOMD]
            Read [F:XITM]ITM0 = [F:XBOMD]CPNITMREF
            If [F:XITM]STOMGTCOD <> 1
                Call QTY_ONHAND([F:XBOMD]CPNITMREF, XFCY, XQTY, XTOT) From XINFP_SDH

                If (XQTY * [F:XBOMD]LIKQTY) > XTOT
                    # TODO - UPDATE OF MESSAGE
                    Call ECR_TRACE([F:XBOMD]CPNITMREF - " : QUANTITY TO ISSUE IS GREATER THAN STOCK AVAILABLE",0) From GESECRAN
                    End 0
                Endif
            Endif
        Next
    Endif
End 1

# DETERMINES THE QTY ON HAND
# XITM    - ITEM NUMBER
# XFCY    - STOCKING SITE
# XQTY    - ALLOCATED QTY
# XONHAND - CALCULATED QTY ON HAND
######################################################################################################
Subprog QTY_ONHAND(XITM,XFCY,XQTY,XONHAND)
    Value Char        XITM
    Value Char        XFCY
    Value Decimal     XQTY
    Variable Decimal  XONHAND

    If clalev([F:XITV]) = 0 : Local File  ITMMVT [F:XITV]  : Endif

    Columns [F:XITV](ITMREF,STOFCY,PHYSTO,REJSTO,CTLSTO,PHYALL,REJALL,CTLALL,GLOALL)

    Read [F:XITV]ITV0 = XITM;XFCY

    If !fstat
        XONHAND = ([F:XITV]PHYSTO + [F:XITV]REJSTO + [F:XITV]CTLSTO + XQTY) - [F:XITV]PHYALL - [F:XITV]REJALL - [F:XITV]CTLALL - [F:XITV]GLOALL
    Else
        XONHAND = 0
    Endif

    If clalev([F:XITV]) = 1 : Close Local File   [F:XITV]  : Endif
End




