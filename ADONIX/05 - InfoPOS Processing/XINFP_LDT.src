$ACTION
    Case ACTION
        When Default
    Endcase
Return

# CALCULATES LEAD TIME
###########################################################################################
Subprog YGAPLT(WDAT,WBPC,WBPA,WFCY,WITM,WQTY,WLTI)
    Value    Date    WDAT
    Value    Char    WBPC
    Value    Char    WBPA
    Value    Char    WFCY
    Value    Char    WITM
    Value    Decimal WQTY
    Variable Integer WLTI

    WLTI = int(rnd(19)) + 1

End




