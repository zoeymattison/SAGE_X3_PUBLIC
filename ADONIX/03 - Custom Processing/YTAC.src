$ACTION
   case ACTION 
      when "ADD_TOT" : goto ADD_TOT
   endcase
Return

$ADD_TOT
    if find('PST Exemption: Yes', [M:SOH4]YCUSTNOT(NLIG))>0
        [M:SOH4]VACITM2(NLIG)=''
    endif
Return

Funprog IFFS(CRITERIA,TRUEPART,FALSEPART)
Value Char CRITERIA
Value Char TRUEPART
Value Char FALSEPART
Value Char RETVAL

If(evalue(CRITERIA)) 
    RETVAL=TRUEPART
Else 
    RETVAL=FALSEPART
Endif
End RETVAL



Funprog QTYAVL(SITE, ITMREF)
Value char SITE
Value char ITMREF
local decimal RETVAL
local decimal SAUSTUCOE : SAUSTUCOE = 1
local decimal STKAVL : STKVAL = 0
local decimal STKALL : STKALL = 0

if !clalev([F:YITM]) : local file ITMMASTER [YITM] : Endif
read [F:YITM]ITM0=ITMREF
if fstat = 0 : SAUSTUCOE = [F:YITM]SAUSTUCOE : endif

if !clalev([YSTO]) : local file STOCK [YSTO] : endif
filter [YSTO] where ITMREF = [L]ITMREF & STOFCY = [L]SITE & STA = 'A'
read [YSTO] first
for [YSTO]
   STKAVL += [F:YSTO]QTYSTU
next

if !clalev([YSTA]) : local file STOALL [YSTA] : endif
filter [YSTA] where ITMREF = [L]ITMREF & STOFCY = [L]SITE
read [YSTA] first
for [YSTA]
    STKALL += [F:YSTA]QTYSTUACT
next
RETVAL = STKAVL - STKALL
RETVAL = RETVAL / SAUSTUCOE
# infbox num$(RETVAL)
end RETVAL


Funprog BPCPYR()
Local Char RETVAL
  RETVAL=func AFNC.INTFLD('BPARTNER','BPRNAM',[F:BPC]BPCINV)
End RETVAL


Funprog GetSOHLig(YNUM)
Value char YNUM
Local Clbfile RETVAL (6)
RETVAL='<!-- lines start -->'

#SORDERQ SOHNUM-1234 SOQSEQ-1000 SOPLIN-1000 ITMDES
#SORDERQ SOHNUM-1234 SOQSEQ-2000 SOPLIN-2000 ITMDES

#SORDERP SOHNUM-1234 SOQSEQ-2000 SOPLIN-2000 GROPRI
#SORDERP SOHNUM-1234 SOQSEQ-1000 SOPLIN-1000 GROPRI


if !clalev([F:YYSOQ]) : local file SORDERQ[YYSOQ] : endif
if !clalev([F:YYSOP]) : local file SORDERP[YYSOP] : endif
LINK [YYSOQ] WITH [YYSOP]SOP0=[F:YYSOQ]SOHNUM;[F:YYSOQ]SOPLIN;[F:YYSOQ]SOQSEQ AS [YYSO]

Filter [YYSO] where SOHNUM = YNUM
read [YYSO] first
if fstat = 0
    For [YYSO]
RETVAL += '<tr><td>'+num$([F:YYSO]QTY)+'</td><td>'+[F:YYSOP]ITMDES+'</td><td>'+format$("N3vF<:13.2",[F:YYSOP]GROPRI)+'</td><td>'+[F:YYSOP]SAU+'</td><td>'+format$("N3vF<:13.2",[F:YYSOP]GROPRI*[F:YYSO]QTY)+'</td></tr>'
    next
endif
RETVAL+='<!-- lines end -->'
End RETVAL


Funprog GetPrinterUNC(USR)
value char USR
local char RETVAL(50)
local char PRTDEF
if USR = "" 
    USR = GUSER
endif
PRTDEF = func AFNC.INTFLD("AUTILIS", "PRTDEF(4)", USR)
if PRTDEF <> ""
   RETVAL = func AFNC.INTFLD("APRINTER", "PRTNAM", PRTDEF)
  
else
   RETVAL = ""
endif
End RETVAL



Funprog GetSupplierEmail(YBPSNUM)
value char YBPSNUM
local char RETVAL(200)

RETVAL=func AFNC.INTFLD('BPADDRESS','WEB(0)','1~'+YBPSNUM+'~REMIT')

End RETVAL













































































