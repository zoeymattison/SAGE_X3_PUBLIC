#<AdxTL>@(#)0.0.0.0 $Revision$ 
Call OUVRE_TRACE("Novexco Quantity Updates "+num$(date$)+" "+num$(time$)) From LECFIC

Local Integer ZL_COUNTER : [L]ZL_COUNTER=0

    If !clalev([F:ZITV]) : Local File ITMMVT [ZITV] : Endif
    If !clalev([F:ZITM]) : Local File ITMMASTER [ZITM] : Endif

    # 1. Use Decimal instead of Integer to prevent fractional quantity truncation
    Local Decimal OLD_QTY
    Local Decimal NEW_QTY

    # 2. Trace log initialization
    Call ECR_TRACE("Update in progress", 0) From GESECRAN
    Call ECR_TRACE("-----------------------------------------------------------------------", 0) From GESECRAN

    # 3. Buffer restrictions
    Columns [ZITM] (ITMREF, ZNOVEXCO, ZQTYNVX)
    Filter [ZITM] Where ZNOVEXCO<>""

    # 4. Open transaction outside the loop to protect cursor lock integrity
    For [ZITM]
        # Fetch matching stock record for site DC30
        Read [ZITV]ITV0=[F:ZITM]ITMREF;"DC30"

        If ![S]fstat
            [L]OLD_QTY=[F:ZITV]ZQTYNVX
            [L]NEW_QTY=([F:ZITV]PHYSTO-[F:ZITV]PHYALL)+[F:ZITM]ZQTYNVX

            If [L]OLD_QTY <> [L]NEW_QTY
            	If adxlog <> 1 : Trbegin [ZITV] : Endif
                Update [F:ZITV] Where ITMREF=[F:ZITM]ITMREF and STOFCY="DC30" With [F:ZITV]ZQTYNVX=[L]NEW_QTY
                If ![S]fstat
                    Call ECR_TRACE([F:ZITM]ITMREF+" updated: "+num$([L]OLD_QTY)+" >> "+num$([L]NEW_QTY), -1) From GESECRAN
                Else
                    Call ECR_TRACE([F:ZITM]ITMREF+" error on rewrite! (Is the record locked?)", 1) From GESECRAN
                Endif
            Else
                [L]ZL_COUNTER+=1
            Endif
        Endif
    Next

    # 6. Reset filters and column limits to avoid corrupting session context
    Filter [ZITM]
    Columns [ZITM]

Call ECR_TRACE("", 0) From GESECRAN
Call ECR_TRACE(num$([L]ZL_COUNTER)+" records were not updated.", -2) From GESECRAN
Call FERME_TRACE From LECFIC
If GUSER<>"ADMIN"
Call LEC_TRACE From LECFIC
Endif












