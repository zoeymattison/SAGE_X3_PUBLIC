#<AdxTL>@(#)0.0.0.0 $Revision$
If !clalev([ZVPB2]) : Local File ZVPOB2B [ZVPB2] : Endif
Local Char PATH(240)
Local Integer STAT : STAT=0


Filter [ZVPB2] Where POHNUM=[M:POH0]POHNUM
For [ZVPB2]
	[L]PATH="sageemmain.monk.ca@D:\Sage\X3\folders\LIVE\ZATTACH\ARCHIVE\"+[F:ZVPB2]POHNUM+"_"+timestamp$+".csv"
	Openo [L]PATH Using [ZZZ]
	adxifs=chr$(9)
	adxirs=chr$(13)+chr$(10)
	Wrseq "sep="+chr$(9) Using [ZZZ]
	Wrseq "Product","Quantity" Using [ZZZ]
	Break
Next

For [ZVPB2]
	Wrseq [F:ZVPB2]ITMREFBPS,num$([F:ZVPB2]QTYSTU) Using [ZZZ]
Next

Openo Using [ZZZ]
Call COPCLI([L]PATH,[L]PATH,[L]STAT) From ORDSYS
