#<AdxTL>@(#)0.0.0.0 $Revision$ 
$ACTION
    case ACTION
      WHEN "BEFWRISTL" : gosub BEFWRISTL
    endcase
Return

$BEFWRISTL
  Local Char YPORDNO
  Local Char YPORDLIN
  Local Char YPORDLINQ
  Local Char YSORDNO
  Local Char YSORDLIN
  Local Char YSORDLINQ
  Local Char YOPTIONALFEATURES

  YPORDNO=func AFNC.INTFLD('PRECEIPTD','POHNUM',[F:STL]VCRNUM+'~'+num$([F:STL]VCRLIN))
  YPORDLIN=func AFNC.INTFLD('PRECEIPTD','POPLIN',[F:STL]VCRNUM+'~'+num$([F:STL]VCRLIN))
  YPORDLINQ=func AFNC.INTFLD('PRECEIPTD','POQSEQ',[F:STL]VCRNUM+'~'+num$([F:STL]VCRLIN))
  
  YSORDNO=func AFNC.INTFLD('PORDERQ','SOHNUM',YPORDNO+'~'+YPORDLIN+'~'+YPORDLINQ)
  YSORDLIN=func AFNC.INTFLD('PORDERQ','SOPLIN',YPORDNO+'~'+YPORDLIN+'~'+YPORDLINQ)
  YSORDLINQ=func AFNC.INTFLD('PORDERQ','SOQSEQ',YPORDNO+'~'+YPORDLIN+'~'+YPORDLINQ)

  YOPTIONALFEATURES=func AFNC.INTFLD('SORDERQ','YOPTFEA',YSORDNO+'~'+YSORDLIN+'~'+YSORDLINQ)

  #sales order no.
  [F:STL]USRFLD2=YSORDNO+'/'+YSORDLIN

  #optional features
  if [F:STL]USRFLD1 = "" 
     [F:STL]USRFLD1=YOPTIONALFEATURES
  endif
 
Return








