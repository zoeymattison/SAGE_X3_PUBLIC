Call CREPRIBK ("TEST")
End

Subprog CRESIFORD()
  Local Integer I
  Local Char FICSRV(250)
  Local Char SIFFILE (250)

  Local Char SOHFILE (250)
  Local Char ITMFILE (250)
  Local Char ITFFILE (250)
  Local Char ITPFILE (250)
  Local Char FILESEQ (250)
  Local Char BPSNUM

  Local Integer IMPITM : IMPITM = 1
  Local Integer IMPITF : IMPITF = 1
  Local Integer IMPITP : IMPITP = 1

  FILESEQ = format$("YYYYMMDDhhmmss", datetime$)

  If [M:YSOH0]NBLIG=0 : Infbox "No files available" : End : Endif
  If [M:YSOH0]BPRNUM = '' : Infbox "Please select a customer" : End : Endif

  For I = 0 To [M:YSOH0]NBLIG-1
    SIFFILE = [M:YSOH0]FILENAM(I)
    SIFFILE = ctrans(SIFFILE, "ZNET.","")
    SIFFILE = ctrans(SIFFILE, ".sif", "")
    If I = 0
       [M:YSOH0]ORDREF = SIFFILE
    Else
       [M:YSOH0]ORDREF += ", "+SIFFILE
    Endif
  Next
  Affzo [M:YSOH0]ORDREF

  #files for import
  ITMFILE = filpath("TMP", GUSER+"_YITM_"+FILESEQ,"DAT")
  ITFFILE = filpath("TMP", GUSER+"_YITF_"+FILESEQ,"DAT")
  ITPFILE = filpath("TMP", GUSER+"_YITP_"+FILESEQ,"DAT")

  SOHFILE = filpath("TMP",GUSER+"_YSIF_"+FILESEQ, "DAT")

  Openo ITMFILE, 0 Using [ZITM]
  Iomode adxifs ";" Using [ZITM]
  Iomode adxirs chr$(13) + chr$(10) Using [ZITM]
  Iomode adxium 50 Using [ZITM]

  Openo ITFFILE, 0 Using [ZITF]
  Iomode adxifs ";" Using [ZITF]
  Iomode adxirs chr$(13) + chr$(10) Using [ZITF]
  Iomode adxium 50 Using [ZITF]

  Openo ITPFILE, 0 Using [ZITP]
  Iomode adxifs ";" Using [ZITP]
  Iomode adxirs chr$(13) + chr$(10) Using [ZITP]
  Iomode adxium 50 Using [ZITP]


  Openo SOHFILE,0 Using [ZYSIF]
  Iomode adxifs ";" Using [ZYSIF]
  Iomode adxirs chr$(13)+chr$(10) Using [ZYSIF]
  Iomode adxium 50 Using [ZYSIF]

  Wrseq "E;"+[M:YSOH0]SALFCY+";SON;;"+[M:YSOH0]BPRNUM+";DC31;"+[M:YSOH0]ORDREF+";"+[M:YSOH0]BPAADD+";"+[M:YSOH0]REP Using [ZYSIF]


  FICSRV = filpath ("TMP", "", "")
  For I = 0 To [M:YSOH0]NBLIG-1
    SIFFILE = FICSRV +"\"+[M:YSOH0]FILENAM(I)
    BPSNUM = [M:YSOH0]BPSNUM(I)
    Gosub PROCSIF
  Next
  Openo Using [ZYSIF]
  Openo Using [ZITM]
  Openo Using [ZITF]
  Openo Using [ZITP]

  Gosub SOLINEENTRY

End

Subprog ADDSIFFILE()

  Local Char FICSRV(250), FICCLI(250), MYPATH(250)
  Local Integer ASTATUS
  Local Integer NOL
  Local Char TEMP(30)
  Local Integer I
  Local Integer FILEEXISTED : FILEEXISTED = 1 #1 = no, 2 = yes
  FICCLI = ""
  FICSRV = filpath("TMP", "", "")
  Call COPSRV(FICCLI, FICSRV, ASTATUS) From ORDSYS
  FICSRV = FICSRV+"\"+FICCLI

  For I = 0 To [M:YSOH0]NBLIG - 1
     If [M:YSOH0]FILENAM(I) = FICCLI
        FILEEXISTED = 2
        Break
     Endif
  Next
  If FILEEXISTED = 1
    NOL = [M:YSOH0]NBLIG
    [M:YSOH0]NBLIG += 1
    [M:YSOH0]FILENAM(NOL) = FICCLI
    Affzo [M:YSOH0]FILENAM(NOL)
  Else
    Infbox "File already added"
  Endif

End

Subprog CREPRIBK(SOHNUM)
   Local Char F(250)
   If [M:SOH4]NBLIG = 0
   Else
    Gosub CREPRIFILE
    Call IMPORTSIL("YPPL",F) From GIMPOBJ
   Endif
End

$CREPRIFILE

   Local Integer I

   F = filpath("TMP",GUSER+"_YPP_"+SOHNUM, "TXT")
   # Infbox F
   Openo F,0 Using [ZYPP]
   Iomode adxifs chr$(9) Using [ZYPP]
   Iomode adxirs chr$(13)+chr$(10) Using [ZYPP]
   Iomode adxium 50 Using [ZYPP]

   Wrseq "E"+chr$(9)+"T50"+chr$(9)+SOHNUM+chr$(9)+num$(date$)+chr$(9)+num$(date$+60) Using [ZYPP]
   For I = 0 To [M:SOH4]NBLIG-1
      Wrseq "L"+chr$(9)+[M:SOH4]ITMREF(I)+chr$(9)+[M:SOH1]PJT+chr$(9)+num$([M:SOH4]SOPLIN(I))+chr$(9)+[M:SOH4]STU(I)+chr$(9)+"0"+chr$(9)+"0"+chr$(9)+"CAD"+chr$(9)+num$([M:SOH4]YMONKCOST)+chr$(9)+"0"+
& chr$(9)+"0"+ chr$(9) +"0" Using [ZYPP]
   Next
   Openo Using [ZYPP]
Return


$PROCSIF
  # Infbox "Process SIF file here"-SIFFILE
   Local Char STRKEY(250)
   Local Char STRVALUE(250)
   Local Char PN (30)
   Local Char X3PN(20)
   Local Integer QTY
   Local Decimal PL
   Local Decimal MARKUP
   Local Decimal COST
   Local Char LASTPN(30)
   Local Char PD(250)
   Local Char ITMDES(30)(3)
   Local Char OD(250)
   Local Char ON(250)


   Openi SIFFILE Using [ZFIC]
   Iomode adxifs  "=" Using [ZFIC]
   Iomode adxirs  chr$(10) Using [ZFIC]

   LASTPN = ""
   ON = ""
   OD = ""
   Call OUVRE_TRACE("Reading "-SIFFILE) From LECFIC
   Repeat
    Rdseq STRKEY, STRVALUE Using [ZFIC]
    If STRKEY <> ""
        Call ECR_TRACE ("Read: "-STRKEY-"="-STRVALUE, 0) From GESECRAN
        If STRKEY = "PN"
           If LASTPN <> ""
              Gosub CRESOHDET
              Gosub CHKITM

           Endif

        Endif
        Case STRKEY
           When "PN" :
              PN = STRVALUE
              LASTPN = PN
              X3PN = PN
              X3PN = ctrans(X3PN, chr$(13), "")
              X3PN = ctrans (X3PN, ".", "-")

              Call ECR_TRACE("Converting part number from"-PN-"to"-X3PN,0) From GESECRAN

           When "QT" : QTY = val(STRVALUE)
           When "PL" : PL = val(STRVALUE)
           When "S-" : MARKUP = val(STRVALUE) / 100
           When "P%" : COST = val(STRVALUE) / 100
           When "PD"
              PD = STRVALUE
              If left$(PD,1) = "+" : PD = right$(PD,2) : Endif
              ITMDES(0) = mid$(PD,1,30)
              ITMDES(1) = mid$(PD,31,30)
              ITMDES(2) = mid$(PD,61,30)
			  ITMDES(0) = ctrans(ITMDES(0), chr$(13), "")
			  ITMDES(1) = ctrans(ITMDES(1), chr$(13), "")
			  ITMDES(2) = ctrans(ITMDES(2), chr$(13), "")
           When "ON"
               ON += ctrans(STRVALUE, chr$(13), "")
           When "OD"
               If OD = ""
                  OD = ctrans(STRVALUE, chr$(13), "")
               Else
                  OD = OD + "," + ctrans(STRVALUE, chr$(13), "")
               Endif
        Endcase
    Endif
   Until fstat = 1
   # OD = OD + chr$(13)
   If PN <> ""
    Gosub CHKITM
    Gosub CRESOHDET

   Endif

   Openi Using [ZFIC]

   Call FERME_TRACE From LECFIC
   Call LEC_TRACE() From LECFIC
   #Infbox  "Finish reading"-SIFFILE


 Return

$CHKITM

  If !clalev([ITM]) : Local File ITMMASTER [ITM] : Endif
  If !clalev([ITF]) : Local File ITMFACILIT [ITF] : Endif
  If !clalev([ITP]) : Local File ITMBPS [ITP] : Endif

  Read [ITM]ITM0=X3PN
  #Infbox num$(fstat)
  # If fstat > 0
     IMPITM = 2
     Call ECR_TRACE ("New part found: "-PN,0) From GESECRAN
     #ITMMASTER
     Wrseq "I;FFURN;"+X3PN+";"+ITMDES(0)+"~~ENG;"+ITMDES(1)+"~~ENG;"+ITMDES(2)+"~~ENG;EA;;0;EA;1;EA;1;;0;;0;FINPRODUCT;GST;PST;;0;0;;;;" Using [ZITM]
     Wrseq "S;;;0;0;;;;" Using [ZITM]
     Wrseq "P;"+BPSNUM+";"+X3PN+";9;2;;EA;1;;0;;" Using [ZITM]
  # Else
     Read [ITP]ITP0=X3PN;BPSNUM
     If fstat > 0
        IMPITP = 2
        Call ECR_TRACE("New product vendor record required for "+X3PN,0) From GESECRAN
        Wrseq "I;"+X3PN Using [ZITP]
        Wrseq "P;"+BPSNUM+";"+X3PN+";2;9" Using [ZITP]
     Endif
  # Endif

  Read [ITF]ITF0=X3PN;"DC31"

  If fstat > 0
     IMPITF = 2
     Call ECR_TRACE("New product site record required for "+X3PN,0) From GESECRAN
     Wrseq "I;"+X3PN+";DC31;1;ALC;2;RECF;RF01;WHS1;*;0;0;0;0" Using [ZITF]
  Endif




Return

$CRESOHDET
#  Wrseq "L;"+X3PN+";"+num$(QTY)+";"+num$((1-MARKUP)*PL)+";"+num$((1-COST)*PL)+";"+num$((1-COST)*PL)+";"+ON+";"+BPSNUM+";ON="+ON+"<div>OD="+OD+"</div>" Using [ZYSIF]
  Wrseq "L;"+X3PN+";"+num$(QTY)+";"+num$(ar2((1-MARKUP)*PL))+";"+num$(ar2((1-COST)*PL))+";"+num$(ar2((1-COST)*PL))+";"+ON+";"+BPSNUM Using [ZYSIF]

  OD = ""
  ON = ""
Return

$SOLINEENTRY

#   Openo SOHFILE,0 Using [ZXXX]
#   Iomode adxifs ";" Using [ZXXX]
#   Iomode adxirs chr$(13)+chr$(10) Using [ZXXX]
#   Iomode adxium 50 Using [ZXXX]
#   Wrseq "E;"+[M:YSOH0]SALFCY+";SON;;332815;DC31;"+[M:YSOH0]ORDREF Using [ZXXX]
#   Wrseq "L;MIRRATWO;1;500;250;Line text entry goes here" Using [ZXXX]
#   Openo Using [ZXXX]
#   Infbox "File written, check it...."
   Call OUVRE_TRACE("Importing "-SOHFILE) From LECFIC
   If IMPITM = 2 : Call IMPORTSIL ("ITMSIF", ITMFILE) From GIMPOBJ : Endif
   If IMPITF = 2 : Call IMPORTSIL ("ITFSIF", ITFFILE) From GIMPOBJ : Endif
   If IMPITP = 2 : Call IMPORTSIL ("YITMBPS", ITPFILE) From GIMPOBJ : Endif

   Call IMPORTSIL("YSIFORD",SOHFILE) From GIMPOBJ
   Call FERME_TRACE From LECFIC
   Call LEC_TRACE() From LECFIC



#   Nap "GESSOH/1/OBJSOH/M/ORD00017425"
Return



