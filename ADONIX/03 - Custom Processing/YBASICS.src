#    Purchase invoice source - local menu 511
#     1 = Order
#     2 = Receipt
#     3 = Return
#     4 = Invoice
#     5 = Miscellaneous
#     6 = Shipment

Funprog REPLACE(STR, OLD, NEW)
    Value Clbfile STR()
    Value Char OLD()
    Value Char NEW()
    Local Integer LENOLD
    Local Integer LENNEW

    #length of string to substitute
    LENOLD= len(OLD)
    #length of string that will substitute OLD string
    LENNEW= len(NEW)

    If LENOLD<=0 or LENOLD>len(STR)
        #the string to substitute is empty or it is longer than initial string, so we do nothing
        End STR
    Endif

    Local Integer INDEX
    Local Integer INDEXSTART

    #We search the string to substitute
    INDEX=instr(1,STR,OLD)

    While INDEX>0
        #INDEX>0 this means that we have found an occurrence of OLD
        #We substitute OLD occurrence with the NEW string
        STR =left$(STR, INDEX-1) + NEW + right$(STR, INDEX+LENOLD)

        #We calc the index to which the NEW string just inserted ends
        INDEXSTART=INDEX+LENNEW

        #We search the string to substitute starting from the end of last found occurrence
        INDEX=instr(INDEXSTART,STR,OLD)
    Wend
End STR
#############################################################################

#############################################################################
Funprog REPLACESTR(STR, OLD, NEW)
    Value Char STR()
    Value Char OLD()
    Value Char NEW()

    Local Char RET(250)
    Local Clbfile STRCLB(1)
    STRCLB = STR
    RET = func REPLACE(STRCLB, OLD, NEW)
End RET
#############################################################################


Subprog ADDBASFILH()
 # Infbox "Adding dbinvh..."
  Local Char FICSRV(250), FICCLI(250), MYPATH(250)
  Local Char BASFILE(250)
  Local Integer ASTATUS

  FICCLI = ""
  FICSRV = filpath("TMP", "", "")
  Call COPSRV(FICCLI, FICSRV, ASTATUS) From ORDSYS
  FICSRV = FICSRV+"\"+FICCLI
  BASFILE = FICSRV

  # 00004611z_dbinvh-668-M
  If mid$(FICCLI, 10, 8) <> "_dbinvh-"
      Infbox "Error selecting header file. Please select file with _dbinvh- in file name"
  Else
      [M]BASFILH = FICCLI
  Endif

End

Subprog ADDBASFILP()
 # Infbox "Adding dbinvp..."
  Local Char FICSRV(250), FICCLI(250), MYPATH(250)
  Local Char BASFILE(250)
  Local Integer ASTATUS
  Local Char EXPFIL(250)
  If [M]BASFILH = ""
     Infbox "Please select header file first"
  Else
    EXPFIL = ctrans([M]BASFILH, "dbinvh", "dbinvp")
    FICCLI = ""
    FICSRV = filpath("TMP", "", "")
    Call COPSRV(FICCLI, FICSRV, ASTATUS) From ORDSYS
    FICSRV = FICSRV+"\"+FICCLI
    BASFILE = FICSRV
    If FICCLI = EXPFIL
        [M]BASFILP = FICCLI
    Else
       Infbox "Please upload "+EXPFIL
    Endif
  Endif
End

Subprog CREBASPIH()
    Local Char BASFILH(250)
    Local Char BASFILP(250)

    Local Char FICSRV(250)
	
	
	local char XCMD(250)
	Local Integer XSTAT
    
	
	FICSRV = filpath("TMP", "", "")
    BASFILH = [M]BASFILH
    BASFILH = FICSRV + "\"+BASFILH
    BASFILP = [M]BASFILP
    BASFILP = FICSRV + "\"+BASFILP
	
   XCMD = 'charconvert "'+BASFILH+'" "'+BASFILH+'.tmp"'
   Call SYSTEME(adxmac(0),XCMD,"",XSTAT) From ORDSYS
   
   XCMD = 'charconvert "'+BASFILP+'" "'+BASFILP+'.tmp"'
   Call SYSTEME(adxmac(0),XCMD,"",XSTAT) From ORDSYS
   

   
   call PREPROCFILE(BASFILH, BASFILP)
   # infbox "Check"

   Gosub PROCBASPIH
End



#When searching for PO, if PO receipt cannot be found, give reason why
Subprog PODET(POHNUM, ITMREF, PTHNUM, PTDLIN, X3UM, X3QTY, X3PRI )
   Value Char POHNUM
   Value Char ITMREF
   Variable Char PTHNUM
   Variable Integer PTDLIN
   Variable Char X3UM
   Variable Integer X3QTY
   Variable Decimal X3PRI

   PTHNUM = ""
   PTDLIN = 0
   X3UM = ""
   X3QTY = 0
   # open receipt lines based on LININVFLG < 2
   If !clalev([YPTD]) : Local File PRECEIPTD [YPTD] : Endif
   Filter [YPTD] Where POHNUM = [L]POHNUM & ITMREF = [L]ITMREF & LININVFLG < 2 Order By PTHNUM
   Read [YPTD] First
   If fstat = 0
      PTHNUM = [F:YPTD]PTHNUM
      PTDLIN = [F:YPTD]PTDLIN
      X3UM = [F:YPTD]PUU
      X3QTY = [F:YPTD]QTYUOM
      X3PRI = [F:YPTD]NETPRI

   Else
     # Infbox  "Searching PO#"+POHNUM+" ITM:"+ITMREF+ " not returning receiving record"
   Endif
End

Subprog ITMDET (POHNUM, BASITM, BASITMDES, ITMREF, ITMDES, ITMUNIT)
#   4. change item reference to the following logic
#      a. if supplier part number exists, use supplier part number
#      b. if supplier part doesn't exist, use search-key if search-key exists
#      c. if none of above is found, use ITMREF
#   Notes from Oct 21, 2019 per discussion with Brandon
#     search in search key only, if not found match to itmref, don't search for supplier item

   Value Char POHNUM
   Value Char BASITM
   Value Char BASITMDES
   Variable Char ITMREF
   Variable Char ITMDES
   Variable Char ITMUNIT
   Local Char BPSNUM

   ITMREF = ""
   ITMDES = ""

   BPSNUM = ""
   If !clalev([YPOH]) : Local File PORDER [YPOH] : Endif
   If !clalev([YITM]) : Local File ITMMASTER [YITM] : Endif
   Filter [YITM] Where SEAKEY=[L]BASITM
   Read [YITM] First
   If fstat = 0
      ITMREF = [F:YITM]ITMREF
	  ITMUNIT = [F:YITM]STU
   Endif
   #infbox "Searching for"-[L]BASITM+"   Found:"+ITMREF
   If ITMREF = ""
      Read [YPOH]POH0=POHNUM

	  If fstat = 0
	     BPSNUM =[F:YPOH]BPSNUM
		 If !clalev([YITP]) : Local File ITMBPS [YITP] : Endif
		 Filter [YITP] Where BPSNUM=[L]BPSNUM & ITMREFBPS=BASITM
		 Read [YITP] First
		 If fstat = 0
		    ITMREF = [F:YITP]ITMREF
			ITMUNIT = [F:YITP]PUU
		 Endif
	     #    infbox "Searching for"-[L]BASITM+" under vendor "+[L]BPSNUM+"   Found:"+ITMREF	 +" fstat="+num$(fstat)
	  Endif
	Endif

	If ITMREF=""
      Filter [YITM] Where ITMREF=[L]BASITM
      Read [YITM] First
      If fstat = 0
         ITMREF = [L]BASITM
		 ITMUNIT = [F:YITM]STU
      Else
         ITMREF = ""
		 ITMUNIT = ""
      Endif
    Endif
   ITMDES = BASITMDES
End

$PROCBASPIH
  # Infbox "Process SIF file here"-SIFFILE
   Local Char HBUFFER(250)(1..93)
   Local Char PBUFFER(250)(1..33)
   Local Integer HFSTAT
   Local Integer PFSTAT
   Local Char BPS : BPS = "V5555"
   Local Char PIHFIL(250)
   Local Integer I
   Local Integer K

   Local Integer HACCDAT    : HACCDAT = 5
   Local Integer HBPRVCR    : HBPRVCR = 2
   Local Integer HBPRDAT    : HBPRDAT = 5
   local Integer HNOINVDAT  : HNOINVDAT = 6 #National office invoice date 
   local integer HTOTAMT    : HTOTAMT = 8
   Local Integer HTOTLINAMT : HTOTLINAMT = 53
   Local Integer HTAX1      : HTAX1 = 10
   Local Integer HTAX2      : HTAX2 = 11
   Local Integer HTAX3		: HTAX3 = 12
   Local Integer HTAX4		: HTAX4 = 13
   local integer HSHPDAT   : HSHPDAT = 14
   Local Integer HTOTFRT	: HTOTFRT = 67 #Changed from  90 to 67
   Local Integer HEHF		: HEHF = 84
   Local Integer HPOHNUM    : HPOHNUM = 28

   Local Integer HLOG1A     : HLOG1A = 69
   Local Integer HLOG1B     : HLOG1B = 72
   Local Integer HLOG2A     : HLOG2A = 70
   Local Integer HLOG2B     : HLOG2B = 73
   Local Integer HLOG3A     : HLOG3A = 71
   Local Integer HLOG3B     : HLOG3B = 74
   Local Integer HLOG4A     : HLOG4A = 0
   Local Integer HLOG4B     : HLOG4B = 75

   Local Integer HINVDAT    : HINVDAT = 5

   Local Integer HNETDUEDAT : HNETDUEDAT = 7

   Local Integer PBASITM    : PBASITM = 4
   Local Integer PBASQTY    : PBASQTY = 5
   Local Integer PBASUM     : PBASUM = 8
   Local Integer PBASPRI    : PBASPRI = 10
   Local Integer PBASAMT    : PBASAMT = 12
   Local Integer PBASITMDES : PBASITMDES = 13

   Local Char TMPMSG(250) : TMPMSG = ""


   Local Char BUFFER(250)
   local char INVTYP : INVTYP = ""
   Local Char POHNUM
   Local Char PTHNUM
   Local Integer PTDLIN
   Local Char BASITM
   Local Char X3ITM
   local char X3ITMUNIT
   Local Char BASITMDES
   Local Char X3ITMDES
   Local Char X3PUM
   Local Integer X3QTY
   Local Decimal X3PRI

   Local Char EHF

   PIHFIL = FICSRV + "\PIH.TXT"

   Openo PIHFIL,0 Using [ZPIH]
   Iomode adxifs ";" Using [ZPIH]
   Iomode adxirs chr$(13)+chr$(10) Using [ZPIH]
   Iomode adxium 50 Using [ZPIH]



   Openi BASFILH Using [ZBASFH]
   Iomode adxifs  chr$(9) Using [ZBASFH]
   Iomode adxirs  chr$(13)+chr$(10) Using [ZBASFH]

   Openi BASFILP Using [ZBASFP]
   Iomode adxifs chr$(9) Using [ZBASFP]
   Iomode adxirs chr$(13)+chr$(10) Using [ZBASFP]

   Call OUVRE_TRACE("Reading "-BASFILH) From LECFIC

   Repeat
    Rdseq HBUFFER Using [ZBASFH]

    HFSTAT = fstat
    If HBUFFER(1) <> ""
      For I = 1 To 93

         HBUFFER(I) = vireblc(HBUFFER(I),1)

      Next
      POHNUM = HBUFFER(HPOHNUM)
      If left$(POHNUM,3) = "46-"
          POHNUM = right$(POHNUM, 4)
      Endif

      TMPMSG = " "
      CALl ECR_TRACE(TMPMSG,0) FROM GESECRAN
      CALl ECR_TRACE(TMPMSG,0) FROM GESECRAN
      CALl ECR_TRACE(TMPMSG,0) FROM GESECRAN
      
      TMPMSG = "Importing invoice "-HBUFFER(HBPRVCR)-"for PO"-POHNUM
      TMPMSG += " Invoice Total = "+HBUFFER(HTOTAMT)

       Call ECR_TRACE(TMPMSG,0) From GESECRAN

       TMPMSG = ""
       TMPMSG = format$("K:60X", HBUFFER(HLOG1A))
       TMPMSG += HBUFFER(HLOG1B)
       Call ECR_TRACE(TMPMSG,0) From GESECRAN

       TMPMSG = ""
       TMPMSG = format$("K:60X", HBUFFER(HLOG2A))
       TMPMSG += HBUFFER(HLOG2B)
       Call ECR_TRACE(TMPMSG,0) From GESECRAN

       TMPMSG = ""
       TMPMSG = format$("K:60X", func REPLACESTR(HBUFFER(HLOG3A), "Exch. Rate:   .0000", ""))
       TMPMSG += HBUFFER(HLOG3B)
       Call ECR_TRACE(TMPMSG,0) From GESECRAN

       TMPMSG = ""
       TMPMSG = format$("K:60X", "Due Date: "+HBUFFER(HNETDUEDAT) + "     Inv. Date: "+HBUFFER(HINVDAT))
       TMPMSG +=  HBUFFER(HLOG4B)
       Call ECR_TRACE(TMPMSG,0) From GESECRAN

       if HBUFFER(HACCDAT) = ""
         if val(HBUFFER(HTOTLINAMT)) = 0
            HBUFFER(HTOTLINAMT) = num$(val(HBUFFER(HTOTAMT))-val(HBUFFER(HTAX1)))
         endif
         if val(HBUFFER(HTOTAMT)) < 0
            INVTYP = "CRM"
            HBUFFER(HTOTLINAMT) = func REPLACESTR( HBUFFER(HTOTLINAMT), "-", "")
         else 
            INVTYP = "INV"
         endif

         BUFFER = "E;MAIN;"+INVTYP+";;"+HBUFFER(HNOINVDAT)+";"+BPS+";AP;CAD;4;"+HBUFFER(HBPRVCR)+";"+HBUFFER(HNOINVDAT)+";;;;;"
         BUFFER += HBUFFER(HTOTLINAMT)+";"+num$(abs(val(HBUFFER(HTAX1)) + val(HBUFFER(HTAX2)) + val(HBUFFER(HTAX3)) + val(HBUFFER(HTAX4))))+";;;;;"+HBUFFER(HNETDUEDAT)
         Wrseq BUFFER Using [ZPIH]


         BUFFER = "L;5;;;1000;;UN;1;"+HBUFFER(HTOTLINAMT)+";"+HBUFFER(HTOTLINAMT)+";0;0;0;;;;"+HBUFFER(HBPRVCR)
         Wrseq BUFFER using [ZPIH]
         BUFFER = "F;2;0"
         Wrseq BUFFER using [ZPIH]
         Buffer = "F;9;0"
         Wrseq BUFFER using [ZPIH]
         K = 0
       else
         BUFFER = "E;MAIN;INV;;"+HBUFFER(HACCDAT)+";"+BPS+";AP;CAD;4;"+HBUFFER(HBPRVCR)+";"+HBUFFER(HACCDAT)+";;;;;"
         BUFFER += HBUFFER(HTOTLINAMT)+";"+num$(val(HBUFFER(HTAX1)) + val(HBUFFER(HTAX2)) + val(HBUFFER(HTAX3)) + val(HBUFFER(HTAX4)))+";;;;;"+HBUFFER(HNETDUEDAT)
         Wrseq BUFFER Using [ZPIH]
         K = 0
        
        EHF="0"

        If vireblc(PBUFFER(1),1) = vireblc(HBUFFER(1),1) and vireblc(PBUFFER(2),1) = vireblc(HBUFFER(2),1)
            # write data to output file
            BASITM = PBUFFER(PBASITM)
            BASITMDES = PBUFFER(PBASITMDES)

            Call ITMDET(POHNUM, BASITM, BASITMDES, X3ITM, X3ITMDES, X3ITMUNIT)
            Call PODET(POHNUM, X3ITM, PTHNUM, PTDLIN, X3PUM, X3QTY, X3PRI)

            If X3PUM = ""
                X3PUM = PBUFFER(PBASUM)
            Endif
            K += 1
            Gosub WRITELINEDETAIL
        Endif


        Repeat
            Rdseq PBUFFER Using [ZBASFP]
            PFSTAT = fstat
            If PBUFFER(1) <> ""
            K += 1
            For I = 1 To 33
                PBUFFER(I) = vireblc(PBUFFER(I),1)
            Next
                # Call ECR_TRACE("\t Reading data "-PBUFFER(1)-" "-PBUFFER(2)-" "-PBUFFER(3)-" "-PBUFFER(4),0) From GESECRAN
            #  BASITM = PBUFFER(PBASITM)
            #  BASITMDES = PBUFFER(PBASITMDES)

            #  call ITMDET(POHNUM, BASITM, BASITMDES, X3ITM, X3ITMDES)
            #  call PODET(POHNUM, X3ITM, PTHNUM, PTDLIN, X3PUM, X3QTY, X3PRI)

            #  if X3PUM = ""
            #     X3PUM = PBUFFER(PBASUM)
            #  endif

            If vireblc(PBUFFER(1),1) = vireblc(HBUFFER(1),1) and vireblc(PBUFFER(2),1) = vireblc(HBUFFER(2),1)
                    BASITM = PBUFFER(PBASITM)
                    BASITMDES = PBUFFER(PBASITMDES)

                    Call ITMDET(POHNUM, BASITM, BASITMDES, X3ITM, X3ITMDES, X3ITMUNIT)
                    Call PODET(POHNUM, X3ITM, PTHNUM, PTDLIN, X3PUM, X3QTY, X3PRI)

                    If X3PUM = ""
                    X3PUM = PBUFFER(PBASUM)
                    Endif
                    Gosub WRITELINEDETAIL
                #  WrSeq "L;1;"+HBUFFER(HPOHNUM)+";"+num$(val(PBUFFER(3)) *
    # 1000)+";1000;"+PBUFFER(PBASITM)+";"+PBUFFER(PBASUM)+";"+PBUFFER(PBASQTY)+";"+PBUFFER(PBASPRI)+";"+PBUFFER(PBASAMT)+";0;0;0;;;" using [ZPIH]
            Else
                Break
            Endif
            Else
            #   Call ECR_TRACE("Read empty line????", 0) From GESECRAN
            Endif
        Until PFSTAT = 1
        BUFFER = "F;2;"+HBUFFER(HTOTFRT)
        Wrseq BUFFER Using [ZPIH]
        IF val(EHF) = 0
            BUFFER = "F;9;"+HBUFFER(HEHF)
        else
            BUFFER = "F;9;"+EHF
        endif 
        Wrseq BUFFER Using [ZPIH]
       endif

    Endif
   Until HFSTAT = 1
   # Infbox "Finish processing file"
   Openo Using [ZPIH]

   Call FERME_TRACE From LECFIC
   Call LEC_TRACE() From LECFIC


   Call OUVRE_TRACE("Importing "-PIHFIL) From LECFIC
   Call IMPORTSIL("YPIH",PIHFIL) From GIMPOBJ
   Call FERME_TRACE From LECFIC
   Call LEC_TRACE() From LECFIC


Return


#add supplier invoice number / line number
$WRITELINEDETAIL
 # infbox X3ITMDES
 If X3ITMDES<> "RECYCLE CHARGE"
   If PTHNUM = ""
      if X3ITMUNIT = "" : X3ITMUNIT = "UN" : ENDIF
      Wrseq "L;5;;;1000;"+X3ITM+";"+X3ITMUNIT+";"+PBUFFER(PBASQTY)+";"+PBUFFER(PBASPRI)+";"+PBUFFER(PBASAMT)+";0;0;0;;;;"+X3ITMDES Using [ZPIH]
      # tmpMsg  = " ==> "+HBUFFER(HBPRVCR)+"/"+num$(k)+" - No receipt found for"-X3ITM-"creating miscellaneous line"

      TMPMSG  = " ==> "+HBUFFER(HBPRVCR)+"/"+num$(K)+" :"-PBUFFER(PBASQTY)-"UN"-X3ITM-"-"-X3ITMDES-" @ $"+PBUFFER(PBASPRI)
      Call ECR_TRACE(TMPMSG, 1) From GESECRAN

      TMPMSG  = "      No receipt found for"-X3ITM-"creating miscellaneous line"
      Call ECR_TRACE(TMPMSG, 1) From GESECRAN
   Else
      if X3QTY <> val(PBUFFER(PBASQTY))
	    Wrseq "L;5;;;1000;"+X3ITM+";"+X3ITMUNIT+";"+PBUFFER(PBASQTY)+";"+PBUFFER(PBASPRI)+";"+PBUFFER(PBASAMT)+";0;0;0;;;;"+X3ITMDES Using [ZPIH]
      else
        Wrseq "L;2;"+PTHNUM+";"+num$(PTDLIN)+";1000;"+X3ITM+";"+X3PUM+";"+PBUFFER(PBASQTY)+";"+PBUFFER(PBASPRI)+";"+PBUFFER(PBASAMT)+";0;0;0;;;;"+X3ITMDES Using [ZPIH]
      endif
      # tmpMsg = " ==> Receipt "+PTHNUM+"/"+num$(PTDLIN)+" found for "+X3ITM


      TMPMSG  = " ==> "+HBUFFER(HBPRVCR)+"/"+num$(K)+" :"-PBUFFER(PBASQTY)-"UN"-X3ITM-"-"-X3ITMDES-" @ $"+PBUFFER(PBASPRI)
      Call ECR_TRACE(TMPMSG, 0) From GESECRAN
      TMPMSG = "       Found on receipt "+PTHNUM+"/"+num$(PTDLIN)
      Call ECR_TRACE(TMPMSG, 0) From GESECRAN
      Gosub SHOWLINEERROR
   Endif
 Else
 #   infbox "Recycling charge"
    EHF = PBUFFER(PBASAMT)
 Endif

Return

$SHOWLINEERROR

   If X3QTY <> val(PBUFFER(PBASQTY))
      Call ECR_TRACE("        ==> Quantity does not match"-"X3 quantity: "+num$(X3QTY)-"Invoice quantity: "+num$(PBUFFER(PBASQTY)), 1) From GESECRAN #add PO / PO line
   Endif

   If X3PRI <> val(PBUFFER(PBASPRI))
      Call ECR_TRACE("        ==> Unit price does not match"-"X3 price:$"+num$(X3PRI)-"Invoice price:$"+num$(PBUFFER(PBASPRI)), 1) From GESECRAN
   Endif
Return





Subprog PREPROCFILE(BASFILH, BASFILP)
   value char BASFILH
   value char BASFILP
   
   Local Char HBUFFER(250)(1..93)
   Local Char PBUFFER(250)(1..33)
   
   Local Integer HFSTAT
   Local Integer PFSTAT
  
   local Integer HDONE : HDONE = 1
   
   Openo BASFILH,0 Using [ZOH]
   Iomode adxifs  chr$(9) Using [ZOH]
   Iomode adxirs  chr$(13)+chr$(10) Using [ZOH]
   Iomode adxium 50 Using [ZOH]
   
   Openo BASFILP,0 Using [ZOP]
   Iomode adxifs  chr$(9) Using [ZOP]
   Iomode adxirs  chr$(13)+chr$(10) Using [ZOP]
   Iomode adxium 50 Using [ZOP]
   
   Openi BASFILH+".tmp" Using [ZIH]
   Iomode adxifs  chr$(9) Using [ZIH]
   Iomode adxirs  chr$(13)+chr$(10) Using [ZIH]

   Repeat
    Rdseq HBUFFER Using [ZIH]

    HFSTAT = fstat
    If HBUFFER(1) <> ""
	  HDONE = 1
	  For I = 1 To 93
         HBUFFER(I) = vireblc(HBUFFER(I),1)
      Next
	  
	  Openi BASFILP+".tmp" Using [ZIP]
	  Iomode adxifs chr$(9) Using [ZIP]
	  Iomode adxirs chr$(13)+chr$(10) Using [ZIP]

      Repeat
        Rdseq PBUFFER Using [ZIP]
        PFSTAT = fstat
        If PBUFFER(1) <> ""
			if vireblc(PBUFFER(1),1) = vireblc(HBUFFER(1),1) and vireblc(PBUFFER(2),1) = vireblc(HBUFFER(2),1) and vireblc(PBUFFER(5),1) <> "0"
				For I = 1 To 33
					PBUFFER(I) = vireblc(PBUFFER(I),1)
				Next
				if HDONE = 1
				    for i = 1 to 93
						Wrseq HBUFFER(i), using [ZOH]
					next
					wrseq using [ZOH]
					HDONE = 2
				endif
				for i = 1 to 33
					Wrseq PBUFFER(i),  using [ZOP]
				next
				wrseq using [ZOP]
			endif
		Endif
      Until PFSTAT = 1
	  Openi using [ZIP]
    Endif
   Until HFSTAT = 1
 
   Openo Using [ZOH]
   Openo using [ZOP]
   openi using [ZIH]
  
End




































