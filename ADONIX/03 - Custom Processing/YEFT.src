########################################
$ACTION

Infbox num$(ACTION)

Case ACTION
 When "INIT" : Gosub BOUTON
Endcase
Return

#########################################

$BOUTON

#Case YEFT
#    When "c"     : Gosub SENDACH
#    When "z"     : Gosub SELECTALL
#Endcase

Return

########################################
$SENDACH
Local Integer EFTFILENUM

If clalev([F:YEV]) = 0 : Local File YEVENT [YEV] : Endif
If clalev([F:BAN]) = 0 : Local File BANK[BAN] : Endif


Readlock [YEV]YEV0 = ""

Trbegin [YEV] : # Transaction Start
Readlock [BAN]BAN0 = [M:FRM0]BAN
If fstat > 1
  # Record does not exist
  Rollback
Elsif fstat = 1
  # Record already locked by another user
  Rollback
Else
  EFTFILENUM = [F:BAN]YEFTFILENUM
  [YEV]FRMNUM = [M:FRM0]FRMNUM
  [YEV]ISACTIVE = 1
  [YEV]NOACH = 0
  [YEV]YEFTFILENUM = EFTFILENUM
  [YEV]CREDATTIM = date$
  Write [YEV]
  [F:BAN]YEFTFILENUM = EFTFILENUM + 1
  Rewrite [BAN]
  If fstat=0
    Commit
    Infbox "Bank file# "-num$(EFTFILENUM)-" and email alert will be created."
  Else
   Rollback
  Endif

 Endif

#Trbegin [YEV] : # Transaction Start
##[YEV]FRMNUM = [M:FRM0]FRMNUM
#[YEV]ISACTIVE = 1
#[YEV]CREDATTIM = date$
#Write [YEV]
#Commit
#Infbox "Bank file has been created; ACH notification email(s) have been sent."


Return

########################################
$SELECTALL

Return
########################################

########################################
$SENDACHNOACH
Local Integer EFTFILENUM

If clalev([F:YEV]) = 0 : Local File YEVENT [YEV] : Endif
If clalev([F:BAN]) = 0 : Local File BANK[BAN] : Endif

Readlock [YEV]YEV0 = ""
Trbegin [YEV] : # Transaction Start
Readlock [BAN]BAN0 = [M:FRM0]BAN
If fstat > 1
  # Record does not exist
  Rollback
Elsif fstat = 1
  # Record already locked by another user
  Rollback
Else
  EFTFILENUM = [F:BAN]YEFTFILENUM
  [YEV]FRMNUM = [M:FRM0]FRMNUM
  [YEV]ISACTIVE = 1
  [YEV]NOACH = 2
  [YEV]YEFTFILENUM = EFTFILENUM
  [YEV]CREDATTIM = date$
  Write [YEV]
  [F:BAN]YEFTFILENUM = EFTFILENUM + 1
  Rewrite [BAN]
  If fstat=0
    Commit
    Infbox "Bank file# "-num$(EFTFILENUM)-" will be created."
  Else
   Rollback
  Endif

 Endif

Return



##################################################
Subprog YEFT (YEFT)
Value    Char    YEFT

Case YEFT
    When "c"     : Gosub SENDACH
    When "z"     : Gosub SELECTALL
Endcase

End

##################################################
Subprog YEFTNOACH (YEFT)
Value    Char    YEFT

Case YEFT
    When "d"     : Gosub SENDACHNOACH
    When "z"     : Gosub SELECTALL
Endcase
End

