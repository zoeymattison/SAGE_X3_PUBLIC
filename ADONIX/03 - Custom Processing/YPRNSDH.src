#<AdxTL>@(#)0.0.0.0 $Revision$ 
call PRINTSDH("RMADC3005200003")
End

Subprog PRINTSDH(SDHNUM)
Value char SDHNUM
local char FONCTION
local char TBPAR(150)(150)
local char TBVAL(150)(150)
local char PRNDEST


local char ETAT
TBPAR(0) = "sitedeb"	: TBVAL(0) = ""
TBPAR(1) = "sitefin"	: TBVAL(1) = "ZZZZZZZZ"

TBPAR(2) = "Livraisondeb"	: TBVAL(2) = SDHNUM
TBPAR(3) = "Livraisonfin"	: TBVAL(3) = SDHNUM

TBPAR(4) = "clientdeb"		: TBVAL(4) = ""
TBPAR(5) = "clientfin"		: TBVAL(5) = "ZZZZZZZZ"

TBPAR(6) = "datedeb"		: TBVAL(6) = "1/1/2020"
TBPAR(7) = "datefin"		: TBVAL(7) = "12/31/2099"

TBPAR(8) = "codimp"		: TBVAL(8) = "1"
TBPAR(9) = "impselections"	: TBVAL(9) = "1"

TBPAR(10) = "valdeb"		: TBVAL(10) = "1"
TBPAR(11) = "valfin"		: TBVAL(11) = "2"

TBPAR(12) = "facdeb"		: TBVAL(12) = "1"
TBPAR(13) = "facfin"		: TBVAL(13) = "2"

ETAT = "BONLIV"

PRNDEST = func afnc.intfld("APRTAUS", "PRT", GUSER+"~"+ETAT+"~")
if PRNDEST = "" 
   PRNDEST = "PREVIEW"
endif
Call ETAT(ETAT, PRNDEST, "eng", 0, FONCTION, TBPAR, TBVAL) from AIMP3

End


















