Subprog AM_BPRNUM(VALEUR)
Variable Char    VALEUR()
local char REP
local char ADDR

ADDR = func AFNC.INTFLD("BPCUSTOMER", "BPDADD", VALEUR)
REP = func AFNC.INTFLD("BPDLVCUST", "REP", VALEUR+"~"+ADDR)
if REP = "" : REP = func AFNC.INTFLD("BPCUSTOMER", "REP", VALEUR) : endif

[M]BPAADD = ADDR
[M]REP = REP

End


