# call PRINTSRH("RMADC3005200003")
# call PRINTSIH2("DIR042173")

call EMLSIH("DIR054021")

End

Subprog EMLSIH(SIHNUM)
Value char SIHNUM
local char FONCTION
local char TBPAR(150)(150)
local char TBVAL(150)(150)

TBPAR(0) = "sitedeb"	: TBVAL(0) = ""
TBPAR(1) = "sitefin"	: TBVAL(1) = "ZZZZZZZZ"

TBPAR(2) = "facturedeb"	: TBVAL(2) = SIHNUM
TBPAR(3) = "facturefin"	: TBVAL(3) = SIHNUM

TBPAR(4) = "typedeb"		: TBVAL(4) = ""
TBPAR(5) = "typefin"		: TBVAL(5) = "ZZZZZZZZ"

TBPAR(6) = "datedeb"		: TBVAL(6) = "1/1/2020"
TBPAR(7) = "datefin"		: TBVAL(7) = "12/31/2099"

TBPAR(8) = "codimp"		: TBVAL(8) = "1" # change to 1 after testing "1"
TBPAR(9) = "impselections"	: TBVAL(9) = "1" 

TBPAR(10) = "duplicata"		: TBVAL(10) = "1"
TBPAR(11) = "traystd"		: TBVAL(11) = "1"
TBPAR(12) = "traybvr"		: TBVAL(12) = "1"
TBPAR(13) = "logosoc"		: TBVAL(13) = "2"
TBPAR(14) = "fcycpynam"		: TBVAL(14) = "1"
TBPAR(15) = "edd"		: TBVAL(15) = "2"
TBPAR(16) = "prnpck"		: TBVAL(16) = "0"
TBPAR(17) = "prndst"		: TBVAL(17) = "" # func YTAC.GETPRINTERUNC([F:SIV]CREUSR)



Call ETAT("YSBONFACPEDD", "AUTO", "eng", 0, FONCTION, TBPAR, TBVAL) from AIMP3

End


Subprog PRINTSIH2(SIHNUM)
Value char SIHNUM
local char FONCTION
local char TBPAR(150)(150)
local char TBVAL(150)(150)
local char PRNDEST
local char BPCNUM
local char SENDSIH
local char SENDEMAIL

local char ETAT
TBPAR(0) = "sitedeb"	: TBVAL(0) = ""
TBPAR(1) = "sitefin"	: TBVAL(1) = "ZZZZZZZZ"

TBPAR(2) = "facturedeb"	: TBVAL(2) = SIHNUM
TBPAR(3) = "facturefin"	: TBVAL(3) = SIHNUM

TBPAR(4) = "typedeb"		: TBVAL(4) = ""
TBPAR(5) = "typefin"		: TBVAL(5) = "ZZZZZZZZ"

TBPAR(6) = "datedeb"		: TBVAL(6) = "1/1/2020"
TBPAR(7) = "datefin"		: TBVAL(7) = "12/31/2099"

TBPAR(8) = "codimp"		: TBVAL(8) = "1"
TBPAR(9) = "impselections"	: TBVAL(9) = "1"

TBPAR(10) = "duplicata"		: TBVAL(10) = "1"
TBPAR(11) = "traystd"		: TBVAL(11) = "1"
TBPAR(12) = "traybvr"		: TBVAL(12) = "1"
TBPAR(13) = "logosoc"		: TBVAL(13) = "2"
TBPAR(14) = "fcycpynam"		: TBVAL(14) = "1"
TBPAR(15) = "edd"		: TBVAL(15) = "1"
TBPAR(16) = "prnpck"		: TBVAL(16) = "2"
TBPAR(17) = "prndst"		: TBVAL(17) = "" # func YTAC.GETPRINTERUNC([F:SIV]CREUSR)

BPCNUM = func afnc.intfld("SINVOICEV", "BPCINV", SIHNUM )
SENDSIH = func afnc.intfld("BPCUSTOMER", "YSENDPRINT", BPCNUM)
SENDEMAIL = func afnc.intfld("BPCUSTOMER", "YSENDEMAIL", BPCNUM)
# infbox BPCNUM


ETAT = "YSBONFACP"

PRNDEST = func afnc.intfld("APRTAUS", "PRT", GUSER+"~"+ETAT+"~")
if PRNDEST = "" 
   PRNDEST = "PREVIEW"
endif


if SENDSIH="2"
  Call ETAT(ETAT, PRNDEST, "eng", 0, FONCTION, TBPAR, TBVAL) from AIMP3
#   TBVAL(8) = "2"
endif
#if SENDEMAIL="2"
#  Call ETAT("YSBONFACPEDD", "AUTO", "eng", 0, FONCTION, TBPAR, TBVAL) from AIMP3
#   TBVAL(8) = "2"
#endif
 
ETAT = "YBONLIV2"
Call ETAT(ETAT, PRNDEST, "eng", 0, FONCTION, TBPAR, TBVAL) from AIMP3
End


Subprog PRINTSIH(SIHNUM)
Value char SIHNUM
local char FONCTION
local char TBPAR(150)(150)
local char TBVAL(150)(150)
local char PRNDEST


local char ETAT
TBPAR(0) = "sitedeb"	: TBVAL(0) = ""
TBPAR(1) = "sitefin"	: TBVAL(1) = "ZZZZZZZZ"

TBPAR(2) = "facturedeb"	: TBVAL(2) = SIHNUM
TBPAR(3) = "facturefin"	: TBVAL(3) = SIHNUM

TBPAR(4) = "typedeb"		: TBVAL(4) = ""
TBPAR(5) = "typefin"		: TBVAL(5) = "ZZZZZZZZ"

TBPAR(6) = "datedeb"		: TBVAL(6) = "1/1/2020"
TBPAR(7) = "datefin"		: TBVAL(7) = "12/31/2099"

TBPAR(8) = "codimp"		: TBVAL(8) = "1"
TBPAR(9) = "impselections"	: TBVAL(9) = "1"

TBPAR(10) = "duplicata"		: TBVAL(10) = "1"
TBPAR(11) = "traystd"		: TBVAL(11) = "1"
TBPAR(12) = "traybvr"		: TBVAL(12) = "1"
TBPAR(13) = "logosoc"		: TBVAL(13) = "2"
TBPAR(14) = "fcycpynam"		: TBVAL(14) = "1"
TBPAR(15) = "edd"		: TBVAL(15) = "1"
TBPAR(16) = "prnpck"		: TBVAL(16) = "2"
TBPAR(17) = "prndst"		: TBVAL(17) = "" # func YTAC.GETPRINTERUNC([F:SIV]CREUSR)


ETAT = "YSBONFACP"

PRNDEST = func afnc.intfld("APRTAUS", "PRT", GUSER+"~"+ETAT+"~")
if PRNDEST = "" 
   PRNDEST = "PREVIEW"
endif
Call ETAT(ETAT, PRNDEST, "eng", 0, FONCTION, TBPAR, TBVAL) from AIMP3

End


##################################################
Subprog PRINTSRH(SIHNUM, PRNDEST)
Value    Char    SIHNUM
value char PRNDEST
local char FONCTION
local char TBPAR(150)(150)
local char TBVAL(150)(150)

local char ETAT
TBPAR(0) = "sitedeb"	: TBVAL(0) = ""
TBPAR(1) = "sitefin"	: TBVAL(1) = "ZZZZZZZZ"

TBPAR(2) = "retourdeb"	: TBVAL(2) = SIHNUM
TBPAR(3) = "retourfin"	: TBVAL(3) = SIHNUM

TBPAR(4) = "clientdeb"	: TBVAL(4) = ""
TBPAR(5) = "clientfin"	: TBVAL(5) = "ZZZZZZZZ"

TBPAR(6) = "typeretdeb"		: TBVAL(6) = ""
TBPAR(7) = "typeretfin"		: TBVAL(7) = "ZZZZZZZZ"

TBPAR(8) = "datedeb"		: TBVAL(8) = "1/1/2020"
TBPAR(9) = "datefin"		: TBVAL(9) = "12/31/2099"

TBPAR(10) = "impselections"	: TBVAL(10) = "1"

ETAT = "BONRETLIV"

if PRNDEST = "" : PRNDEST = "PREVIEW" : ENDIF
Call ETAT(ETAT, PRNDEST, "eng", 0, FONCTION, TBPAR, TBVAL) from AIMP3 #USE PICK PRINTER
End



Subprog PRINTPACLBL(PRHNUM,DEST, NUMCOPY)
Value char PRHNUM
Value integer NUMCOPY
local integer i 
local char FONCTION
local char TBPAR(150)(150)
local char TBVAL(150)(150)

local char ETAT
TBPAR(0) = "bonprepdeb"	: TBVAL(0) = PRHNUM
TBPAR(1) = "bonprepfin"	: TBVAL(1) = PRHNUM

ETAT = "YMOS_PL_PACLAB"

for i = 1 to NUMCOPY
   Call ETAT(ETAT, DEST, "eng", 0, FONCTION, TBPAR, TBVAL) from AIMP3
next
End
















































































































